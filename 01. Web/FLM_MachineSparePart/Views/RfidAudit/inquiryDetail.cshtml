@model FILM_Sparepart_MVC.Models.SparePart
@{
    var url = @Url.Action("inquiry", "RfidAudit").ToString();
    ViewBag.Title = "Inquiry Detail";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}
<h2>Spare Part Master Maintenance - View</h2>
<hr />
<table style="width:100%;">
    <tr>
        <td>

            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                <div class="form-group">
                    @Html.HiddenFor(a => a.SPARE_PART_ID)
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Model No</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.SPARE_PART_MODEL_ID_1
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Series No</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.SERIES_NO
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Part No</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.PART_NO
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Machine Model</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.SPARE_PART_MACHINE_ID_1
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">RFID Type</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.RFID_TYPE_ID_1
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">RFID Tag ID</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.RFID_TAG_ID
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">RFID Tag ID 2</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.RFID_TAG_ID_2
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Storage Code</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.READER_ID
                    </div>
                </div>
                @*<div class="form-group">
                        <label class="col-sm-2">Storage Description 1:</label>
                        <div class="col-md-4">
                            @Html.DropDownListFor(m => m.Reader_ID, Model.Dropdowndesc1, "Select", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Storage Description 2:</label>
                        <div class="col-md-4">
                            @Html.DropDownListFor(m => m.Reader_ID, Model.Dropdowndesc2, "Select", new { @class = "form-control" })
                        </div>
                    </div>*@
                <div class="form-group">
                    <label class="col-sm-2">Manufacturer Code</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.MANUFACTURER_ID_1
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2">Remarks</label>
                    <label class="labelW10">:</label>
                    <div class="col-md-4">
                        @Model.REMARKS
                    </div>
                </div>
            </div>
            <div class="form-group">

                @Html.BackButton(url)
            </div>

        </td>
    </tr>
</table>
<table style="border:1px solid; border-radius:20px; width:50%;">
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
        <td style="width:35%;">@Model.CREATED_BY</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
        <td style="width:35%;">@Model.CREATED_DATE</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
        <td style="width:35%;">@Model.UPDATED_BY</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
        <td style="width:35%;">@Model.UPDATED_DATE</td>
    </tr>
</table>
