@model Boolean
@{
    ViewBag.Title = "RFID Audit Inquiry";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}
<style>
    form {
        padding: 10px;
    }
</style>
@if (TempData["result"] != null)
{
    <script type="text/javascript">
        alert("@TempData["result"]");
        var a = "@Url.Action("MM_SPART_LST", "RfidAudit")";
        window.location.href = "@Url.Action("MM_SPART_LST", "RfidAudit")";
    </script>
}
<h2>@ViewBag.Title</h2>
<hr />

<div class="form-inline">
    <div class="row">

        <div class="col-md-5">
            <input type="text" id="rfid" class="form-control txtbox text-box single-line" />
            <input class="btn btn-primary" type="button" onclick="searchClick()" value="Search" />
        </div>
    </div>
</div>



<script>
    var rfidFound = true; 
    rfidFound =  "@Model" == "False" ? false : true;
    if (!rfidFound) {
        alert("rfid not found")
        }
    console.log(@Model)

    function searchClick() {
        var rfid = document.getElementById("rfid").value;
        if (rfid != null) {
            window.location = '@Url.Action("InquiryDetail", "RfidAudit")?rfid=' + rfid;
        }
    }

</script>