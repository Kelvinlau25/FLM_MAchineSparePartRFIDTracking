@model DBModel.RFIDModel
@{
    ViewBag.Title = "RFIDScan";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}
@{
    if (null != TempData["alertMessage"])
    {
        <script type="text/javascript">
            alert('@TempData["alertMessage"]');
        </script>
    }
}
<style type="text/css">
    .body-content {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    body {
        display: block;
        background-color: rgb(240,240,240);
    }

    .txtbox {
        width: 100%;
    }

    .searchBtn {
        margin-top: 0px;
    }

    .connection {
        display: block;
        height: auto;
        width: 100%;
        padding-top: 10px;
        margin-bottom: 10px;
        margin-left: 2px;
        background-color: #3B5998;
    }

    #testbtn {
        padding: 0;
        border: none;
        background: none;
        height: 3.5vw;
        width: 3.5vw;
    }

    .testTable tr td {
        height: auto;
    }

    .testTable {
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        margin-top: 7px;
        table-layout: fixed !important;
    }


        .testTable thead tr td {
            font-size: 3vw;
            background-color: #7400F6;
            font-weight: bold;
            color: White;
        }

        .testTable tbody tr td {
            font-size: 30px;
            font-size: 3vw;
            height: auto !important;
            height: 10px !important;
            overflow: hidden;
            text-overflow: ellipsis;
            overflow-wrap: break-word;
            vertical-align: top;
        }

            .testTable tbody tr td:first-child {
                text-align: center;
            }

    .logout {
        display: block;
        float: right;
        height: auto;
        font-weight: bold;
        font-size: 2.5vw;
        text-decoration: none;
        color: white;
    }

        .logout a:hover {
            text-decoration: underline;
            font-weight: bold;
        }

    .backBtn {
        float: right;
        font-weight: bold;
        color: white;
</style>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="wrap">
        <div class="connection row" id="row">
            <div class="col-md-11">
                <div style="float:left;">
                    <input value="" type="button" id="testbtn" style="background-color:red;" runat="server" />
                    <label id="lblConn" title="No Internet Connection" style="color:Red;" visible="true"> &nbsp; No Internet Connection</label>
                </div>
            </div>

        </div>
        <div id="divDDL" style="margin-top:25px;font-weight:bold;">
            <div class="col-100">
                @*<div id="row">
                        <div class="col-md-12">
                            Location
                        </div>
                    </div>
                    <div id="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.DropDownList("ddlLocation", Model.DropdownLocation, "Select Location", new { @class = "form-control", @id = "ddlLocation", @disabled = "disabled" })

                            </div>
                        </div>
                    </div>*@
                <div id="row">
                    <div class="col-md-4 col-lg-4">
                        Company
                    </div>
                    <div class="col-md-4 col-lg-4">
                        Department
                    </div>
                    <div class="col-md-4 col-lg-4">
                        Location
                    </div>
                </div>
                <div id="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.DropDownList("ddlCompany", Model.DropdownCompany, new { @class = "form-control", @id = "ddlCompany", @disabled = "disabled" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.DropDownList("ddlDepartment", Model.DropdownDepartment, new { @class = "form-control", @id = "ddlDepartment", @disabled = "disabled" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.DropDownList("ddlLocation", Model.DropdownLocation, "Select Location", new { @class = "form-control", @id = "ddlLocation", @disabled = "disabled" })
                        </div>
                    </div>
                </div>
                @*<div id="row">
                        <div class="col-md-12">
                            <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                            @Html.BackButton(url)
                        </div>
                    </div>*@
            </div>
        </div>
        <div id="divSCAN" style="display:none;">
            <div class="col-100">
                <div id="row" style="height:31px">
                    <div class="col-md-12 col-sm-12">
                        <label>
                            RFID :
                            <input id="taginput" oninput="tagFunction(this.value);" disabled="disabled" autofocus />
                        </label>&nbsp; &nbsp;
                    </div>
                </div>
                <div id="row">
                    <div class="col-md-12">
                        <label id="taglblscan" title="" style="color:black;" visible="true">Current scanned : 0</label>
                        <label id="taglblresult" title="" style="color:Red;" visible="true"></label>
                    </div>
                </div>
                <div id="row" style="height: 50px;">
                    <div class="col-md-1">
                        <input id="btnSubmit" type="button" class="btn btn-success" value="Submit" title="Confirm the audit" onclick="completeScan();" disabled="disabled" />
                    </div>
                    <div class="col-md-1">
                        <input id="btnReset" type="button" class="btn btn-warning" value="Reset" title="Reset the audit" OnClick="resetBtn();" disabled="disabled" />
                    </div>
                    <div class="col-md-1">
                        <input id="btnCancel" type="button" class="btn btn-danger" value="Cancel" onclick="cancelScan();" title="Exit current audit" disabled="disabled" />
                    </div>
                </div>
                <div id="row">
                    <div class="col-md-12">
                        <table id="tagTABLE" class="testTable" style="display:none;">
                            <thead>
                                <tr>
                                    <td style="width:10%;">No</td>
                                    <td style="width:80%;">RFID</td>
                                    <td style="width:10%;">&nbsp;</td>
                                    <td style="visibility:hidden;">&nbsp;</td>
                                </tr>
                            </thead>
                            <tbody id="tagtbodyid"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@{
    <script type="text/javascript">
        $(document).ready(function () {

            $("#ddlCompany").change(function () {
                var dID = $('#ddlCompany option:selected').val();
                //alert(dID);
                $("#ddlDepartment").empty();
                $("#ddlDepartment").append($('<option></option>').val("").html("Select Department"));
                $("#ddlLocation").empty();
                $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));

                if (dID != null) {//dID > 0
                    $.ajax({
                        url: '@Url.Action("GETdepartmentDDL", "RfidAudit")',
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        dataType: "JSON",
                        data: { pID: dID },
                        success: function (response) {
                            console.log(response);
                            $.each(response, function (index, value) {
                                $("#ddlDepartment").append(
                                    $('<option></option>').val(value.Value).html(value.Text));
                            });
                        },
                        error: function (xhr, status, error) {
                            alert(xhr.responseText);
                            var err = eval("(" + error.responseText + ")");
                            alert(err.Message);
                        }
                    });
                }
            });

            $("#ddlDepartment").change(function () {
                var dID = $('#ddlCompany option:selected').val();
                var dID1 = $('#ddlDepartment option:selected').val();
                $("#ddlLocation").empty();
                $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));
                if (dID != null && dID1 != null) {//dID > 0 && dID1 > 0
                    $.ajax({
                        url: '@Url.Action("GETlocationDDL", "RfidAudit")',
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        dataType: "JSON",
                        data: { pID: dID, pID1: dID1 },
                        success: function (response) {
                            console.log(response);
                            $.each(response, function (index, value) {
                                $("#ddlLocation").append(
                                    $('<option></option>').val(value.Value).html(value.Text));
                            });
                        },
                        error: function (xhr, status, error) {
                            alert(xhr.responseText);
                            var err = eval("(" + error.responseText + ")");
                            alert(err.Message);
                        }
                    });
                }

            });

            $("#ddlLocation").change(function () {
                var pID = $('#ddlLocation option:selected').val();
                $.ajax({
                        url: '@Url.Action("CheckLocationStatus", "RfidAudit")',
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        dataType: "JSON",
                        data: { pID: pID },
                        success: function (response) {
                            console.log(response);
                            if (response == "1") {
                                var r = confirm("Are you sure want to Audit " + pID + " now?");
                                if (r == true) {
                                    RFIDUPDATE("1", pID, "", "ADMIN");
                                    document.getElementById('divDDL').style.display = 'none';
                                    document.getElementById('divSCAN').style.display = 'block';
                                    var location = $('#ddlLocation option:selected').text();
                                    document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : 0";
                                    document.getElementById("taginput").disabled = false;
                                    document.getElementById("taginput").value = "";
                                    document.getElementById("taginput").focus();
                                } else {
                                    document.getElementById('ddlLocation').selectedIndex = "0";
                                }
                            }
                            else if (response == "2") {
                                alert("Someone is doing audit for " + pID + " now");
                                document.getElementById('ddlLocation').selectedIndex = "0";
                            }
                            else if (response == "3") {
                                //alert(pID + " already done audit for today");
                                //document.getElementById('ddlLocation').selectedIndex = "0";
                                var r = confirm("Are you sure want to Audit " + pID + " now?");
                                if (r == true) {
                                    RFIDUPDATE("1", pID, "", "ADMIN");
                                    document.getElementById('divDDL').style.display = 'none';
                                    document.getElementById('divSCAN').style.display = 'block';
                                    var location = $('#ddlLocation option:selected').text();
                                    document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : 0";
                                    document.getElementById("taginput").disabled = false;
                                    document.getElementById("taginput").value = "";
                                    document.getElementById("taginput").focus();
                                } else {
                                    document.getElementById('ddlLocation').selectedIndex = "0";
                                }
                            }

                        },
                        error: function (xhr, status, error) {
                            alert(xhr.responseText);
                            var err = eval("(" + error.responseText + ")");
                            alert(err.Message);
                        }
                });
            });


            });

            var username = "@Model.CREATED_BY";


            function completeScan() {
                var r = confirm("Are you sure want to complete current process now?");
                if (r == true) {
                    document.getElementById("ddlLocation").disabled = true;
                    document.getElementById("btnSubmit").disabled = true;
                    document.getElementById("btnReset").disabled = true;
                    document.getElementById("btnCancel").disabled = true;
                    document.getElementById("taglblresult").style.color = "green";
                    document.getElementById("taglblresult").innerHTML = "Updating audit result, please wait.";

                    var table = document.getElementById("tagTABLE").getElementsByTagName('tbody')[0];
                    var rows = $('#tagTABLE tbody tr').length;
                    var pID = $('#ddlLocation option:selected').val();
                    var timecount = 0;

                    for (i = 0; i < rows; i++) {
                        console.log("here");
                        timecount = timecount + 300;
                        var rfid = table.rows[i].cells[1].innerHTML;
                        RFIDUPDATE("2", pID, rfid, "ADMIN");
                        checkAndInsertRfid(rfid);

                    }

                    RFIDUPDATE("4", pID, "", "ADMIN");

                    setTimeout(function () { RFIDUPDATE("6", pID, "", "ADMIN"); }, timecount);


                }
            }

            function checkAndInsertRfid(rfidInput) {
               var location = document.getElementById("ddlLocation").value;
                $.ajax({
                url: '@Url.Action("CreateEntry", "RfidAudit")',
                type: "POST",
                contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ "rfid": rfidInput, "location": location, "username": username }),
                    success: function (response) {
                        resetTAG();
                },
                error: function (e) {
                    alert("Please put in an rfid");
                }
            });
            }
            function cancelScan() {
                var r = confirm("Are you sure want to cancel current process now?");
                if (r == true) {
                    window.location = '@Url.Action("Entry", "RfidAudit")';
                }
            }

        function doSomething() {

            if (navigator.onLine == true) {

                document.getElementById("testbtn").style.backgroundColor = "lightgreen";
                document.getElementById("lblConn").style.color = "lightgreen";
                document.getElementById("lblConn").innerHTML = "Connection Available";
                document.getElementById("ddlCompany").disabled = false;
                document.getElementById("ddlDepartment").disabled = false;
                document.getElementById("ddlLocation").disabled = false;
                document.getElementById("btnSubmit").disabled = false;
                document.getElementById("btnReset").disabled = false;
                document.getElementById("btnCancel").disabled = false;


            } else {
                document.getElementById("testbtn").style.backgroundColor = "red";
                document.getElementById("lblConn").style.color = "red";
                document.getElementById("lblConn").innerHTML = "Connection Not Available";
                document.getElementById("ddlCompany").disabled = true;
                document.getElementById("ddlDepartment").disabled = true;
                document.getElementById("ddlLocation").disabled = true;
                document.getElementById("btnSubmit").disabled = true;
                document.getElementById("btnReset").disabled = true;
                document.getElementById("btnCancel").disabled = true;
            }

            $.ajax({

                url: '@Url.Action("KeepSession", "RfidAudit")',
                cache: false,
                success: function (html) {

                    //alert("Data Processed successfully....");
                }

            });

        }

            function resetStatus() {
                $("#ddlDepartment").empty();
                $("#ddlDepartment").append($('<option></option>').val("").html("Select Department"));
                $("#ddlLocation").empty();
                $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));
                $("#tagtbodyid").empty();
                document.getElementById("taglblscan").innerHTML = "Current scanned : 0";
                document.getElementById("taglblscan").style.color = "black";
                document.getElementById("taglblresult").innerHTML = "";
                //document.getElementById('ddlLocation').selectedIndex = "0";
                document.getElementById('ddlCompany').selectedIndex = "0";
                document.getElementById('divDDL').style.display = 'block';
                document.getElementById('divSCAN').style.display = 'none';
                document.getElementById("taginput").disabled = true;
        }

        function resetBtn() {

            var r = confirm("Are you sure want to reset current audit process?");
            if (r == true) {
                resetTAG();
            }

            }


            function backBtn() {
                var r = confirm("Are you sure want to cancel current audit process and back to menu?");
                if (r == true) {
                    var pID = $('#ddlLocation option:selected').val();
                    RFIDUPDATE("5", pID, "", "ADMIN");
                    var url = '@Url.Action("Login", "Home")';
                    window.location.href = url;
                }
            }

            function resetTAG() {

            var location = $('#ddlLocation option:selected').text();
            $("#tagTABLE").css({ "display": "none" });
            $("#tagtbodyid").empty();
            document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : 0";
            document.getElementById("taglblscan").style.color = "black";
            $("#tagresultTable").css({ "display": "none" });
            document.getElementById("taglblresult").innerHTML = "";
            document.getElementById("taginput").value = "";
            document.getElementById("taginput").focus();
        }

        function addRow(str) {

            if (str != "") {
            debugger
                if ($('#tagresultTable tbody tr').length > 0) { resetTAG(); }

                var table = document.getElementById("tagTABLE").getElementsByTagName('tbody')[0];
                var rows = $('#tagTABLE tbody tr').length;

                for (i = 0; i < rows; i++) {
                    var row1 = table.rows[i].cells[1].innerHTML;

                    if (str == row1) {
                        document.getElementById("taginput").value = "";
                        document.getElementById("taglblresult").style.color = "red";
                        document.getElementById("taglblresult").innerHTML = "Cannot scan duplicate RFID tag."; return;
                    }


                }

                var row = table.insertRow(rows);
                var cell1 = row.insertCell(0);
                var cell2 = row.insertCell(1);
                var cell3 = row.insertCell(2);
                var cell4 = row.insertCell(3);

                cell1.innerHTML = '<strong>' + (rows + 1) + '</strong>';
                cell2.innerHTML = str;
                cell3.innerHTML = '<a Class="fa fa-times-circle fa-lg dICON" style="width:100%;text-align:center;" onclick="deleteRow(this)"></a>';
                cell4.innerHTML = str;
                cell4.style.display = "none";
                $("#tagTABLE").css({ "display": "" });
                var location = $('#ddlLocation option:selected').text();
                document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : " + (rows + 1);
            }

            document.getElementById("taginput").value = "";
            var focusbox;
            focusbox = document.getElementById("taginput");
            focusbox.focus();

        }

        function deleteRow(r) {
            var i = r.parentNode.parentNode.rowIndex;
            var hid = r.parentNode.parentNode.parentNode.parentNode.id;
            document.getElementById(hid).deleteRow(i);

            var renum = 1;
            $("tr td strong").each(function () {
                $(this).text(renum);
                renum++;
            });

            var rows = $('#tagTABLE tbody tr').length;
            var location = $('#ddlLocation option:selected').text();
            document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : " + (rows);
            document.getElementById("taginput").value = "";
            document.getElementById("taginput").focus();
        }

            taginput.addEventListener("keypress", function (event) {
                event.preventDefault();
                document.getElementById("taglblresult").innerHTML = "";

                var X = event.which || event.keyCode;

                if (X === 13) {
                    if (taginput.value.toUpperCase().substring(12, 16) != "FFFF") { addRow(taginput.value.toUpperCase()); }
                    else { taginput.value = ""; }
                }
                else { taginput.value = taginput.value + String.fromCharCode(X); }

                if (taginput.value.length == 24) {
                    if (taginput.value.toUpperCase().substring(12, 16) != "FFFF") { addRow(taginput.value.toUpperCase()); }
                    else { taginput.value = ""; }
                }
            });


            function RFIDUPDATE(type,ID,RFID,User) {
                $.ajax({
                       url: '@Url.Action("UPDATERFID", "RfidAudit")',
                       type: "GET",
                       contentType: "application/json; charset=utf-8",
                       dataType: "JSON",
                    data: { pTYPE: type, pID: ID, pRFID: RFID, pUSER: User},
                       success: function (response) {
                           console.log(response);
                           if (response == "EMAIL") {
                               document.getElementById("ddlCompany").disabled = false;
                               document.getElementById("ddlDepartment").disabled = false;
                               document.getElementById("ddlLocation").disabled = false;
                               document.getElementById("btnSubmit").disabled = false;
                               document.getElementById("btnReset").disabled = false;
                               document.getElementById("btnCancel").disabled = false;
                               alert("This location had been audit completely today. Audit Report for " + ID + " already send to PIC.");
                               resetStatus();
                           }
                       },
                       error: function (xhr, status, error) {
                              alert(xhr.responseText);
                              var err = eval("(" + error.responseText + ")");
                              alert(err.Message);
                       }
                });
            }


    </script>

    <script>setInterval(doSomething, 1000);</script>
}
