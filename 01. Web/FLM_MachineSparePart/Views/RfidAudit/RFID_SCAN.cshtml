@model DBModel.RFIDModel
@{
    ViewBag.Title = "Entry Screen";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";

}
<link rel="stylesheet" href="~/css/css.css" />
<script src="~/js/jquery-ui-1.12.1.js"></script>
<link rel="stylesheet" href="~/css/jquery-ui-1.12.1.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.js" defer></script>
<link href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.css" rel="stylesheet" />
<style>
    .row {
        margin-bottom: 20px;
    }

    td {
        background: rgb(217,225,242);
        border: 1px solid white;
    }

    .connection {
        display: block;
        height: auto;
        width: 100%;
        padding-top: 10px;
        margin-bottom: 10px;
        margin-left: 2px;
        background-color: #3B5998;
    }

    #testbtn {
        padding: 0;
        border: none;
        background: none;
        height: 3.5vw;
        width: 3.5vw;
    }

    .testTable tr td {
        height: auto;
    }

    .testTable {
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        margin-top: 7px;
        table-layout: fixed !important;
    }


        .testTable thead tr td {
            font-size: 3vw;
            background-color: #7400F6;
            font-weight: bold;
            color: White;
        }

        .testTable tbody tr td {
            font-size: 30px;
            font-size: 3vw;
            height: auto !important;
            height: 10px !important;
            overflow: hidden;
            text-overflow: ellipsis;
            overflow-wrap: break-word;
            vertical-align: top;
        }

            .testTable tbody tr td:first-child {
                text-align: center;
            }

    .logout {
        display: block;
        float: right;
        height: auto;
        font-weight: bold;
        font-size: 2.5vw;
        text-decoration: none;
        color: white;
    }

        .logout a:hover {
            text-decoration: underline;
            font-weight: bold;
        }

    .backBtn {
        float: right;
        font-weight: bold;
        color: white;
    }
</style>
<div>
    <h1>@ViewBag.Title</h1>
    <hr>



    <div class="connection row" id="row">
        <div class="col-md-11">
            <div style="float:left;">
                <input value="" type="button" id="testbtn" style="background-color:red;" runat="server" />
                <label id="lblConn" title="No Internet Connection" style="color:Red;" visible="true"> &nbsp; No Internet Connection</label>
            </div>
        </div>
        <div class="col-md-1">
            @*<a id="btnBack" class="backBtn" title="Back" onclick="backBtn();">Back to Menu</a>*@
        </div>
    </div>
    <div id="divDDL" style="margin-top:25px;font-weight:bold;">
        <div class="col-100">
            <div id="row">
                <div class="col-md-4 col-lg-4">
                    Company
                </div>
                <div class="col-md-4 col-lg-4">
                    Department
                </div>
                <div class="col-md-4 col-lg-4">
                    Location
                </div>
            </div>
            <div id="row">
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.DropDownList("ddlCompany", Model.DropdownCompany, "Select Company", new { @class = "form-control", @id = "ddlCompany", @disabled = "disabled" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        @Html.DropDownList("ddlDepartment", new SelectList(Enumerable.Empty<SelectListItem>(), "id", "name"), "Select Department", new { @class = "form-control", @id = "ddlDepartment", @disabled = "disabled" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        @Html.DropDownList("ddlLocation", new SelectList(Enumerable.Empty<SelectListItem>(), "id", "name"), "Select Location", new { @class = "form-control", @id = "ddlLocation", @disabled = "disabled" })
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div id="divSCAN" style="display:none">
        <div class="rfid-input-section">
            <div class="title"><label class="required">* </label><label>RFID</label></div>
            <div class="input"><input id="rfid-input" type="text" onkeyup="rfidSearch(this)" class="form-control txtbox text-box single-line" /></div>
        </div>
        <div class="button-section">
            <input id="btnSubmit" class="rfid-button btn btn-primary" type="button" value="Submit" onclick="submitClicked()" />
            <input id="btnReset" class="rfid-button btn btn-primary" type="button" value="Reset" onclick="resetClicked()" />
            <input id="btnCancel" class="rfid-button btn btn-primary" type="button" value="Cancel" />
        </div>
    </div>

    <div id='myModal' class='modal'>
        <div class="modal-dialog">
            <div class="modal-content">
                <div id='myModalContent'></div>
            </div>
        </div>

    </div>
</div>

<script>
    function assignDataTable() {
        $('#myTable').DataTable({
            "order": []
        });
    }

    var tempInput = [];
    function submitClicked() {
        var rfidInput = document.getElementById("rfid-input").value;
        var options = { "backdrop": "static", keyboard: true };
        if (!rfidInput) {
            alert("Rfid Input must have some value");
            return;
        }
        var req = JSON.stringify({ "rfid": rfidInput });

        $.ajax({
            url: '@Url.Action("CreateEntry", "RfidAudit")',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ "rfid": rfidInput }),
            success: function (response) {
                debugger;
                $('#myModalContent').html(response);
                $('#myModal').modal(options);
                $('#myModal').modal('show');
                assignDataTable();
            },
            error: function (e) {
                console.log(e);
                tempInput.push(req);
            }
        });

        $("#closbtn").click(function () {
            $('#myModal').modal('hide');
        });
    }


    function resetClicked() {
        document.getElementById("rfid-input").value = "";

    }

    function submit(rfidInput) {


        $.ajax({
            url: '@Url.Action("CreateEntry", "RfidAudit")',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: rfidInput,
            success: function (response) {
                console.log("record inserted");
            },
            error: function (e) {
                console.log(e);
                tempInput.push(rfidInput);
            }
        });

        $("#closbtn").click(function () {
            $('#myModal').modal('hide');
        });
    }
    @*function rfidSearch(ele) {
        var searchValue = ele.value;
        console.log(searchValue)
        var similarityRequest = { input: searchValue }
        $.ajax({
            type: "POST",
            url: '@Url.Action("RfidSimilarities", "RfidAudit")',
            contentType: "application/json; charset=utf-8;",
            dataType: "json",
            data: JSON.stringify(similarityRequest),
            success: function (similarities) {
                $("#rfid-input").autocomplete({
                    source: function (request, response) {
                        response(similarities);
                    }
                }).focus(function () {
                    $(this).autocomplete("search");
                });

            }, error: function (e) {
                console.log(e);
            }
        })
    }*@
    var checking = false;
    function toggleNavigatorStatus() {
        if (navigator.onLine == true) {
            document.getElementById("testbtn").style.backgroundColor = "lightgreen";
            document.getElementById("lblConn").style.color = "lightgreen";
            document.getElementById("lblConn").innerHTML = "Connection Available";
            document.getElementById("ddlCompany").disabled = false;
            document.getElementById("ddlDepartment").disabled = false;
            document.getElementById("ddlLocation").disabled = false;
            document.getElementById("btnSubmit").disabled = false;
            document.getElementById("btnReset").disabled = false;
            document.getElementById("btnCancel").disabled = false;
        } else {
            document.getElementById("testbtn").style.backgroundColor = "red";
            document.getElementById("lblConn").style.color = "red";
            document.getElementById("lblConn").innerHTML = "Connection Not Available";
            document.getElementById("ddlCompany").disabled = true;
            document.getElementById("ddlDepartment").disabled = true;
            document.getElementById("ddlLocation").disabled = true;
            document.getElementById("btnSubmit").disabled = true;
            document.getElementById("btnReset").disabled = true;
            document.getElementById("btnCancel").disabled = true;
            checking = true;
            if (!checking) {
                for (const input of tempInput) {
                    submit(input);
                }
                checking = false;
            }
        }
    }
     $("#ddlLocation").change(function () {
            var pID = $('#ddlLocation option:selected').val();
            $.ajax({
                    url: '@Url.Action("CheckLocationStatus", "RfidAudit")',
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    dataType: "JSON",
                    data: { pID: pID },
                    success: function (response) {
                        console.log(response);
                        if (response == "1") {
                            var r = confirm("Are you sure want to Audit " + pID + " now?");
                            if (r == true) {
                                RFIDUPDATE("1", pID, "", "ADMIN");
                                document.getElementById('divDDL').style.display = 'none';
                                document.getElementById('divSCAN').style.display = 'block';
                                var location = $('#ddlLocation option:selected').text();
                                document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : 0";
                                document.getElementById("taginput").disabled = false;
                                document.getElementById("taginput").value = "";
                                document.getElementById("taginput").focus();
                            } else {
                                document.getElementById('ddlLocation').selectedIndex = "0";
                            }
                        }
                        else if (response == "2") {
                            alert("Someone is doing audit for " + pID + " now");
                            document.getElementById('ddlLocation').selectedIndex = "0";
                        }
                        else if (response == "3") {
                            //alert(pID + " already done audit for today");
                            //document.getElementById('ddlLocation').selectedIndex = "0";
                            var r = confirm("Are you sure want to Audit " + pID + " now?");
                            if (r == true) {
                                RFIDUPDATE("1", pID, "", "ADMIN");
                                document.getElementById('divDDL').style.display = 'none';
                                document.getElementById('divSCAN').style.display = 'block';
                                var location = $('#ddlLocation option:selected').text();
                                document.getElementById("taglblscan").innerHTML = "Auditing " + location + " | Current scanned : 0";
                                document.getElementById("taginput").disabled = false;
                                document.getElementById("taginput").value = "";
                                document.getElementById("taginput").focus();
                            } else {
                                document.getElementById('ddlLocation').selectedIndex = "0";
                            }
                        }

                    },
                    error: function (xhr, status, error) {
                        alert(xhr.responseText);
                        var err = eval("(" + error.responseText + ")");
                        alert(err.Message);
                    }
            });
    });
    $("#ddlCompany").change(function () {
            var dID = $('#ddlCompany option:selected').val();
            //alert(dID);
            $("#ddlDepartment").empty();
            $("#ddlDepartment").append($('<option></option>').val("").html("Select Department"));
            $("#ddlLocation").empty();
            $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));

            if (dID != null) {//dID > 0
                $.ajax({
                    url: '@Url.Action("GETdepartmentDDL", "RfidAudit")',
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    dataType: "JSON",
                    data: { pID: dID },
                    success: function (response) {
                        console.log(response);
                        $.each(response, function (index, value) {
                            $("#ddlDepartment").append(
                                $('<option></option>').val(value.Value).html(value.Text));
                        });
                    },
                    error: function (xhr, status, error) {
                        alert(xhr.responseText);
                        var err = eval("(" + error.responseText + ")");
                        alert(err.Message);
                    }
                });
            }
        });

        $("#ddlDepartment").change(function () {
            var dID = $('#ddlCompany option:selected').val();
            var dID1 = $('#ddlDepartment option:selected').val();
            $("#ddlLocation").empty();
            $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));
            if (dID != null && dID1 != null) {//dID > 0 && dID1 > 0
                $.ajax({
                    url: '@Url.Action("GETlocationDDL", "RfidAudit")',
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    dataType: "JSON",
                    data: { pID: dID, pID1: dID1 },
                    success: function (response) {
                        console.log(response);
                        $.each(response, function (index, value) {
                            $("#ddlLocation").append(
                                $('<option></option>').val(value.Value).html(value.Text));
                        });
                    },
                    error: function (xhr, status, error) {
                        alert(xhr.responseText);
                        var err = eval("(" + error.responseText + ")");
                        alert(err.Message);
                    }
                });
            }

        });
    $("#ddlDepartment").change(function () {
            var dID = $('#ddlCompany option:selected').val();
            var dID1 = $('#ddlDepartment option:selected').val();
            $("#ddlLocation").empty();
            $("#ddlLocation").append($('<option></option>').val("").html("Select Location"));
            if (dID != null && dID1 != null) {//dID > 0 && dID1 > 0
                $.ajax({
                    url: '@Url.Action("GETlocationDDL", "RfidAudit")',
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    dataType: "JSON",
                    data: { pID: dID, pID1: dID1 },
                    success: function (response) {
                        console.log(response);
                        $.each(response, function (index, value) {
                            $("#ddlLocation").append(
                                $('<option></option>').val(value.Value).html(value.Text));
                        });
                    },
                    error: function (xhr, status, error) {
                        alert(xhr.responseText);
                        var err = eval("(" + error.responseText + ")");
                        alert(err.Message);
                    }
                });
            }

    });

     function RFIDUPDATE(type,ID,RFID,User) {
            $.ajax({
                   url: '@Url.Action("UPDATERFID", "RfidAudit")',
                   type: "GET",
                   contentType: "application/json; charset=utf-8",
                   dataType: "JSON",
                data: { pTYPE: type, pID: ID, pRFID: RFID, pUSER: User},
                   success: function (response) {
                       console.log(response);
                       if (response == "EMAIL") {
                           document.getElementById("ddlCompany").disabled = false;
                           document.getElementById("ddlDepartment").disabled = false;
                           document.getElementById("ddlLocation").disabled = false;
                           document.getElementById("btnSubmit").disabled = false;
                           document.getElementById("btnReset").disabled = false;
                           document.getElementById("btnCancel").disabled = false;
                           alert("This location had been audit completely today. Audit Report for " + ID + " already send to PIC.");
                           resetStatus();
                       }
                   },
                   error: function (xhr, status, error) {
                          alert(xhr.responseText);
                          var err = eval("(" + error.responseText + ")");
                          alert(err.Message);
                   }
            });
        }

</script>
<script>
    toggleNavigatorStatus();
    setInterval(toggleNavigatorStatus, 10000);
</script>


