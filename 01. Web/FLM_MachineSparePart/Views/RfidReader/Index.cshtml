@{
    ViewBag.Title = "RFID Reader Management";
}

<style>
    .rfid-container {
        padding: 15px;
    }
    .reader-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }
    .reader-table th {
        background-color: #f2f2f2;
        padding: 10px 15px;
        text-align: left;
        border: 1px solid #ddd;
        font-weight: bold;
    }
    .reader-table td {
        padding: 10px 15px;
        border: 1px solid #ddd;
    }
    .reader-table tr {
        cursor: pointer;
    }
    .reader-table tr.selected {
        background-color: #cce5ff;
    }
    .reader-table tr:hover {
        background-color: #e9ecef;
    }
    .status-connected {
        color: green;
        font-weight: bold;
    }
    .status-disconnected {
        color: red;
        font-weight: bold;
    }
    .status-connecting {
        color: orange;
        font-weight: bold;
    }
    .btn-connect-all {
        background-color: #00ff00;
        border: 1px solid #00cc00;
        color: #000;
        font-family: 'Lucida Bright', Georgia, serif;
        font-size: 14px;
        padding: 10px 25px;
        cursor: pointer;
        margin-right: 5px;
    }
    .btn-connect-all:hover {
        background-color: #00cc00;
    }
    .btn-disconnect-all {
        background-color: #ff0000;
        border: 1px solid #cc0000;
        color: #fff;
        font-family: 'Lucida Bright', Georgia, serif;
        font-size: 14px;
        padding: 10px 25px;
        cursor: pointer;
        margin-right: 5px;
    }
    .btn-disconnect-all:hover {
        background-color: #cc0000;
    }
    .btn-connect {
        background-color: #00ff00;
        border: 1px solid #00cc00;
        color: #000;
        font-family: 'Lucida Bright', Georgia, serif;
        font-size: 14px;
        padding: 10px 25px;
        cursor: pointer;
    }
    .btn-connect.disconnect {
        background-color: #ff0000;
        border: 1px solid #cc0000;
        color: #fff;
    }
    .btn-connect.disconnect:hover {
        background-color: #cc0000;
    }
    .btn-connect:hover {
        background-color: #00cc00;
    }
    .button-row {
        margin-top: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .lbl-error {
        color: red;
        margin-top: 15px;
        font-size: 13px;
    }
    .page-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }
    .log-panel {
        margin-top: 20px;
        border: 1px solid #ddd;
        padding: 10px;
        max-height: 200px;
        overflow-y: auto;
        background-color: #1e1e1e;
        color: #00ff00;
        font-family: 'Consolas', monospace;
        font-size: 12px;
    }
    .log-panel p {
        margin: 2px 0;
    }
    .tag-panel {
        margin-top: 20px;
    }
    .tag-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .tag-table th {
        background-color: #343a40;
        color: #fff;
        padding: 8px 12px;
        text-align: left;
        border: 1px solid #555;
    }
    .tag-table td {
        padding: 6px 12px;
        border: 1px solid #ddd;
    }
</style>

<div class="rfid-container">
    <div class="page-title">
        <i class="fas fa-broadcast-tower"></i> Film RFID Reader Management
    </div>

    <!-- Reader Table (replicates lv_reader ListView from Form1.vb) -->
    <table class="reader-table" id="readerTable">
        <thead>
            <tr>
                <th style="width: 150px;">Location</th>
                <th style="width: 150px;">IP Address</th>
                <th style="width: 270px;">Reader Name</th>
                <th style="width: 300px;">Connection Status</th>
            </tr>
        </thead>
        <tbody id="readerTableBody">
            <tr>
                <td colspan="4" style="text-align: center; color: #999;">Loading reader configurations...</td>
            </tr>
        </tbody>
    </table>

    <!-- Buttons (replicates btnConnectAll, btnDisconnectAll, btnConnect from Form1.vb) -->
    <div class="button-row">
        <div>
            <button type="button" class="btn-connect-all" id="btnConnectAll" onclick="connectAllReaders()">
                Connect All
            </button>
            <button type="button" class="btn-disconnect-all" id="btnDisconnectAll" onclick="disconnectAllReaders()">
                Disconnect All
            </button>
        </div>
        <div>
            <button type="button" class="btn-connect" id="btnConnect" onclick="toggleConnection()" disabled>
                Connect
            </button>
        </div>
    </div>

    <!-- Error Label (replicates lbl_error from Form1.vb) -->
    <div class="lbl-error" id="lblError"></div>

    <!-- Live Log Panel -->
    <div class="log-panel" id="logPanel">
        <p><em>RFID Reader log will appear here...</em></p>
    </div>

    <!-- Tag Read Panel -->
    <div class="tag-panel">
        <h5><i class="fas fa-tags"></i> Recently Detected Tags</h5>
        <table class="tag-table" id="tagTable">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Reader</th>
                    <th>Tag ID</th>
                    <th>Antenna</th>
                </tr>
            </thead>
            <tbody id="tagTableBody">
                <tr>
                    <td colspan="4" style="text-align: center; color: #999;">No tags detected yet.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- SignalR Scripts -->
<script src="~/Scripts/jquery.signalR-2.2.2.min.js"></script>
<script src="~/signalr/hubs"></script>

<script type="text/javascript">
    var selectedReaderIP = null;
    var readers = [];
    var rfidHub = null;
    var maxLogEntries = 100;
    var maxTagEntries = 50;

    $(document).ready(function () {
        initializeSignalR();
        loadReaders();
    });

    function initializeSignalR() {
        rfidHub = $.connection.rfidHub;

        // Client-side hub methods
        rfidHub.client.loadReadersResult = function (readerList) {
            readers = readerList;
            renderReaderTable();
        };

        rfidHub.client.connectResult = function (result) {
            addLog(result.ReaderIP + ': ' + result.Message);
            loadReaders(); // Refresh
        };

        rfidHub.client.disconnectResult = function (result) {
            addLog(result.ReaderIP + ': ' + result.Message);
            loadReaders(); // Refresh
        };

        rfidHub.client.connectAllResult = function (results) {
            for (var i = 0; i < results.length; i++) {
                addLog(results[i].ReaderIP + ': ' + results[i].Message);
            }
            loadReaders(); // Refresh
        };

        rfidHub.client.disconnectAllResult = function (results) {
            for (var i = 0; i < results.length; i++) {
                addLog(results[i].ReaderIP + ': ' + results[i].Message);
            }
            loadReaders(); // Refresh
        };

        rfidHub.client.readerStatusChanged = function (readerIP, status, isConnected) {
            updateReaderStatus(readerIP, status, isConnected);
            addLog(readerIP + ': ' + status);
        };

        rfidHub.client.readerStatusEvent = function (readerHostName, statusMsg) {
            addLog(readerHostName + ': ' + statusMsg);
        };

        rfidHub.client.tagRead = function (readerHostName, tagID, antennaID, timestamp) {
            addTagEntry(readerHostName, tagID, antennaID, timestamp);
        };

        rfidHub.client.readerStatuses = function (statuses) {
            readers = statuses;
            renderReaderTable();
        };

        // Start SignalR connection
        $.connection.hub.start().done(function () {
            addLog('SignalR connected. Hub ready.');
        }).fail(function (err) {
            addLog('SignalR connection failed: ' + err);
            $('#lblError').text('SignalR connection failed. Real-time updates unavailable.');
        });
    }

    function loadReaders() {
        $.ajax({
            url: '@Url.Action("LoadReaders", "RfidReader")',
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    readers = response.data;
                    renderReaderTable();
                } else {
                    $('#lblError').text(response.message);
                    addLog('Error loading readers: ' + response.message);
                }
            },
            error: function (xhr) {
                $('#lblError').text('Failed to load reader configurations.');
                addLog('AJAX error loading readers.');
            }
        });
    }

    function renderReaderTable() {
        var tbody = $('#readerTableBody');
        tbody.empty();

        if (!readers || readers.length === 0) {
            tbody.append('<tr><td colspan="4" style="text-align: center; color: #999;">No reader configurations found.</td></tr>');
            return;
        }

        for (var i = 0; i < readers.length; i++) {
            var r = readers[i];
            var statusClass = r.IsConnected ? 'status-connected' : 'status-disconnected';
            if (r.Status && (r.Status.indexOf('Connecting') >= 0 || r.Status.indexOf('Disconnecting') >= 0)) {
                statusClass = 'status-connecting';
            }
            var selectedClass = (selectedReaderIP === r.READER_IP) ? ' selected' : '';
            var row = '<tr class="reader-row' + selectedClass + '" data-ip="' + r.READER_IP + '" onclick="selectReader(\'' + r.READER_IP + '\')">' +
                '<td>' + (r.LOCATION || '') + '</td>' +
                '<td>' + (r.READER_IP || '') + '</td>' +
                '<td>' + (r.READER_NAME || '') + '</td>' +
                '<td class="' + statusClass + '" id="status_' + r.READER_IP.replace(/\./g, '_') + '">' + (r.Status || 'Disconnected') + '</td>' +
                '</tr>';
            tbody.append(row);
        }
    }

    function selectReader(ip) {
        selectedReaderIP = ip;

        // Highlight selected row
        $('.reader-row').removeClass('selected');
        $('[data-ip="' + ip + '"]').addClass('selected');

        // Update Connect/Disconnect button
        var reader = readers.find(function (r) { return r.READER_IP === ip; });
        var btn = $('#btnConnect');
        btn.prop('disabled', false);

        if (reader && reader.IsConnected) {
            btn.text('Disconnect');
            btn.addClass('disconnect');
        } else {
            btn.text('Connect');
            btn.removeClass('disconnect');
        }
    }

    function toggleConnection() {
        if (!selectedReaderIP) {
            $('#lblError').text('Please select a reader first.');
            return;
        }

        var btn = $('#btnConnect');
        if (btn.text() === 'Connect') {
            connectReader(selectedReaderIP);
        } else {
            disconnectReader(selectedReaderIP);
        }
    }

    function connectReader(ip) {
        updateReaderStatus(ip, 'Connecting...', false);
        $.ajax({
            url: '@Url.Action("ConnectReader", "RfidReader")',
            type: 'POST',
            data: { readerIP: ip },
            success: function (result) {
                addLog(ip + ': ' + result.Message);
                loadReaders();
            },
            error: function () {
                addLog(ip + ': Connection request failed.');
                $('#lblError').text('Connection request failed for ' + ip);
            }
        });
    }

    function disconnectReader(ip) {
        updateReaderStatus(ip, 'Disconnecting...', false);
        $.ajax({
            url: '@Url.Action("DisconnectReader", "RfidReader")',
            type: 'POST',
            data: { readerIP: ip },
            success: function (result) {
                addLog(ip + ': ' + result.Message);
                loadReaders();
            },
            error: function () {
                addLog(ip + ': Disconnection request failed.');
                $('#lblError').text('Disconnection request failed for ' + ip);
            }
        });
    }

    function connectAllReaders() {
        // Update all rows to "Connecting..."
        for (var i = 0; i < readers.length; i++) {
            updateReaderStatus(readers[i].READER_IP, 'Connecting...', false);
        }

        $.ajax({
            url: '@Url.Action("ConnectAll", "RfidReader")',
            type: 'POST',
            success: function (results) {
                if (Array.isArray(results)) {
                    for (var i = 0; i < results.length; i++) {
                        addLog(results[i].ReaderIP + ': ' + results[i].Message);
                    }
                }
                loadReaders();
            },
            error: function () {
                addLog('Connect All request failed.');
                $('#lblError').text('Connect All request failed.');
            }
        });
    }

    function disconnectAllReaders() {
        // Update all rows to "Disconnecting..."
        for (var i = 0; i < readers.length; i++) {
            updateReaderStatus(readers[i].READER_IP, 'Disconnecting...', false);
        }

        $.ajax({
            url: '@Url.Action("DisconnectAll", "RfidReader")',
            type: 'POST',
            success: function (results) {
                if (Array.isArray(results)) {
                    for (var i = 0; i < results.length; i++) {
                        addLog(results[i].ReaderIP + ': ' + results[i].Message);
                    }
                }
                loadReaders();
            },
            error: function () {
                addLog('Disconnect All request failed.');
                $('#lblError').text('Disconnect All request failed.');
            }
        });
    }

    function updateReaderStatus(ip, status, isConnected) {
        var safeIP = ip.replace(/\./g, '_');
        var statusCell = $('#status_' + safeIP);

        statusCell.text(status);
        statusCell.removeClass('status-connected status-disconnected status-connecting');

        if (isConnected) {
            statusCell.addClass('status-connected');
        } else if (status.indexOf('Connecting') >= 0 || status.indexOf('Disconnecting') >= 0) {
            statusCell.addClass('status-connecting');
        } else {
            statusCell.addClass('status-disconnected');
        }

        // Update local reader data
        var reader = readers.find(function (r) { return r.READER_IP === ip; });
        if (reader) {
            reader.IsConnected = isConnected;
            reader.Status = status;
        }

        // Update button if this is the selected reader
        if (ip === selectedReaderIP) {
            var btn = $('#btnConnect');
            if (isConnected) {
                btn.text('Disconnect');
                btn.addClass('disconnect');
            } else {
                btn.text('Connect');
                btn.removeClass('disconnect');
            }
        }
    }

    function addLog(message) {
        var logPanel = $('#logPanel');
        var time = new Date().toLocaleTimeString();
        logPanel.append('<p>' + time + ' - ' + message + '</p>');

        // Keep only recent entries
        var entries = logPanel.find('p');
        if (entries.length > maxLogEntries) {
            entries.first().remove();
        }

        // Auto-scroll to bottom
        logPanel.scrollTop(logPanel[0].scrollHeight);
    }

    function addTagEntry(readerHostName, tagID, antennaID, timestamp) {
        var tbody = $('#tagTableBody');

        // Remove placeholder if present
        if (tbody.find('td[colspan]').length > 0) {
            tbody.empty();
        }

        var row = '<tr>' +
            '<td>' + timestamp + '</td>' +
            '<td>' + readerHostName + '</td>' +
            '<td>' + tagID + '</td>' +
            '<td>' + antennaID + '</td>' +
            '</tr>';

        tbody.prepend(row);

        // Keep only recent entries
        var rows = tbody.find('tr');
        if (rows.length > maxTagEntries) {
            rows.last().remove();
        }
    }
</script>
