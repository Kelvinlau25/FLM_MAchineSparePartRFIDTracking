@using DBModel
@model AclViewModel
@using ACL_System.Helper_Code.Objects;

@{
    var url = @Url.Action("RoleRegistration", "Mstmain").ToString();
    ViewBag.Title = "ACLRegistrationEdit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var items = Model.resourceAclModel?.ToList() ?? new List<ResourceAclModel>();
}

<h2>
    ACL Registration - Edit
</h2>
<hr />


@using (Html.BeginForm("ACLRegistrationEdit", "Mstmain", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="col-100">
        <div style="width:66.66666667%">
                <div>@Html.HiddenFor(a => a.roleModel.ID_ACL_ROLE)</div>
                <div class="col-md-3">
                    @Html.LabelFor(a => a.roleModel.ROLE_NAME)
                </div>
                <div class="form-group">
                    <div class="col-md-9">
                        @Html.TextBoxFor(a => a.roleModel.ROLE_NAME, null, new { @class = "form-control", @readonly = "true" })
                    </div>
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(a => a.roleModel.ROLE_DESC)
                </div>
                <div class="form-group">
                    <div class="col-md-9">
                        @Html.TextBoxFor(a => a.roleModel.ROLE_DESC, null, new { @class = "form-control", @readonly = "true" })
                    </div>
                </div>
        </div>   

            <div class="col-md-12">&nbsp;</div>

            <div id="grid">
                <table class="table table-bordered">
                    <thead class="head">
                        <tr>
                            <th>Resource Name</th>
                            <th>Resource Desc</th>
                            <th>View</th>
                            <th>Add</th>
                            <th>Edit</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items != null && items.Any())
                        {
                            foreach (var item in items)
                            {
                                <tr>
                                    <td>@item.RESOURCE_NAME</td>
                                    <td>@item.RESOURCE_DESC</td>
                                    <td><input type="checkbox" name="chkRowV" value="@item.ID_ACL_RESOURCE" checked="@item.View_Right" /></td>
                                    <td><input type="checkbox" name="chkRowA" value="@item.ID_ACL_RESOURCE" checked="@item.Add_Right" /></td>
                                    <td><input type="checkbox" name="chkRowE" value="@item.ID_ACL_RESOURCE" checked="@item.Edit_Right" /></td>
                                    <td><input type="checkbox" name="chkRowD" value="@item.ID_ACL_RESOURCE" checked="@item.Delete_Right" /></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No records found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @TempData["Message"]


            <div class="col-md-8">
                <input id="Submit" type="submit" name="ActionType" value="Submit" class="btn btn-primary" />
                @Html.BackButton(url)
            </div>

     </div>
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Result");
            var url = '@Url.Action("RoleRegistration", "Mstmain")';
            window.location.href = url;
        </script>
    }
}

