@model UserMMModel.StoreLocReader
@{
    var url = @Url.Action("MM_STORE_RDR_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Storage Reader - View";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url = '@Url.Action("MM_STORE_RDR_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_STORE_RDR_EDIT", "Mstmain", new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@{
    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

<h2>Storage Reader Master Maintenance - View</h2>
<hr />
<table style="width:100%;">
    <tr>
        <td>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-8">
                            @Html.HiddenFor(a => a.READER_ID)
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Storage Code</label>
                        <label class="labelW10">:</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(a => a.Storage_Code, null, new { @class = "form-control txtbox", @maxlength = "50" })
                            @Html.ValidationMessageFor(a => a.Storage_Code, "", new { @style = "color:red" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Reader Name</label>
                        <label class="labelW10">:</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(a => a.Reader_Name, null, new { @class = "form-control txtbox", @maxlength = "50" })
                            @Html.ValidationMessageFor(a => a.Reader_Name, "", new { @style = "color:red" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Remarks</label>
                        <label class="labelW10">:</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox", @maxlength = "50" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                    @Html.BackButton(url)
                </div>
            }
        </td>
    </tr>
</table>

<table style="border:1px solid; border-radius:20px; width:60%;">
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
</table>
