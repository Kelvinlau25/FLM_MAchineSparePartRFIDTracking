@model UserMMModel.Manufacturer
@{
    var url = @Url.Action("MM_MANUF_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Manufacturer - Add";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_MANUF_LST", "Mstmain")';
        window.location.href = url;
        </script>
    }
}

<script type="text/javascript">
            var popup;
            function SelectParentID() {
                var url = '@Url.Action("ResourceParentPopUp", "Mstmain")';
                popup = window.open(url, "Popup", "scrollbars=yes,resizable=yes,location=no,toolbar=no,width=500,height=500");
                popup.focus();
            }
</script>

<h2>Manufacturer Master Maintenance - Add</h2>
<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="col-100">

        <div class="col-md-8">
            <label>Manufacturer Code</label>
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Manufacturer_Code, null, new { @class = "form-control txtbox" })
                @Html.ValidationMessageFor(a => a.Manufacturer_Code, "", new { @style = "color:red" })
            </div>
        </div>

        <div class="col-md-8">
            <label>Manufacturer Description</label>
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Manufacturer_Desc, null, new { @class = "form-control txtbox" })
                @Html.ValidationMessageFor(a => a.Manufacturer_Desc)
            </div>
        </div>

        <div class="col-md-8">
            @Html.LabelFor(a => a.Remarks)
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
            </div>
        </div>

        <div class="col-md-8">
            <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
            @Html.BackButton(url)
        </div>

    </div>

}