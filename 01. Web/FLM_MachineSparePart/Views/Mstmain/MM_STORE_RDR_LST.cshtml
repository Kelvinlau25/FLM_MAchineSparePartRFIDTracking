@using UserMMModel
@model IEnumerable<StoreLocReader>
@{
    ViewBag.Title = "MM Storage Reader";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model,
defaultSort: "id",
canPage: true,
ajaxUpdateContainerId: "grid",
rowsPerPage: 10);
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_STORE_RDR_LST", "Mstmain")";
    </script>
}

<script type="text/javascript">
    //$(document).ready(function () {
    //    //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
    //    //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();
    //    $('td:nth-child(1), th:nth-child(1)').hide();
    //});
    function popUpDelete(rowid)
    {
        //var row = rowid.parentNode.parentNode;
        //var tranid = row.getElementsByTagName("TD")[0].innerHTML;
        var readerid = rowid.toString();
        //alert(readerid);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");
            var url = '@Url.Action("MM_STORE_RDR_DELETE", "Mstmain")?id=' + readerid;
            window.location.href = url;
        }
    }
</script>

<h2>Storage Reader Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_Header",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_STORE_RDR_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_STORE_RDR_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount:5,
    mode: WebGridPagerModes.All,
    firstText:"First",
    previousText: "Previous",
    nextText: "Next",
    lastText:"Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
        //grid.Column("", format: @<a href="@Url.Action("MM_STORE_RDR_DELETE", "Mstmain",new { id = item.READER_ID })"><i class="fa fa-trash"></i></a>),
        grid.Column("", format: @<a href="#" onclick="popUpDelete('@item.READER_ID');"><i class="fa fa-trash"></i></a>),
        grid.Column("Storage Code", format: @<text> @item.Storage_Code </text>),
        grid.Column("Reader Name", format: @<text> @item.Reader_Name </text>),
        grid.Column("Remarks", format: @<text> @item.Remarks </text>),
        grid.Column("View", format: @<a href="@Url.Action("MM_STORE_RDR_EDIT", "Mstmain", new { id = item.READER_ID })"><i class="fa fa-pencil"></i></a>)))
</div>
} 
 <input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelStoreLocRDR", "Mstmain")'" />
   