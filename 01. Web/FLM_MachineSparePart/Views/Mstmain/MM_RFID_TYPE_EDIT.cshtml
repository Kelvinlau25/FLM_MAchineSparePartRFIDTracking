@model UserMMModel.RfidType

@{
    var url = @Url.Action("MM_RFID_TYPE_LST", "Mstmain").ToString();
    ViewBag.Title = "MM RFID Type - Edit";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_RFID_TYPE_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_RFID_TYPE_EDIT", "Mstmain" , new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@*@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_RFID_TYPE_LST", "Mstmain")';
        window.location.href = url;
        </script>
    }
}*@

@section scripts
{
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>

    <script type="text/javascript">
        function postback() {
            var elem = document.getElementById("postbackBtn");
            if (typeof elem.onsubmit == "function") {
                elem.onsubmit.apply(elem);
            }
        }

    </script>


}

<h2>RFID Type Master Maintenance - Edit</h2>
<hr />
<table style="width:100%;">
    <tr>
        <td>
            @using (Html.BeginForm())
            {

                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.HiddenFor(a => a.RFID_TYPE_ID)
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2" style="width:120px;">RFID Type</label>
                        <label class="labelW10">:</label>
                        <div class="col-sm-5">
                            @*col-md-4*@
                            @Html.TextBoxFor(a => a.Rfid_Type, null, new { @class = "form-control txtbox" })
                            @Html.ValidationMessageFor(a => a.Rfid_Type, "", new { @style = "color:red" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2" style="width:120px;">Remarks</label>
                        <label class="labelW10">:</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
                            @*@Html.ValidationMessageFor(a => a.Remarks)*@
                        </div>
                    </div>

                </div>

                <div class="form-group">
                    <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                    @Html.BackButton(url)
                </div>
            }
        </td>
    </tr>
</table>

<table style="border:1px solid; border-radius:20px; width:50%;">
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
</table>
