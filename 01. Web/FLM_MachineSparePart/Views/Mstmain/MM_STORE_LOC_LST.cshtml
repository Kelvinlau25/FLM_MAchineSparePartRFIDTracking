@using UserMMModel
@model IEnumerable<StoreLocation>
@{
    ViewBag.Title = "MM Storage Location";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var items = Model?.ToList() ?? new List<StoreLocation>();
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        alert("@TempData["result"]");
    </script>
}

<script type="text/javascript">
    //$(document).ready(function () {
    //    //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
    //    //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();
    //    $('td:nth-child(1), th:nth-child(1)').hide();
    //});
    function popUpDelete(rowid)
    {
        //var row = rowid.parentNode.parentNode;
        //var storeid = row.getElementsByTagName("TD")[0].innerHTML;
        var storeid = rowid.toString();
        //alert(storeid);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");
            var url = '@Url.Action("MM_STORE_LOC_DELETE", "Mstmain")?id=' + storeid;
            window.location.href = url;
        }
    }
</script>

<h2>Storage Location Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_Header",new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_STORE_LOC_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_STORE_LOC_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
@{
<div id="grid">
    <table class="table table-bordered">
        <thead class="head">
            <tr>
                <th></th>
                <th>Storage Code</th>
                <th>Storage Description 1</th>
                <th>Storage Description 2</th>
                <th>Reader Name</th>
                <th>Remark</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @if (items != null && items.Any())
            {
                foreach (var item in items)
                {
                    <tr>
                        <td><a href="#" onclick="popUpDelete('@item.STORAGE_ID');"><i class="fa fa-trash"></i></a></td>
                        <td>@item.Storage_Code</td>
                        <td>@item.Storage_Desc_1</td>
                        <td>@item.Storage_Desc_2</td>
                        <td>@item.Reader_Name</td>
                        <td>@item.Remarks</td>
                        <td><a href="@Url.Action("MM_STORE_LOC_EDIT", "Mstmain", new { id = item.STORAGE_ID })"><i class="fa fa-pencil"></i></a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">No records found</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelStoreLoc", "Mstmain")'" />
