@using UserMMModel
@model IEnumerable<SparePart>
@{
    /**/
    ViewBag.Title = "MM Spare Part";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model, defaultSort: "id", canPage: true, ajaxUpdateContainerId: "grid", rowsPerPage: 10);
}


@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_SPART_LST", "Mstmain")";
    </script>
}


<script type="text/javascript">
    //$(document).ready(function () {
    //    //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
    //    //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();
    //    $('td:nth-child(1), th:nth-child(1)').hide();
    //});
    function popUpDelete(rowid)
    {
        //var row = rowid.parentNode.parentNode;
        //var spartid = row.getElementsByTagName("TD")[0].innerHTML;
        var spartid = rowid.toString();
        //alert(spartid);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");
            var url = '@Url.Action("MM_SPART_DELETE", "Mstmain")?id=' + spartid;
            window.location.href = url;
        }
    }
</script>

<h2>Spare Part Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_Header",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_SPART_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_SPART_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })


}
@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount: 5,
    mode: WebGridPagerModes.All,
    firstText: "First",
    previousText: "Previous",
    nextText: "Next",
    lastText: "Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
        //grid.Column("", format: @<a href="@Url.Action("MM_Spart_DELETE", "Mstmain",new { id = item.SPARE_PART_ID })"><i class="fa fa-trash"></i></a>),
        //grid.Column(null,null, format: @<text> @item.SPARE_PART_ID </text>),
        //grid.Column("", format: @<a href="#" onclick="popUpDelete(this);"><i class="fa fa-trash"></i></a>),
        grid.Column("", format: @<a href="#" onclick="popUpDelete('@item.SPARE_PART_ID');"><i class="fa fa-trash"></i></a>),
        grid.Column("Model No", format: @<text> @item.Spare_Part_Model_ID </text>),
        grid.Column("Serial No", format: @<text> @item.Series_No </text>),
        grid.Column("Part No", format: @<text> @item.Part_No </text>),
        grid.Column("Machine Model", format: @<text> @item.Spare_Part_Machine_ID </text>),
        grid.Column("Storage", format: @<text> @item.Storage_ID </text>),
        //grid.Column("Storage Description 1", format: @<text> @item.Storage_Description_1 </text>),
        //grid.Column("Storage Description 2", format: @<text> @item.Storage_Description_2 </text>),
        grid.Column("Manufacturer", format: @<text> @item.Manufacturer_ID </text>),
        grid.Column("Status", format: @<text> @item.Status </text>),
        grid.Column("Remarks", format: @<text> @item.Remarks </text>),
        grid.Column("Edit", format: @<a href="@Url.Action("MM_SPART_EDIT", "Mstmain",new { id = item.SPARE_PART_ID })"><i class="fa fa-pencil"></i></a>))
    )
</div>

<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelSpart", "Mstmain")'" />
<input type="button" value="Add Spare Part(Excel)"  class="btn btn-primary" onclick="location.href='@Url.Action("MM_SPART_ADD_Excel", "Mstmain")'" />
    
}
