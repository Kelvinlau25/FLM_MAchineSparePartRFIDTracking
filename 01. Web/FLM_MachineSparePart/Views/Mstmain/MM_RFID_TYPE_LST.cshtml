@using UserMMModel
@model IEnumerable<RfidType>


@{
    ViewBag.Title = "RFID Type";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model,
    defaultSort: "id",
    canPage: true,
    ajaxUpdateContainerId: "grid",
    rowsPerPage: 10);
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_RFID_TYPE_LST", "Mstmain")";
    </script>
}

<script type="text/javascript">
    //$(document).ready(function () {
    //    //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
    //    //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();
    //    $('td:nth-child(1), th:nth-child(1)').hide();
    //});
    function popUpDelete(rowid)
    {
        //var row = rowid.parentNode.parentNode;
        //var rfid = row.getElementsByTagName("TD")[0].innerHTML;
        var rfid = rowid.toString();
        //alert(rfid);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");
            var url = '@Url.Action("MM_RFID_TYPE_DELETE", "Mstmain")?id=' + rfid;
            window.location.href = url;
        }
    }
</script>

<h2>
    RFID Type Master Maintenance
</h2>
<hr />
@{
    @Html.Partial("_Header",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_RFID_TYPE_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_RFID_TYPE_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount:5,
    mode: WebGridPagerModes.All,
    firstText:"First",
    previousText: "Previous",
    nextText: "Next",
    lastText:"Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
         //grid.Column("", format: @<a href="@Url.Action("MM_RFID_TYPE_DELETE", "Mstmain",new { id = item.RFID_TYPE_ID })"><i class="fa fa-trash"></i></a>),
         //grid.Column(null,null, format: @<text> @item.RFID_TYPE_ID </text>),                
         //grid.Column("", format: @<a href="#" onclick="popUpDelete(this);"><i class="fa fa-trash"></i></a>),
         grid.Column("", format: @<a href="#" onclick="popUpDelete('@item.RFID_TYPE_ID');"><i class="fa fa-trash"></i></a>),
         grid.Column("RFID Type", format: @<text> @item.Rfid_Type </text>),
         grid.Column("Remarks", format: @<text> @item.Remarks </text>),
         grid.Column("Edit", format: @<a href="@Url.Action("MM_RFID_TYPE_EDIT", "Mstmain",new { id = item.RFID_TYPE_ID })"><i class="fa fa-pencil"></i></a>)
    )
    )
</div>
}
<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelRFIDType", "Mstmain")'" />
 
