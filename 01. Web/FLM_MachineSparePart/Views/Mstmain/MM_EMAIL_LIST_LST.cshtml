@using UserMMModel
@model IEnumerable<EmailList>
@{
    ViewBag.Title = "MM Email List";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model,
  defaultSort: "id",
  canPage: true,
  ajaxUpdateContainerId: "grid",
  rowsPerPage: 10);
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_EMAIL_LIST_LST", "Mstmain")";
    </script>
}

<h2>Email List Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_HeaderNoAdd",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_EMAIL_LIST_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_EMAIL_LIST_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
<br />
@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount:5,
    mode: WebGridPagerModes.All,
    firstText:"First",
    previousText: "Previous",
    nextText: "Next",
    lastText:"Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
    grid.Column("Email Group", format: @<text> @item.Email_Group_Id </text>),
    grid.Column("Email Category", format: @<text> @item.Email_Group_Cat </text>),
    grid.Column("Email List", format: @<text> @item.Email_List </text>),
    grid.Column("Remarks", format: @<text> @item.Remarks </text>),
      grid.Column("Edit", format: @<a href="@Url.Action("MM_EMAIL_LIST_EDIT", "Mstmain",
                    new { id = item.EMAIL_LIST_ID })"><i class="fa fa-pencil"></i></a>))
                                                                                                                      )
</div>
}
<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelEmailList", "Mstmain")'" />
