@model UserMMModel.TransactionType
@{
    var url = @Url.Action("MM_TRAN_TYPE_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Transaction Type";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}


@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_TRAN_TYPE_LST", "Mstmain")';
        window.location.href = url;
        </script>
    }
}

<script type="text/javascript">
            var popup;
            function SelectParentID() {
                var url = '@Url.Action("ResourceParentPopUp", "Mstmain")';
                popup = window.open(url, "Popup", "scrollbars=yes,resizable=yes,location=no,toolbar=no,width=500,height=500");
                popup.focus();
            }
</script>

<h2>Transaction Type Master Maintenance - Add</h2>

<hr />
@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()
    <div class="col-100">
        <div class="col-md-8">
            @Html.HiddenFor(a => a.TRANS_TYPE_ID)
        </div>

        <div class="col-md-8">
            <label>Transaction Name</label>
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Trans_Name, null, new { @class = "form-control txtbox" })
                @Html.ValidationMessageFor(a => a.Trans_Name, "", new { @style = "color:red" })
            </div>
        </div>
        <div class="col-md-8">
            <label>Transaction Description</label>
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.DropDownListFor(a => a.Trans_Desc, Model.DropdownTransDesc, "Select Transaction Description", new { @class = "form-control txtbox" })
                @Html.ValidationMessageFor(a => a.Trans_Desc, "", new { @style = "color:red" })
            </div>
        </div>

        <div class="col-md-8">
            @Html.LabelFor(a => a.Remarks)
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
            </div>
        </div>
        <div class="col-md-8">
            <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
            @Html.BackButton(url)
        </div>
    </div>
}