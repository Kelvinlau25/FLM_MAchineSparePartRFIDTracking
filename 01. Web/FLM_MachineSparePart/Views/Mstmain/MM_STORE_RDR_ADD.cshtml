@model UserMMModel.StoreLocReader
@{
    var url = @Url.Action("MM_STORE_RDR_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Storage Reader - Add";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        url= '@Url.Action("MM_STORE_RDR_LST", "Mstmain")';
        window.location.href = url;
    </script>
}
<script type="text/javascript">
            var popup;
            function SelectParentID() {
                var url = '@Url.Action("ResourceParentPopUp", "Mstmain")';
                popup = window.open(url, "Popup", "scrollbars=yes,resizable=yes,location=no,toolbar=no,width=500,height=500");
                popup.focus();
            }
</script>

<h2>Storage Reader Master Maintenance - Add</h2>
<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="col-100">
        
        <div class="col-md-8">
            <label>Storage Code</label>
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Storage_Code, null, new { @class = "form-control txtbox", @maxlength = "50" })
                @Html.ValidationMessageFor(a => a.Storage_Code, "", new { @style = "color:red" })
            </div>
        </div>
        <div class="col-md-8">
            <label>Reader Name</label>
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Reader_Name, null, new { @class = "form-control txtbox", @maxlength = "50" })
                @Html.ValidationMessageFor(a => a.Reader_Name, "", new { @style = "color:red" })
            </div>
        </div>        
        <div class="col-md-8">
            @Html.LabelFor(a => a.Remarks)
        </div>
        <div class="col-md-8">
            <div class="form-group">
                @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox", @maxlength = "50" })
            </div>
        </div>

        <div class="col-md-8">
            <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
            @Html.BackButton(url)
        </div>
        <br />
    </div>

