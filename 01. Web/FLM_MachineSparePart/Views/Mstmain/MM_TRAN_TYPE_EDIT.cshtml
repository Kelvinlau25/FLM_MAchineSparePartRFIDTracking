@model UserMMModel.TransactionType
@{
    var url = @Url.Action("MM_TRAN_TYPE_LST", "Mstmain").ToString();
    ViewBag.Title = "MM_TRAN_TYPE_EDIT";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_TRAN_TYPE_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_TRAN_TYPE_EDIT", "Mstmain" , new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@section scripts
{
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/jquery-3.3.1.min.js"></script>

    @*To update Trans_Desc dropdownlist from model data.*@
    <script type="text/javascript">
        $("document").ready(function () {
            $('#Trans_Desc').val('@Model.Trans_Desc');
    });
    </script>

    <script type="text/javascript">
        function postback() {
            var elem = document.getElementById("postbackBtn");
            if (typeof elem.onsubmit == "function") {
                elem.onsubmit.apply(elem);
            }
        }

    </script>


}

<h2>Transaction Type Master Maintenance - Edit</h2>

<hr />
<table style="width:100%;">
    <tr>
        <td>
            @using (Html.BeginForm())
            {

                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.HiddenFor(a => a.TRANS_TYPE_ID)
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2">Transaction Name</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Trans_Name, null, new { @class = "form-control txtbox" })
                            @Html.ValidationMessageFor(a => a.Trans_Name, "", new { @style = "color:red" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2">Transaction Desc.</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.DropDownListFor(a => a.Trans_Desc, Model.DropdownTransDesc, "Select Transaction Description", new { @class = "form-control txtbox" })
                            @Html.ValidationMessageFor(a => a.Trans_Desc, "", new { @style = "color:red" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2">Remarks</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                    @Html.BackButton(url)
                </div>


            }
        </td>
    </tr>
</table>

<table style="border:1px solid; border-radius:20px; width:50%;">
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
</table>
