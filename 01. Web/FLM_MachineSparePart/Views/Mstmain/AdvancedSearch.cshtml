
@{
    Layout = null;
    //@Styles.Render("~/Content/Main.css")
    //@Styles.Render("~/Content/bootstrap.min.css")
}

<body>
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" style="float:left;" id="exampleModalLabel">Advanced Search</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="searchSourceBody">

            @if (ViewData["SearchSource"] != null)
            {
                //get the column name from SearchSourceModel
                foreach (var search in (ViewData["SearchSource"] as string[]))
                {
                    //split the column name
                    string[] c = search.Split(new Char[] { ',' });
                    <div class="row">
                        <div class="col-md-3">
                            <label>@c[0].ToString()</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-9">
                                <input class="form-control" id="@c[1].ToString()" type="text" />
                            </div>
                        </div>
                    </div>
                    <br />
                }
            }
        </div>
        <div class="modal-footer">
            <button type="button" style="float:right" class="btn btn-secondary" onclick="action_clicked();" data-dismiss="modal">Search</button>
        </div>
    </div>
</body>

<script>

    function action_clicked() {
        //debugger
        //var searchValue = "";
        //$('#searchSourceBody input[type="text"]').each(function () {
        //    if (this.value != "") {
        //        var tmp_string = ",";
        //        tmp_string += this.value;
        //        searchValue += this.id + " LIKE '%" + tmp_string + "%' ";

        //    }
        //});

        var searchValue = "str";
        $('#searchSourceBody input[type="text"]').each(function () {
            if (this.value != "") {
                //trim the advanced search value
                this.value = this.value.trim();
                var tmp_string = ",";
                //combine column name with advanced search value
                tmp_string += this.value;

                if (searchValue != "str") {
                    searchValue += " AND " + this.id + " LIKE '%" + tmp_string + "%' ";
                }
                else {
                    searchValue = this.id + " LIKE '%" + tmp_string + "%' ";
                }

            }
        });

        window.location.href = "@Url.Action(ViewData["Action"].ToString(), ViewData["Controller"].ToString())?searchValue=" +searchValue ;

    }


</script>

