@using DBModel
@model PopUpResourceModel

@{
    Layout = null;
    ViewBag.Title = "ResourcePopUpList";
}

<!DOCTYPE html>
<html>
<head>
    <link type="text/css" rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.5.0/css/font-awesome.min.css" />
</head>
<body>
    @using (Html.BeginForm())
    {
        <h3>Resource List</h3>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div id="treeview-checkbox-demo">
                        @if (Model.RootResourceModel != null && Model.RootResourceModel.Count > 0)
                        {
                            for (int i = 0; i < Model.RootResourceModel.Count; i++)
                            {
                                <ul>
                                    <li data-value="@Model.RootResourceModel[i].ID_ACL_RESOURCE">
                                        @Model.RootResourceModel[i].RESOURCE_NAME.ToString()

                                        @if (Model.Layer1ResourceModel != null && Model.Layer1ResourceModel.Count > 0)
                                        {
                                            for (int j = 0; j < Model.Layer1ResourceModel.Count; j++)
                                            {
                                                if (Model.Layer1ResourceModel[j].RESOURCE_PARENT_ID == Model.RootResourceModel[i].ID_ACL_RESOURCE)
                                                {
                                                    <ul>
                                                        <li data-value="@Model.Layer1ResourceModel[j].ID_ACL_RESOURCE">
                                                            @Model.Layer1ResourceModel[j].RESOURCE_NAME.ToString()

                                                            @if (Model.Layer2ResourceModel != null && Model.Layer2ResourceModel.Count > 0)
                                                            {
                                                                for (int k = 0; k < Model.Layer2ResourceModel.Count; k++)
                                                                {
                                                                    if (Model.Layer2ResourceModel[k].RESOURCE_PARENT_ID == Model.Layer1ResourceModel[j].ID_ACL_RESOURCE)
                                                                    {
                                                                        <ul>
                                                                            <li>
                                                                                @Model.Layer2ResourceModel[k].RESOURCE_NAME.ToString()
                                                                            </li>
                                                                        </ul>
                                                                    }
                                                                }
                                                            }
                                                        </li>
                                                    </ul>
                                                }

                                            }
                                        }
                                    </li>
                                </ul>
                             }
                        }
                    </div>


                    <pre id="values"></pre>
                    <button type="button" class="btn btn-primary" id="show-values">Select</button>
                    <input type="button" value="Confirm" class="btn btn-primary" onclick="SetValues();" />
                </div>
            </div>
        </div>
    }

        <script src="https://code.jquery.com/jquery-2.2.0.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js"></script>
        <script src="https://www.jqueryscript.net/demo/Checkable-Collapsible-jQuery-Tree-View-Plugin-Treeview/dev/logger.js"></script>
        <script src="https://www.jqueryscript.net/demo/Checkable-Collapsible-jQuery-Tree-View-Plugin-Treeview/dev/treeview.js"></script>

        <script>
            $('#treeview-checkbox-demo').treeview({
                debug: true,
                //data: ['links']
            });

            $('#treeview-checkbox-demo').on("treeview.change", function (e, ele) {
                if ($(ele).parents('ul').length > 1) {  // not on root elements
                    $(ele).closest('li').siblings().find(':checkbox').prop('checked', false);
                }
            });

            $('#show-values').on('click', function () {
                $('#values').text(
                    $('#treeview-checkbox-demo').treeview('selectedValues')
                );
            });
        </script>
        <script type="text/javascript">
            function SetValues() {
                if (window.opener != null && !window.opener.closed) {
                    var txtParentID = window.opener.document.getElementById("txtParentID");
                    //txtParentID.value = document.getElementById("values").value;
                    
                    txtParentID.value = document.querySelector('pre').innerHTML

                }
                window.close();
            }

        </script>
    </body>
</html>



