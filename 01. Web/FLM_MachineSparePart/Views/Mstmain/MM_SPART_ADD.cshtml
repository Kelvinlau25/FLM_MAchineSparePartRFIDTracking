@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
<div class="col-100">
    <div class="col-md-8">
        <label>Model No</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.Spare_Part_Model_ID_1, Model.DropdownModelNo, "Select Model", new { @class = "form-control" })
            @Html.ValidationMessageFor(a => a.Spare_Part_Model_ID_1, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Series No</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.Series_No, null, new { @class = "form-control txtbox", @maxlength = "200" })
            @Html.ValidationMessageFor(a => a.Series_No, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Part No</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.Part_No, null, new { @class = "form-control txtbox", @maxlength = "200" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Machine Model</label>
    </div>

    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.Spare_Part_Machine_ID_1, Model.DropdownMachineCode, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-8">
        <label>RFID Type</label>
    </div>

    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.RFID_Type_ID_1, Model.DropdownRFIDType, "Select RFID Type", new { @class = "form-control" })
            @Html.ValidationMessageFor(a => a.RFID_Type_ID_1, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        <label>RFID Tag ID</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.RFID_Tag_ID, null, new { @class = "form-control txtbox", @maxlength = "24" })
            @Html.ValidationMessageFor(a => a.RFID_Tag_ID, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        <label>RFID Tag ID 2</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.RFID_Tag_ID_2, null, new { @class = "form-control txtbox", @maxlength = "24" })       
        </div>
    </div>
    <div class="col-md-8">
        <label>Storage Code</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.Reader_ID, Model.DropdownStorageCode, "Select Storage Code", new { @class = "form-control", id = "ddlreaderid" })
            @Html.ValidationMessageFor(a => a.Reader_ID, "", new { @style = "color:red" })
        </div>
    </div>
    @*<div class="col-md-8">
            <label>Storage Description 1</label>
        </div>
