        <label>Manufacturer Code</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.Manufacturer_ID_1, Model.DropdownManufacCode, "Select Manufacturer", new { @class = "form-control" })
        </div>
    </div>

    <div class="col-md-8">
        @Html.LabelFor(a => a.Remarks)
    </div>
    <div class="form-group">
        <div class="col-md-8">
            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox", @maxlength = "200" })
        </div>
    </div>

    <div class="col-md-8">
        <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
