@model UserMMModel.SparePart
@{
    var url = @Url.Action("MM_SPART_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Spare Part- Add";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_SPART_LST", "Mstmain")';
        window.location.href = url;
        </script>
    }

    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

