@using UserMMModel
@model IEnumerable<SparePartModel>
@{
    ViewBag.Title = "MM Spare Part Model";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model,
   defaultSort: "id",
   canPage: true,
   ajaxUpdateContainerId: "grid",
   rowsPerPage: 10);
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_SPARE_PART_LST", "Mstmain")";
    </script>
}


<script type="text/javascript">
    //$(document).ready(function () {
        //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
        //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();                
        //$('#WebGrid td:nth-child(1), th:nth-child(1)').hide();
        //$('#WebGrid tfoot tr td').show();
    //});    
    function popUpDelete(rowid) {
        //var row = rowid.parentNode.parentNode;
        //var modelid = row.getElementsByTagName("TD")[0].innerHTML;
        var modelid = rowid.toString();
        //var id = $('#hfID').val();
        //alert(modelid);
        //alert(id);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");                        
            var url = '@Url.Action("MM_SPARE_PART_DELETE", "Mstmain")?id=' + modelid;
            alert(url);
            window.location.href = url;
        }
    }
</script>

<h2>
    Spare Part Model Master Maintenance
</h2>
<hr />
@{
    @Html.Partial("_Header",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_SPARE_PART_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_SPARE_PART_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount: 5,
    mode: WebGridPagerModes.All,
    firstText: "First",
    previousText: "Previous",
    nextText: "Next",
    lastText: "Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
        //grid.Column(null,null, format: @<input type="hidden" id="itemId" value="@item.SPARE_PART_MODEL_ID"/>),
        //grid.Column("", format: @<a href="@Url.Action("MM_Spart_part_LST", "Mstmain",new { id = item.SPARE_PART_MODEL_ID })"><i class="fa fa-trash"></i></a>),
        //grid.Column(null, null, format: @<text> @item.SPARE_PART_MODEL_ID </text>),
        //grid.Column(null, null, format: @<input type="hidden" name="hfID" value="@item.SPARE_PART_MODEL_ID" />),
        grid.Column("", format: @<a href="#" onclick="popUpDelete('@item.SPARE_PART_MODEL_ID');"><i class="fa fa-trash"></i></a>),                
        grid.Column("Model No", format: @<text> @item.Model_No </text>),
        grid.Column("Remarks", format: @<text> @item.Remarks </text>),
        grid.Column("Edit", format: @<a href="@Url.Action("MM_SPARE_PART_EDIT", "Mstmain",new { id = item.SPARE_PART_MODEL_ID })"><i class="fa fa-pencil"></i></a>)
    )
    )
</div>
}
<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelSparePart", "Mstmain")'" />


