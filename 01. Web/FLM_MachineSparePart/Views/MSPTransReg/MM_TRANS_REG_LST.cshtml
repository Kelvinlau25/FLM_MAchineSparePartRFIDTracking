@using MSPTransReg
@model IEnumerable<Transaction>
@{
    ViewBag.Title = "MM_TRANS_REG_LST";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var grid = new WebGrid(source: Model,
 defaultSort: "id",
 canPage: true,
 ajaxUpdateContainerId: "grid",
 rowsPerPage: 10);
}


@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_TRANS_REG_LST", "MSPTransReg")";
    </script>
}


<script type="text/javascript">
    //$(document).ready(function () {
    //    //$('.webgrid-table thead td:nth-child(0), thead th:nth-child(0').hide();
    //    //$('.webgrid-table tbody td:nth-child(0), tbody th:nth-child(0').hide();
    //    $('td:nth-child(1), th:nth-child(1)').hide();
    //});
    function popUpDelete(rowid)
    {
        //var row = rowid.parentNode.parentNode;
        //var spartid = row.getElementsByTagName("TD")[0].innerHTML;
        var transreg = rowid.toString();
        //alert(transreg);
        var agree = confirm("Are you sure to delete?");
        if (agree) {
            //alert("deleted.");
            var url = '@Url.Action("MM_TRANS_REG_DELETE", "MSPTransReg")?id=' + transreg;
            window.location.href = url;
        }
    }
</script>

<h2>Transaction Registration Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_Header",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_TRANS_REG_ADD" },
        { "Ctrl", "MSPTransReg" },
        { "SrcAct", "MM_TRANS_REG_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}

@{
<div id="grid">
    @grid.GetHtml(
    tableStyle: "table table-bordered",
    headerStyle: "head",
    numericLinksCount: 5,
    mode: WebGridPagerModes.All,
    firstText: "First",
    previousText: "Previous",
    nextText: "Next",
    lastText: "Last",
    alternatingRowStyle: "alt",
    columns: grid.Columns(
          //grid.Column("", format: @<a href="@Url.Action("MM_TRANS_REG_DELETE", "Mstmain", new { id = item.TRANSACTION_ID })"><i class="fa fa-trash"></i></a>),
          grid.Column("", format: @<a href="#" onclick="popUpDelete('@item.TRANSACTION_ID');"><i class="fa fa-trash"></i></a>),
          grid.Column("Model No", format: @<text> @item.Model_No </text>),
          grid.Column("Series No", format: @<text> @item.Series_No </text>),
          grid.Column("Part No", format: @<text> @item.Part_No </text>),
          grid.Column("RFID Tag ID", format: @<text> @item.RFID_Tag_ID </text>),
          grid.Column("Transaction Name", format: @<text> @item.Trans_Name </text>),
          grid.Column("Reason", format: @<text> @item.Trans_Reason </text>),
          grid.Column("Status", format: @<text> @item.Status </text>),                    
          grid.Column("View", format: (item) => (item.Status == "DONE") ? Html.Raw(String.Format("<a href= {0} class='fa fa-pencil'></a>", Url.Action("MM_TRANS_REG_VIEW", "MSPTransReg", new { id = item.TRANSACTION_ID })))
            : Html.Raw(String.Format("<a href= {0} class='fa fa-pencil'></a>", Url.Action("MM_TRANS_REG_EDIT", "MSPTransReg", new { id = item.TRANSACTION_ID })))
          //@<a href="@Url.Action("MM_TRANS_REG_VIEW", "MSPTransReg",new { id = item.TRANSACTION_ID })"><i class="fa fa-pencil"></i></a>
          //grid.Column("View", format: (item) => (item.Status == "DONE") ? Html.ActionLink(" ", "MM_TRANS_REG_VIEW", "MSPTransReg", new { id = item.TRANSACTION_ID, @class = "fa fa-pencil" })
          //: Html.ActionLink(" ", "MM_TRANS_REG_EDIT", "MSPTransReg", new { id = item.TRANSACTION_ID, @class = "fa fa-pencil" }))
          )

        )
   )
</div>
}

  
        <input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelTrans", "MSPTransReg")'" />
   