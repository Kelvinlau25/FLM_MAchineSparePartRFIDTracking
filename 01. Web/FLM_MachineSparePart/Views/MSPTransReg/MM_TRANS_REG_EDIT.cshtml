@model MSPTransReg.Transaction
@{
    var url = @Url.Action("MM_TRANS_REG_LST", "MSPTransReg").ToString();
    ViewBag.Title = "MM_TRANS_REG_EDIT";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_TRANS_REG_LST", "MSPTransReg")';
        } else {
            url = '@Url.Action("MM_TRANS_REG_EDIT", "MSPTransReg", new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@{
    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

<h2>Transaction Registration Master Maintenance - Edit</h2>
<hr />
<table style="width:100%;">
    <tr>
        <td>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        @Html.HiddenFor(a => a.TRANSACTION_ID)
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Model No</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Model_No, null, new { @class = "form-control txtbox", @readonly = "true"})
                            @Html.HiddenFor(a => a.SPARE_PART_MODEL_ID)
                            @Html.ValidationMessageFor(a => a.Model_No, "", new { @style = "color:red" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Transaction Type</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">                            
                            @Html.DropDownListFor(m => m.Trans_Type_ID, Model.DropdownTransType, "Select Transaction Type", new { @class = "form-control" })
                            @Html.ValidationMessageFor(a => a.Trans_Type_ID, "", new { @style = "color:red" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2">Status</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Status, null, new { @class = "form-control txtbox", @readonly = "true" })
                        </div>
                    </div> 
                    <div class="form-group">
                        <label class="col-sm-2">Reason</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Trans_Reason, null, new { @class = "form-control txtbox" })
                            @Html.ValidationMessageFor(a => a.Trans_Reason, "", new { @style = "color:red" })
                        </div>
                    </div>                                        
                    <div class="form-group">
                        <label class="col-sm-2">Remarks</label>
                        <label class="labelW10">:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                    @Html.BackButton(url)
                </div>
            }
        </td>
    </tr>
</table>
<table style="border:1px solid; border-radius:20px; width:50%;">
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Created_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_By, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
    <tr>
        <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
        <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_Date, null, new { @class = "form-control", @readonly = "true" })</td>
    </tr>
</table>
