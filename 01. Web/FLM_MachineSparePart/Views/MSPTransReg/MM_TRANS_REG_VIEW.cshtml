@model MSPTransReg.Transaction
@{
    var url = @Url.Action("MM_TRANS_REG_LST", "MSPTransReg").ToString();
    ViewBag.Title = "MM_TRANS_REG_VIEW";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

<h2>Transaction Registration Master Maintenance - View</h2>
<hr />
<div class="form-horizontal">
    <div class="form-group">
        <label class="col-sm-2">Model No</label>
        <label class="labelW10">:</label>
        <div class="col-md-4">
            @Html.TextBoxFor(a => a.Model_No, null, new { @class = "form-control", @readonly = "true" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Transaction Type</label>
        <label class="labelW10">:</label>
        <div class="col-md-4">
            @Html.TextBoxFor(a => a.Trans_Name, null, new { @class = "form-control", @readonly = "true" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Status</label>
        <label class="labelW10">:</label>
        <div class="col-md-4">
            @Html.TextBoxFor(a => a.Status, null, new { @class = "form-control", @readonly = "true" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Reason</label>
        <label class="labelW10">:</label>
        <div class="col-md-4">
            @Html.TextBoxFor(a => a.Trans_Reason, null, new { @class = "form-control", @readonly = "true" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Remarks</label>
        <label class="labelW10">:</label>
        <div class="col-md-4">
            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control", @readonly = "true" })
        </div>
    </div>
</div>
<div class="form-group">
    <table style="border:1px solid; border-radius:20px; width:50%;">
        <tr>
            <td style="padding-left:0.5em; width:15%;"><label>Created By:</label></td>
            <td style="width:35%;">@Html.TextBoxFor(a => a.Created_By, null, new { @class = "form-control", @readonly = "true" })</td>
        </tr>
        <tr>
            <td style="padding-left:0.5em; width:15%;"><label>Created Date:</label></td>
            <td style="width:35%;">@Html.TextBoxFor(a => a.Created_Date, null, new { @class = "form-control", @readonly = "true" })</td>
        </tr>
        <tr>
            <td style="padding-left:0.5em; width:15%;"><label>Updated By:</label></td>
            <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_By, null, new { @class = "form-control", @readonly = "true" })</td>
        </tr>
        <tr>
            <td style="padding-left:0.5em; width:15%;"><label>Updated Date:</label></td>
            <td style="width:35%;">@Html.TextBoxFor(a => a.Updated_Date, null, new { @class = "form-control", @readonly = "true" })</td>
        </tr>
    </table>
</div>
<div class="form-group">
    @Html.BackButton(url)
</div>
