    @* Advance search *@
    using (Html.BeginForm(postto, ctrlto))
    {
        <div>
            <fieldset>
                <div class="editor-field">
                    <div class="topleft">
                        <input type="text" id="SEARCH_VALUE" class="searchtxt" name=@Html.ViewData["SrcVal"].ToString() />
                    </div>
                    <div class="topright">
                        <button id="btnsubmit" class="btntolink searchbtn"><i class="fa fa-search"></i></button>
                    </div>

                    <div style="float:right;" >
                        <a href="#" onclick="advanceSearchClick()" data-toggle="modal" data-target="#exampleModal1" class="fa fa-search-plus fa-2x"></a>
                    </div>
                    <div class="modal fade" id="exampleModal1" tabindex="-1" role="dialog" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
                        <div class="modal-dialog" role="document">
                            <div id="advanceSearchDiv"></div>
                        </div>
                    </div>

                    <script>
                        function advanceSearchClick()
                        {
                            $("#advanceSearchDiv").load('@(Url.Content("/Mstmain/AdvancedSearch") + "?actionRequested=" + ViewContext.RouteData.Values["action"].ToString() + "/" + ViewContext.RouteData.Values["controller"].ToString())');
                        }
                    </script>
                </div>
            </fieldset>

        </div>
    }
}
