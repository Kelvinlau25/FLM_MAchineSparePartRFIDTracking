@using FILM_Sparepart_MVC.Helper_Code.Objects;
<!DOCTYPE html>
<html>
<head>
    <style>
        .mobileWidth {
            height: 100vh;
        }

        .RightFrameWidth >
        .mobileWidth {
            width: 100vw;
        }

        @@media only screen and (max-width: 1035.200px) {
            .RightFrameWidth > .mobileWidth {
                width: 100%;
            }
        }

        @@media only screen and (max-width: 1144px) and (min-width: 993px) {
            #RightIframe > .mobileWidth {
                width: 77vw;
            }

            .RightFrameWidth > .mobileWidth {
                width: 100vw !important;
            }
        }

        @@media only screen and (max-width: 993px) {
            #RightIframe > .mobileWidth {
                width: 94vw;
            }
        }
    </style>
    <script>
        function changeFrameSize() {
            if (!document.getElementById("layoutLeftBar").classList.contains("LeftNone")) {
                document.getElementById("RightIframe").classList.add("RightFrameWidth");
            }
            else {
                document.getElementById("RightIframe").classList.remove("RightFrameWidth");
            }
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css.css")
    @Scripts.Render("~/bundles/modernizr.css")
    @Styles.Render("~/Content/font-awesome.min.css")
    @Styles.Render("~/Content/site.css")
    @Styles.Render("~/Content/bootstrap.min.css")
    @Scripts.Render("~/Scripts/jquery-3.4.1.min.js")
    @Scripts.Render("~/Scripts/jquery.validate.min.js")
    @Scripts.Render("~/Scripts/jquery.validate.unobtrusive.min.js")
    @Scripts.Render("~/Scripts/popper.min.js")
    @Scripts.Render("~/Scripts/bootstrap.js")
    @Scripts.Render("~/Scripts/moment.min.js")
    @Scripts.Render("~/Scripts/jquery.unobtrusive-ajax.min.js")

    <!--new 20190612-->
    @Styles.Render("~/Content/Main.css")
    @Scripts.Render("~/Scripts/Main.js")
    <!--new 20190612 end-->
    @Scripts.Render("~/Scripts/bootstrap-select.js")
    @Scripts.Render("~/Scripts/script-bootstrap-select.js")
    @Styles.Render("~/Content/style/bootstrap-select.css")
    @Styles.Render("~/Content/style/bootstrap-select.min.css")
    <!--for Datepicker-->
    @*@Styles.Render("~/Content/jquery-ui-1.8.22.custom.css")
        @Scripts.Render("~/Scripts/jquery.mtz.monthpicker.js")*@

    <script type="text/javascript">
    $(document).ready(function() {
        $("#sidebar").load('@Url.Content("/Home/SideBar")');
    });
    </script>
    <style type="text/css">

        .navbar-brand:hover {
            color: black !important;
        }

        /*.navbar-toggle {
            display: inline-block !important;
            float: left;
        }*/

        .fa-sign-out {
            padding-top: 10px;
            padding-right: 50px;
            text-decoration: none;
            /*float: right;*/
        }

        @@media only screen and (max-width: 770px) {
            .fa-sign-out {
                position: fixed;
                top: 0;
                right: 0;
            }
        }


        .fa-sign-out:hover {
            text-decoration: none;
        }

        .displayLogin {
            padding-right: 10px;
            font-size: large;
            font-weight: normal;
            /*line-height: 50px;*/
            /*padding-bottom: 100px;*/
        }

        /*.navbar-header {
            float: left;
            width: 100%;
        }*/
        .fa-file {
            padding-right: 0.5em;
        }
    </style>

</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top height5">
        <div class="navbar-header">
            @*<button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>*@
            <button onclick="changeFrameSize()" type="button" class="btn" id="make-small-nav">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @Html.ActionLink("Machine Spare Part Tracking System", "Menu", "Home", new { area = "" }, new { @class = "navbar-brand hidden-xs" })
        </div>
        <div style="float:right">
            @Html.Label((string)(Session["AclUser"] as ACL_UserObj).EMP_NAME, new { @class = "displayLogin hidden-xs" })
            @Html.ActionLink(" ", "Login", "Home", new { area = "" }, new { @class = "fa fa-sign-out fa-2x signout" })
        </div>
    </div>
    <div class="full-height">
        <div id="layoutLeftBar" class="maincover LeftBar">
            <div class="container" style="width:220px; padding-top:2em;">
                <div id="sidebar"></div>
            </div>
            @*<div class="navbar-collapse collapse">*@
            @*<div class="Ul-span">Modules</div>*@
            @*<div id="sidebar"></div>*@
            @*<div class="Ul-span">Settings</div>
                <div class="panel-heading">
                    <div class="panel-title">
                        <i class="fa fa-cog" style="padding-right:10px"></i>@Html.ActionLink("Change Password", "ChangePassword", "Home", "", new { target = "iframe" })
                    </div>
                </div>*@
            @*</div>*@
        </div>
        <div class="maincover RightBar">
            <div class="body-content">
                @RenderBody()
                <footer>
                    <table style="width:100%;">
                        <tr>
                            <td style="width:50%; padding-left:2.0em"></td>
                            <td style="width:50%; float:right;"></td>
                        </tr>
                    </table>
                    @*<small style="text-align:left"></small>*@
                </footer>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
