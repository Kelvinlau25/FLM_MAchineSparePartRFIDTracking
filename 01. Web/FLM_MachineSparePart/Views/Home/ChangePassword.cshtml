@model HomeModel.ChangePasswordModel 
@{
    //var url = @Url.Action("Menu", "Home").ToString();
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (ViewData["Message"] != null)
{
    if (ViewData["MessageType"].ToString()[0] == 'E')
    {
        <div class="alert alert-danger " role="alert">
            @ViewData["Message"].ToString()
        </div>
    }

    if (ViewData["MessageType"].ToString()[0] == 'Y')
    {
        <div class="alert alert-success " role="alert">
            @ViewData["Message"].ToString()
        </div>

        <script type="text/javascript" language="javascript">
            alert("@ViewData["Message"]");            
        </script>

        if (ViewData["MessageType"].ToString()[0] == 'Y')
        {
            <script type="text/javascript" language="javascript">
                var url = '@Url.Action("Login", "Home")';
                window.location.href = url;
            </script>
        }
    }
}

@Styles.Render("~/Content/ChangePassword.css")
@Styles.Render("~/Content/Alert.css")
@Scripts.Render("~/Scripts/Alert.js")
<style>
    #successBtn, #failBtn {
        display: none;
    }

    .errMsg {
        color: crimson;
    }
</style>

<form class="box" action="ChangePassword" method="post">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <h1>Change Password</h1>
        <br />
        @*@Html.TextBoxFor(a => a.LOGIN_ID, new { placeholder = "Username" })*@
        @Html.PasswordFor(a => a.OLD_PASSWORD, new { placeholder = "Password" })
        @Html.PasswordFor(a => a.NEW_PASSWORD, new { placeholder = "New Password" })
        @Html.PasswordFor(a => a.CONFIRM_NEW_PASSWORD, new { placeholder = "Confirm Password" })
        <input id="Submit" type="submit" value="Submit" />
        <div class="errMsg">@Html.ValidationMessageFor(a => a.OLD_PASSWORD)</div>
        <div class="errMsg">@Html.ValidationMessageFor(a => a.NEW_PASSWORD)</div>
        <div class="errMsg">@Html.ValidationMessageFor(a => a.CONFIRM_NEW_PASSWORD)</div>

        @*<input type="button" id="failBtn" value="Fail" onclick="alert('&#10006; Failed','Invalid Username & Password. <br> Please Try Again.','red');" />*@

        @*@Html.ActionLink("Login", "Menu", "Home", new { @type = "submit" })*@
    }
</form>

