        [HttpPost]
        public ActionResult MM_SPART_ADD_Excel(IFormFile file)
        {
            DataTable dt = new DataTable();
            //Checking file content length and Extension must be .xlsx  
            if (file != null && file.Length > 0 && System.IO.Path.GetExtension(file.FileName).ToLower() == ".xlsx")
            {
                string path = Path.Combine(_webHostEnvironment.WebRootPath, "UploadFile", Path.GetFileName(file.FileName));
                //Saving the file
                using (var stream = new FileStream(path, FileMode.Create))
                {
                    file.CopyTo(stream);
                }
                //Started reading the Excel file.  
                using (XLWorkbook workbook = new XLWorkbook(path))
                {
                    IXLWorksheet worksheet = workbook.Worksheet(1);
                    bool FirstRow = true;
                    //Range for reading the cells based on the last cell used.  
                    string readRange = "1:1";

                    foreach (IXLRow row in worksheet.RowsUsed())
                    {
                        //If Reading the First Row (used) then add them as column name  
                        if (FirstRow)
                        {
                            //Checking the Last cellused for column generation in datatable  
                            readRange = string.Format("{0}:{1}", 1, row.LastCellUsed().Address.ColumnNumber);
                            foreach (IXLCell cell in row.Cells(readRange))
                            {
                                dt.Columns.Add(cell.Value.ToString());

                            }
                            FirstRow = false;
                        }
                        else
                        {
                            //Adding a Row in datatable  
                            dt.Rows.Add();
                            int cellIndex = 0;
                            //Updating the values of datatable  
                            foreach (IXLCell cell in row.Cells(readRange))
                            {
                                dt.Rows[dt.Rows.Count - 1][cellIndex] = cell.Value.ToString();

                                cellIndex++;
                            }
                        }

                    }

                    for (int i = 0; i <= dt.Rows.Count - 1; i++)
                    {
                       
                        string modelno = dt.Rows[i][0].ToString();
                        string seriesno = dt.Rows[i][1].ToString();
                        string partno = dt.Rows[i][2].ToString();
                        string machine = dt.Rows[i][3].ToString();
                        string rfidtype = dt.Rows[i][4].ToString();
                        string rfidtag = dt.Rows[i][5].ToString();
                        string rfidtag2 = dt.Rows[i][6].ToString();
                        string storagecode = dt.Rows[i][7].ToString();
                        string storagedesc1 = dt.Rows[i][8].ToString();
                        string storagedesc2 = dt.Rows[i][9].ToString();
                        string manucode = dt.Rows[i][10].ToString();
                        string remarks = dt.Rows[i][11].ToString();

                        if (modelno == null && seriesno == null && partno == null && machine == null &&
                           rfidtype == null && rfidtag == null && storagecode == null && storagedesc1 == null &&
                           storagedesc2 == null && manucode == null && remarks == null)
                        {

                        }
                        else
                        {
                            DB db = new DB();

                            string loc = HttpContext.Connection.RemoteIpAddress?.ToString() ?? string.Empty;
                            string pc = Environment.MachineName;
                           
                            string result = db.SpartExcelImportFile(" ", modelno, seriesno, partno, machine, rfidtype, rfidtag, rfidtag2, storagecode, storagedesc1, storagedesc2,
                                manucode, remarks, loc, pc, i);
                            ViewBag.Result = result;
                        }
                    }

                   
                    //If no data in Excel file  
                    if (FirstRow)
                    {
                        ViewBag.Message = "Empty Excel File!";
                    }
                }
            }
            else
            {
                //If file extension of the uploaded file is different then .xlsx  
                ViewBag.Message = "Please select file with .xlsx extension!";
            }
            return View(dt);
        }

