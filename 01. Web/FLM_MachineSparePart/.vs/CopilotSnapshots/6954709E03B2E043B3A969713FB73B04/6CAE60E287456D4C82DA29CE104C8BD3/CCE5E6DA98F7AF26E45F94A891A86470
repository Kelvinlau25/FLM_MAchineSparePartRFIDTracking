        DataSet GetSpartRecords()
        {
            DataSet dataSet = new DataSet();

            SqlConnection conn = new SqlConnection();
            conn.ConnectionString = _configuration.GetConnectionString("SQLCon");
            SqlCommand cmd = new SqlCommand();
            cmd.CommandType = CommandType.Text;
            cmd.CommandText = "SELECT A.MODEL_NO As 'Model No', MM.SERIES_NO AS 'Series No', MM.PART_NO AS 'Part No'" + 
                              ", B.MACHINE_MODEL AS 'Machine Model', F.STORAGE_CODE AS 'Storage', " +
                              "D.STORAGE_DESC_1 AS 'Storage Description 1', D.STORAGE_DESC_2 AS 'Storage Description 2', " +
                              "E.MANUFACTURER_CODE AS 'Manufacturer', MM.STATUS AS 'Status', MM.REMARKS AS 'Remarks'," +
                              "MM.UPDATED_BY AS 'Last Update By', MM.UPDATED_DATE AS 'Last Update Date' " +
                              "FROM dbo.MM_SPARE_PART AS MM LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_MODEL AS A ON A.SPARE_PART_MODEL_ID = MM.SPARE_PART_MODEL_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_MACHINE AS B ON B.SPARE_PART_MACHINE_ID = MM.SPARE_PART_MACHINE_ID LEFT OUTER JOIN " +
                              "dbo.MM_RFID_TYPE AS C ON C.RFID_TYPE_ID = MM.RFID_TYPE_ID LEFT OUTER JOIN " +
                              "dbo.MM_SP_STORAGE AS D ON D.STORAGE_ID = MM.STORAGE_ID LEFT OUTER JOIN " +
                              "dbo.MM_SP_MANUFACTURER AS E ON E.MANUFACTURER_ID = MM.MANUFACTURER_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_READER AS F ON F.READER_ID = D.READER_ID " +
