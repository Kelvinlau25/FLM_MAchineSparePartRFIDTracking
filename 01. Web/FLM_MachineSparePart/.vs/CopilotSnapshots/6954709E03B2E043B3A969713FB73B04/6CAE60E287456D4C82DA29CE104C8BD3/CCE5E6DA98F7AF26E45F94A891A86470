        public ActionResult ExportExcelStoreLocRDR()
        {
            //Fill dataset with records
            DataSet dataSet = GetStoreLocRDRRecords();

            StringBuilder sb = new StringBuilder();

            sb.Append("<table>");
            sb.Append("<tr><td colspan='5' style='background-color:#E0F8F7; color:black; font-weight:bold;'><b><u>Storage Reader Inquiry Report</u></b></td></tr>");
            sb.Append("<tr><td colspan='5'></td></tr>");

            //LINQ to get Column names
            var columnName = dataSet.Tables[0].Columns.Cast<DataColumn>()
                                 .Select(x => x.ColumnName)
                                 .ToArray();
            sb.Append("<tr>");
            //Looping through the column names
            foreach (var col in columnName)
                sb.Append("<td style='background-color:#36CBE6; color:black; font-weight:bold;'>" + col + "</td>");
            sb.Append("</tr>");

            //Looping through the records
            foreach (DataRow dr in dataSet.Tables[0].Rows)
            {
                sb.Append("<tr>");
                foreach (DataColumn dc in dataSet.Tables[0].Columns)
                {
                    sb.Append("<td>" + dr[dc] + "</td>");
                }
                sb.Append("</tr>");
            }

            sb.Append("</table>");



            //Return Excel file as FileContentResult
            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var fileName = $"Storage Reader Inquiry Report_{DateTime.Now:ddMMyyyy}.xls";
            return File(bytes, "application/vnd.ms-excel", fileName);
        }
        DataSet GetStoreLocRDRRecords()
        {
            DataSet dataSet = new DataSet();

            SqlConnection conn = new SqlConnection();
            conn.ConnectionString = _configuration.GetConnectionString("SQLCon");
            SqlCommand cmd = new SqlCommand();
            cmd.CommandType = CommandType.Text;
            cmd.CommandText = "SELECT STORAGE_CODE AS 'Storage Code', READER_NAME AS 'Reader Name', " +
                              "REMARKS AS 'Remarks', UPDATED_BY AS 'Last Update By', UPDATED_DATE AS 'Last Update Date' " +
                              "FROM MM_SPARE_PART_READER WHERE RECORD_TYPE <> 5 " +
                              "ORDER BY UPDATED_DATE DESC ";

            cmd.Connection = conn;
            SqlDataAdapter sqlDataAdapter = new SqlDataAdapter();
            sqlDataAdapter.SelectCommand = cmd;
            sqlDataAdapter.Fill(dataSet);

            return dataSet;
        }

