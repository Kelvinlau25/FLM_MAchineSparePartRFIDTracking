        public IActionResult ExportExcelTrans()
        {
            //Fill dataset with records
            DataSet dataSet = GetTransRecords();

            StringBuilder sb = new StringBuilder();

            sb.Append("<table>");
            sb.Append("<tr><td colspan='14' style='background-color:#E0F8F7; color:black; font-weight:bold;'><b><u>Transaction Registration Report</u></b></td></tr>");
            sb.Append("<tr><td colspan='14'></td></tr>");

            //LINQ to get Column names
            var columnName = dataSet.Tables[0].Columns.Cast<DataColumn>()
                                 .Select(x => x.ColumnName)
                                 .ToArray();
            sb.Append("<tr>");
            //Looping through the column names
            foreach (var col in columnName)
                sb.Append("<td style='background-color:#36CBE6; color:black; font-weight:bold;'>" + col + "</td>");
            sb.Append("</tr>");

            //Looping through the records
            foreach (DataRow dr in dataSet.Tables[0].Rows)
            {
                sb.Append("<tr>");
                foreach (DataColumn dc in dataSet.Tables[0].Columns)
                {
                    sb.Append("<td>" + dr[dc] + "</td>");
                }
                sb.Append("</tr>");
            }

            sb.Append("</table>");

            //Return Excel file as FileContentResult
            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var fileName = $"Transaction Registration Report_{DateTime.Now:ddMMyyyy}.xls";
            return File(bytes, "application/vnd.ms-excel", fileName);
        }
        DataSet GetTransRecords()
        {
            DataSet dataSet = new DataSet();

            SqlConnection conn = new SqlConnection();
            conn.ConnectionString = _configuration.GetConnectionString("SQLCon");
            SqlCommand cmd = new SqlCommand();
            cmd.CommandType = CommandType.Text;
            cmd.CommandText = "SELECT D.MODEL_NO AS 'Model No', C.SERIES_NO AS 'Series No', A.TRANS_REASON AS 'Transaction Reason', " +
                              "A.TRANS_FLOW AS 'Transaction Flow', A.STATUS AS 'Status',  " +
                              "B.TRANS_NAME AS 'Transaction Name', C.PART_NO AS 'Part No', E.MACHINE_MODEL AS 'Spare Part Machine', " +
                              "F.RFID_TYPE AS 'RFID Tag', I.STORAGE_CODE AS 'Storage Code', G.STORAGE_DESC_1 AS 'Storage Description 1', " +
                              "G.STORAGE_DESC_2 AS 'Storage Description 2', " +
                              "H.MANUFACTURER_CODE AS 'Manufacturer', A.REMARKS AS 'Remark' FROM dbo.RFID_TRANS_REG AS A LEFT OUTER JOIN " +
                              "dbo.MM_TRANSACTION_TYPE AS B ON A.TRANS_TYPE_ID = B.TRANS_TYPE_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART AS C ON A.RFID_TAG_ID = C.RFID_TAG_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_MODEL AS D ON A.SPARE_PART_MODEL_ID = D.SPARE_PART_MODEL_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_MACHINE AS E ON C.SPARE_PART_MACHINE_ID = E.SPARE_PART_MACHINE_ID LEFT OUTER JOIN " +
                              "dbo.MM_RFID_TYPE AS F ON C.RFID_TYPE_ID = F.RFID_TYPE_ID LEFT OUTER JOIN " +
                              "dbo.MM_SP_STORAGE AS G ON C.STORAGE_ID = G.STORAGE_ID LEFT OUTER JOIN " +
                              "dbo.MM_SP_MANUFACTURER AS H ON C.MANUFACTURER_ID = H.MANUFACTURER_ID LEFT OUTER JOIN " +
                              "dbo.MM_SPARE_PART_READER AS I ON I.READER_ID = G.READER_ID " +
                              "Where A.RECORD_TYPE <> 5 ORDER BY A.CREATED_DATE DESC";
            cmd.Connection = conn;

            SqlDataAdapter sqlDataAdapter = new SqlDataAdapter();
            sqlDataAdapter.SelectCommand = cmd;
            sqlDataAdapter.Fill(dataSet);

            return dataSet;
        }

        private static List<SelectListItem> getTransTypeDll()
        {
            DB db = new DB();
            var dt = db.getTransTypeLst(); //get all Transaction Type
            List<SelectListItem> items = new List<SelectListItem>();
            if (dt.Rows.Count > 0)
            {
                for (int i = 0; i < dt.Rows.Count; i++)
                {
                    items.Add(new SelectListItem
                    {
                        Text = dt.Rows[i]["TRANS_NAME"].ToString(),
                        Value = dt.Rows[i]["TRANS_TYPE_ID"].ToString()
                    });
                }
            }
            return items;
        }

