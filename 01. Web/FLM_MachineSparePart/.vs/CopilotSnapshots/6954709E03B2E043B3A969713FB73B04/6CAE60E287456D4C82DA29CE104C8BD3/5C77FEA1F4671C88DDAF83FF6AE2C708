        [HttpPost]
        public IActionResult MM_TRANS_REG_ADD(Transaction model)
        {
            try
            {
                model.DropdownTransType = getTransTypeDll();      
                
                if (model.QTY_TRANS == "")
                {
                    _logger.LogWarning("Transaction add failed: Transaction quantity not provided");
                    ViewBag.Error = "Please Enter Transaction Quantity.";
                }
                else
                {
                    if (Convert.ToInt32(model.QTY_TRANS) + Convert.ToInt32(model.QTY_ON_REQUEST) > Convert.ToInt32(model.QTY_ON_HAND))
                    {
                        _logger.LogWarning("Transaction add failed: Insufficient on-hand quantity. Requested: {QtyTrans}, OnRequest: {QtyOnRequest}, OnHand: {QtyOnHand}", 
                            model.QTY_TRANS, model.QTY_ON_REQUEST, model.QTY_ON_HAND);
                        ViewBag.Error = "On hand quantity cannot fullfill request quantity.";
                    }
                    else
                    {
                        for (int i = 1; i <= Convert.ToInt32(model.QTY_TRANS); i++)
                        {
                            DB db = new DB();

                            string loc = HttpContext.Connection.RemoteIpAddress?.ToString() ?? string.Empty;
                            //string pc = Environment.MachineName;
                            var aclUserJson = HttpContext.Session.GetString("AclUser");
                            var aclUser = JsonSerializer.Deserialize<ACL_UserObj>(aclUserJson);
                            string pc = aclUser.EMP_NO;

                            //string loc = "10.80.100.10";
                            //string pc = "9328";

                            string result = db.TransactionRegMaint(model, "1", loc, pc);
                            ViewBag.Result = result;
                            _logger.LogInformation("Transaction added successfully by user {EmpNo}, iteration {Iteration} of {Total}", 
                                pc, i, model.QTY_TRANS);
                            //TempData["Message4"] = "MM_TRANS_REG_ADD post";
                            //ViewData["result"] = result; // for dislaying message after saving storing output.
                        }
                    }
                }                             
                ModelState.Clear(); //clearing model            
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error adding transaction");
                Console.Write(ex);
                ViewBag.Error = ex.Message;
            }
            //return RedirectToAction("MM_Spart_LST", "Mstmain");
            return View(model);
        }

