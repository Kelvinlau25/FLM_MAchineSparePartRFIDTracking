@using UserMMModel
@using FILM_Sparepart_MVC.Helpers
@model PaginatedList<UserMMModel.SparePart>
@{
    /**/
    ViewBag.Title = "MM Spare Part";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    var items = Model?.ToList() ?? new List<UserMMModel.SparePart>();
}


@if (TempData["result"] != null)
{
    <script type="text/javascript">
        alert("@TempData["result"]");
    </script>
}


<script type="text/javascript">
    //$(document).ready(function () {
