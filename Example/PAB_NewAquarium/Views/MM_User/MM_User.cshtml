@model PAB_NewAquarium.Models.User
@{
    ViewBag.Title = "MM_User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    @@media only screen and (min-device-width: 1280px) and (max-device-width: 1599px) {
        .modal-header {
            margin-bottom: -15px;
            margin-top: -10px;
        }
    }

    @@media (min-width: 1599px) {
        .modal-header {
            margin-bottom: -25px;
            margin-top: -10px;
        }
    }

    .toolbar {
        float: right;
    }

    /* Override -2px, form some reason the non-bootstrap is -6px */
    table.dataTable tbody td.select-checkbox::before,
    table.dataTable tbody th.select-checkbox::before {
        margin-top: -6px;
    }

    .tr-no-border {
        border: 0px !important;
    }

    .multiselect-container > .disabled {
        display: none;
    }

    .form-check-input {
        border-color: #929292;
    }

    .page-container {
        overflow: auto;
        padding-bottom: 2rem;
        padding-right: 1rem !important;
        padding-left: 1rem !important;
    }

    .dataTables_scrollHeadInner, .table {
        width: 100% !important;
        max-width: none;
    }

    .form-check-input[type="checkbox"]:indeterminate {
        background-color: #057FE5;
        border-color: #057FE5;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">RFID Employee Batch Registration</p>
    </div>
    <div class="col-sm-6 text-end align-self-center">
        <div class="d-flex justify-content-end">
            <div id="customDTButton"></div>
        </div>
    </div>
</div>
<div class="tr-btm-line"></div>

<div class="page-container px-3 overflow-auto">
    <div class="tr-btm-btn-margin">
        <div>
            <div class="row mt-3 mb-2">
                <div class="col-12 col-sm-8">

                </div>
                <div class="col-12 col-sm-4 align-self-end text-end pb-0 mb-0" id="action-bar">

                </div>
            </div>
            <div class="row">
                <table id="tr-datatable" class="table table-hover table-bordered compact">
                    <thead>
                        <tr class="bg-datatable-tr">
                            <th></th>
                            <th>Employee ID</th>
                            <th>Employee Name</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="row tr-btm-btn-area">
                <div class="col">
                    <div class="aud export-section"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
            </div>
            <hr />
            <div class="modal-body">
                <h6>Are you sure to delete this record?</h6>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="btnConfirm2">Confirm</button>
            </div>
        </div>
    </div>
</div>
<div class="toast-container position-fixed toast-alert">
    <div id="liveToast1" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
        <div class="toast-header" style="background-color: #FFF0EE">
            <strong class="me-auto text-danger">Warning!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
            Multiple selection for audit trail is not applicable!
        </div>
    </div>
</div>
<div class="toast-container position-fixed toast-alert">
    <div id="liveToast2" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
        <div class="toast-header" style="background-color: #FFF0EE">
            <strong class="me-auto text-danger">Warning!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
            Please select at least one record!
        </div>
    </div>
</div>


@section scripts {
    <script type="text/javascript">
    var table;
    var data = [], dataAll = [];
    var jsonData = @Html.Raw(Json.Encode(Model.UserListing));
    var data = jsonData;
    dataAll = data;

    $(document).ready(function () {

        var abc = $('.tr-select2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.tr-select2:input').val('');
        $('.tr-select2').multiselect('rebuild');

        var def = $('.tr-select').select2({
            theme: "bootstrap-5",
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            placeholder: $(this).data('placeholder'),
            minimumResultsForSearch: Infinity,
            templateSelection: function formatState(state) {
                return 'Status : ' + state.element.value;
            },
            dropdownCssClass: 'tr-select2-container',
            selectionCssClass: 'tr-no-border'
        });




        $('.multiselectpicker').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.multiselectpicker2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.multiselect-native-select > .btn-group').addClass("w-100");
        $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
        $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");

        loadDataTable();

         $('#tr-datatable').on('length.dt', function (e, settings, len) {
             var customToolbarDiv = $('.custom-toolbar');

             if (len == 10) {
                 customToolbarDiv.removeClass('custom-toolbar-add-margin');
             } else {
                 customToolbarDiv.addClass('custom-toolbar-add-margin');
             }
        });

         $('.dataTables_length select').addClass('tr-select2');

         $('.tr-select2').multiselect({
             buttonClass: 'form-select form-control text-start',
             templates: {
                 button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
             }
         });

         $('.tr-select').select2({
             theme: "bootstrap-5",
             width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
             placeholder: $(this).data('placeholder'),
             minimumResultsForSearch: Infinity,
             templateSelection: function formatState(state) {
                 return 'Status : ' + state.element.value;
             },
             dropdownCssClass: 'tr-select2-container',
             selectionCssClass: 'tr-no-border'
         });

        $('#btnSearchAS').on('click', function () {
            var countStatus = [];
            $('#select-mul-id option:selected').each(function () {
                    countStatus.push($(this).val())
            });

                table.destroy();
                table = $('.table').DataTable({
                    bFilter: true, //allow to do filter
                    "paging": true, //allow to do pagging
                    pagingType: 'simple_numbers',
                    scrollY: calcDataTableHeight,
                    orderCellsTop: true,
                    fixedHeader: true,
                    buttons: [
                        'copy', 'csv', 'excel', 'pdf', 'print'
                    ],
                    columns: getColumnConfig(),
                    columnDefs: [
                        {
                            targets: 0,
                            render: function (data, type, row, meta) {
                                if (type === 'display') {
                                    data = '<div class="checkbox" ID=' + row["ID"] + '><input type="checkbox" class="dt-checkboxes form-check-input"><label></label></div>';
                                }
                                return data;
                            },
                            checkboxes: {
                                selectRow: true,
                                selectAllRender: '<div class="checkbox"><input type="checkbox" class="dt-checkboxes form-check-input"></div>'
                            }
                        },
                        {
                            //use this to customize your columns
                            //targets::5 mean column index 5 you want to change
                            //render: function datatable return current row and current data
                            //data: your column
                            //audit
                            targets: 5,
                            render: function (data, type, row, meta) {
                                if (type === 'display') {
                                    var htmlLink = row["id_mm_rem_ind"];
                                    var urlparam = $("#txtheader").html();

                                    data = '<a href="@Url.Action("Detail","Home")" class="name tr-icon-size" id=n-"' + meta.row + '" /><i class="fa-solid fa-eye"></i></a>';
                                    //data = '<a href="../Audit/Index?pTable=PVIEW_MM_PACK_CODE_A&pID=' + row["ID_MM_PACK_CODE"] + '&pView=Index&pController=MMPACKCODE&pController=MMPACKCODE&pHeader= ' + urlparam + '">View</a>';
                                }
                                return data;
                            }

                        }],
                        select: {
                            style: 'multi',
                            info: false,
                            selector: 'td:nth-child(1)'
                        },
                    "ajax": {
                        //ajax request data using ajax
                        //url: MM_ExampleAJAX_Client is controller and RequestDataAJAX is function name
                        //dataType: request data format json
                        //"dataSrc": "records" your data object name. records is taking from viewmodel name.
                        //"dataSrc" : main function to grab data and move to datatable
                        "url": "../MM_ExampleAJAX_Client/RequestDataAJAX",
                        "dataType": "json",
                        type:'POST',
                        data: {

                            'model': {
                                "PackCode": $('#select-id option:selected').val(),
                                'PackDesc': $("#txt-pack-desc").val(),
                                'Status': countStatus,
                                'MachineNo': $("#txt-machine-no").val(),
                                'createdDate': $("#txt-created-date").val()
                            },
                            'isSearch': true
                        },
                        "dataSrc": "Records",
                    },
                    drawCallback: function () {
                        //use this if you want to hide loading after fitler server side
                        //$("#loading").hide();
                        var api = this.api();
                        $("#txtGoTo").val(api.page() + 1);
                    },
                    preDrawCallback: function (settings) {
                        //use this if you want to call loading before fitler server side
                        // loadings();
                    },
                    dom: "<'row toolbar-row g-0 custom-toolbar'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6'<'d-flex justify-content-end'<'toolbar'>>>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end'p<'go-to align-self-center mx-2'>>>>",
                    initComplete: function () {
                        //create custom filter textbox base on column
                        var api = this.api();
                        $("#loading").hide();
                        $("div.toolbar").html('<div class="input-group input-group-sm">' +
                            '<input type="text" id="searchBox" class="form-control remove-right-border" style="border-top-right-radius: 0px !important; border-bottom-right-radius: 0px !important;"  placeholder="Search" aria-label="Search" aria-describedby="btnAdvanceSearch">' +
                            '<div class="input-group-text listing-search-icon">' +
                            '    <a href="" class="text-reset" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i></a>' +
                            '</div>' +
                            '</div>');
                        // For each column
                        api
                            .columns()
                            .eq(0)
                            .each(function (colIdx) {
                                // Set the header cell to contain the input element
                                var cell = $('.filters th ').eq(
                                    $(api.column(colIdx).header()).index()
                                );
                                var title = $(cell).text();

                                //colIdx 0 is # column we dont want to filter
                                if (colIdx == 0) {
                                    $(cell).html('');
                                } else if (colIdx == 1) {
                                    $(cell).html('<input type="text" class="form-control" placeholder="Pack Code" />');
                                } else if (colIdx == 2) {
                                    $(cell).html('<input type="text" class="form-control" placeholder="Pack Description" />');
                                } else if (colIdx == 3) {
                                    $(cell).html('<input type="text" class="form-control" placeholder="Machine No" />');
                                } else if (colIdx == 4) {
                                    $(cell).html('<input type="text" class="form-control" placeholder="Status" />');
                                }

                                // On every keypress in this input
                                $(
                                    'input',
                                    $('.filters th').eq($(api.column(colIdx).header()).index())
                                )
                                    .off('keyup change')
                                    .on('change', function (e) {
                                        // Get the search value
                                        $(this).attr('title', $(this).val());
                                        var regexr = '({search})'; //$(this).parents('th').find('select').val();

                                        var cursorPosition = this.selectionStart;
                                        // Search the column for that value
                                        api
                                            .column(colIdx)
                                            .search(
                                                this.value != ''
                                                    ? regexr.replace('{search}', '(((' + this.value + ')))')
                                                    : '',
                                                this.value != '',
                                                this.value == ''
                                            )
                                            .draw();
                                    })
                                    .on('keyup', function (e) {
                                        e.stopPropagation();

                                        $(this).trigger('change');
                                        $(this)
                                            .focus()[0]
                                            .setSelectionRange(cursorPosition, cursorPosition);
                                    });
                                var totalPages = api.page.info().pages;
                                updateGoToInfo(totalPages);

                            });
                    },
                    order: [[1, 'asc']]
                });
        });

        $('#btnReset').on('click', function () {
            $(':input').val('');

            $('#mul-select-id1').multiselect('rebuild');
            $('#mul-select-id2').multiselect('rebuild');
            $('#select-id2').multiselect('rebuild');
            $('#select-id3').multiselect('rebuild');
        });

        $('.tr-select').on('change', function (e) {
            if (e.target.value == "All") {
                data = dataAll;
            } else {
                data = dataAll.filter(x => x.Status.toString() == e.target.value);
            }
            $('.tr-rec').text(data.length);
            table.clear().rows.add(data).draw();
        });
    });


    function setRandomValue() {
        data = dataAll;
        $('.tr-rec').text(data.length);
    }

    window.onload = setRandomValue;


    function getColumnConfig() {

        var dynamicColumns = [];
        var val = data[0];
        var columnJsonArrs = new Array();

        var x = 0;
        for (var j in val) {
            columnJsonArrs[x] = j;
            x++
        }

        columnJsonArrs.forEach(function (columnJsonArr, index) {
            var columnConfig = {
                data: columnJsonArr
            };
            dynamicColumns.push(columnConfig);
        });
        return dynamicColumns;
    }

    function loadDataTable() {

        table = $('#tr-datatable').DataTable({
            data: data,
            scrollCollapse: true,
            scrollY: calcDataTableHeight,
            pagingType: 'simple_numbers',
            columns: getColumnConfig(),
            columnDefs: [
                {
                    targets: 0,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = '<div class="checkbox"><input type="checkbox" class="dt-checkboxes form-check-input"><label></label></div>';
                        }

                        return data;
                    },
                    checkboxes: {
                        selectRow: true,
                        selectAllPages: false,
                        selectAllRender: '<div class="checkbox"><input type="checkbox" id="checkboxAll" class="dt-checkboxes form-check-input"><label></label></div>'
                    },
                    orderable: false, // Disable sorting for this column
                },
                {
                    targets: 3,
                    render: function (data, type, row, meta) {
                        return '<a href="@Url.Action("MM_User_View", "MM_User")?id=' + row.USER_ID + '" class="name tr-icon-size" id="' + row.USER_ID + '"><i class="fa-solid fa-eye"></i></a>';
                    },
                    orderable: false,
                }
            ],
            select: {
                style: 'multi',
                info: false,
                selector: 'td:nth-child(1)'
            },
            order: [[1, 'asc']],
            dom: "<'row toolbar-row g-0 custom-toolbar'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end '<'toolbar'>>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end mt-2'p<'go-to align-self-center mx-2'>>>>",
            initComplete: function () {
                $("div.toolbar").html('<div class="input-group">' +
                    '<input type="text" id="txtSearch" class="form-control remove-right-border tr-search-txt tr-list-txtbx-border" style="border-top-right-radius: 0px !important; border-bottom-right-radius: 0px !important;" placeholder="Search" aria-label="Search" aria-describedby="btnAdvanceSearch">' +
                    '<div class="input-group-text listing-search-icon tr-list-txtbx-border tr-input-grp-right">' +
                    '<a href="" class="text-reset d-flex align-items-center justify-content-end text-decoration-none" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i></a>' +
                    '</div>' +
                    '</div>');

                @*$("#btnAuditTrail").on("click", function () {
                    var url = '@Url.Action("AuditTrail", "Home")';
                    window.location.href = url;
                });*@

                $("#btnSearch").on("click", function (e) {
                    e.preventDefault();
                });

                $("#txtSearch").on("keyup", function (e) {
                    table.search($('#txtSearch').val()).draw();
                });

                $('#btnConfirm2').on('click', function () {
                    var selectedValues = [];
                    var selectedRows = table.rows({ selected: true }).data().toArray();
                    selectedRows.forEach(function (rowData) {
                        var checkboxValue = rowData["USER_ID"];
                        selectedValues.push(checkboxValue);
                    });

                    $.ajax({
                        url: '/MM_User/MM_User_DeleteListing',
                        type: 'POST',
                        data: { deleteID: selectedValues },
                        success: function (response) {
                            if (response.isSuccess == "Success") {
                                Swal.fire({
                                    title: "Success",
                                    text: "Successfully Deleted.",
                                    icon: "success",
                                    showCancelButton: false,
                                    confirmButtonText: "OK"
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // User pressed "OK", redirect to another view
                                        window.location.href = "/MM_User/MM_User";
                                    }
                                });
                            } else {
                                Swal.fire('Failed!', 'Failed Delete.', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.fire('Error!', error, 'error');
                        }
                    });
                });
            },
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            },
            fixedHeader: {
                header: true,
                footer: false
            }
        });

        $("div.go-to").html('<div class="d-flex align-items-center p-0"><input class="form-control" type="text" id="txtGoTo" style="width:75px" value=1> &nbsp; <div class="page-info">of ' + table.page.info().pages + '</div></div>');
        $("#txtGoTo").on('keyup', function (e) {
            try {
                var page = e.target.value;
                if ($.isNumeric(page) && page > 0 && page <= table.page.info().pages) {
                    table.page(page - 1).draw('page');
                } else if (e.target.value.trim() == '') {

                }
                else {
                    e.target.value = table.page() + 1;
                }

            } catch (ex) {
                e.target.value = 1;
            }
        });
        $("#txtGoTo").on('blur', function (e) {
            try {
                var page = e.target.value;
                if (page.trim() == '') {
                    $("#txtGoTo").val(1);
                    table.page(0).draw('page');
                    $("#txtGoTo").focus();
                }
            } catch (ex) {
                e.target.value = 1;
            }
        });
        $(".dataTables_length .form-select").on('change', function () {
            $("#txtGoTo").val(table.page() + 1);
            $("div.page-info").html('of ' + table.page.info().pages + '</div>');
        });

        table.on('select deselect', function (e, dt, type, indexes) {
            var rowCnt = table.rows({ selected: true }).count();
            // do something with the number of selected rows
            if (rowCnt > 0) {
                $(".tr-trash").removeClass('isHide');
                $("#btnExport").prop('disabled', false);
            } else {
                $(".tr-trash").addClass('isHide');
                $("#btnExport").prop('disabled', true);
            }
        });

        addTableButtons();
    }

    function calcDataTableHeight() {
        var winWidth = $(window).width();
        if (winWidth >= 1280 && winWidth <= 1599) {
            return $(window).height() * 43 / 100;
        } else {
            return $(window).height() * 50 / 100;
        }
    };

    function addTableButtons() {
        new $.fn.dataTable.Buttons(table, {
            name: "add",
            buttons: [
                {
                    text: '<i class="fa-solid fa-plus text-primary"></i>&nbsp;&nbsp; Add User',
                    className: 'btn-sm btn-outline-secondary mt-1',
                    init: function (api, node, config) {
                        $(node).attr("id", "btnAdd");
                        $(node).removeClass('btn-secondary');
                    },
                    action: function (e, dt, node, config) {
                        // Add new action here
                        var url = '@Url.Action("MM_User_Create", "MM_User")';
                        window.location.href = url;
                    }
                }
            ]
        });


        new $.fn.dataTable.Buttons(table, {
            name: "delete",
            buttons: [
                {
                    text: '<i class="fa-solid fa-trash-can tr-icon-size tr-icon-del"></i>',
                    className: 'tr-btn m-0 py-0 px-3 text-danger tr-trash isHide',
                    init: function (api, node, config) {
                        $(node).attr("id", "btnDelete");
                        $(node).attr("data-bs-toggle", "modal");
                        $(node).attr("data-bs-target", "#confirmation-modal");
                        $(node).removeClass('btn btn-secondary');
                    },
                    action: function (e, dt, node, config) {
                        // Delete action here
                        //$("div.spanner").addClass("show");
                        //$("div.overlay").addClass("show");

                        //setTimeout(function () {
                        //    $("div.spanner").removeClass("show");
                        //    $("div.overlay").removeClass("show");
                        //}, 2500);
                    }
                }
            ]
        });

        new $.fn.dataTable.Buttons(table, {
            name: "audit",
            buttons: [
                {
                    text: 'Audit Trail',
                    className: 'm-0 p-0 tr-btn',
                    attr: {
                        id: 'btnAuditTrail'
                    },
                    init: function (api, node, config) {
                        $(node).removeClass('btn btn-secondary')
                    },
                    action: function (e, dt, node, config) {
                        var selectedValues = [];
                        var selectedRows = table.rows({ selected: true }).data().toArray();
                        selectedRows.forEach(function (rowData) {
                            var checkboxValue = rowData;
                            selectedValues.push(checkboxValue);
                        });

                        if (selectedValues.length >= 2) {
                            const toastLiveExample = document.getElementById('liveToast1');
                            const toast = new bootstrap.Toast(toastLiveExample);
                            toast.show();
                            return;
                        } else if (selectedValues.length == 0) {
                            const toastLiveExample = document.getElementById('liveToast2');
                            const toast = new bootstrap.Toast(toastLiveExample);
                            toast.show();
                            return;
                        }else {
                            selectedValues.forEach(function (element) {
                                var url = '@Url.Action("MM_User_AuditTrail", "MM_User")';
                                window.location.href = url + '?id=' + element.USER_ID;
                            });
                        }

                    }
                }
            ]
        });

        table.buttons("add", null).containers().appendTo('#customDTButton');
        table.buttons("audit, delete", null).containers().appendTo('#action-bar');
    }
    </script>
}


