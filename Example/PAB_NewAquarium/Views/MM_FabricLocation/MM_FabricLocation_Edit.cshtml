@model PAB_NewAquarium.Models.FabricLocationDetail
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var UrlActionView = Url.Action("MM_FabricLocation_View", "MM_FabricLocation", new { id = Model.LOC_CODE });
    var LOC_CODE = Model.LOC_CODE_ID;
}

@using (Html.BeginForm("MM_FabricLocation_Edit", "MM_FabricLocation", FormMethod.Post, new { id = "FabricLocationForm" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.LOC_CODE_ID)
    @Html.HiddenFor(model => model.LOC_CODE)
    <div class="row g-0 px-3 tr-listing-header">
        <div class="col-sm-6 align-self-center">
            <p class="text-muted m-0 tr-listing-header-title">Location</p>
        </div>
        <div class="col-sm-6 text-end align-self-center">
            <div class="d-flex justify-content-end">
                <div id="customDTButton">
                </div>
            </div>
        </div>
    </div>
    <div class="tr-btm-line"></div>
    <div class="page-container px-3 overflow-auto">
        <div class="tr-btm-btn-margin">
            <div class="card mt-3 mb-2 card-height">
                <div class="card-body">
                    <div class="row align-items-baseline">
                        <div class="col"><h6 class="text-muted card-title">Edit Location</h6></div>
                    </div>
                    <hr />
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Location Code <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBox("LOC_CODE", LOC_CODE, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Description <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.LOC_DESC, null, new { @class = "form-control form-valid" })
                            @Html.ValidationMessageFor(model => model.LOC_DESC, null, new { @class = "text-danger validate-text" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Location Type <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.DropDownListFor(m => m.LOC_TYPE, Model.LocationTypeDdl, "Please select an option...", new { @class = "tr-select2 form-valid" })
                            @Html.ValidationMessageFor(model => model.LOC_TYPE, null, new { @class = "text-danger validate-text" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col"></div>
                <div class="col">
                    <div class="row row-cols-auto justify-content-end isEditable g-1" style="padding-right: 20px">
                        <div class="col"><button id="btnBack" type="button" class="btn btn-sm btn-secondary" onclick="location.href='@UrlActionView'">Back</button></div>
                        <div class="col"><button id="btnSubmit" type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalSubmit">Submit</button></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal dialog -->
    <div class="modal fade" id="modalSubmit" tabindex="-1" aria-hidden="true">
        @Html.Partial("_Modal_Submit")
    </div>
}

<!-- Common JavaScript -->
<script src="~/ViewsHelpers/CommonComponent/MultiSelect.js"></script>

<script>
    var returnMessage = "@ViewBag.Result";
    var url = "@UrlActionView";

    $(document).ready(function () {
        toastMessage();

        $('#btnSubmitConfirm').click(function () {
            $('#modalSubmit').modal('hide');
        });
    });

    function toastMessage() {
        if (returnMessage != null && returnMessage != "" && returnMessage != "Duplicated Location Code") {
            showAlert('Success', 'Record editted successfully.', url);
        }
        else if (returnMessage == "Duplicated Location Code") {
            showAlert('Error', 'Failed to edit, Duplicated Location Code.');
        }
    }
</script>
