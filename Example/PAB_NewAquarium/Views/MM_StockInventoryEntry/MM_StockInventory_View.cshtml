@model PAB_NewAquarium.Models.MM_STOCK_INVENTORY

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var UrlActionStockIn = Url.Action("MM_StockInventoryEntry", "MM_StockInventoryEntry", new { stock = "In" });
    var UrlActionStockOut = Url.Action("MM_StockInventoryEntry", "MM_StockInventoryEntry", new { stock = "Out" });
    var UrlActionGetChopNo = Url.Action("MM_StockInventory_GetInventoryDtl", "MM_StockInventoryEntry");
}

<style>
    .nav-tabs {
        --bs-nav-tabs-border-width: 0px;
    }

    .tr-tab .nav-link {
        min-width: 250px;
        text-align: left;
        background-color: #F0F0F0 !important;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

        .tr-tab .nav-link:not(:first-child) {
            margin-left: 5px;
        }

    .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
        box-shadow: inset 0 0px 0 transparent !important;
    }

    .tr-tab .nav-link.active {
        color: #54575A !important;
        background-color: #EBF3FF !important;
        font-weight: bold;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .nav-tabs .nav-link {
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        border-width: 0px !important;
    }

    .tr-select2 + .btn-group > .multiselect-container input[type="text"] {
        visibility: visible;
    }

    .multiselect-container.dropdown-menu {
        max-height: 250px;
        overflow: auto;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.STOCK_TYPE)
    <div class="row g-0 px-3 tr-listing-header">
        <div class="col-sm-6 align-self-center">
            <p class="text-muted m-0 tr-listing-header-title">Stock In / Out Inventory</p>
        </div>
    </div>
    <div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
    <div class="page-container px-3 overflow-auto">
        <div class="tr-btm-btn-margin mt-3">
            <nav class="tr-tab">
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                    <button class="nav-link active" id="nav-page1-tab" data-bs-toggle="tab" data-bs-target="#nav-page1" type="button" role="tab" aria-selected="true">Stock In</button>
                    <button class="nav-link" id="nav-page2-tab" data-bs-toggle="tab" data-bs-target="#nav-page2" type="button" role="tab" aria-selected="false">Stock Out</button>
                    <div style="flex: 1">
                        <div class="row" style="margin-top: -5px;">
                            <div class="text-end">
                                <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="background-color: #CCE5F9; border: 0px;">
                                    <i class="fa-solid fa-ellipsis-vertical" style="color: #54575A"></i>
                                </a>
                                <ul class="tr-ddm dropdown-menu">
                                    <li><a class="dropdown-item" href="@UrlActionStockIn">Stock In Listing</a></li>
                                    <li><a class="dropdown-item" href="@UrlActionStockOut">Stock Out Listing</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
            <div class="tab-content p-2" id="nav-tabContent" style="border: 4px solid #EBF3FF;">
                <div class="tab-pane fade show active" id="nav-page1" role="tabpanel" tabindex="0">
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Reference No <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4 required-field hidden">
                            @Html.DropDownListFor(model => model.REFERENCE_NO, ViewBag.REFERENCE_NO_DDL as List<SelectListItem>, "Please Select", new { @class = "form-control tr-select2 required-input" })
                            @Html.ValidationMessageFor(model => model.REFERENCE_NO, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-sm-4 hidden-field"><input class="form-control grayed-out" /></div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Colorway <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4 required-field hidden">
                            @Html.DropDownListFor(model => model.COLOR_WAY, Enumerable.Empty<SelectListItem>(), "Please Select", new { @class = "form-control tr-select2 required-input" })
                            @Html.ValidationMessageFor(model => model.COLOR_WAY, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-sm-4 hidden-field"><input class="form-control grayed-out" /></div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Location <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4 required-field hidden">
                            @Html.DropDownListFor(model => model.STORE_LOC, ViewBag.STORE_LOC_DDL as List<SelectListItem>, "Please Select", new { @class = "form-control tr-select2 required-input" })
                            @Html.ValidationMessageFor(model => model.STORE_LOC, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-sm-4 hidden-field"><input class="form-control grayed-out" /></div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">RFID <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.RFID_STOCK_IN, new { @class = "form-control form-valid grayed-out", value = "" })
                            @Html.ValidationMessageFor(model => model.RFID_STOCK_IN, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row d-flex align-items-center">
                        <div class="col">
                            <p class="text-muted m-0"><b>Table List</b></p>
                        </div>
                        <div class="col text-end">
                            <button type="button" id="btnRemoveStockIn" class="btn btn-sm btn-danger hidden mx-1">Remove</button>
                            <button type="button" id="btnAddStockIn" class="btn btn-sm btn-primary">Add</button>
                        </div>
                    </div>
                    <table id="tr-datatable1" class="table table-hover table-bordered">
                        <thead>
                            <tr style="background-color: #FCFCFC">
                                <th style="width:1%"><input id="chkAllStockIn" class="hidden" type="checkbox" style="padding:10px 10px 5px 10px" /></th>
                                <th>Reference No</th>
                                <th>Chop No</th>
                                <th>Colorway</th>
                                <th>Location</th>
                                <th>RFID Tag</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="tab-pane fade" id="nav-page2" role="tabpanel" tabindex="0">
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">RFID <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.RFID_STOCK_OUT, new { @class = "form-control form-valid grayed-out", value = "" })
                            @Html.ValidationMessageFor(model => model.RFID_STOCK_OUT, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row d-flex align-items-center">
                        <div class="col">
                            <p class="text-muted m-0"><b>Table List</b></p>
                        </div>
                        <div class="col text-end">
                            <button type="button" id="btnRemoveStockOut" class="btn btn-sm btn-danger hidden mx-1">Remove</button>
                            <button type="button" id="btnAddStockOut" class="btn btn-sm btn-primary">Add</button>
                        </div>
                    </div>
                    <table id="tr-datatable2" class="table table-hover table-bordered">
                        <thead>
                            <tr style="background-color: #FCFCFC">
                                <th style="width:1%"><input id="chkAllStockOut" class="hidden" type="checkbox" style="padding:10px 10px 5px 10px" /></th>
                                <th>Reference No</th>
                                <th>Chop No</th>
                                <th>Colorway</th>
                                <th>Location</th>
                                <th>RFID Tag</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col text-end me-3">
                    <button id="btnBack" type="button" class="btn btn-sm btn-secondary mx-1" onclick="location.href='@UrlActionStockIn'">Back</button>
                    <button id="btnSubmit" type="button" class="btn btn-sm btn-primary mx-1" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="submit-confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to submit this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnStockInConfirm">Confirm</button>
                    <button type="submit" class="btn btn-sm btn-primary hidden" id="btnStockOutConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed toast-success">
        <div id="successToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto" style="color: #00A251">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Submit Successfully.
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed toast-alert">
        <div id="errorToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
            <div class="toast-header" style="background-color: #FFF0EE">
                <strong class="me-auto text-danger">Warning!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">

            </div>
        </div>
    </div>
    <div class="toast-container position-fixed toast-success">
        <div id="infoToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000" style="border: 1px solid #057FE5">
            <div class="toast-header" style="background-color: #EBF3FF">
                <strong class="me-auto">Information</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #EBF3FF; border-top: 1px solid #EBF3FF; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">

            </div>
        </div>
    </div>
}

<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
<script src="~/signalr/hubs"></script>
<script>
    var hub = $.connection.signalRHub;
    var urlActionList = "@UrlActionStockIn";
    var urlActionGetChopNo = "@UrlActionGetChopNo";
    var stockType = "@Model.STOCK_TYPE";
    var stockInData = @Html.Raw(Json.Encode(Model.STOCK_IN_LISTING));
    var returnMessage = "@ViewBag.ReturnMessage";
    var chopNo = "";
    var rfidInList = [], rfidOutList = [];

    $(document).ready(function () {
        $('.form-control').val("");
        $('div.spanner').addClass("show");
        $('div.overlay').addClass("show");
        setTimeout(function () {
            $('.tr-select2').multiselect({
                buttonClass: 'form-select form-control text-start',
                enableCaseInsensitiveFiltering: true,
                enableFiltering: true,
                templates: {
                    button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                    filter: '<div class="multiselect-filter" style="position:sticky; top:0; background-color:white"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input id="REFERENCE_NO_FILTER" class="form-control multiselect-search" type="text" /></div></div>',
                },
            });
            $('.multiselect-native-select > .btn-group').addClass("w-100");
            $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
            $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");
            $('div.spanner').removeClass("show");
            $('div.overlay').removeClass("show");
            $.connection.hub.start().done(function () {
                hub.server.displayConnectionID();
            });
        }, 0);

        tabNavigation();
        toastMessage(returnMessage, "");

        $('#tr-datatable1, #tr-datatable2').DataTable({
            paging: false,
            ordering: false,
            info: false,
            filter: false,
        });

        $('#REFERENCE_NO').on('change', function () {
            var referenceNo = $('#REFERENCE_NO').val();
            var colorWayDDL = $('#COLOR_WAY');
            colorWayDDL.empty();
            colorWayDDL.append($('<option/>', {
                value: '',
                text: 'Please Select'
            }));

            $.ajax({
                type: "post",
                url: urlActionGetChopNo,
                data: {
                    referenceNo: referenceNo,
                },
                datatype: "json",
                traditional: true,
                success: function (data) {
                    chopNo = data.CHOP_NO;
                    for (var i = 0; i < data.COLOR_WAY_DDL.length; i++) {
                        colorWayDDL.append($('<option/>', {
                            value: data.COLOR_WAY_DDL[i].Value,
                            text: data.COLOR_WAY_DDL[i].Text
                        }));
                    }
                    colorWayDDL.multiselect('rebuild');
                },
            });
        });

        $('.form-control.tr-select2').on('change', function () {
            if ($(this).val().trim() === "") {
                $(this).siblings('.btn-group').children('button').addClass('dropdown-is-invalid');
                $(this).parent().siblings('span.text-danger').text("This field is required.").show();
            } else {
                $(this).siblings('.btn-group').children('button').removeClass('dropdown-is-invalid');
                $(this).parent().siblings('span.text-danger').text("This field is required.").hide();
            }
        });

        $('.form-valid').on('blur change keyup', function () {
            if ($(this).val().trim() === "") {
                $(this).addClass('is-invalid');
                $(this).siblings('.text-danger').text("This field is required.").show();
            }
            else {
                $(this).removeClass('is-invalid');
                $(this).siblings('.text-danger').text("").hide();
            }
        })

        $('#nav-tab').on('click', function () {
            var table1 = $('#tr-datatable1').DataTable();
            var table2 = $('#tr-datatable2').DataTable();
            var tab = $('#nav-tab button.active').text();
            if (tab == "Stock In") {
                $('#btnStockInConfirm').removeClass('hidden');
                $('#btnStockOutConfirm').addClass('hidden');
                table1.columns.adjust().draw();
            }
            else if (tab == "Stock Out") {
                $('#btnStockInConfirm').addClass('hidden');
                $('#btnStockOutConfirm').removeClass('hidden');
                table2.columns.adjust().draw();
            }
        });

        $('#btnStockInConfirm').on('click', function () {
            var rowCount = 0;
            $('#STOCK_TYPE').val("In");
            $('#submit-confirmation-modal').modal('hide');
            $('#tr-datatable1 tbody tr').each(function () {
                var row = $(this);
                if (row.find('input[type="hidden"]').length > 0) {
                    rowCount++;
                }
            });
            if (rowCount == 0) {
                $('.form-control.tr-select2').each(function () {
                    if ($(this).val().trim() === "") {
                        $(this).siblings('.btn-group').children('button').addClass('dropdown-is-invalid');
                        $(this).parent().siblings('span.text-danger').text("This field is required.").show();
                    } else {
                        $(this).siblings('.btn-group').children('button').removeClass('dropdown-is-invalid');
                        $(this).parent().siblings('span.text-danger').text("This field is required.").hide();
                    }
                });
                return false;
            }
            else {
                hub.server.disconnectRFID();
            }
        });

        $('#btnStockOutConfirm').on('click', function () {
            var rowCount = 0;
            $('#STOCK_TYPE').val("Out");
            $('#submit-confirmation-modal').modal('hide');
            $('#tr-datatable2 tbody tr').each(function () {
                var row = $(this);
                if (row.find('input[type="hidden"]').length > 0) {
                    rowCount++;                   
                }
            });
            console.log(rowCount);
            if (rowCount == 0) {
                const toastIDError = document.getElementById('errorToast');
                const toastError = new bootstrap.Toast(toastIDError);
                $('#errorToast .toast-body').html("There is nothing to stock out.");
                toastError.show();
                return false;
            }
            else {
                hub.server.disconnectRFID();
            }
        });

        $('#btnAddStockIn').on('click', function () {
            var table = $('#tr-datatable1').DataTable();
            var checkBox = '<input class="checkbox" type="checkbox" style="padding:10px 10px 5px 10px" />'
            var referenceNo = $('#REFERENCE_NO').val();
            var colorWay = $('#COLOR_WAY').val();
            var storeLoc = $('#STORE_LOC').val();
            var rfid = $('#RFID_STOCK_IN').val();
            var hiddenValue1 = '<input type="hidden" name="LIST_REFERENCE_NO" value="' + referenceNo + '" />'
            var hiddenValue2 = '<input type="hidden" name="LIST_CHOP_NO" value="' + chopNo + '" />'
            var hiddenValue3 = '<input type="hidden" name="LIST_COLOR_WAY" value="' + colorWay + '" />'
            var hiddenValue4 = '<input type="hidden" name="LIST_STORE_LOC" value="' + storeLoc + '" />'
            var hiddenValue5 = '<input type="hidden" name="LIST_RFID" value="' + rfid + '" />'

            if (referenceNo == "" || colorWay == "" || location == "") {
                $('.form-control.tr-select2').each(function () {
                    if ($(this).val().trim() === "") {
                        $(this).siblings('.btn-group').children('button').addClass('dropdown-is-invalid');
                        $(this).parent().siblings('span.text-danger').text("This field is required.").show();
                    } else {
                        $(this).siblings('.btn-group').children('button').removeClass('dropdown-is-invalid');
                        $(this).parent().siblings('span.text-danger').text("This field is required.").hide();
                    }
                });
                if (rfid == "")
                {
                    $('#RFID_STOCK_IN').addClass('is-invalid');
                    $('#RFID_STOCK_IN').siblings('.text-danger').text("This field is required.").show();
                }
                return false;
            }

            $('#tr-datatable1 tbody tr').each(function () {
                var row = $(this);
                var rfidColumn = row.find('td:eq(5)').text();
                if (rfidColumn == rfid) {
                    return false;
                }
                else {
                    table.row.add([
                        checkBox,
                        referenceNo + hiddenValue1,
                        chopNo + hiddenValue2,
                        colorWay + hiddenValue3,
                        storeLoc + hiddenValue4,
                        rfid + hiddenValue5
                    ]).draw(false);

                    $('#chkAllStockIn').removeClass('hidden');
                }
            });
        });

        $('#btnAddStockOut').on('click', function () {
            var table = $('#tr-datatable2').DataTable();

            $('#tr-datatable2 tbody tr').each(function () {
                var row = $(this);
                var rfidColumn = row.find('td:eq(5)').text();
                if (rfidColumn == rfid) {
                    return false;
                }
                else {
                    for (var i = 0; i < stockInData.length; i++) {
                        if (stockInData[i].RFID == rfid) {
                            var checkBox = '<input class="checkbox" type="checkbox" style="padding:10px 10px 5px 10px" />'
                            var referenceNo = stockInData[i].REFERENCE_NO;
                            var chopNo = stockInData[i].CHOP_NO;
                            var colorWay = stockInData[i].COLOR_WAY;
                            var storeLoc = stockInData[i].STORE_LOC;
                            var rfid = stockInData[i].RFID;
                            var hiddenValue1 = '<input type="hidden" name="LIST_REFERENCE_NO" value="' + referenceNo + '" />'
                            var hiddenValue2 = '<input type="hidden" name="LIST_CHOP_NO" value="' + chopNo + '" />'
                            var hiddenValue3 = '<input type="hidden" name="LIST_COLOR_WAY" value="' + colorWay + '" />'
                            var hiddenValue4 = '<input type="hidden" name="LIST_STORE_LOC" value="' + storeLoc + '" />'
                            var hiddenValue5 = '<input type="hidden" name="LIST_RFID" value="' + rfid + '" />'

                            table.row.add([
                                checkBox,
                                referenceNo + hiddenValue1,
                                chopNo + hiddenValue2,
                                colorWay + hiddenValue3,
                                storeLoc + hiddenValue4,
                                rfid + hiddenValue5
                            ]).draw(false);
                        }
                    }
                }
            });

            $('#chkAll').removeClass('hidden');
        });

        $('#btnRemoveStockIn').on('click', function () {
            var table = $('#tr-datatable1').DataTable();
            var rowCount = 0;

            $('#tr-datatable1 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');

                if (checkbox.prop('checked')) {
                    table.row(this).remove().draw(false);
                }
            });

            $('#tr-datatable1 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');
                if (checkbox.length > 0) {
                    rowCount++;
                }
            });

            if (rowCount > 0) {
                $('#btnRemoveStockIn').removeClass('hidden');
                $('#chkAllStockIn').removeClass('hidden');
            } else {
                $('#btnRemoveStockIn').addClass('hidden');
                $('#chkAllStockIn').prop('checked', false);
                $('#chkAllStockIn').addClass('hidden');
            }
        });

        $('#btnRemoveStockOut').on('click', function () {
            var table = $('#tr-datatable2').DataTable();
            var rowCount = 0;

            $('#tr-datatable2 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');

                if (checkbox.prop('checked')) {
                    table.row(this).remove().draw(false);
                }
            });

            $('#tr-datatable2 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');
                if (checkbox.length > 0) {
                    rowCount++;
                }
            });

            if (rowCount > 0) {
                $('#btnRemoveStockOut').removeClass('hidden');
                $('#chkAllStockOut').removeClass('hidden');
            } else {
                $('#btnRemoveStockOut').addClass('hidden');
                $('#chkAllStockOut').prop('checked', false);
                $('#chkAllStockOut').addClass('hidden');
            }
        });

        $('#chkAllStockIn').on('click', function () {
            var checkbox = $(this);
            if (checkbox.prop('checked')) {
                $('.checkBoxStockIn').prop('checked', true);
                $('#btnRemoveStockIn').removeClass('hidden');
            }
            else {
                $('.checkBoxStockIn').prop('checked', false);
                $('#btnRemoveStockIn').addClass('hidden');
            }
        });

        $('#chkAllStockOut').on('click', function () {
            var checkbox = $(this);
            if (checkbox.prop('checked')) {
                $('.checkBoxStockOut').prop('checked', true);
                $('#btnRemoveStockOut').removeClass('hidden');
            }
            else {
                $('.checkBoxStockOut').prop('checked', false);
                $('#btnRemoveStockOut').addClass('hidden');
            }
        });

        $(document).on('click', '.checkBoxStockIn', function () {
            var tableRowCount = $('#tr-datatable1 tbody tr').length;
            var rowCount = 0;

            $('#tr-datatable1 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');

                if (checkbox.prop('checked')) {
                    rowCount++;
                }
            });

            if (rowCount > 0) {
                $('#btnRemoveStockIn').removeClass('hidden');
                $('#chkAllStockIn').removeClass('hidden');
                if (rowCount == tableRowCount) {
                    $('#chkAllStockIn').prop('checked', true);
                } else {
                    $('#chkAllStockIn').prop('checked', false);
                }
            } else {
                $('#btnRemoveStockIn').addClass('hidden');
                $('#chkAllStockIn').prop('checked', false);
            }
        });

        $(document).on('click', '.checkBoxStockOut', function () {
            var tableRowCount = $('#tr-datatable2 tbody tr').length;
            var rowCount = 0;

            $('#tr-datatable2 tbody tr').each(function () {
                var row = $(this);
                var checkbox = row.find('input[type="checkbox"]');

                if (checkbox.prop('checked')) {
                    rowCount++;
                }
            });

            if (rowCount > 0) {
                $('#btnRemoveStockOut').removeClass('hidden');
                $('#chkAllStockOut').removeClass('hidden');
                if (rowCount == tableRowCount) {
                    $('#chkAllStockOut').prop('checked', true);
                } else {
                    $('#chkAllStockOut').prop('checked', false);
                }
            } else {
                $('#btnRemoveStockOut').addClass('hidden');
                $('#chkAllStockOut').prop('checked', false);
            }
        });

        hub.client.receiveParameter = function (tag) {
            var tab = $('#nav-tab button.active').text();
            if (tab == "Stock In") {
                var referenceNo = $('#REFERENCE_NO').val();
                var colorWay = $('#COLOR_WAY').val();
                var storeLoc = $('#STORE_LOC').val();
                if (referenceNo == "" || colorWay == "" || storeLoc == "") {
                    return false;
                }
                else {
                    if (!rfidInList.includes(tag)) {
                        rfidInList.push(tag);
                        processStockIn(tag);
                    }
                }
            }
            else if (tab == "Stock Out") {
                if (!rfidOutList.includes(tag)) {
                    rfidOutList.push(tag);
                    processStockOut(tag)
                }
            }
        };

        hub.client.receiveConnectionID = function (connectionID) {
            console.log("Connected to SignalR Hub");
            console.log("Connection ID: " + connectionID);
            if (connectionID != "") {
                if (returnMessage == "") {
                    hub.server.connectRFID();
                }
            }
            else {
                toastMessage("Error", "RFID reader is disconnected.");
            }
        };

        hub.client.receiveClientMessage = function (message) {
            if (returnMessage == "") {
                toastMessage("Info", message);
            }
        };

        window.addEventListener("beforeunload", function () {
            hub.server.disconnectRFID();
        });
    });

    function tabNavigation() {
        if (stockType == "In") {
            $('#nav-page1-tab').click();
            $('#btnStockInConfirm').removeClass('hidden');
            $('#btnStockOutConfirm').addClass('hidden');
        }
        else {
            $('#nav-page2-tab').click();
            $('#btnStockInConfirm').addClass('hidden');
            $('#btnStockOutConfirm').removeClass('hidden');
        }
    }

    function processStockIn(tag) {
        $('#RFID_STOCK_IN').val(tag);
        var table = $('#tr-datatable1').DataTable();
        var checkBox = '<input class="checkBoxStockIn" type="checkbox" style="padding:10px 10px 5px 10px" />'
        var referenceNo = $('#REFERENCE_NO').val();
        var colorWay = $('#COLOR_WAY').val();
        var storeLoc = $('#STORE_LOC').val();
        var rfid = $('#RFID_STOCK_IN').val();
        var hiddenValue1 = '<input type="hidden" name="LIST_REFERENCE_NO" value="' + referenceNo + '" />'
        var hiddenValue2 = '<input type="hidden" name="LIST_CHOP_NO" value="' + chopNo + '" />'
        var hiddenValue3 = '<input type="hidden" name="LIST_COLOR_WAY" value="' + colorWay + '" />'
        var hiddenValue4 = '<input type="hidden" name="LIST_STORE_LOC" value="' + storeLoc + '" />'
        var hiddenValue5 = '<input type="hidden" name="LIST_RFID" value="' + rfid + '" />'

        if (referenceNo == "" || colorWay == "" || storeLoc == "") {
            return false;
        }

        table.row.add([
            checkBox,
            referenceNo + hiddenValue1,
            chopNo + hiddenValue2,
            colorWay + hiddenValue3,
            storeLoc + hiddenValue4,
            rfid + hiddenValue5
        ]).draw(false);

        $('#chkAllStockIn').removeClass('hidden');
    }

    function processStockOut(tag) {
        var table = $('#tr-datatable2').DataTable();
        for (var i = 0; i < stockInData.length; i++) {
            if (stockInData[i].RFID == tag) {
                $('#RFID_STOCK_OUT').val(tag);
                var checkBox = '<input class="checkBoxStockOut" type="checkbox" style="padding:10px 10px 5px 10px" />'
                var referenceNo = stockInData[i].REFERENCE_NO;
                var chopNo = stockInData[i].CHOP_NO;
                var colorWay = stockInData[i].COLOR_WAY;
                var storeLoc = stockInData[i].STORE_LOC;
                var rfid = stockInData[i].RFID;
                var hiddenValue1 = '<input type="hidden" name="STOCK_OUT_ID" value="' + stockInData[i].PRODUCT_I_ID + '" />'

                table.row.add([
                    checkBox,
                    referenceNo + hiddenValue1,
                    chopNo,
                    colorWay,
                    storeLoc,
                    rfid
                ]).draw(false);

                $('#chkAllStockOut').removeClass('hidden');
            }
        }
    }

    function toastMessage(status, message) {
        const toastIDSuccess = document.getElementById('successToast');
        const toastIDError = document.getElementById('errorToast');
        const toastIDInfo = document.getElementById('infoToast');
        const toastSuccess = new bootstrap.Toast(toastIDSuccess);
        const toastError = new bootstrap.Toast(toastIDError);
        const toastInfo = new bootstrap.Toast(toastIDInfo);

        if (status == "Info") {
            $('#infoToast .toast-body').html(message);
            toastSuccess.hide();
            toastError.hide();
            toastInfo.show();
            $('.required-field').removeClass('hidden');
            $('.hidden-field').addClass('hidden');
        }
        else if (status == "Error") {
            $('#errorToast .toast-body').html(message);
            toastSuccess.hide();
            toastError.show();
            toastInfo.hide();
            $('.required-field').addClass('hidden');
            $('.hidden-field').removeClass('hidden');
        }
        else if (status == "Success") {
            toastSuccess.show();
            toastError.hide();
            toastInfo.hide();
            setTimeout(function () {
                window.location.href = urlActionList;
            }, 2000);
        }
    }
</script>

