@model PAB_NewAquarium.Models.ProductCommentList
@{
    ViewBag.Title = "CustomerReviewFeedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media (min-width: 768px) {

        .product-container {
            height: 79.5vh;
        }

    }

    @@media (min-width: 1400px) {
        .product-container {
            height: 82.5vh;
        }

    }

    .bold {
        font-weight: bold;
    }

    .commentSuggest {
        border-radius: 100px;
        border: 1px solid #54575A;
        height: 40px;
        padding-left: 20px;
        padding-right: 20px;
        margin-right: 10px;
        color: #54575A;
        background-color: #EBF3FE;
    }

    .commentSuggestSelect {
        border-radius: 100px;
        border: 2px solid #004098 !important;
        height: 40px;
        padding-left: 20px;
        padding-right: 20px;
        margin-right: 10px;
        color: #004098 !important;
        font-weight: bold !important;
        background-color: #EBF3FE;
    }

    .commentDiv {
        background-color: #F0F0F0;
        padding: 20px;
        height: 150px;
        border-radius: 10px;
    }

    .fontBlack {
        color: black;
    }

    .table > :not(caption) > * > * {
        border-bottom-width: 0px;
    }

    .backBtn{
        cursor: pointer;
    }

    .hiddenDate{
        display: none;
    }
</style>

@using (Html.BeginForm("ProductDetail", "ProductDetail", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
    <div class="product-container mx-3 my-3 overflow-auto">
        <div class="row">
            <div class="col"><h5 class="text-muted card-title"><span class="fas fa-chevron-left dark-blue me-sm-3 backBtn"></span>Customer Review & Feedback:</h5></div><br /><br />
            <div>
                <button type="button" class="commentSuggest allSelection commentSuggestSelect">All</button>
                @for (int i = 0; i < ViewBag.CommentSuggestion.Count; i++)
                {
                    <button type="button" class="commentSuggest">@ViewBag.CommentSuggestion[i]</button>
                }
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="p-3">
                <table class="table">
                    <thead class="d-none">
                        <tr>
                            <th class="w-50"></th>
                            <th class="w-50"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ProductListComment.Count; i = i + 2)
                        {
                            <tr>
                                <td class="w-50">
                                    <div class="commentDiv">
                                        <div class="hiddenDate">@Model.ProductListComment[i].CREATED_DATE</div>
                                        <span>@Model.ProductListComment[i].CUSTOMER_NAME</span><br />
                                        <span>Variation: @Model.ProductListComment[i].COLOR_WAY</span><br />
                                        <p class="fontBlack pt-lg-2">@Model.ProductListComment[i].FEEDBACK_DESC</p>
                                    </div>
                                </td>
                                <td class="w-50">
                                    @if (i + 1 < Model.ProductListComment.Count)
                                    {
                                        <div class="commentDiv">
                                            <div class="hiddenDate">@Model.ProductListComment[i].CREATED_DATE</div>
                                            <span>@Model.ProductListComment[i + 1].CUSTOMER_NAME</span><br />
                                            <span>Variation: @Model.ProductListComment[i + 1].COLOR_WAY</span><br />
                                            <p class="fontBlack pt-lg-2">@Model.ProductListComment[i + 1].FEEDBACK_DESC</p>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}



<script>
    var table;
    var commentSuggestArr = [];
    var allComments = @Html.Raw(ViewBag.AllComments);
    var filterData = allComments;

    $(document).ready(function () {
        $('div.spanner').addClass("show");
        $('div.overlay').addClass("show");
        setTimeout(function () {
            $('div.spanner').removeClass("show");
            $('div.overlay').removeClass("show");
            commentSuggestArr.push("All");

            $(".backBtn").on('click', function () {
                var url = '@Url.Action("ProductDetail", "ProductDetail")?id=' + @ViewBag.ProductHID + '&groupDID=0';
                window.location.href = url;
            });

            filterTable();

            $(".commentSuggest").on('click', function () {
                var array = [];
                if ($(this).hasClass("commentSuggestSelect")) {
                    $(this).removeClass("commentSuggestSelect");
                    var itemIndex = commentSuggestArr.indexOf($(this).text());
                    if (itemIndex !== -1) {
                        commentSuggestArr.splice(itemIndex, 1);
                    }
                    if (commentSuggestArr.length == 0 || $(this).hasClass("allSelection")) {
                        $(".allSelection").addClass("commentSuggestSelect");
                        commentSuggestArr.push("All");
                        array = allComments;
                    }
                }
                else {
                    if ($(this).hasClass("allSelection") == false) {
                        $(".allSelection").removeClass("commentSuggestSelect");
                        if(commentSuggestArr.includes("All"))
                            commentSuggestArr.splice(commentSuggestArr.indexOf("All"), 1);
                    }
                    else {
                        $(".commentSuggest").removeClass("commentSuggestSelect");
                        commentSuggestArr.splice(0);
                        array = allComments;
                    }
                    $("#rvSuggestedComment").addClass("hidden");
                    $(this).addClass("commentSuggestSelect");
                    commentSuggestArr.push($(this).text());
                }
                if (commentSuggestArr.includes("All") == false || commentSuggestArr.length == 0) {
                    for (var i = 0; i < allComments.length; i++) {
                        var isValid = false;
                        $.each(commentSuggestArr, function (index, value) {
                            if (allComments[i].KEYWORD_STR.includes(value)) {
                                isValid = true;
                            }
                        });

                        if (isValid == true) {
                            if (!array.includes(allComments[i])) {
                                array.push(allComments[i]);
                            }
                        }
                    }
                }
                
                filterData = array;
                filterTable();
            });
            var tableCount = ($('.table').find('td').length) / 2;

            $("div.go-to").html('<div class="d-flex align-items-center p-0"><input class="form-control" type="text" id="txtGoTo" style="width:75px" value=1> &nbsp; <div class="page-info">of ' + table.page.info().pages + '</div></div>');
            $("#txtGoTo").on('keyup', function (e) {
                try {
                    var page = e.target.value;
                    if ($.isNumeric(page) && page > 0 && page <= table.page.info().pages) {
                        table.page(page - 1).draw('page');
                    } else if (e.target.value.trim() == '') {

                    }
                    else {
                        e.target.value = table.page() + 1;
                    }

                } catch (ex) {
                    e.target.value = 1;
                }
            });
            $("#txtGoTo").on('blur', function (e) {
                try {
                    var page = e.target.value;
                    if (page.trim() == '') {
                        $("#txtGoTo").val(1);
                        table.page(0).draw('page');
                        $("#txtGoTo").focus();
                    }
                } catch (ex) {
                    e.target.value = 1;
                }
            });
            $(".dataTables_length .form-select").on('change', function () {
                $("#txtGoTo").val(table.page() + 1);
                $("div.page-info").html('of ' + table.page.info().pages + '</div>');
            });

        }, 100);
    });

    function filterTable() {
        var html = '';
        
        table = $('.table').DataTable();
        table.destroy();
        var count = 0;
        for (var i = 0; i < filterData.length; i++) {
            html += '<tr>';
            html += '<td class="w-50"><div class="commentDiv">';
            html += '<div class="hiddenDate">' + filterData[i].CREATED_DATE + '</div>';
            html += '<span>' + filterData[i].CUSTOMER_NAME + '</span><br />';
            html += '<span>Variation: ' + filterData[i].COLOR_WAY + '</span><br />';
            html += '<p class="fontBlack pt-lg-2">' + filterData[i].FEEDBACK_DESC + '</p><br />';
            html += '</div></td>';
            
            if (i < filterData.length - 1) {
                i++;
                count++;
                html += '<td class="w-50"><div class="commentDiv">';
                html += '<div class="hiddenDate">' + filterData[i].CREATED_DATE + '</div>';
                html += '<span>' + filterData[i].CUSTOMER_NAME + '</span><br />';
                html += '<span>Variation: ' + filterData[i].COLOR_WAY + '</span><br />';
                html += '<p class="fontBlack pt-lg-2">' + filterData[i].FEEDBACK_DESC + '</p><br />';
                html += '</div></td>';
            }
            else {
                html += '<td></td>';
            }
            html += '</tr>';
        }
        $('tbody').html(html);
        table = $('.table').DataTable({
            order: [[0, 'desc']],
            pageLength: 6,
            dom: "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end mt-2'p<'go-to align-self-center mx-2'>>>>",
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            },
            fixedHeader: {
                header: true,
                footer: false
            },
            "fnInfoCallback": function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {
                return "Showing " + (filterData.length == 0 ? 0 : (iStart == 1 ? 1 : iStart * 2 - 1)) + " to " + (iEnd * 2 < filterData.length ? iEnd * 2 : filterData.length) + " of " + (filterData.length) + " entries";
            },
            language: {
                emptyTable: "No review & feedback found"
            }
        });

        $("div.go-to").html('<div class="d-flex align-items-center p-0"><input class="form-control" type="text" id="txtGoTo" style="width:75px" value=1> &nbsp; <div class="page-info">of ' + table.page.info().pages + '</div></div>');
        $("#txtGoTo").on('keyup', function (e) {
            try {
                var page = e.target.value;
                if ($.isNumeric(page) && page > 0 && page <= table.page.info().pages) {
                    table.page(page - 1).draw('page');
                } else if (e.target.value.trim() == '') {

                }
                else {
                    e.target.value = table.page() + 1;
                }

            } catch (ex) {
                e.target.value = 1;
            }
        });
        $("#txtGoTo").on('blur', function (e) {
            try {
                var page = e.target.value;
                if (page.trim() == '') {
                    $("#txtGoTo").val(1);
                    table.page(0).draw('page');
                    $("#txtGoTo").focus();
                }
            } catch (ex) {
                e.target.value = 1;
            }
        });
        $(".dataTables_length .form-select").on('change', function () {
            $("#txtGoTo").val(table.page() + 1);
            $("div.page-info").html('of ' + table.page.info().pages + '</div>');
        });
    }
</script>
