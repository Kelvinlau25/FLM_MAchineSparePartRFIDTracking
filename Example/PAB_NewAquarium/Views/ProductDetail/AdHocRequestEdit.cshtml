@model PAB_NewAquarium.Models.AddHocRequestModel
@using PAB_NewAquarium.Helpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var session = Session["AclUser"] as ACL_UserObj;
}

<style>
    .card-height {
        height: calc(100vh - 300px);
    }

    @@media only screen and (max-device-width: 1919px) {
        .card-height {
            height: calc(100vh - 250px);
        }
    }

    .readonly {
        background-color: #F0F0F0;
    }

        .readonly:focus {
            background-color: #F0F0F0;
        }

    .btnDatepicker {
        cursor: pointer;
    }
</style>

<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">Ad Hoc Request</p>
    </div>
</div>
<div class="tr-btm-line"></div>
<div class="page-container px-3">
    <div class="tr-btm-btn-margin">
        <form method="post">
            @Html.HiddenFor(model => model.SAMPLE_REQUEST_NO)
            <div class="card mt-3 mb-2 card-height">
                <div class="card-body">
                    <div class="row header-row">
                        <div class="col"><h6 class="text-muted card-title m-0">@Model.SAMPLE_REQUEST_NO</h6></div>
                    </div>
                    <hr />
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Attention To <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.ATTN_TO, new { @class = "form-control form-valid", maxlength = "40", required = "required" })
                            @Html.ValidationMessageFor(model => model.ATTN_TO, null, new { @class = "text-danger validate-text" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Priority <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.PRIORITY, "High", new { @class = "me-1" }) High
                            </label>
                            <label>
                                @Html.RadioButtonFor(model => model.PRIORITY, "Low", new { @class = "me-1" }) Low
                            </label>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Remark<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextAreaFor(model => model.REMARK, new { @class = "form-control", rows = "4", cols = "50" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Completed<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.COMPLETED, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                    </div>
                    <hr />
                    <h6 class="text-muted card-title m-0">Customer Details</h6>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Customer Code <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.CUST_CODE, new { @class = "form-control form-valid readonly", @readonly = "readonly" })
                                <button type="button" class="btn btn-primary btn-modal-search d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#modalCustomerDetailsList">
                                    <i class="fa fa-ellipsis-h"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(model => model.CUST_CODE, null, new { @class = "text-danger validate-text" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Customer Name<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CUST_NAME, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Telephone No <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.PHONE_NO, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Address 1<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CUST_ADDR_1, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Address 2<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CUST_ADDR_2, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Address 3<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CUST_ADDR_3, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Address 4<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CUST_ADDR_4, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                    </div>
                    <hr />
                    <h6 class="text-muted card-title m-0">Sample Request List</h6>
                    <table class="detailTable w-100 mt-2">
                        <thead>
                            <tr class="toolbar-row">
                                <th>Po No</th>
                                <th>Color Way</th>
                                <th>Sample Roll No</th>
                                <th>Location</th>
                                <th>Balance Yardage</th>
                                <th>UOM</th>
                                <th>Quantity Request <span class="text-danger">*</span></th>
                                <th>Quantity Sent</th>
                                <th>Chop No</th>
                                <th>Composition</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Details.Count; i++)
                            {
                                <tr>
                                    <td>@Html.TextBoxFor(model => model.Details[i].PO_NO, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].COLOR_DESC, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].SAMPLE_ROLL_NO, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].LOCATION, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].BALANCE_YARDAGE, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].UOM, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>
                                        @Html.TextBoxFor(model => model.Details[i].QUANTITY_REQUEST, new { @class = "form-control", type = "number", min = "1", max = Model.Details[i].BALANCE_YARDAGE, required = "required" })
                                        @Html.ValidationMessageFor(model => model.Details[i].QUANTITY_REQUEST, null, new { @class = "text-danger validate-text" })
                                    </td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].QUANTITY_SENT, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].CHOP_NO, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                    <td>@Html.TextBoxFor(model => model.Details[i].COMPOSITION, new { @class = "form-control readonly", @readonly = "readonly" })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                    <h6 class="text-muted card-title m-0">Dispatch Details</h6>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Sent By <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.SENT_BY, new { @class = "form-control readonly", @readonly = "readonly" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Date Sent <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.DATE_SENT, new { @class = "form-control tr-date", @readonly = "readonly" })
                                <div class="btnDatepicker input-group-text bg-transparent border-start-0">
                                    <i class="fa-solid fa-calendar-days tr-icon-blue" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Charge <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-10">
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE, "No Charge", new { @class = "me-1" }) No Charge
                            </label>
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE, "Charge Fabric", new { @class = "me-1" }) Charge Fabric
                            </label>
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE, "Charge Freight", new { @class = "me-1" }) Charge Freight
                            </label>
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE, "Fabric / Freight", new { @class = "me-1" }) Fabric / Freight
                            </label>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline section-charge-by @(Model.CHARGE == "No Charge" ? "hidden" : "")">
                        <div class="col-sm-2">
                            <p class="text-muted">Charge By <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-10">
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE_BY, "Sales Debit Note", new { @class = "me-1" }) Sales Debit Note
                            </label>
                            <label class="me-3">
                                @Html.RadioButtonFor(model => model.CHARGE_BY, "Sample Room Invoice", new { @class = "me-1" }) Sample Room Invoice
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col">
                    <button id="btnCancel" type="button" class="btn btn-sm btn-danger mx-1" onclick="TriggerAction('Cancel')" data-bs-toggle="modal" data-bs-target="#modalSubmit">Cancel Request</button>
                </div>
                <div class="col text-end me-3">
                    <button id="btnBack" type="button" class="btn btn-sm btn-secondary mx-1" onclick="history.back()">Back</button>
                    <button id="btnSubmit" type="button" class="btn btn-sm btn-primary mx-1" onclick="TriggerAction('Update')" data-bs-toggle="modal" data-bs-target="#modalSubmit">Submit</button>
                </div>
            </div>

            <!-- Modal Dialog -->
            <div class="modal fade" id="modalSubmit">
                @Html.Partial("_Modal_Submit")
            </div>
        </form>
    </div>
</div>

<!-- Customer Table Selection -->
<div class="modal fade" id="modalCustomerDetailsList" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="text-muted m-2 tr-listing-header-title">Customers List</h5>
            </div>
            <hr />
            <div class="modal-body" id="modal-body">
                <div class="table-search"></div>
                <table id="customer-table" class="table table-hover table-bordered compact w-100 mt-0">
                    <thead>
                        <tr class="bg-datatable-tr">
                            <th>Customer Code</th>
                            <th>Customer Name</th>
                            <th>Address 1</th>
                            <th>Address 2</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Back</button>
            </div>
        </div>
    </div>
</div>

<script>
    var table, btnAction;

    $(function () {

        PageOnload(); // Initialize the page

        // Change event for CHARGE radio buttons
        $('input[name="CHARGE"]').on('change', function () {
            var charge = $(this).val();
            var chargeBy = $('input[name="CHARGE_BY"]:checked').val();
            var sectionChargeBy = $('.section-charge-by');

            // If "No Charge" is selected, hide CHARGE_BY section
            if (charge == "No Charge") {
                $('.section-charge-by').addClass('hidden');
            }
            else {
                // If no CHARGE_BY is selected, default to first option
                if (chargeBy === undefined) {
                    $('input[name="CHARGE_BY"]').first().prop('checked', true);
                }
                // If hidden, show the CHARGE_BY section and scroll to bottom
                if (sectionChargeBy.hasClass('hidden')) {
                    sectionChargeBy.removeClass('hidden');
                    $('.card').animate({
                        scrollTop: $('.card')[0].scrollHeight
                    }, 200);
                }
            }
        });

        // Initialize date picker for DATE_SENT
        $('#DATE_SENT').datetimepicker({
            timepicker: false,
            format: 'd/m/Y',
            minDate: 0 // Disable past dates
        });

        // Trigger datepicker when button is clicked
        $('.btnDatepicker').on('click', function (e) {
            $('#DATE_SENT').focus();
        });

        // Submit confirmation modal button click
        $('#btnSubmitConfirm').click(function (event) {
            event.preventDefault();
            loadings(false); // Hide any loading indicators
            $('#modalSubmit').modal('hide'); // Close modal

            if (btnAction == "Update") {
                // Show loading and submit form
                ShowLoading(true, "Submitting Request...", "Please wait while your request is being processed");
                $('form').submit();
            }
            else {
                // Show loading and perform AJAX to cancel request
                ShowLoading(true, "Canceling Request...", "Please wait while your request is being processed");

                $.ajax({
                    url: "/ProductDetail/AdHocRequestCancel",
                    type: "POST",
                    data: { requestNo: "@Model.SAMPLE_REQUEST_NO" },
                    dataType: "json",
                    traditional: true,
                    success: function (response) {
                        if (response.success) {
                            showAlert("Success", "Your request has been successfully canceled", "/Account/RequestHistory");
                        }
                        else {
                            showAlert("Error", "We encountered an issue while canceling your request");
                        }
                    }
                });
            }
        });
    });

    // Run on initial page load
    function PageOnload() {
        ShowSwalMessage();
        GetCustomerList();      
    }

    // Show SweetAlert message based on ViewBag
    function ShowSwalMessage() {
        var message = "@ViewBag.RETURN_MESSAGE";

        if (message == "") {
            ShowLoading(true, "Loading...", "Please wait while the data is loaded");
        }
        else {
            showAlert("Success", "Your request has been successfully editted", "/Account/RequestHistory");
        }
    }

    // Set button action and update modal message
    function TriggerAction(action) {
        btnAction = action;

        if (action == "Update") {
            $('#modalSubmit .modal-body h6').html("Are you sure to submit this record?");
        } else {
            $('#modalSubmit .modal-body h6').html("Are you sure to cancel this record?");
        }
    }

    // Fill customer details into input fields based on customer code
    function AppendCustomerData() {
        var custCode = $('#CUST_CODE').val();

        table.rows().every(function (rowIdx, tableLoop, rowLoop) {
            let data = this.data();

            if (data.CUST_CODE == custCode) {
                $('#CUST_NAME').val(data.CUST_NAME);
                $('#CUST_ADDR_1').val(data.CUST_ADD1);
                $('#CUST_ADDR_2').val(data.CUST_ADD2);
                $('#CUST_ADDR_3').val(data.CUST_ADD3);
                $('#CUST_ADDR_4').val(data.CUST_ADD4);

                return false; // Stop loop
            }
        });
    }

    // Load customer list using AJAX
    function GetCustomerList() {
        var custCode = $('#CUST_CODE').val();

        $.ajax({
            url: "/ProductDetail/GetCustomersListAsync",
            type: "POST",
            dataType: "json",
            traditional: true,
            success: function (data) {
                InitCustomerTable(data); // Populate DataTable
                AppendCustomerData(); // Auto-fill form fields
            },
            complete: function () {
                ShowLoading(false); // Hide loading spinner
            }
        });
    }

    // Initialize customer DataTable
    function InitCustomerTable(data) {
        table = $('#customer-table').DataTable({
            data: data,
            pagingType: 'simple_numbers',
            columns: [
                { data: 'CUST_CODE' },
                { data: 'CUST_NAME' },
                { data: 'CUST_ADD1' },
                { data: 'CUST_ADD2' },
                { data: 'STATUS' }
            ],
            dom: "<'row toolbar-pop-row g-0'<'col-sm-12 col-md-12'<'toolbar-pop pb-2'>>>" +
                "<'row toolbar-row g-0'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6'<'d-flex justify-content-end'>>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-12 col-md-4'i><'col-sm-12 col-md-8'<'d-flex justify-content-end'p<'go-to align-self-center mx-2'>>>>",// +
            initComplete: function () {
                $("div.toolbar-pop").html('<div class="input-group input-group-sm">' +
                    '<input type="text" id="txtSearch" class="form-control remove-right-border" placeholder="Search" aria-label="Search" aria-describedby="btnAdvanceSearch">' +
                    '<div class="input-group-text listing-search-icon">' +
                    '    <a href="" class="text-reset" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i></a>' +
                    '</div>' +
                    '</div>');

                $("#btnSearch").on("click", function (e) {
                    e.preventDefault();
                });

                $("#txtSearch").on("keyup", function (e) {
                    table.search($('#txtSearch').val()).draw();
                });
            },
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            }
        });

        $("div.go-to").html('<div class="d-flex align-items-center p-0"><input class="form-control" type="text" id="txtGoTo" style="width:75px" value=1> &nbsp; <div class="page-info">of ' + table.page.info().pages + '</div></div>');
        $("#txtGoTo").on('keyup', function (e) {
            try {
                var page = e.target.value;
                if ($.isNumeric(page) && page > 0 && page <= table.page.info().pages) {
                    table.page(page - 1).draw('page');
                } else if (e.target.value.trim() == '') {

                }
                else {
                    e.target.value = table.page() + 1;
                }

            } catch (ex) {
                e.target.value = 1;
            }
        });
        $("#txtGoTo").on('blur', function (e) {
            try {
                var page = e.target.value;
                if (page.trim() == '') {
                    $("#txtGoTo").val(1);
                    table.page(0).draw('page');
                    $("#txtGoTo").focus();
                }
            } catch (ex) {
                e.target.value = 1;
            }
        });
        $(".dataTables_length .form-select").on('change', function () {
            $("#txtGoTo").val(table.page() + 1);
            $("div.page-info").html('of ' + table.page.info().pages + '</div>');
        });
        $('#customer-table tbody').on('dblclick', 'tr', function () {
            var data = table.row(this).data();
            $('#CUST_CODE').val(data.CUST_CODE);
            $('#CUST_NAME').val(data.CUST_NAME);
            $('#CUST_ADDR_1').val(data.CUST_ADD1);
            $('#CUST_ADDR_2').val(data.CUST_ADD2);
            $('#CUST_ADDR_3').val(data.CUST_ADD3);
            $('#CUST_ADDR_4').val(data.CUST_ADD4);
            $('#modalCustomerDetailsList').modal('hide');
        });
    }
</script>