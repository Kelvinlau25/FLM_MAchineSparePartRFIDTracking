                            html += '</td>';
                            html += '<td>';
                            html += `<input type="text" value="${data.sampleRolls[i].COMPOSITION}" class="txtComposition form-control grayed-out">`;
                            html += `<input type="text" value="${data.sampleRolls[i].FINISH_TYPE1}" class="txtFinishType1 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].FINISH_TYPE2}" class="txtFinishType2 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].FINISH_TYPE3}" class="txtFinishType3 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].FINISH_TYPE4}" class="txtFinishType4 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WARP_DENSITY}" class="txtWarpDensity hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WARP_DENSITY2}" class="txtWarpDensity2 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WEFT_DENSITY}" class="txtWeftDensity hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WEFT_DENSITY2}" class="txtWeftDensity2 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WARP_COUNT}" class="txtWarpCount hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WARP_COUNT2}" class="txtWarpCount2 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WARP_COUNT3}" class="txtWarpCount3 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WEFT_COUNT}" class="txtWeftCount hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WEFT_COUNT2}" class="txtWeftCount2 hidden">`;
                            html += `<input type="text" value="${data.sampleRolls[i].WEFT_COUNT3}" class="txtWeftCount3 hidden">`;
                            html += '</td>';
                            html += '</tr>';

                            if (calRequestQty > data.sampleRolls[i].BALANCE_YARDAGE) {
                                calRequestQty = calRequestQty - data.sampleRolls[i].BALANCE_YARDAGE;
                            }
                            else {
                                calRequestQty = 0;
                            }
                        }

                        $('#tbody').append(html);

