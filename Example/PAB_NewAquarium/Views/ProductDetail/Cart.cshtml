@model PAB_NewAquarium.Models.AddToCartModel
@{
    var count = 0;
    Layout = ViewBag.ID == "" ? "~/Views/Shared/_Layout.cshtml" : "~/Views/Shared/_Layout_Customer.cshtml";
}

<style>
    body {
        background-color: #EBEBEB;
    }

    .page-container {
        overflow-x: hidden;
        overflow-y: hidden;
        max-height: calc(100vh - 100px);
    }

    .cart-item-container {
        overflow-x: hidden;
        overflow-y: auto;
        height: calc(100vh - 130px);
    }

    .cart-summary-container {
        overflow-x: hidden;
        overflow-y: auto;
    }

    .cart-item {
        background-color: #FFFFFF;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    .cart-summary {
        background-color: #FFFFFF;
        border-radius: 5px;
        margin-left: 10px;
    }

    .cart-item-image {
        height: 150px;
        width: 150px;
        border-radius: 0.5rem;
    }

    .btnCartItem {
        background-color: #FFFFFF;
        border: 2px solid #EBEBEB;
    }

    .divider-line {
        border-bottom: 2px solid #EBEBEB;
    }

    .toast-success {
        right: 0px !important;
    }

    input[type="checkbox"] {
        cursor: pointer;
    }

        input[type="checkbox"]:disabled {
            cursor: not-allowed;
        }

    button[type="button"]:disabled {
        cursor: pointer;
    }

    button[type="button"]:disabled i {
        opacity: 0.3;
    }

    .modal-dialog-adhoc{
        max-width: 80%;
    }

    .sampleRequestListDiv {
        width: 100%;
        overflow-x: auto;
        white-space: nowrap;
    }

    .sampleRequestList thead th, .sampleRequestList tbody td {
        text-transform: none;
        padding: 5px 10px;
    }

    .fa-info-circle {
        --fa-beat-scale: 1.5;
    }

    @@media only screen and (min-device-width: 1280px) and (max-device-width: 1599px) {
        .cart-item-container {
            overflow-x: hidden;
            overflow-y: auto;
            height: calc(100vh - 90px);
        }
    }
</style>

<body>
    <div class="page-container">
        <div class="p-2">
            <div class="cart-item-container float-start w-75 pb-5">
                <div class="cart">
                    @for (int i = 0; i < Model.GROUP_CART.Count; i++)
                    {
                        count++;
                        <div id="cartParentID_@count">
                            <div class="cart-item">
                                <div class="row px-3 py-2">
                                    <div class="col">
                                        <input id="checkboxID_@count" type="checkbox" class="me-2" index="@count" data-cart-id="@Model.GROUP_CART[i].ITEM[0].CART_H_ID" />
                                        <text>@Model.GROUP_CART[i].COMPANY_NAME</text>
                                    </div>
                                    <div class="col d-flex justify-content-end">
                                        <a id="trashID_@count" class="hidden" href="#" index="@count" data-bs-toggle="modal" data-bs-target="#confirmation-modal"><i class="fa-solid fa-trash-can red"></i></a>
                                    </div>
                                </div>
                                <div class="divider-line"></div>
                                @for (int j = 0; j < Model.GROUP_CART[i].ITEM.Count; j++)
                                {
                                    <div id="cartChildID_@Model.GROUP_CART[i].ITEM[j].CART_D_ID">
                                        <div class="row">
                                            <div class="col">
                                                <div class="row row-cols-auto px-3 py-2 w-60 float-start @(Model.GROUP_CART[i].ITEM[j].CURRENT_QTY == 0? "opacity-50" : "")">
                                                    <div class="col">
                                                        <input type="checkbox" class="checkboxID_@count me-2 @(Model.GROUP_CART[i].ITEM[j].CURRENT_QTY == 0? "invisible" : "")" index="@count" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID" data-cart-id="@Model.GROUP_CART[i].ITEM[j].CART_H_ID" />
                                                        <img class="cart-item-image" src="@Model.GROUP_CART[i].ITEM[j].IMAGE_URL" />
                                                    </div>
                                                    <div class="col">
                                                        <div class="row"><text>@Model.GROUP_CART[i].ITEM[j].CATEGORY_NAME</text></div>
                                                        <div class="row"><text>Chop No: @Model.GROUP_CART[i].ITEM[j].CHOP_NO</text></div>
                                                        <div class="mt-3"></div>
                                                        <div class="row"><text>Variation: @Model.GROUP_CART[i].ITEM[j].COLOR_WAY</text></div>
                                                        <div class="row"><text>Reference No: @Model.GROUP_CART[i].ITEM[j].REFERENCE_NO</text></div>
                                                    </div>
                                                </div>
                                                <div class="px-3 py-2 w-40 float-end d-flex justify-content-end align-items-center">
                                                    @if (Model.GROUP_CART[i].ITEM[j].CURRENT_QTY == 0)
                                                    {
                                                        <!-- If available quantity is 0 -->
                                                        <a id="btnDelete" href="#" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID"><i class="fa-solid fa-trash-can red"></i></a>
                                                    }
                                                    else if (Model.GROUP_CART[i].ITEM[j].QUANTITY == 1)
                                                    {
                                                        <!-- If cart quantity is 1 -->
                                                        <button type="button" class="btnCartItem" action="minus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID" disabled><i class="fa-solid fa-minus dark-blue"></i></button>
                                                        <div class="mx-3"><text class="fw-bold" id="quantityID_@Model.GROUP_CART[i].ITEM[j].CART_D_ID">@Model.GROUP_CART[i].ITEM[j].QUANTITY</text></div>
                                                        <button type="button" class="btnCartItem" action="plus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID"><i class="fa-solid fa-plus dark-blue"></i></button>
                                                    }
                                                    else if (Model.GROUP_CART[i].ITEM[j].CURRENT_QTY <= Model.GROUP_CART[i].ITEM[j].QUANTITY)
                                                    {
                                                        <!-- If available quantity less than cart quantity -->
                                                        <button type="button" class="btnCartItem" action="minus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID"><i class="fa-solid fa-minus dark-blue"></i></button>
                                                        <div class="mx-3"><text class="fw-bold" id="quantityID_@Model.GROUP_CART[i].ITEM[j].CART_D_ID">@Model.GROUP_CART[i].ITEM[j].QUANTITY</text></div>
                                                        <button type="button" class="btnCartItem" action="plus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID" disabled><i class="fa-solid fa-plus dark-blue"></i></button>
                                                    }
                                                    else
                                                    {
                                                        <!-- Normal flow  -->
                                                        <button type="button" class="btnCartItem" action="minus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID"><i class="fa-solid fa-minus dark-blue"></i></button>
                                                        <div class="mx-3"><text class="fw-bold" id="quantityID_@Model.GROUP_CART[i].ITEM[j].CART_D_ID">@Model.GROUP_CART[i].ITEM[j].QUANTITY</text></div>
                                                        <button type="button" class="btnCartItem" action="plus" cartID="@Model.GROUP_CART[i].ITEM[j].CART_D_ID"><i class="fa-solid fa-plus dark-blue"></i></button>
                                                    }
                                                </div>
                                                <div class="pb-2"></div>
                                                @if (Model.GROUP_CART[i].ITEM[j].CURRENT_QTY == 0)
                                                {
                                                    <div class="px-3 w-40 float-end d-flex justify-content-end">
                                                        <div><span class="fa fa-info-circle fa-beat red mx-2"></span><text class="red">This product is not available.</text></div>
                                                    </div>
                                                }
                                                <div class="px-3 w-40 float-end d-flex justify-content-end">
                                                    <div><text id="currentQtyID_@Model.GROUP_CART[i].ITEM[j].CART_D_ID">Available: @Model.GROUP_CART[i].ITEM[j].CURRENT_QTY</text></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="cart-summary-container float-end w-25">
                <div class="cart-summary">
                    <p class="text-muted tr-listing-header-title p-2 m-0"><b>Sample Request Summary</b></p>
                    <div class="summary-section">
                        <div class="row px-2 pb-2">
                            <div class="col"><text>Total</text></div>
                            <div class="col d-flex justify-content-end"><text class="dark-blue fw-bold">0</text></div>
                        </div>
                    </div>
                    <div class="proceed-section p-2 hidden">
                        <button id="btnProceed" class="btn btn-primary w-100">PROCEED</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Add Hoc modal dialog -->
    <div class="modal fade" id="adhoc-modal">
        <div class="modal-dialog modal-dialog-centered modal-dialog-adhoc">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adhoc Request</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Attention To <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBox("txtAttentionTo", null, new { @class = "form-control form-valid", @placeholder = "Please Insert Customer Name..." })
                            @Html.ValidationMessage("txtAttentionTo", null, new { @class = "text-danger validate-text", id = "rvtxtAttentionTo" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Priority <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-check form-check-inline">
                                @Html.RadioButton("Priority", "1", new { @class = "form-check-input Pradio" })
                                <label class="form-check-label" for="inlineRadio1">High</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButton("Priority", "0", new { @class = "form-check-input Pradio", @checked = "checked" })
                                <label class="form-check-label" for="inlineRadio1">Low</label>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Remark <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextArea("txtRemark", null, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-6">

                            </div>
                        </div>
                        <hr />
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-12">
                                <p class="text-muted fw-bold">Customer Details </p>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Customer Code <span class="text-danger">*</span><span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                <div class="input-group">
                                    @Html.TextBox("txtCustomerCode", null, new { @class = "form-control grayed-out" })
                                    <a href="" class="text-reset vm input-group-text tr-input-group tr-disabled text-decoration-none">
                                        <i class="fa-solid fa-ellipsis white" aria-hidden="true"></i>
                                    </a>
                                </div>
                                @Html.ValidationMessage("txtCustomerCode", null, new { @class = "text-danger validate-text", id = "rvtxtCustomerCode" })
                            </div>
                            <div class="col-sm-6">

                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Customer Name <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtCustomerName", null, new { @class = "form-control grayed-out" })
                            </div>
                            <div class="col-sm-6">

                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Telephone No <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtTelephoneNo", null, new { @class = "form-control grayed-out" })
                            </div>
                            <div class="col-sm-6">

                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Address 1 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtAddress1", null, new { @class = "form-control grayed-out" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Address 2 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtAddress2", null, new { @class = "form-control grayed-out" })
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Address 3 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtAddress3", null, new { @class = "form-control grayed-out" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Address 4 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtAddress4", null, new { @class = "form-control grayed-out" })
                            </div>
                        </div>
                        <hr />
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-12">
                                <p class="text-muted fw-bold">Sample Request List </p>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-12 sampleRequestListDiv">
                                <table id="sample-request-list" class="sampleRequestList" style="width:130%">
                                    <thead>
                                        <tr class="toolbar-row">
                                            <th style="width:10%">PO No</th>
                                            <th style="width:15%">Color Way</th>
                                            <th style="width:10%">Sample Roll No</th>
                                            <th style="width:10%">Location</th>
                                            <th style="width:10%">Balance Yardage</th>
                                            <th style="width:5%">UOM</th>
                                            <th style="width:5%">Quantity Request <span class="text-danger">*</span></th>
                                            <th style="width:5%">Quantity Sent</th>
                                            <th style="width:10%">Chop No</th>
                                            <th style="width:15%">Composition</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody"></tbody>
                                </table>
                            </div>
                        </div>
                        <hr />
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-12">
                                <p class="text-muted fw-bold">Dispatch Details </p>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Sent By <span class="text-danger">*</span><span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBox("txtSentBy", null, new { @class = "form-control grayed-out" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Date Sent <span class="text-danger">*</span><span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                <div class="input-group">
                                    <input type="text" placeholder="Please pick a date..." class="form-control tr-date" id="txtDateSent">
                                    <div class="input-group-text bg-transparent border-start-0">
                                        <a href="" class="text-reset dp" id="dp1"><i class="fa-solid fa-calendar-days tr-icon-blue" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Charge <span class="text-danger">*</span><span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-10">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeRadioOptions" id="chargeRadio1" value="No Charge" checked>
                                    <label class="form-check-label" for="chargeRadio1">No Charge</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeRadioOptions" id="chargeRadio2" value="Charge Fabric">
                                    <label class="form-check-label" for="chargeRadio2">Charge Fabric</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeRadioOptions" id="chargeRadio3" value="Charge Greight">
                                    <label class="form-check-label" for="chargeRadio3">Charge Freight</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeRadioOptions" id="chargeRadio4" value="Fabric/Freight">
                                    <label class="form-check-label" for="chargeRadio4">Fabric / Freight</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline section-charge-by hidden">
                            <div class="col-sm-2">
                                <p class="text-muted">Charge By <span class="text-danger">*</span><span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-10">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeByRadioOptions" id="chargeByRadio1" value="Sales Debit Note" checked>
                                    <label class="form-check-label" for="chargeByRadio1">Sales Debit Note</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="chargeByRadioOptions" id="chargeByRadio2" value="Sample Room Invoice">
                                    <label class="form-check-label" for="chargeByRadio2">Sample Room Invoice</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" id="btnDraftAdhoc">Save as Draft</button>
                        <button type="button" class="btn btn-sm btn-primary" id="btnSubmitAdhoc">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Customer Table Selection -->
    <div class="modal fade bd-example-modal-lg" id="modalCustomerDetailsList" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="text-muted m-2 tr-listing-header-title">Customers List</h5>
                </div>
                <hr />
                <div class="modal-body" id="modal-body">
                    <div class="table-search"></div>
                    <table id="tr-datatable2" class="table table-hover table-bordered compact w-100 mt-0">
                        <thead>
                            <tr style="background-color: #FCFCFC">
                                <th>Customer Code</th>
                                <th>Customer Name</th>
                                <th>Address 1</th>
                                <th>Address 2</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Back</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Confirmation modal dialog -->
    <div class="modal fade" id="confirmation-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnDeleteConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Toast Message -->
    <div class="toast-container position-fixed toast-success">
        <div id="successToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto" style="color: #00A251">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Request Successfully.
            </div>
        </div>
    </div>

    <script>
        var urlUpdateCart = "@Url.Action("UpdateCart", "ProductDetail")";
        var urlUpdateRequest = "@Url.Action("UpdateRequest", "ProductDetail")";
        var getCustomerDetails = "@Url.Action("GetCustomerDetailAsync", "ProductDetail")";
        var getCustomersDetailsList = "@Url.Action("GetCustomersListAsync", "ProductDetail")";
        var urlGetSampleRolls = "@Url.Action("GetSampleRollAsync", "ProductDetail")";
        var urlGetDraftData = "@Url.Action("GetDraftDataAsync", "ProductDetail")";
        var urlSaveAsDraft = "@Url.Action("SaveAsDraftAsync", "ProductDetail")";
        var cart = @Html.Raw(Json.Encode(Model.CART));
        var userName = "@ViewBag.Username";
        var cartItemDeleted = [];
        var custCode = "", cartHeaderID, table;
        var today = new Date();
        var todayDay = today.getDate();
        var todayMonth = today.getMonth() + 1;
        var processA = false, processB = false;

        $(document).ready(function () {

            loadCustomersDetailListTable();

            $(".Pradio").change(function () {
                var a = $(this).val();
                if (a == 1) {
                    $("#btnDraftAdhoc").hide()
                }
                else {
                    $("#btnDraftAdhoc").show()
                }
            })

            $('#txtSentBy').val(userName);
            $('#txtDateSent').val(((todayDay < 10) ? '0' + todayDay : todayDay) + '/' + ((todayMonth < 10) ? '0' + todayMonth : todayMonth) + '/' + today.getFullYear());
            $('#txtDateSent').datetimepicker({
                timepicker: false,
                format: 'd/m/Y',
                minDate: 0,
                onSelectDate: function () {
                    fromdate = $('#fromDate').val();
                },
            });
            $('#dp1').on('click', function (e) {
                e.preventDefault();
                $('#txtDateSent').focus();
            });

            // Parent checkbox
            $('[id^="checkboxID_"]').on('click', function () {
                var checkbox = $(this).attr('id');
                var index = $(this).attr('index');
                var indexChecked = $(this).is(':checked');
                cartHeaderID = $(this).attr('data-cart-id');

                // If parent checkbox is checked, prop all child checkbox to checked and show delete button
                if (indexChecked) {
                    $(`.${checkbox}`).prop('checked', true)
                    $(`#trashID_${index}`).removeClass('hidden');
                }
                // Else prop all child checkbox to unchecked and hide delete button
                else {
                    $(`.${checkbox}`).prop('checked', false)
                    $(`#trashID_${index}`).addClass('hidden');
                }

                checkboxControl(index, indexChecked);
                displaySummary();
            });

            // Child checkbox
            $('[class^="checkboxID_"]').on('click', function () {
                var indexID = $(this).attr('index');
                var indexChecked = $(this).is(':checked');
                cartHeaderID = $(this).attr('data-cart-id');
                var checked = '';
                var unchecked = [];

                checkboxControl(indexID, indexChecked);
                displaySummary();

                $('[class^="checkboxID_"]').each(function () {
                    // For example, if index is 1, then trashID_1 will be show, else hide it
                    var index = $(this).attr('index');
                    if ($(this).is(':checked')) {
                        $(`#trashID_${index}`).removeClass('hidden');
                        checked = index;
                    }

                    else if (checked != index) {
                        $(`#trashID_${index}`).addClass('hidden');
                        unchecked.push(index);
                    }

                    else if (checked == index) {
                        unchecked.push(index);
                    }
                });

                $('[id^="checkboxID_"]').each(function () {
                    var index = $(this).attr('index');
                    if (unchecked.includes(index)) {
                        $(`#checkboxID_${index}`).prop('checked', false);
                    }
                    else {
                        $(`#checkboxID_${index}`).prop('checked', true);
                    }
                });
            });

            // Delete button
            $('[id^="trashID_"]').on('click', function () {
                $('#btnSubmitConfirm').addClass('hidden');
                $('#btnDeleteConfirm').removeClass('hidden');
                $('#confirmation-modal .modal-body').html('<h6>Are you sure to remove these items?</h6>')
            });

            // View more button to open customer table selection modal dialog
            $('.vm').on('click', function (e) {
                e.preventDefault();
                $('#modalCustomerDetailsList').modal('show');
            });

            // Button to update cart item quantity
            $('.btnCartItem').on('click', function () {
                var action = $(this).attr('action');
                var cartID = $(this).attr('cartID');
                var cartQty = parseInt($('#txtCartCount > text').attr('count'));
                var iconSize = parseInt($('#txtCartCount').attr('size'));

                for (var i = 0; i < cart.length; i++) {
                    if (cart[i].CART_D_ID == cartID) {
                        if (action == "plus" && cart[i].CURRENT_QTY > cart[i].QUANTITY) {
                            cartQty++;
                            cart[i].QUANTITY++;
                            updateCart(cartID, "+");

                            if (cart[i].CURRENT_QTY == cart[i].QUANTITY) {
                                $(this).attr('disabled', true);
                            }
                            else if (cart[i].QUANTITY > 1) {
                                $(this).siblings(".btnCartItem").attr('disabled', false);
                            }
                        }

                        else if (action == "minus" && cart[i].QUANTITY > 1) {
                            cartQty--;
                            cart[i].QUANTITY--;
                            updateCart(cartID, "-");

                            if (cart[i].QUANTITY == 1) {
                                $(this).attr('disabled', true);
                            }
                            else if (cart[i].CURRENT_QTY > cart[i].QUANTITY) {
                                $(this).siblings(".btnCartItem").attr('disabled', false);
                            }
                        }

                        if (cartQty < 10) {
                            $('#txtCartCount > text').html(cartQty);
                        }

                        else if (cartQty >= 10 && cartQty < 100) {
                            iconSize += 2;
                            $('#txtCartCount').css({
                                'height': iconSize,
                                'width': iconSize
                            });

                            $('#txtCartCount > text').html(cartQty);
                        }
                        else if (cartQty >= 100) {
                            iconSize += 4;
                            $('#txtCartCount').css({
                                'height': iconSize,
                                'width': iconSize
                            });

                            $('#txtCartCount > text').html("99+");
                        }
                        $('#txtCartCount > text').attr('count', cartQty);
                        $(`#quantityID_${cartID}`).text(cart[i].QUANTITY);
                    }
                }

                displaySummary();
            });

            // Delete button
            $('#btnDelete').on('click', function () {
                var cartID = $(this).attr('cartID')
                $(`#cartChildID_${cartID}`).html('');
                deleteCartID(cartID, "5");
            });

            // Submit button to open ad hoc modal dialog
            $('#btnProceed').on('click', function () {
                $('#txtAttentionTo').removeClass('is-invalid');
                $('#rvtxtAttentionTo').hide();
                $('#txtCustomerCode').removeClass('is-invalid');
                $('#rvtxtCustomerCode').hide();

                var index;
                var action = "Submit";
                var cartIDList = "", requestQty = "";
                var parentChecked = false;
                var cartItemProceed = [];
                var requestQtyArr = [];

                $('[id^="checkboxID_"]').each(function () {
                    if ($(this).is(':checked')) {
                        parentChecked = true;
                        index = $(this).attr('index');
                        $('.checkboxID_' + index).each(function () {
                            var cartID = $(this).attr('cartID');
                            cartItemProceed.push(cartID);
                            requestQtyArr.push($(this).parent().parent().next().find('[id^="quantityID_"]').text());
                        });
                    }
                });

                if (!parentChecked) {
                    $('[class^="checkboxID_"]').each(function () {
                        if ($(this).is(':checked')) {
                            var cartID = $(this).attr('cartID');
                            cartItemProceed.push(cartID);
                            requestQtyArr.push($(this).parent().parent().next().find('[id^="quantityID_"]').text());
                        }
                    });
                }

                for (var i = 0; i < cartItemProceed.length; i++) {
                    if (action == "Submit") {
                        if (cartIDList == "") {
                            cartIDList += cartItemProceed[i];
                            requestQty += requestQtyArr[i];
                        }
                        else {
                            cartIDList += "," + cartItemProceed[i];
                            requestQty += "," + requestQtyArr[i];
                        }
                    }
                }

                ShowLoading(true, "Loading...", "Please wait while the data is loaded");
                getDraftData();
                getSampleRolls(cartIDList, requestQty);

                var interval = setInterval(function () {
                    if (processA && processB) {
                        clearInterval(interval);
                        ShowLoading(false);
                        $('#adhoc-modal').modal('show');
                    }
                }, 100);
                
                $('#confirmation-modal .modal-body').html('<h6>Are you sure to proceed these items?</h6>')
            });

            // Modal dialog delete button
            $('#btnDeleteConfirm').on('click', function () {
                removeCartItem("Delete");
                getAddToCart();
            });

            // Submit ad hoc button
            $('#btnSubmitAdhoc').on('click', function () {
                var txtAttentionTo = $('#txtAttentionTo').val();
                var txtCustomerCode = $('#txtCustomerCode').val();
                var isValidAttentionTo = false;
                var isValidCustomerCode = false;
                var isValidRequestQty = false;
                var totalRequestQty = 0;
                
                if (txtCustomerCode == "") {
                    $('#txtCustomerCode').addClass('is-invalid');
                    var modal = document.getElementById("adhoc-modal");
                    var textbox = document.getElementById("txtCustomerCode");
                    var textboxPosition = textbox.getBoundingClientRect().top + window.pageYOffset;
                    modal.scrollTop = textboxPosition;
                    $('#rvtxtCustomerCode').text('This field is required.').show();
                    isValidCustomerCode = false;
                }
                else {
                    $('#txtCustomerCode').removeClass('is-invalid');
                    $('#rvtxtCustomerCode').hide();
                    isValidCustomerCode = true;
                }

                if (txtAttentionTo == "") {
                    $('#txtAttentionTo').addClass('is-invalid');
                    $('#txtAttentionTo').focus();
                    $('#rvtxtAttentionTo').text('This field is required.').show();
                    isValidAttentionTo = false;
                }
                else {
                    $('#txtAttentionTo').removeClass('is-invalid');
                    $('#rvtxtAttentionTo').hide();
                    isValidAttentionTo = true;
                }

                $('#sample-request-list tbody tr').each(function (index, row) {
                    var requestQty = $(this).closest('tr').find('.txtQuantityRequest').val();
                    totalRequestQty += parseInt(requestQty);
                });

                if (totalRequestQty == 0 || isNaN(totalRequestQty)) {
                    showAlert("Error", "Total request quantity cannot be zero");
                }
                else {
                    isValidRequestQty = true;
                }

                if (isValidAttentionTo && isValidCustomerCode && isValidRequestQty) {
                    removeCartItem("Submit");
                }
            });

            // Submit Draft adhoc button
            $('#btnDraftAdhoc').on('click', function () {

                var txtAttentionTo = $('#txtAttentionTo').val();
                var txtRemark = $('#txtRemark').val();
                var txtCustomerCode = $('#txtCustomerCode').val();
                var selectedCharge = $("input[name='chargeRadioOptions']:checked").val();
                var selectedChargeBy = $("input[name='chargeByRadioOptions']:checked").val();

                var model = {
                    CART_H_ID: cartHeaderID,
                    ATTN_TO: txtAttentionTo,
                    REMARK: txtRemark,
                    CUST_CODE: txtCustomerCode,
                    CHARGE: selectedCharge,
                    CHARGE_BY: selectedChargeBy
                }

                $('#adhoc-modal').modal('hide');

                $.ajax({
                    type: "post",
                    url: urlSaveAsDraft,
                    data: JSON.stringify(model),
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.success) {
                            showAlert("Success", "Successfully save as draft");
                        }
                        else {
                            showAlert("Error", "Failed to save as draft");
                        }
                    },
                });
            });
        });

        // Function to append draft data to input field
        function appendDraftData(data) {
            var attn_to = data == null ? "" : data.ATTN_TO;
            var remark = data == null ? "" : data.REMARK;
            var cust_code = data == null ? custCode : data.CUST_CODE;
            var charge = data == null ? "No Charge" : data.CHARGE;
            var charge_by = data == null ? "Sales Debit Note" : data.CHARGE_BY;
            cust_code = cust_code == "0" || cust_code == 0 ? "" : cust_code;

            $('.vm').show();
            $("#txtAttentionTo").val(attn_to);
            $("#txtRemark").val(remark);
            $("#txtCustomerCode").val(cust_code);
            $("input[name='chargeRadioOptions'][value ='" + charge + "']").prop('checked', true);
            $("input[name='chargeRadioOptions'][value ='" + charge + "']").trigger("change");
            $("input[name='chargeByRadioOptions'][value ='" + charge_by + "']").prop('checked', true);

            // Show/hide and enable/disable chargeBy section
            if (charge == "No Charge") {
                $('.section-charge-by').addClass('hidden');
                $('input[name="chargeByRadioOptions"]').prop('disabled', true);
            }
            else {
                $('.section-charge-by').removeClass('hidden');
                $('input[name="chargeByRadioOptions"]').prop('disabled', false);
            }

            // Populate customer details if matched in DataTable
            table.rows().every(function (rowIdx, tableLoop, rowLoop) {
                let rowData = this.data();

                if (rowData.CUST_CODE == cust_code) {
                    $('#txtCustomerName').val(rowData.CUST_NAME);
                    $('#txtAddress1').val(rowData.CUST_ADD1);
                    $('#txtAddress2').val(rowData.CUST_ADD2);
                    $('#txtAddress3').val(rowData.CUST_ADD3);
                    $('#txtAddress4').val(rowData.CUST_ADD4);

                    return false // Stop the loop once found
                }
            });
        }

        // Function to get draft data through AJAX
        function getDraftData() {

            $.ajax({
                type: "POST",
                url: urlGetDraftData,
                data: { id: cartHeaderID },
                datatype: "json",
                traditional: true,
                success: function (response) {
                    var success = response.success;

                    if (success) {
                        appendDraftData(response.data);
                        processA = true;
                    }
                    else {
                        processA = false;
                        ShowLoading(false);
                        showAlert("Error", "An error occur when retrieving draft data");
                    }
                }
            });
        }

