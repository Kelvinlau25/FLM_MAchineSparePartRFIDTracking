        // Function to make sure only 1 parent checkbox and it's child can checked only
        function checkboxControl(indexID, indexChecked) {
            if (indexChecked) {
                $('[id^="checkboxID_"]').each(function () {
                    var index = $(this).attr('index');
                    if (indexID != index) {
                        $(`#checkboxID_${index}`).attr('disabled', true);
                        $(`.checkboxID_${index}`).attr('disabled', true);
                    }
                });
            }
            else {
                var classIndexChecked = false;
                $(`.checkboxID_${indexID}`).each(function () {
                    if ($(this).is(':checked')) {
                        classIndexChecked = true;
                    }
                });
                if (!classIndexChecked) {
                    $('[id^="checkboxID_"]').attr('disabled', false);
                    $('[class^="checkboxID_"]').attr('disabled', false);
                }
            }
        }

        // Function to display content of product based on checkbox
        function displaySummary() {
            var html = '';
            var quantity = 0;
            var isProceed = true, isContent = false;
            var cartArray = [], categoryArray = [];
            var prevCustCode = custCode;

            html += '<div class="px-2" style="overflow:hidden auto; max-height:380px">';

            // Loop each child checkbox
            $('[class^="checkboxID_"]').each(function () {
                if ($(this).is(':checked')) {
                    var cartID = $(this).attr('cartID');
                    for (var i = 0; i < cart.length; i++) {
                        if (cart[i].CART_D_ID == cartID && !cartItemDeleted.includes(cartID) && cart[i].CURRENT_QTY >= cart[i].QUANTITY) {
                            // If html not contain company name of cart item, display it
                            if (!html.includes(`<div><text>${cart[i].COMPANY_NAME}</text></div>`)) {
                                html += `<div><text>${cart[i].COMPANY_NAME}</text></div>`;
                                custCode = cart[i].CUST_CODE;
                            }
                            // If html not contain category name of cart item, display it
                            if (!html.includes(`<div class="col ms-4 cart-category"><text>${cart[i].CATEGORY_NAME}</text></div>`)) {
                                html += '<div class="row mt-2">';
                                html += `<div class="col ms-4 cart-category"><text>${cart[i].CATEGORY_NAME}</text></div>`;
                                html += `<div class="col d-flex justify-content-end "><text>${cart[i].QUANTITY}</text></div>`;
                                html += '</div>';

                                if (!categoryArray.includes(cart[i].CATEGORY_NAME)) {
                                    var cartObj = {
                                        CATEGORY_NAME: cart[i].CATEGORY_NAME,
                                        QUANTITY: cart[i].QUANTITY
                                    }
                                    categoryArray.push(cart[i].CATEGORY_NAME);
                                    cartArray.push(cartObj);
                                }
                            }
                            // Else sum the quantity order by categoray name
                            else {
                                for (var j = 0; j < cartArray.length; j++) {
                                    if (cartArray[j].CATEGORY_NAME == cart[i].CATEGORY_NAME) {
                                        cartArray[j].QUANTITY += cart[i].QUANTITY;
                                    }
                                }
                            }
                            quantity += cart[i].QUANTITY;
                            isContent = true;
                        }
                        // If the available quantity less than cart quantity, set proceed to false
                        if (cart[i].CART_D_ID == cartID && !cartItemDeleted.includes(cartID) && cart[i].CURRENT_QTY < cart[i].QUANTITY) {
                            proceed = false;
                        }
                    }
                }
            });
            html += '</div>';
            if (isContent) {
                html += '<div class="divider-line m-2"></div>';
            }

            if (quantity != 0 && isProceed) {
                $('.proceed-section').removeClass('hidden');
            }
            else {
                $('.proceed-section').addClass('hidden');
            }
            html += '<div class="row px-2 pb-2">';
            html += '<div class="col"><text>Total</text></div>';
            html += `<div class="col d-flex justify-content-end"><text class="dark-blue fw-bold">${quantity}</text></div>`;
            html += '</div>';
            $('.summary-section').html(html);

            // Update sum quantity for each category name
            $('.cart-category').each(function () {
                for (var i = 0; i < cartArray.length; i++) {
                    if ($(this).text() == cartArray[i].CATEGORY_NAME) {
                        $(this).next().text(cartArray[i].QUANTITY);
                    }
                }
            });

            if (prevCustCode != custCode) {
                $.ajax({
                    type: "post",
                    url: getCustomerDetails,
                    data: {
                        id: custCode,
                    },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (data.CUST_CODE != null) {
                            $('.vm').hide();
                        }
                        else {
                            $('.vm').show();
                        }
                        $('#txtCustomerCode').val(data.CUST_CODE);
                        $('#txtCustomerName').val(data.CUST_NAME);
                        $('#txtTelephoneNo').val();
                        $('#txtAddress1').val(data.CUST_ADD1);
                        $('#txtAddress2').val(data.CUST_ADD2);
                        $('#txtAddress3').val(data.CUST_ADD3);
                        $('#txtAddress4').val(data.CUST_ADD4);
                    },
                });
            }
        }

        // Function to toast message after submit
        function toastMessage() {
            const toastLiveExample = document.getElementById('successToast');
            const toast = new bootstrap.Toast(toastLiveExample);
            toast.show();
            setTimeout(function () {
                location.reload();
            }, 2000);
        }

        // Function to remove item from cart after submit or delete
        function removeCartItem(action) {
            var index;
            var cartID = "";
            var AdhocReqNo = "";
            var parentChecked = false;
            cartItemDeleted = [];

            // If parent checkbox is checked, remove whole cart from page
            $('[id^="checkboxID_"]').each(function () {
                if ($(this).is(':checked')) {
                    parentChecked = true;
                    index = $(this).attr('index');
                    $(`.checkboxID_${index}`).each(function () {
                        var cartID = $(this).attr('cartID')
                        cartItemDeleted.push(cartID);
                    });
                    $(`#cartParentID_${index}`).html('');
                }
            });

            // If parent checkbox not checked, remove checked child from parent cart
            if (!parentChecked) {
                $('[class^="checkboxID_"]').each(function () {
                    if ($(this).is(':checked')) {
                        var cartID = $(this).attr('cartID')
                        index = $(this).attr('index');
                        cartItemDeleted.push(cartID);
                        $(`#cartChildID_${cartID}`).html('');
                    }
                });
            }

            for (var i = 0; i < cartItemDeleted.length; i++) {
                // If action is submit, join checked cart item into string cartID
                if (action == "Submit") {
                    if (cartID == "") {
                        cartID += cartItemDeleted[i];
                    }
                    else {
                        cartID += "," + cartItemDeleted[i];
                    }
                }
                // Else delete cart item
                else {
                    updateCart(cartItemDeleted[i], "5");
                }
            }

            // Submit ad hoc request
            if (action == "Submit") {
                submitAdHocRequest(cartID);
            }

            $('#confirmation-modal').modal('hide');
            $('#trashID_' + index).addClass('hidden');
            checkboxControl(index, false);
            displaySummary();
        }

        // Function to update cart quantity
        function updateCart(cartID, action) {
            $.ajax({
                type: "post",
                url: urlUpdateCart,
                data: {
                    cartID: cartID,
                    action: action,
                },
                datatype: "json",
                traditional: true,
                success: function (data) {
                },
            });
        }

        // Function to delete cart item
        function deleteCartID(cartID, action) {
            $.ajax({
                type: "post",
                url: urlUpdateCart,
                data: {
                    cartID: cartID,
                    action: action
                },
                datatype: "json",
                traditional: true,
                success: function (data) {
                    getAddToCart();
                },
            });
        }

        // Function to submit ad hoc request
        function submitAdHocRequest() {
            var cartDArray = [];
            var adHocRequestDetailArray = [];
            var cartDIDVal = "", prevCartDIDVal = "", ttlQty = 0;
            var txtSentBy = $('#txtSentBy').val();
            var txtDateSent = $('#txtDateSent').val();
            var txtAttentionTo = $('#txtAttentionTo').val();
            var txtRemark = $('#txtRemark').val();
            var txtCustomerCode = $('#txtCustomerCode').val();
            var txtCustomerName = $('#txtCustomerName').val();
            var txtTelephoneNo = $('#txtTelephoneNo').val();
            var txtAddress1 = $('#txtAddress1').val();
            var txtAddress2 = $('#txtAddress2').val();
            var selectedCharge = $("input[name='chargeRadioOptions']:checked").val();
            var selectedChargeBy = $("input[name='chargeByRadioOptions']:checked").val();
            var cartIDStr = "";
            var priority = $("input[type='radio']:checked").val();

            if (selectedCharge == "No Charge") {
                selectedChargeBy = "";
            }

            var sampleAdHocMaster = {
                CUST_CODE: txtCustomerCode,
                TEL_NO: txtTelephoneNo,
                ADDR1: txtAddress1,
                ADDR2: txtAddress2,
                ATTN_TO: txtAttentionTo,
                REMARK: txtRemark,
                SENT_BY: txtSentBy,
                DATE_SENT: txtDateSent,
                COURIER_NO: "",
                CHARGE: selectedCharge,
                CHARGE_BY: selectedChargeBy,
                PRIORITY: priority
            };

            $('#sample-request-list tbody tr').each(function (index, row) {
                cartDIDVal = $(this).closest('tr').find('.txtCartDID').val();
                if (cartIDStr == "") {
                    cartIDStr += cartDIDVal;
                }
                else {
                    cartIDStr += "," + cartDIDVal;
                }
                var txtPoNo = $(this).closest('tr').find('.txtPoNo').val();
                var txtChopNo = $(this).closest('tr').find('.txtChopNo').val();
                var txtComposition = $(this).closest('tr').find('.txtComposition').val();
                var txtColorWay = $(this).closest('tr').find('.txtColorWay').val();
                var txtFinishType1 = $(this).closest('tr').find('.txtFinishType1').val();
                var txtFinishType2 = $(this).closest('tr').find('.txtFinishType2').val();
                var txtFinishType3 = $(this).closest('tr').find('.txtFinishType3').val();
                var txtFinishType4 = $(this).closest('tr').find('.txtFinishType4').val();
                var txtWarpDensity = $(this).closest('tr').find('.txtWarpDensity').val();
                var txtWarpDensity2 = $(this).closest('tr').find('.txtWarpDensity2').val();
                var txtWeftDensity = $(this).closest('tr').find('.txtWeftDensity').val();
                var txtWeftDensity2 = $(this).closest('tr').find('.txtWeftDensity2').val();
                var txtWarpCount = $(this).closest('tr').find('.txtWarpCount').val();
                var txtWarpCount2 = $(this).closest('tr').find('.txtWarpCount2').val();
                var txtWarpCount3 = $(this).closest('tr').find('.txtWarpCount3').val();
                var txtWeftCount = $(this).closest('tr').find('.txtWeftCount').val();
                var txtWeftCount2 = $(this).closest('tr').find('.txtWeftCount2').val();
                var txtWeftCount3 = $(this).closest('tr').find('.txtWeftCount3').val();
                var txtSampleRollNo = $(this).closest('tr').find('.txtSampleRollNo').val();
                var txtBalanceYardage = $(this).closest('tr').find('.txtBalanceYardage').val();
                var txtLocation = $(this).closest('tr').find('.txtLocation').val();
                var requestQty = $(this).closest('tr').find('.txtQuantityRequest').val();
                var txtUOM = $(this).closest('tr').find('.txtUOM').val();

                if (prevCartDIDVal == "" || prevCartDIDVal == cartDIDVal) {
                    ttlQty += parseInt(requestQty, 10);
                }
                else {
                    var cartD = {
                        CART_D_ID: prevCartDIDVal,
                        QUANTITY: ttlQty
                    };
                    cartDArray.push(cartD);
                    ttlQty = parseInt(requestQty, 10);
                }
                prevCartDIDVal = $(this).closest('tr').find('.txtCartDID').val();
                var adhocDetail = {
                    PO_NO: txtPoNo,
                    CHOP_NO: txtChopNo,
                    COMPOSITION: txtComposition,
                    COLOR_WAY: txtColorWay,
                    FINISH_TYPE1: txtFinishType1,
                    FINISH_TYPE2: txtFinishType2,
                    FINISH_TYPE3: txtFinishType3,
                    FINISH_TYPE4: txtFinishType4,
                    WARP_DENSITY: txtWarpDensity,
                    WARP_DENSITY2: txtWarpDensity2,
                    WEFT_DENSITY: txtWeftDensity,
                    WEFT_DENSITY2: txtWeftDensity2,
                    WARP_COUNT: txtWarpCount,
                    WARP_COUNT2: txtWarpCount2,
                    WARP_COUNT3: txtWarpCount3,
                    WEFT_COUNT: txtWeftCount,
                    WEFT_COUNT2: txtWeftCount2,
                    WEFT_COUNT3: txtWeftCount3,
                    SAMPLE_ROLL_NO: txtSampleRollNo,
                    BALANCE_YARDAGE: txtBalanceYardage,
                    LOCATION: txtLocation,
                    REQUEST_QUANTITY: requestQty,
                    UOM: txtUOM,
                    SENT_BY: txtSentBy,
                    DATE_SENT: txtDateSent
                };
                adHocRequestDetailArray.push(adhocDetail);
            });
            var cartD = {
                CART_D_ID: prevCartDIDVal,
                QUANTITY: ttlQty
            };
            cartDArray.push(cartD);

            var postData = {
                cartDArray: cartDArray,
                adHocRequestDetailArray: adHocRequestDetailArray,
                sampleAdHocMaster: sampleAdHocMaster,
                cartIDStr: cartIDStr
            }
            var jsonData = JSON.stringify(postData);
            $('#adhoc-modal').modal('hide');

            ShowLoading(true, "Submitting Request...", "Please wait while your request is being processed");

            $.ajax({
                type: "POST",
                url: urlUpdateRequest,
                data: jsonData,
                contentType: 'application/json',
                success: function (response) {
                    if (response.success) {
                        showAlert("Success", "Your request has been successfully submitted");
                        getAddToCart();
                    }
                    else {
                        showAlert("Error", "We encountered an issue while submitting your request");
                    }
                }
            });
        }
    </script>
</body>