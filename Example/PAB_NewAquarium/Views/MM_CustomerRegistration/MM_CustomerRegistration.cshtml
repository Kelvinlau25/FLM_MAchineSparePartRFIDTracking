@model PAB_NewAquarium.Models.Customer

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Common Listing CSS -->
<link href="~/ViewsHelpers/CommonListing/Listing.css" rel="stylesheet" />

<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">Customer</p>
    </div>
    <div class="col-sm-6 text-end align-self-center">
        <div class="d-flex justify-content-end">
            <div id="customDTButton"></div>
        </div>
    </div>
</div>
<div class="tr-btm-line"></div>

<div class="page-container px-3 overflow-auto">
    <div class="tr-btm-btn-margin">
        <div>
            <div class="row mt-3 mb-2">
                <div class="col-12 col-sm-8">

                </div>
                <div class="col-12 col-sm-4 align-self-end text-end pb-0 mb-0" id="action-bar">

                </div>
            </div>
            <div class="row">
                <table id="tr-datatable" class="table table-hover table-bordered compact w-100">
                    <thead>
                        <tr class="bg-datatable-tr">
                            <th></th>
                            <th>Customer Code</th>
                            <th>Customer Name</th>
                            <th>Country</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="row tr-btm-btn-area">
                <div class="col">
                    <div class="aud export-section"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Common Listing Html -->
@Html.Partial("_Listing_Page_V2")

<!-- Common Listing JavaScript -->
<script src="~/ViewsHelpers/CommonListing/Listing.js"></script>

<script>
    var table;
    var jsonData = @Html.Raw(Json.Encode(Model.CustomerListing));
    var data = jsonData;

    $(document).ready(function () {

        onPageLoad();

    });

    function onPageLoad() {
        initPage();
        loadDataTable();
        initDataTableComponent();
        adjustDataTableColumn();
    }

    function loadDataTable() {
        table = $('#tr-datatable').DataTable({
            data: data,
            scrollCollapse: true,
            scrollY: calcDataTableHeight,
            pagingType: 'simple_numbers',
            columns: getColumnConfig(),
            columnDefs: [
                {
                    targets: 0,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = '<div class="checkbox"><input type="checkbox" class="dt-checkboxes form-check-input"><label></label></div>';
                        }

                        return data;
                    },
                    checkboxes: {
                        selectRow: true,
                        selectAllPages: false,
                        selectAllRender: '<div class="checkbox"><input type="checkbox" id="checkboxAll" class="dt-checkboxes form-check-input"><label></label></div>'
                    },
                    orderable: false, // Disable sorting for this column
                },
                {
                    targets: 4,
                    render: function (data, type, row, meta) {
                        return '<a href="@Url.Action("MM_CustomerRegistration_View", "MM_CustomerRegistration")?id=' + row.CUST_CODE + '" class="name tr-icon-size" id="' + row.CUST_CODE + '"><i class="fa-solid fa-eye"></i></a>';
                    },
                    orderable: false,
                }
            ],
            select: {
                style: 'multi',
                info: false,
                selector: 'td:nth-child(1)'
            },
            order: [[1, 'asc']],
            dom: `<'row toolbar-row g-0 custom-toolbar'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'<'toolbar'>>>
                  <'row'<'col-sm-12'tr>>
                  <'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end mt-2'p<'go-to align-self-center mx-2'>>>>`,
            fixedHeader: {
                header: true,
                footer: false
            },
            initComplete: function () {
                $('.custom-toolbar .toolbar').html(searchInputHtml);
            },
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            }
        });
    }

    function getColumnConfig() {

        var dynamicColumns = [];
        var val = data[0];
        var columnJsonArrs = new Array();

        var x = 0;
        for (var j in val) {
            columnJsonArrs[x] = j;
            x++
        }

        columnJsonArrs.forEach(function (columnJsonArr, index) {
            var columnConfig = {
                data: columnJsonArr
            };
            dynamicColumns.push(columnConfig);
        });
        return dynamicColumns;
    }
</script>