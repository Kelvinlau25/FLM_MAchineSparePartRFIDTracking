    // Function to get similar products using matrix comparison API
    function displayRecommendedProduct() {        
        $.ajax({
            type: "get",
            url: urlSimilarProducts,
            data: {
                user: user,
                type: (pageTitle == "All Products") ? "ALL" : "MOM"
            },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data != "Failed" && data.length != 0) {
                    var html = '';
                    for (var i = 0; i < data.length; i++) {
                        html += `<div class="td-content align-top px-3 pt-2 pb-2" onclick="location.href='${urlActionView}?id=${data[i].PRODUCT_H_ID}&groupDID=${customerID}'">`;
                        html += `<div><img src="${data[i].IMAGE_URL}" loading="lazy"></div>`;
                        html += `<div class="my-1"><text class="header-title fw-bold">${data[i].CATEGORY_NAME}</text></div>`;
                        html += '<div class="divider-line-2px"></div>';
                        html += `<div class="my-1"><text>${data[i].CHOP_NO}</text></div>`;
                        html += '</div>';
                    }
                    $('.recommend-section').html(html);
                }
                else {
                    $('.page-div-right').addClass('hidden');
                    $('.custom-overlay').addClass('invisible');
                }
            },
        });
    }

    // Function to disable filter button
    function disableFilterButton() {
        var inStock = false;
        var lowStock = false;
        var outStock = false;
        var isGarment = false;

        // Indicate which filter is valid, true is valid
        for (var i = 0; i < allProducts.length; i++) {
            var qty = allProducts[i].CURRENT_QTY;
            var garment = allProducts[i].ISGARMENT;

            if (qty > 0) {
                inStock = true;
            }
            else {
                outStock = true;
            }
            if (garment != 0) {
                isGarment = true;
            }
            if (qty > 0 && qty < 10) {
                lowStock = true;
            }
        }

        $('.li-weight > button').each(function () {
            var text = $(this).text().trim();
            var range = text.split(" - ");
            var selectedWeight = false;

            for (var i = 0; i < allProducts.length; i++) {
                var weight = allProducts[i].FAB_WEIGHT_GSM;
                if (weight >= parseInt(range[0]) && weight <= parseInt(range[1])) {
                    selectedWeight = true;
                    return false;
                }
            }

            // If false, disable the filter button
            if (!selectedWeight) {
                $(this).addClass('notAllowed');
                $(this).prop('disabled', true);
                $(this).attr('title', "No items meet the criteria for this filter");
            }
        });

        $('.li-stock > button').each(function () {
            var text = $(this).text().trim();

            // If false, disable the filter button
            if (!inStock && text == "In Stock") {
                $(this).addClass('notAllowed');
                $(this).prop('disabled', true);
                $(this).attr('title', "No items meet the criteria for this filter");
            }
            // If false, disable the filter button
            if (!lowStock && text == "Low Stock") {
                $(this).addClass('notAllowed');
                $(this).prop('disabled', true);
                $(this).attr('title', "No items meet the criteria for this filter");
            }
            // If false, disable the filter button
            if (!outStock && text == "Out Stock") {
                $(this).addClass('notAllowed');
                $(this).prop('disabled', true);
                $(this).attr('title', "No items meet the criteria for this filter");
            }
        });

        $('.li-garment > button').each(function () {
            // If false, disable the filter button
            if (!isGarment) {
                $(this).addClass('notAllowed');
                $(this).prop('disabled', true);
                $(this).attr('title', "No items meet the criteria for this filter");
            }
        });
    }    
