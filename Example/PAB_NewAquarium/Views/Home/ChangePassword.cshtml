@model PAB_NewAquarium.Models.ChangePasswordModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>

    .status-select {
        border: 0px;
    }

    .tr-text {
        text-align: end;
    }

    .toolbar {
        float: right;
    }

    .toolbar-pop {
        float: left;
    }

    .tr-pop-line {
        border-top: 1px solid #F0F0F0;
        margin: 0px;
    }

    .tr-input-group {
        background-color: #057EE6;
        border-color: #057EE6;
    }

        .tr-input-group .tr-disabled {
            background-color: #54575A;
            border-color: #54575A;
        }

    @@media only screen and (min-device-width: 1280px) and (max-device-width: 1599px) {
        .tr-text {
            text-align: start;
        }

        .tr-pop-line {
            border-top: 1px solid #F0F0F0;
            margin: 10px 0px;
        }

        .modal-header {
            margin-bottom: -15px;
            margin-top: -10px;
        }
    }

    @@media (min-width: 1599px) {
        .modal-lg, .modal-xl {
            --bs-modal-width: 1024px;
        }

        .modal-header {
            margin-bottom: -25px;
            margin-top: -10px;
        }
    }

    /* Override -2px, form some reason the non-bootstrap is -6px */
    table.dataTable tbody td.select-checkbox::before,
    table.dataTable tbody th.select-checkbox::before {
        margin-top: -6px;
    }

    /**, *:before, *:after {
        box-sizing: border-box;
        font-size: 14px;
    }*/

    .styled-select {
        position: relative;
        display: flex;
        align-items: center;
        width: 300px;
        /*margin: 100px auto 0 auto;*/
        font-family: "Helvetica", "Arial", sans-serif;
    }

        .styled-select label {
            flex: 1 1 60px;
        }

        .styled-select .select-wrapper {
            border: none;
            flex: 1 1 100%;
            background: white;
            border-radius: 5px;
            position: relative;
        }

    .select-wrapper[data-prefix]:before {
        content: attr(data-prefix);
        display: flex;
        align-items: center;
        position: absolute;
        z-index: 0;
        left: 0;
        top: 0;
        bottom: 0;
        padding: 0 5px 0 10px;
        /*color: #b3b3b3;*/
    }

    .styled-select .select-wrapper[data-suffix]:after {
        content: attr(data-suffix);
        display: flex;
        align-items: center;
        position: absolute;
        z-index: 0;
        right: 23px;
        top: 0;
        bottom: 0;
        padding: 0 10px 0 5px;
        /*color: #b3b3b3;*/
    }

    /*.styled-select .select-wrapper:focus-within {
                border-color: #00a7e1;
            }*/

    /*.styled-select .select-wrapper:focus-within:before, .styled-select .select-wrapper:focus-within:after, .styled-select .select-wrapper:focus-within .fas {
                    color: #00a7e1;
                }*/

    .styled-select .select-wrapper select {
        display: block;
        padding-top: 10px;
        padding-bottom: 10px;
        width: 100%;
        border: none;
        outline: none;
        -webkit-appearance: none;
        position: relative;
        z-index: 1;
        background: transparent;
        font-size: 16px;
    }

    /*.styled-select .select-wrapper select.default-value {
                    color: #b3b3b3;
                }*/

    .styled-select .select-wrapper .fas {
        display: flex;
        align-items: center;
        font-size: 14px;
        position: absolute;
        z-index: 0;
        top: 0;
        right: 0;
        bottom: 0;
        padding: 0 10px 0 0;
        width: 23px;
        /*color: #b3b3b3;*/
    }

    .tr-no-border {
        border: 0px !important;
    }

    .file-upload::-webkit-file-upload-button {
        color: red; /* Change this to the desired text color */
    }
</style>

@{
    var Validate = ViewBag.Validate as string;
}

@if (ViewBag.Validate == "Success")
{
    <div class="alert alert-success">
        Password changed successfully.
    </div>
}
else if (ViewBag.Validate == "Fail" || ViewBag.Validate == "Error")
{
    <div class="alert alert-danger" style="margin-top:10px">
        @ViewData["Message"]
    </div>
}

<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">
            Setting - Change Password
        </p>
    </div>
</div>
<div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>

@using (Html.BeginForm("ChangePassword", "Home", FormMethod.Post))
{
    <div class="page-container px-3 overflow-auto">
    <div class="tr-btm-btn-margin">
        <div class="card mt-3 mb-2 card-height">
            <div class="card-body">
                <h6 class="card-title text-muted">Change Password</h6>
                <hr />
                <div class="row mt-2 align-items-baseline">
                    <div class="col-sm-4">
                        <p class="text-muted">Old Password <span class="text-danger">*</span><span style="float:right">:</span></p>
                    </div>
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.OLD_PASSWORD, new { @class = "form-control", type = "password", placeholder = "Please enter old password..." })
                    </div>
                </div>

                <div class="row align-items-baseline">
                    <div class="col-sm-4">
                        <p class="text-muted">New Password <span class="text-danger">*</span><span style="float:right">:</span></p>
                    </div>
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.NEW_PASSWORD, new { @class = "form-control", type = "password", placeholder = "Please enter new password..." })
                    </div>
                </div>

                <div class="row align-items-baseline">
                    <div class="col-sm-4">
                        <p class="text-muted">Confirm New Password<span class="text-danger">*</span><span style="float:right">:</span></p>
                    </div>
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.CONFIRM_NEW_PASSWORD, new { @class = "form-control", type = "password", placeholder = "Please repeat new password..." })
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-auto justify-content-end g-1 tr-btm-btn-area" style="padding-right: 20px">
            <div class="col"><button id="btnBack" type="button" class="btn btn-sm btn-secondary mx-1">Back</button></div>
            <div class="col"><button id="btnSubmit" type="button" class="btn btn-sm btn-primary mx-1" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal">Submit</button></div>
        </div>
    </div>

    <div class="modal fade" id="submit-confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to submit this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" data-bs-dismiss="modal" id="btnConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    </div>
}
<div id="toastMessage" data-message="@ViewBag.Validate"></div>

<script>
    $(document).ready(function () {
        var toastMsgElement = document.getElementById('toastMessage');
        var toastMsg = toastMsgElement.getAttribute('data-message');

        if (toastMsg) {
            const toastLiveExample = document.getElementById('liveToast1');
            const toast = new bootstrap.Toast(toastLiveExample);
            toast.show();
        }
    });

    $('#btnBack').on('click', function () {
        var url = '@Url.Action("Index", "Dashboard")';
        window.location.href = url;
    });
</script>