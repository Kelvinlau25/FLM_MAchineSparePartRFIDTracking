@using PAB_NewAquarium.Models
@model PAB_NewAquarium.Models.Notification

@{
    Layout = null;
}

<style type="text/css">

    #loading {
        display: none;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.8);
        z-index: 1000;
    }

    #loadingcontent {
        display: table;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
    }

    #loadingspinner {
        display: table-cell;
        vertical-align: middle;
        width: 100%;
        text-align: center;
        font-size: larger;
        padding-top: 80px;
    }

    #elementToRotate1, #elementToRotate2, #elementToRotate3, #elementToRotate4 {
        transition: transform 0.5s;
    }

    .rotated {
        transform: rotate(90deg);
    }

    .nav-link:hover {
        background: #fff;
    }

    a {
        text-decoration: none;
    }

    .sidebar .nav-link, new-noti {
        padding: 0;
        width: 200px;
    }

    .dropdown-toggle-icon{
        margin-top: 2px;
        margin-left: auto;
    }

    @@media only screen and (min-device-width: 1919px) {
        .header-text-noti {
            padding: 0px 10px 0px 10px;
        }
    }

    @@media only screen and (max-device-width: 1919px) {
        .header-text-noti {
            padding: 0px 20px 0px 20px;
        }
    }
    
    .noti-header {
        height: 75px;
        align-items: center;
        display: flex;
        border-top: 1px solid #F0F0F0;
        cursor: unset;
    }

        .noti-header:hover{
            color: #54575A;
        }

    .notiRow{
        width: 400px;
    }

    .notiTextControl {
        width: 75%;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .notiDuration{
        width: 25%;
        text-align: right;
    }

    .new-noti {
        background-color: #E4FFE4;
        color: #54575A;
    }

        .new-noti:hover {
            color: #54575A;
        }

</style>

<li>
    @if (Model.NotificationListing.Count == 0)
    {
        <div class="m-3">
            <text>There is no notification yet</text>
        </div>
    }
    @foreach (var row in Model.NotificationListing)
    {
        if (row.ISSEEN == true)
        {
            <a href="#" class="nav-link noti-header header-text-noti hasSub">
                <div class="row notiRow" id="@row.NOTIFICATION_ID">
                    @{
                        TimeSpan duration = @DateTime.Now - @row.CREATED_DATE;
                        string durationStr = "";
                        int firstCommaPosition = @row.CATEGORY_NAME.IndexOf(',');
                        string substringBeforeComma = @row.CATEGORY_NAME;
                        if (firstCommaPosition != -1) substringBeforeComma = @row.CATEGORY_NAME.Substring(0, firstCommaPosition);
                    }
                    <div class="col-sm-8 notiTextControl">
                        You have request sample of <span class="text-black">@substringBeforeComma - Chop No: @row.CHOP_NO.</span>
                    </div>
                    <div class="col-sm-4 notiDuration">
                        @if ((int)@duration.TotalDays > 0)
                        {
                            durationStr = @duration.TotalDays.ToString("0") + " d ago";
                        }
                        else if ((int)@duration.TotalHours > 0)
                        {
                            durationStr = @duration.TotalHours.ToString("0") + " h ago";
                        }
                        else if ((int)@duration.TotalMinutes > 0)
                        {
                            durationStr = @duration.TotalMinutes.ToString("0") + " m ago";
                        }
                        else
                        {
                            durationStr = "Just now";
                        }
                        @durationStr
                    </div>
                </div>
            </a>
        }
        else{
            <a href="#" class="new-noti noti-header header-text-noti hasSub ">
                <div class="row notiRow" id="@row.NOTIFICATION_ID">
                    @{
                        TimeSpan duration = @DateTime.Now - @row.CREATED_DATE;
                        string durationStr = "";
                        int firstCommaPosition = @row.CATEGORY_NAME.IndexOf(',');
                        string substringBeforeComma = @row.CATEGORY_NAME;
                        if (firstCommaPosition != -1) substringBeforeComma = @row.CATEGORY_NAME.Substring(0, firstCommaPosition);
                    }
                    <div class="col-sm-8 notiTextControl">
                        You have request sample of <span class="text-black">@substringBeforeComma - Chop No: @row.CHOP_NO.</span>
                    </div>
                    <div class="col-sm-4 notiDuration">
                        @if ((int)@duration.TotalDays > 0)
                        {
                            durationStr = @duration.TotalDays.ToString("0") + " d ago";
                        }
                        else if ((int)@duration.TotalHours > 0)
                        {
                            durationStr = @duration.TotalHours.ToString("0") + " h ago";
                        }
                        else if ((int)@duration.TotalMinutes > 0)
                        {
                            durationStr = @duration.TotalMinutes.ToString("0") + " m ago";
                        }
                        else
                        {
                            durationStr = "Just now";
                        }
                        @durationStr
                    </div>
                </div>
            </a>
        }

    }

</li>

<script>
    // Add this script after the sidebar HTML code
    $(document).ready(function () {
        $(".active a").click(function (e) {
            e.stopPropagation();
        });
    });
</script>