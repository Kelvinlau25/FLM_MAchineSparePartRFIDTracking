
@{
    ViewBag.Title = "NotFoundPage";
    Layout = "~/Views/Shared/_Layout_Empty.cshtml";
}

<div class="row w-100" style="height:100vh; margin: auto">
    <div class="row" style="margin: auto">
        <div class="row text-center">
            <img src="~/assets/error-2.png" style="margin:auto; width: 350px;" />
        </div>

        <div class="row text-center pb-2">
            <h5 style="font-weight: bold">PAGE NOT FOUND</h5>
        </div>

        <div class="row text-center">
            <p>Sorry, the page you are looking for at this URL is not found</p>
        </div>

        <div class="row text-center">
            <p>Contact TMS helpdesk: <span style="color:#004098; font-weight:bold">04-3854184 / helpdesk.tms.mb@@mail.toray</span></p>
        </div>

        <div class="row text-center">
            <p>Click <a id="btnHome" style="color:#004098; font-weight:bold">HERE</a> back to Home</p>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#btnLogin').click(function (e) {
                e.preventDefault();
                var url = '@Url.Action("Login", "ACL")';
                window.location.href = url;
            });

            $('#btnHome').click(function (e) {
                e.preventDefault();
                var url = '@Url.Action("List", "Home")';
                window.location.href = url;
            });
        });
    </script>
}