
@{
    ViewBag.Title = "SessionExpired";
    Layout = "~/Views/Shared/_Layout_Empty.cshtml";
}

<div class="row w-100" style="height:100vh; margin: auto">
    <div class="row" style="margin: auto">
        <div class="row text-center">
            <img src="~/assets/expired-2.png" style="margin:auto; width: 350px" />
        </div>
        <div class="row text-center">
            <p style="font-weight: bold">Your session has expired</p>
        </div>
        <div class="row text-center">
            <p style="font-weight: bold">Please click login to continue.</p>
        </div>
        <div class="row text-center">
            <div class="d-grid gap-2 d-md-block">
                <button id="btnLogin" type="button" class="btn btn-sm btn-primary">Login</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#btnLogin').click(function (e) {
                e.preventDefault();
                var url = '@Url.Action("Login", "ACL")';
                window.location.href = url;
            });

            $('#btnHome').click(function (e) {
                e.preventDefault();
                var url = '@Url.Action("List", "Home")';
                window.location.href = url;
            });
        });
    </script>
}