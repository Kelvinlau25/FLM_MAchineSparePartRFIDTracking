                <strong class="me-auto" style="color: #00A251">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Add to Cart Successfully.
            </div>
        </div>
    </div>
}

<script>
    var imageData = @Html.Raw(Model.imageList);
    var productID = "@Model.PRODUCT_H_ID";
    var colorway = "@ViewBag.colorWay";
    var urlAddToCart = "@Url.Action("AddToCart", "ProductDetail")";
    var videoCnt = "@Model.FabricVideoList.Count"

    $(document).ready(function () {
        generateImagePreview();

        $(".color-btn2").click(function () {
            var id = $(this).attr("id");
            var seq = id.substring(id.indexOf("_") + 1);
            var colorWay = imageData[seq - 1].COLOR_WAY;
            var imageNum = imageData[seq - 1].imageFile.length;
            var randomNum = Math.floor(Math.random() * (4 - 1 + 1)) + 1;
            var url = "";
            if (imageNum == 1) {
                if(randomNum == 1)
                    url = '@Url.Action("RFIDProductPage", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 2)
                    url = '@Url.Action("RFIDProductPage2", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 3)
                    url = '@Url.Action("RFIDProductPage3", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 4)
                    url = '@Url.Action("RFIDProductPage4", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                window.location.href = url;
            }
            else if (imageNum == 2) {
                if(randomNum == 1)
                    url = '@Url.Action("RFIDProductPage5", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 2)
                    url = '@Url.Action("RFIDProductPage6", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 3)
                    url = '@Url.Action("RFIDProductPage7", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 4)
                    url = '@Url.Action("RFIDProductPage8", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                window.location.href = url;
            }
            else if (imageNum == 3) {
                if(randomNum == 1)
                    url = '@Url.Action("RFIDProductPage9", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 2)
                    url = '@Url.Action("RFIDProductPage10", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 3)
                    url = '@Url.Action("RFIDProductPage11", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                else if (randomNum == 4)
                    url = '@Url.Action("RFIDProductPage12", "RFIDDashboard")?id=' + @Model.PRODUCT_H_ID + '&user=' + '@ViewBag.user' + '&colorWay=' + colorWay;
                window.location.href = url;
            }
        });

        var isDragging = false;
        var startX, startY, scrollLeft, scrollTop;

        var scrollContainer = $('#color-selection2');
        var scrollContent = $('#color-selection-content2');

        scrollContainer.on('mousedown', function (e) {
            isDragging = true;
            startX = e.pageX - scrollContainer.offset().left;
            startY = e.pageY - scrollContainer.offset().top;
            scrollLeft = scrollContainer.scrollLeft();
            scrollTop = scrollContainer.scrollTop();
        });

        $(document).on('mousemove', function (e) {
            if (!isDragging) return;
            e.preventDefault();
            var x = e.pageX - scrollContainer.offset().left;
            var y = e.pageY - scrollContainer.offset().top;
            var scrollX = scrollLeft - (x - startX);
            var scrollY = scrollTop - (y - startY);
            scrollContainer.scrollLeft(scrollX);
            scrollContainer.scrollTop(scrollY);
        });

        $(document).on('mouseup', function () {
            isDragging = false;
        });
    });

    function generateImagePreview() {
        for (var i = 0; i < imageData.length; i++) {
            for (var j = 0; j < imageData[i].imageName.length; j++) {
                var url = imageData[i].imageFile[j];
                if (j == 0) {
                    var colorBtn = $("<button>").attr("id", "colorBtn_" + (i + 1));
                    colorBtn.attr("class", "color-btn2");
                    colorBtn.attr("type", "button");
                    var btnImg = $("<img>").attr("src", url);
                    btnImg.attr("class", "card");
                    btnImg.addClass('image-sm');
                    colorBtn.append(btnImg);
                    $("#color-selection-content2").append(colorBtn);
                }
                if (imageData[i].COLOR_WAY == '@ViewBag.colorWay') {
                    $("#image" + (j + 1)).attr("src", url)
                    $("#currentQtyLbl").text(imageData[i].CURRENT_QTY + " / yards");
                    addToCartButtonControl(imageData[i].CURRENT_QTY);
                    $("#colorBtn_" + (i+1)).find("img").addClass("color-select-border");
                }
                else if ('@ViewBag.colorWay' == "" && i == 0) {
                    $("#image" + (j + 1)).attr("src", url)
                    $("#currentQtyLbl").text(imageData[i].CURRENT_QTY + " / yards");
                    addToCartButtonControl(imageData[i].CURRENT_QTY);
                    $("#colorBtn_" + (i + 1)).find("img").addClass("color-select-border");
                }
            }
        }
        if (videoCnt != "0" && isNaN(videoCnt) == false) {
            var videoBtn = $("<button>").attr("id", "videoBtn");
            var videoPlayUrl = "../ViewsHelpers/CommonIcon/Play/Play.png"
            videoBtn.attr("class", "video-btn");
            videoBtn.attr("type", "button");
            var btnImg = $("<img>").attr("src", videoPlayUrl);
            btnImg.attr("class", "card");
            btnImg.addClass('image-sm');
            videoBtn.append(btnImg);
            $("#color-selection-content2").append(videoBtn);
            $("#videoBtn").click(function () {
                $("#video-modal").modal("show");
            })
        }
    }

    function addToCartButtonControl(currentQty) { //disable add to cart button when current quantity is 0
        if (currentQty > 0)
            $('#btnAddToCart').prop("disabled", false);
        else
            $('#btnAddToCart').prop("disabled", true);
    }
</script>

