                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Product Type / Usage:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.PRODUCT_TYPE1</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="col-sm-12">

                                </div>
                                <div class="col-sm-12">

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-sm-4 third-col-align-item">
                <img class="fitImage image-width right image-animation3" id="image3" />
            </div>
        </div>
        <button id="btnAddToCart" type="button" class="btn btn-sm btn-primary">ADD TO CART</button>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to delete this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" value="delete" name="btn" id="btnConfirm2">Confirm</button>
