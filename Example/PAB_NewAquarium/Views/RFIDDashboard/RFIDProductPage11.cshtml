@model PAB_NewAquarium.Models.Product_H_Detail
@{
    ViewBag.Title = "RFIDProductPage11";
    if (ViewBag.user == "sales")
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout_Customer.cshtml";
    }
}

<link href="~/Content/RFIDProductPage.css" rel="stylesheet" />

<style>
    @@media (min-width: 768px) {
        .product-container {
            height: 79.5vh;
        }

        .fitImage2 {
            height: 49.5vh;
            position: absolute;
        }

        .fitImage3 {
            height: 49.5vh;
        }

        @@keyframes image2-animation {
            0% {
                height: 0vh;
                opacity: 0;
            }

            100% {
                height: 49.5vh;
                opacity: 1;
            }
        }

        .product-detail {
            margin-top: 10px;
        }

        .product-detail-body {
            padding-bottom: 50px;
        }
    }

    @@media (min-width: 1400px) {
        .product-container {
            height: 82.5vh;
        }

        .fitImage2 {
            height: 52.5vh;
            position: absolute;
        }

        .fitImage3 {
            height: 52.5vh;
        }

        @@keyframes image2-animation {
            0% {
                height: 0vh;
                opacity: 0;
            }

            100% {
                height: 52.5vh;
                opacity: 1;
            }
        }

        .product-detail {
            margin-top: 30px;
        }

        .product-detail-body {
            padding-bottom: 70px;
            z-index: 2;
        }
    }

    .image-sm {
        width: 50px;
        height: 50px;
    }

    .fitImage {
        height: 90%;
        position: absolute;
    }

    .bold {
        font-weight: bold;
    }

    .product-detail-width {
        width: 41.5vw;
    }

    .image-width {
        width: 33.5vw;
    }

    .image-width2 {
        width: 24.7vw;
        border-radius: 0px 0px 80px 0px;
        top: 0;
    }

    .detail-head {
        border-radius: 0px 20% 0px 0px;
        position: absolute;
        width: 25.5vw;
        bottom: 110px;
    }

    .align-item-head {
        padding-top: 20px;
        text-align: center;
    }

    .detail-background {
        z-index: 1;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding-left: 0;
        padding-right: 0;
        background-color: #FFFFFF;
    }

    .right {
        right: 0;
    }

    .left {
        left: 0;
    }

    .fitImage3 {
        width: 41.5vw;
        z-index: 0;
    }

    .detail-background-firsthalf {
        height: 35%;
        text-align: center;
        line-height: 100px;
        z-index: -1;
    }

    .product-detail {
        background-color: #F0F0F0;
        border-radius: 80px 80px 0px 0px;
        margin-left: auto;
        margin-right: auto;
    }

    .product-detail-body {
        padding-left: 60px;
        height: 100vh;
    }

    .first-col-align-item {
        display: flex;
        justify-content: center;
    }

    .third-col-align-item {
        padding-left: 0;
    }

    .image-animation {
        animation-name: image1-animation;
        animation-duration: 1.5s;
    }

    @@keyframes image1-animation {
        0% {
            left: -1000px;
            opacity: 0;
        }

        100% {
            left: 0px;
            opacity: 1;
        }
    }

    .image-animation2 {
        animation-name: image2-animation;
        animation-duration: 1.5s;
    }

    .image-animation3 {
        animation-name: image3-animation;
        animation-duration: 1.5s;
    }

    @@keyframes image3-animation {
        0% {
            right: -1000px;
            opacity: 0;
        }

        100% {
            right: 0px;
            opacity: 1;
        }
    }

    @@media only screen and (max-device-width: 1280px) {
        .product-header {
            font-size: 1.5rem;
        }

        .product-subheader {
            font-size: 16px;
            padding-top: 1.5rem;
        }

        .product-detail, .product-text {
            font-size: 14px;
        }

        .detail-head {
            bottom: 80px;
        }

        .align-item-head {
            padding-top: 0px;
        }

        #btnAddToCart {
            right: 15px;
            bottom: 40px;
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) {
        .product-header {
            font-size: 1.75rem;
        }

        .product-subheader {
            font-size: 20px;
            padding-top: 3rem;
        }

        .product-detail, .product-text {
            font-size: 18px;
        }
    }

    @@media only screen and (min-device-width: 1920px) {
        .product-header {
            font-size: 2rem;
        }

        .product-subheader {
            font-size: 24px;
            padding-top: 3rem;
        }

        .product-detail, .product-text {
            font-size: 22px;
        }
    }
</style>

@Html.Partial("_Modal_Video", Model)

@using (Html.BeginForm("RFIDProductPage", "RFIDDashboard", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
    <div class="product-container">
        <div class="row">
            <div class="col-sm-3 first-col-align-item">
                <div class="product-detail-head align-item-head detail-head">
                    <div>
                        <p class="product-header bold m-0">@Model.CATEGORY</p>
                        <p class="product-text pt-2 m-0">Chop No: @Model.CHOP_NO</p>
                        <p class="h5 bold dark-blue">____________</p>
                        <div id="color-selection2">
                            <div id="color-selection-content2" class="d-flex">

                            </div>
                        </div>
                    </div>
                </div>
                <img class="fitImage2 image-width2 left image-animation" id="image2" />
            </div>
            <div class="col-sm-5 detail-background">
                <div class="detail-background-firsthalf">
                    <img class="fitImage3 image-width3 image-animation2" id="image1" />
                </div>
                <div class="product-detail product-detail-width">
                    <div class="product-detail-body">
                        <p class="product-subheader h5 bold"><u>Product Details</u></p>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Composition:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.COMPOSITION</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Weave Type:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.WEAVE_TYPE</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Width:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.FINISH_WIDTH1 @Model.UOM</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Location:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.HANGER_LOC</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Weight:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="">@Model.FAB_WEIGHT_GSM gsm</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="col-sm-12">
                                    <p class="bold pt-2 mb-sm-0">Sample Availability:</p>
                                </div>
                                <div class="col-sm-12">
                                    <label class="" id="currentQtyLbl"></label>
                                </div>
                            </div>
