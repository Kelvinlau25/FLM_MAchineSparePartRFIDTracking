        initSlider();
    }

    function initSlider() {
        var lowerSlider = document.querySelector('#lower'),
            upperSlider = document.querySelector('#upper');

        lowerSlider.oninput = function () {
            this.value = Math.min(this.value, this.parentNode.childNodes[5].value - 1);
            var value = (100 / (parseInt(this.max) - parseInt(this.min))) * parseInt(this.value) - (100 / (parseInt(this.max) - parseInt(this.min))) * parseInt(this.min);
            var children = this.parentNode.childNodes[1].childNodes;
            children[1].style.width = value + '%';
            children[5].style.left = value + '%';
            children[7].style.left = value + '%';
            $('#rangeMinTxt').val(this.value);
        };

        upperSlider.oninput = function () {
            this.value = Math.max(this.value, this.parentNode.childNodes[3].value - (-1));
            var value = (100 / (parseInt(this.max) - parseInt(this.min))) * parseInt(this.value) - (100 / (parseInt(this.max) - parseInt(this.min))) * parseInt(this.min);
            var children = this.parentNode.childNodes[1].childNodes;
            children[3].style.width = (100 - value) + '%';
            children[5].style.right = (100 - value) + '%';
            children[9].style.left = (value + 2) + '%';
            $('#rangeMaxTxt').val(this.value);
        };
    }

    function updateRangeMin(inputValue) {
        if (inputValue > 200 || inputValue >= parseInt($('#rangeMaxTxt').val())) {
            $('#rangeMinTxt').val($('#rangeMaxTxt').val() - 1);
        }
        else if (inputValue < 0) {
            $('#rangeMinTxt').val(0);
        }

        lowerSlider.value = Math.min(inputValue, lowerSlider.parentNode.childNodes[5].value - 1);
        var value = (100 / (parseInt(lowerSlider.max) - parseInt(lowerSlider.min))) * parseInt(lowerSlider.value) - (100 / (parseInt(lowerSlider.max) - parseInt(lowerSlider.min))) * parseInt(lowerSlider.min);
        var children = lowerSlider.parentNode.childNodes[1].childNodes;
        children[1].style.width = value + '%';
        children[5].style.left = value + '%';
        children[7].style.left = value + '%';
        $('#rangeMinTxt').val(lowerSlider.value);
    }

    function updateRangeMax(inputValue) {
        if (inputValue <= parseInt($('#rangeMinTxt').val()) || isNaN(inputValue)) {
            $('#rangeMaxTxt').val(parseInt($('#rangeMinTxt').val()) + 1);
        }
        else if (inputValue > 600) {
            $('#rangeMaxTxt').val(600);
        }

        upperSlider.value = Math.max(inputValue, upperSlider.parentNode.childNodes[3].value - (-1));
        var value = (100 / (parseInt(upperSlider.max) - parseInt(upperSlider.min))) * parseInt(upperSlider.value) - (100 / (parseInt(upperSlider.max) - parseInt(upperSlider.min))) * parseInt(upperSlider.min);
        var children = upperSlider.parentNode.childNodes[1].childNodes;
        children[3].style.width = (100 - value) + '%';
        children[5].style.right = (100 - value) + '%';
        children[9].style.left = (value + 2) + '%';
    }

    function checkSelectionLimit() {
        // Get selected options.
        var selectedOptions = $('.multiselectpicker option:selected');
        var selectLimit = $("#selectLimit");

        if (selectedOptions.length >= 6) {
            // Disable all other checkboxes.
            var nonSelectedOptions = $('.multiselectpicker option').filter(function () {
                return !$(this).is(':selected');
            });

            nonSelectedOptions.each(function () {
                var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                input.prop('disabled', true);
                input.parent('li').addClass('disabled');
            });
        }
        else {
            // Enable all checkboxes.
            $('.multiselectpicker option').each(function () {
                var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                input.prop('disabled', false);
                input.parent('li').addClass('disabled');
            });
        }
        selectLimit.text(selectedOptions.length + " out of 6")
    }

    function Action(act)
    {
        switch (act)
        {
            case "Product Activation": case "Product Deactivation":
                console.log(act)
                showConfirmationModal(act);
                break;
            case "Edit Category":
                editCategory();
                break;
            default:

                break;
        }
    }

    function editCategory()
    {
         var selectedValues = [];
         var selectedRows = table.rows({ selected: true }).data().toArray();
         selectedRows.forEach(function (rowData) {
             var checkboxValue = rowData["PRODUCT_H_ID"];
             selectedValues.push(checkboxValue);
         });
         var selectedStr = selectedValues.join(',');

         var url = '@Url.Action("MM_ProductRegistration_EditCategory", "MM_ProductRegistration")?editID=' + selectedStr;
         window.location.href = url;
    }

    function initButtonFunction()
    {
        $("#ulAction > li").each(function () {
            var cat = $(this).find("a").data("cat");
            if (cat == "Edit Category") {
                $(this).find("a").attr("id", "btnEdit");
                $(this).find("a").removeClass('btn btn-secondary');
            }
            else if (cat == "Delete")
            {
                $(this).find("a").attr("data-bs-toggle", "modal");
                $(this).find("a").attr("data-bs-target", "#confirmation-modal");
                $(this).find("a").removeClass('btn btn-secondary');
            }
        });
        $("#btnAuditTrail").click(function () {
            
            var selectedValues = [];
            var selectedRows = table.rows({ selected: true }).data().toArray();
            selectedRows.forEach(function (rowData) {
                var checkboxValue = rowData;
                selectedValues.push(checkboxValue);
            });

            if (selectedValues.length >= 2) {
                const toastLiveExample = document.getElementById('liveToast1');
                const toast = new bootstrap.Toast(toastLiveExample);
                toast.show();
                return;
            } else if (selectedValues.length == 0) {
                const toastLiveExample = document.getElementById('liveToast2');
                const toast = new bootstrap.Toast(toastLiveExample);
                toast.show();
                return;
            } else {
                selectedValues.forEach(function (element) {
                    var url = '@Url.Action("MM_ProductRegistration_AuditTrail", "MM_ProductRegistration")';
                    window.location.href = url + '?id=' + element.PRODUCT_H_ID;
                });
            }
        });
        $('#btnConfirm2').on('click', function () {
            var selectedValues = [];
            var selectedRows = table.rows({ selected: true }).data().toArray();
            selectedRows.forEach(function (rowData) {
                var checkboxValue = rowData["PRODUCT_H_ID"];
                selectedValues.push(checkboxValue);
            });

            $.ajax({
                url: '/MM_ProductRegistration/MM_ProductRegistration_DeleteListing',
                type: 'POST',
                data: { deleteID: selectedValues },
                success: function (response) {
                    if (response.isSuccess == "Success") {
                        Swal.fire({
                            title: "Success",
                            text: "Successfully Deleted.",
                            icon: "success",
                            showCancelButton: false,
                            confirmButtonText: "OK"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // User pressed "OK", redirect to another view
                                window.location.href = "/MM_ProductRegistration/MM_ProductRegistration";
                            }
                        });
                    } else {
                        Swal.fire('Failed!', 'Failed Delete.', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire('Error!', error, 'error');
                }
            });
        });

        $("#btnConfirmAct").click(function ()
        {
            var type = $(this).data("action");

            var status = ["Inactive", "Active"];
            var txt = ""
            if (type == 0) {
                txt = "Successfully deactivate the product";
            }
            else {
                txt = "Successfully activate the product";
            }

            var selectedValues = [];
            var selectedRows = table.rows({ selected: true }).data().toArray();
            selectedRows.forEach(function (rowData) {
                var checkboxValue = rowData["PRODUCT_H_ID"];
                selectedValues.push(checkboxValue);
            });

            $.ajax({
                url: '/MM_ProductRegistration/MM_ProductRegistration_ProductActDeact',
                type: 'POST',
                data: { type: status[type], id: selectedValues },
                success: function (response) {
                    if (response.isSuccess == "Success") {
                        Swal.fire({
                            title: "Success",
                            text: txt,
                            icon: "success",
                            showCancelButton: false,
                            confirmButtonText: "OK"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // User pressed "OK", redirect to another view
                                window.location.href = "/MM_ProductRegistration/MM_ProductRegistration";
                            }
                        });
                    } else {
                        Swal.fire('Failed!', 'Failed.', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire('Error!', error, 'error');
                }
            });
        })


    }

    function showConfirmationModal(act)
    {
        var message = ""
        //"Product Activation"
        if (act == "Product Activation") {
            message = "Are you sure you want to activate the selected product?";
            $("#btnConfirmAct").data("action",1)
        }
        else //"Product Deactivation"
        {
            message = "Are you sure you want to deactivate the selected product?";
            $("#btnConfirmAct").data("action", 0)
        }
        $("#productActDeact").text(message);
        $("#activation-modal").modal("show");
    }

