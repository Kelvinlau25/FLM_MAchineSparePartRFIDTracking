<!-- Common Listing JavaScript -->
<script src="~/ViewsHelpers/CommonListing/Listing.js"></script>

<script>
    var urlGetData = "/MM_ProductRegistration/GetProductListAsync"
    var table;
    var data = [], dataAll = [];

    $(document).ready(function () {

        onPageLoad();

        $('#rangeMinTxt').on('input', function () {
            var inputValue = $(this).val();
            updateRangeMin(inputValue);
        });

        $("#rangeMaxTxt").blur(function () {
            var inputValue = $(this).val();
            updateRangeMax(inputValue);
        });

        $('.multiselectpicker').multiselect({
            buttonClass: 'form-select form-control text-start',
            includeResetOption: true,
            includeResetDivider: true,
            resetText: "CLEAR",
            selectAllText: ' Select all',
            includeSelectAllOption: true,
            onSelectAll: function () {
                // Custom code to limit the selection to the top 6 options
                var selectedOptions = $(".multiselectpicker").val() || [];
                if (selectedOptions.length > 6) {
                    var firstSixOptions = selectedOptions.slice(0, 6);
                    $(".multiselectpicker").multiselect("deselectAll", false)
                        .multiselect("select", firstSixOptions);
                }

                checkSelectionLimit();
            },
            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" for="finishedTypeMulti" ><input type="checkbox" class="form-check-input" id="finishedTypeMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn"></button></div></br><div class="text-start" id="selectLimit" style="padding:5px 11px;">0 out of 6</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit();
            }
        });

        $("#resetBtn").click(function () {
            checkSelectionLimit();
        });

        $('.tr-select').select2({
            theme: "bootstrap-5",
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            placeholder: $(this).data('placeholder'),
            minimumResultsForSearch: Infinity,
            templateSelection: function formatState(state) {
                return 'Status : ' + state.element.value;
            },
            dropdownCssClass: 'tr-select2-container',
            selectionCssClass: 'tr-no-border'
        });

        $('#select-id2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" id="fabricTypDdl" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });

        $('.multiselect-native-select > .btn-group').addClass("w-100");
        $('.dataTables_length .multiselect-native-select > .btn-group').removeClass("w-100");
        $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
        $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");

        $('#btnSearchAS').on('click', function () {
            table.columns(1).search($('#REFERENCE_NO_SEARCH').val().trim());
            table.columns(12).search($('#WARP_COUNT_SEARCH').val().trim());
            table.columns(2).search($('#CHOP_NO_SEARCH').val().trim());
            table.columns(13).search($('#WEFT_COUNT_SEARCH').val().trim());
            if ($('#fabricTypDdl').text() != 'ALL') {
                table.columns(4).search($('#fabricTypDdl').text());
            }
            else {
                table.columns(4).search('');
            }
            table.columns(6).search($('#WEAVE_TYPE_SEARCH').val().trim());
            table.columns(14).search($('#COMPOSITION_SEARCH').val().trim());
            table.columns(15).search($('#WARP_DENSITY_SEARCH').val().trim());
            table.columns(16).search($('#WEFT_DENSITY_SEARCH').val().trim());
            table.columns(17).search($('#FIN_WARP_DENSITY_SEARCH').val().trim());
            table.columns(18).search($('#FIN_WEFT_DENSITY_SEARCH').val().trim());
            table.columns(19).search($('#FINISH_WIDTH1_SEARCH').val().trim());
            table.columns(7).search($('#WIDTH_SEARCH').val().trim());
            table.columns(20).search($('#FINISH_WIDTH2_SEARCH').val().trim());
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var minNum = parseInt($('#rangeMinTxt').val());
                var maxNum = parseInt($('#rangeMaxTxt').val());

                var weight = parseFloat(data[8]) || 0;
                if ((minNum <= weight) && (maxNum >= weight)) {
                    return true;
                }
                return false;
            });

            var finishedTypeArr = [], finishTypeCount = 0;
            $('#multiselect-id1 option:selected').each(function () {
                finishedTypeArr.push($(this).val());
            });

            if (finishedTypeArr.length != 0) {
                $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                    var finishedTypeArr = [], finishTypeCount = 0;
                    $('#multiselect-id1 option:selected').each(function () {
                        finishedTypeArr.push($(this).val());
                    });
                    finishTypeCount = 0;
                    for (var i = 0; i < finishedTypeArr.length; i++) {

                        if (data[21].includes(finishedTypeArr[i]) == true) {
                            finishTypeCount++;
                        }
                    }
                    if (finishTypeCount == finishedTypeArr.length) { return true; }
                    else {
                        if (finishedTypeArr.length == 0) {
                            return true;
                        }
                        else return false;
                    }
                });
            }

            table.draw();
            adjustDataTableColumn();

        });

        $('#btnReset').on('click', function () {
            $('.modal-body :input[type=text]').val('');

            //reset Fabric Type dropdown in advanced search
            $('#select-id2').next().find('.multiselect-option').first().click();

            $('#rangeMinTxt').val(0);
            $('#rangeMaxTxt').val(600);
            updateRangeMin(0);
            updateRangeMax(600);
            $("#resetBtn").click();

        });

        $('.tr-select').on('change', function (e) {
            if (e.target.value == "All") {
                data = dataAll;
            } else {
                data = dataAll.filter(x => x.STATUS.toString() == e.target.value);
            }
            $('.tr-rec').text(data.length);
            table.clear().rows.add(data).draw();
        });

        table.on('select deselect', function () {
            var rowCnt = table.rows({ selected: true }).count();
            if (rowCnt > 0) {
                $("#btnAction").removeClass('hidden');
            } else {
                $("#btnAction").addClass('hidden');
            }
        });
    });

    function onPageLoad() {
        initPage();
