@model PAB_NewAquarium.Models.Product_H_Detail  

@{
    ViewBag.Title = "MM_ProductRegistration_View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string referenceNo = Model.REFERENCE_NO;
    string status = Model.STATUS;
}

<style>
    .card-height {
        overflow-y: scroll;
    }

    @@media only screen and (max-device-width: 1280px) {
        .card-height {
            height: calc(100vh - 55px - 55px - 60px - 40px - 30px);
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) {
        .card-height {
            height: calc(100vh - 55px - 55px - 60px - 40px - 30px);
        }
    }

    @@media only screen and (min-device-width: 1920px) {
        .card-height {
            height: calc(100vh - 70px - 70px - 70px - 60px - 30px);
        }
    }

    #viewMoreButton {
        background-color: transparent;
        border: none;
        cursor: pointer;
        padding-right: 0px;
        color: #004098;
        text-decoration: underline;
    }

    .checkboxCustom {
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
        cursor: default;
    }

    .image-container {
        position: relative;
        display: inline-block;
        margin-right: 10px;
        margin-bottom: 10px;
    }

    .borderBottomImg {
        border-bottom: 1px solid lightgray;
    }

    .image-element {
        height: 100px;
        width: 100px;
        border-radius: 0.5rem;
    }
</style>

@using (Html.BeginForm("MM_ProductRegistration_View", "MM_ProductRegistration", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.PRODUCT_H_ID)
    <div class="row g-0 px-3 tr-listing-header">
        <div class="col-sm-6 align-self-center">
            <p class="text-muted m-0 tr-listing-header-title">Fabric Registration - @referenceNo - @status</p>
        </div>
        <div class="col-sm-6 text-end align-self-center">
            <div class="d-flex justify-content-end">
                <div id="customDTButton">
                </div>
            </div>
        </div>
    </div>
    <div class="tr-btm-line"></div>
    <div class="page-container px-3">
        <div class="tr-btm-btn-margin">
            <div class="card mt-3 mb-2 card-height">
                <div class="card-body">
                    <div class="row align-items-baseline">
                        <div class="col"><h6 class="text-muted card-title">Fabric Detail</h6></div>
                        <div class="col text-end"><button class="btn btn-sm btn-primary" id="btnEdit" type="button" onclick="location.href='@Url.Action("MM_ProductRegistration_Edit","MM_ProductRegistration")?id=' + @Model.PRODUCT_H_ID + '&status=' + '@Model.STATUS'" data-behaviour="toggle">Edit</button></div>
                    </div>
                    <hr />
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Ref No <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.REFERENCE_NO, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Warp Count <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.WARP_COUNT1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Chop No <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CHOP_NO, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Weft Count <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.WEFT_COUNT1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Fabric Type <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.FABRIC_TYPE, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Finished Type <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.FINISH_TYPE1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Weave Type <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.WEAVE_TYPE, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Composition <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.COMPOSITION, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="additional-content" style="display:none;">
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Warp Density <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.WARP_DENSITY, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Weft Density <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.WEFT_DENSITY, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Fin Warp Density <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.FIN_WARP_DENSITY, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Fin Weft Density <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.FIN_WEFT_DENSITY, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Finish Width 1 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.FINISH_WIDTH1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Grey Width <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.WIDTH, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Finish Width 2 <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.FINISH_WIDTH2, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Fabric Weight <span class="float-end">:</span></p>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(model => model.FAB_WEIGHT_GSM, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">

                        </div>
                        <div class="col-sm-4">

                        </div>
                        <div class="col-sm-2">

                        </div>
                        <div class="col-sm-4">
                            <button type="button" class="float-end" id="viewMoreButton">View More</button>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Product Type <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.PRODUCT_TYPE1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Material <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.MATERIAL_TYPE1, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Category <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CATEGORY, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">RFID Tag <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.RFID, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Video Category<span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.VIDEO_CAT_NAME, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Location <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.HANGER_LOC, null, new { @class = "form-control", @readonly = true, @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Owned By <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <label class="multiselect-all btn btn-sm btn-block checkboxCustom" for="ownedByChkbox">@Html.CheckBoxFor(m => m.RUNNING_NO, new { @class = "form-check-input me-sm-2", id = "ownedByChkbox", disabled = "disabled" }) Hot Sales</label>
                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Classified By <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            <label class="multiselect-all btn btn-sm btn-block checkboxCustom" for="classifiedByChkbox">@Html.CheckBoxFor(m => m.ISGARMENT, new { @class = "form-check-input me-sm-2", id = "classifiedByChkbox", disabled = "disabled" }) Garment</label>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Upload Image <span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-10" id="imgUploadRow">

                        </div>
                    </div>
                </div>
                </div>
            <div class="row tr-btm-btn-area">
                <div class="col"><button id="btnDelete" type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#confirmation-modal">Delete</button></div>
                <div class="col">
                    <div class="row row-cols-auto justify-content-end isNotEditable" style="padding-right: 20px">
                        <div class="col"><button id="btnCancel" type="button" class="btn btn-sm btn-secondary" onclick="location.href='@Url.Action("MM_ProductRegistration","MM_ProductRegistration")'">Back</button></div>
                    </div>
                    <div class="row row-cols-auto justify-content-end isEditable g-1" style="display:none; padding-right: 20px">
                        <div class="col"><button id="btnBack" type="button" class="btn btn-sm btn-secondary">Back</button></div>
                        <div class="col"><button id="btnSubmit" type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal">Submit</button></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to delete this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" value="delete" name="btn" id="btnConfirm2">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed toast-alert">
        <div id="liveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
            <div class="toast-header" style="background-color: #FFF0EE">
                <strong class="me-auto text-danger">Warning!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Failed to delete.
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed toast-success">
        <div id="liveToast2" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto" style="color: #00A251">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Delete Successfully.
            </div>
        </div>
    </div>
}

<script>
    var imageData = @Html.Raw(Model.imageList);
    var colorCount = 0;

    $(document).ready(function () {
        $("#viewMoreButton").click(function () {
            $(".additional-content").slideToggle();
            var buttonText = "";
            if ($(this).text() === "View More") {
                buttonText = "View Less";
                $(this).css('color', '#FF3366');
            }
            else {
                buttonText = "View More";
                $(this).css('color', '#004098');
            }
            $(this).text(buttonText);
        });

        $('#btnConfirm2').click(function () {
            $('#confirmation-modal').modal('hide');
        });

        generateImagePreview();
    });

    function generateImagePreview() {
        for (var i = 0; i < imageData.length; i++) {
            for (var j = 0; j < imageData[i].imageName.length; j++) {
                var COLOR_WAY = imageData[i].COLOR_WAY;
                var imageName = (imageData[i].imageName[j]);
                var url = imageData[i].imageFile[j];
                var imageDiv = $("<div>").attr("class", "imageDiv mt-2 borderBottomImg pb-3");
                var colorWay = $("<p>");
                var numOfImg = $("<span>");
                var imgContainer = $("<div>").attr("class", "image-container");
                var isColorExist = false;
                var matchedColorID;
                var img = $("<img>").attr("src", url);
                img.attr("class", "image-element");

                $(".imageDiv").each(function (index, element) {
                    var color = $(element).find("p").text();
                    if (color.includes(COLOR_WAY)) {
                        isColorExist = true;
                        matchedColorID = $(this).attr("id");
                    }
                });
                if (isColorExist == false) {
                    colorCount++;
                    imageDiv.attr("id", "imageDiv" + colorCount);
                    colorWay.text(colorCount + ". " + COLOR_WAY);
                    numOfImg.text("1 out of 5");
                    numOfImg.attr("class", "float-end");
                    imgContainer.append(img);
                    imageDiv.append(colorWay);
                    colorWay.append(numOfImg);
                    imageDiv.append(imgContainer);
                    $('#imgUploadRow').append(imageDiv);
                }
                else {
                    var currentImageDiv = $("#" + matchedColorID);
                    if (currentImageDiv.find(".image-container").length < 6) {
                        var currentDivImgCount = currentImageDiv.find(".image-container").length + 1
                        currentImageDiv.find("span").text(currentDivImgCount + " out of 5");
                        imgContainer.append(img);
                        currentImageDiv.append(imgContainer);
                    }
                }
            }
        }

    }
</script>

@{
    if (ViewBag.Result != "Duplicated Reference No" && ViewBag.Result != null)
    {
        <script>
        const toastLiveExample = document.getElementById('liveToast2');
        const toast = new bootstrap.Toast(toastLiveExample);
        toast.show();
            setTimeout(function () {
                var url = '@Url.Action("MM_ProductRegistration", "MM_ProductRegistration")';
                window.location.href = url;
            }, 2000);
        </script>
    }
    else if (ViewBag.Result == "Duplicated Reference No")
    {
        <script>
            const toastLiveExample = document.getElementById('liveToast');
            const toast = new bootstrap.Toast(toastLiveExample);
            toast.show();
        </script>
    }
}

