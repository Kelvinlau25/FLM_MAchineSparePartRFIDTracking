@model PAB_NewAquarium.Models.Product_H_Array

@{
    ViewBag.Title = "MM_ProductRegistration_EditCategory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #viewMoreButton {
        background-color: transparent;
        border: none;
        cursor: pointer;
        padding-right: 0px;
    }

    .checkboxCustom {
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
        cursor: default;
    }

    .multiselect-reset .multiselect-all:hover {
        background-color: transparent !important;
    }

    .multiselectDdlCustom {
        font-weight: bold;
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
    }

    .btn-reset {
        float: right;
    }

        .btn-reset:hover {
            background-color: transparent;
        }

    #productTypeMulti, #materialTypeMulti, #categoryMulti {
        margin-right: 9px;
        display: none;
    }

    @@media (min-width: 768px) {
        .multiselect-all {
            float: left;
            padding-left: 0.2rem !important;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, -33px) !important;
        }

        .arrow-bar {
            display: block;
            background-color: #000;
            width: 130px;
            height: 2px;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
        }

        .arrow-head {
            font-size: 40px;
            color: #000;
            position: absolute;
            top: 10%;
            transform: translateY(-50%);
            left: 120px;
        }
    }

    @@media (min-width: 1400px) {
        .multiselect-all {
            float: left;
            text-align: left;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, 41px) !important;
        }

        .arrow-bar {
            display: block;
            background-color: #000;
            width: 230px;
            height: 2px;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
        }

        .arrow-head {
            font-size: 40px;
            color: #000;
            position: absolute;
            top: 10%;
            transform: translateY(-50%);
            left: 210px;
        }
    }

    #select-id + .btn-group {
        display: flex;
    }

        #select-id + .btn-group .text-center {
            text-align: left !important;
        }

        #select-id + .btn-group .multiselect-container {
            width: 100% !important;
        }

    .tr-select2 + .btn-group > .multiselect-container input[type="text"] {
        visibility: visible;
    }

    .grayed-out {
        background-color: #F0F0F0;
        pointer-events: none;
        box-shadow: 0 0 0 0.01rem #c2cdf6;
    }

    .long-arrow {
        display: inline-block;
        position: relative;
        height: 10px;
    }

    .product-card {
        background-color:#F0F0F0; 
        border:1px solid black;
        padding-bottom: 10px;
    }
    
</style>


@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()

    <div class="row g-0 px-3 tr-listing-header">
        <div class="col-sm-6 align-self-center">
            <p class="text-muted m-0 tr-listing-header-title">Product</p>
        </div>
        <div class="col-sm-6 text-end align-self-center">
            <div class="d-flex justify-content-end">
                <div id="customDTButton">
                </div>
            </div>
        </div>
    </div>
    <div class="tr-btm-line"></div>
    <div class="page-container px-3 overflow-auto">
        <div class="tr-btm-btn-margin">
            <div class="card mt-3 mb-2 card-height">
                <div class="card-body">
                    <div class="row align-items-baseline">
                        <div class="col"><h6 class="text-muted card-title">Edit Category</h6></div>
                    </div>
                    <hr />
                    @for (int i = 0; i < @ViewBag.ProductNum; i++)
                    {
                        @Html.HiddenFor(model => model.Product_H_Detail_Category[i].PRODUCT_H_ID)
                        @Html.HiddenFor(model => model.Product_H_Detail_Category[i].CATEGORY)
                        <div class="row mt-2 align-items-baseline product-card">
                            <div class="row mt-2 align-items-baseline">
                                <div class="col"><h6 class="text-muted card-title">Item @(i + 1)</h6></div>
                            </div>
                            <div class="row mt-2 align-items-baseline">
                                <div class="col-sm-2">
                                    <p class="text-muted">Ref No <span class="float-end">:</span></p>
                                </div>
                                <div class="col-sm-3">
                                    @Html.TextBoxFor(model => model.Product_H_Detail_Category[i].REFERENCE_NO, null, new { @class = "form-control grayed-out" })
                                </div>
                                <div class="col-sm-2">
                                    <div class="long-arrow">
                                        <span class="arrow-bar"></span>
                                        <span class="arrow-head">&#8594;</span>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <p class="text-muted">Category <span class="float-end">:</span></p>
                                </div>
                                <div class="col-sm-3">
                                    @{
                                        int count = i + 1;
                                    }
                                    @Html.DropDownListFor(model => model.Product_H_Detail_Category[i].CATEGORY_SELECTED, Model.Product_H_Detail_Category[i].CATEGORY_DDL, null, new { @class = "multiselectpicker form-control", multiple = "multiple", id = "multiselect-id" + count })
                                </div>
                            </div>
                            <div class="row mt-2 align-items-baseline">
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-3">
                                    Current Category as below:
                                </div>
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-3">

                                </div>
                            </div>
                            <div class="row mt-2 align-items-baseline">
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-3">
                                    @if (Model.Product_H_Detail_Category[i].CATEGORY_SELECTED != null)
                                    {
                                        for (int j = 0; j < Model.Product_H_Detail_Category[i].CATEGORY_SELECTED.Count; j++)
                                        {
                                            string number = j + 1 + ". ";
                                            <span>@number @Model.Product_H_Detail_Category[i].CATEGORY_SELECTED[j]</span><br />
                                        }
                                    }
                                    else
                                    {
                                        <span>N/A</span><br />
                                    }
                                </div>
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-2">

                                </div>
                                <div class="col-sm-3">

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col"></div>
                <div class="col">
                    <div class="row row-cols-auto justify-content-end isEditable g-1" style="padding-right: 20px">
                        <div class="col"><button id="btnBack" type="button" class="btn btn-sm btn-secondary" onclick="location.href='@Url.Action("MM_ProductRegistration","MM_ProductRegistration")'">Back</button></div>
                        <div class="col"><button id="btnSubmit" type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal">Submit</button></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="submit-confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to submit this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" value="submit" name="btn" id="btnConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed toast-alert">
        <div id="liveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
            <div class="toast-header" style="background-color: #FFF0EE">
                <strong class="me-auto text-danger">Warning!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Failed to submit, Duplicated Company Name.
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed toast-success">
        <div id="liveToast2" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto green">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Submit Successfully.
            </div>
        </div>
    </div>
}

    <script>
        var modelData = @Html.Raw(Json.Encode(Model.Product_H_Detail_Category));
        var clickSequence = 1;
    $(document).ready(function () {
        $("#viewMoreButton").click(function () {
            $(".additional-content").slideToggle();
            console.log($(this).text())
            var buttonText = $(this).text() === "View More" ? "View Less" : "View More";
            $(this).text(buttonText);
            var arrowUp = "<div class='fas fa-chevron-up dropdown-toggle-icon dark-blue ms-2'></div>";
            var arrowDown = "<div class='fas fa-chevron-down dropdown-toggle-icon dark-blue ms-2'></div>";
            $(this).append(buttonText === "View More" ? arrowDown : arrowUp);
        });

        $('.dataTables_length select').addClass('tr-select2');

        for (var productCount = 0; productCount < modelData.length; productCount++) {
            var categorySelected = modelData[productCount].CATEGORY_SELECTED;
            if (categorySelected != null) {
                for (var i = 0; i < categorySelected.length; i++) {
                    $("#multiselect-id" + (productCount + 1) + " option:contains('" + categorySelected[i].trim() + "')").prop("selected", true);
                }
            }
        }

        $('.multiselectpicker').multiselect({
            buttonClass: 'form-select form-control text-start',
            includeResetOption: true,
            includeResetDivider: true,
            resetText: "CLEAR",
            selectAllText: ' Select all',
            includeSelectAllOption: true,
            onSelectAll: function () {
                checkSelectionLimit();
            },
            onDeselectAll: function () {
                checkSelectionLimit();
            },
            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" for="materialTypeMulti" ><input type="checkbox" class="form-check-input" id="materialTypeMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn"></button></div></br><div class="text-start selectLimit" id="selectLimit" style="padding:5px 11px;">0 out of @ViewBag.CategoryNum</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit();
            }
        });

        $(".btn-reset").click(function () {
            checkSelectionLimit();
        });

        function checkSelectionLimit() {
            // Get selected options.
            var selectedOptions = $('#multiselect-id' + clickSequence + ' option:selected');
            var selectLimit = $('#multiselect-id' + clickSequence).parent().find(".selectLimit");
            console.log(selectLimit.text())

                $('.multiselectpicker option').each(function () {
                    var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                    input.prop('disabled', false);
                    input.parent('li').addClass('disabled');
                });
            selectLimit.text(selectedOptions.length + " out of @ViewBag.CategoryNum")
        }

        $("#btnConfirm").click(function () {
            setTimeout(function () {
                if ($('.field-validation-error').length > 0) {
                    $('#submit-confirmation-modal').modal('hide');
                }
            }, 1000);
        });

        $('.multiselect-native-select > .btn-group').addClass("w-100");
        $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
        $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");

        checkSelectionLimit();

        $(".multiselect.dropdown-toggle.form-select").click(function () {
            var multiselectId = $(this).parent().parent().find('.multiselectpicker.form-control').attr('id');
            var substringToRemove = "multiselect-id";
            clickSequence = multiselectId.replace(new RegExp(substringToRemove, 'g'), '');
            checkSelectionLimit();
        });

    });

    


    </script>


@{
    if (ViewBag.Result != "Duplicated Company Name" && ViewBag.Result != null)
    {
        <script>
        const toastLiveExample = document.getElementById('liveToast2');
        const toast = new bootstrap.Toast(toastLiveExample);
        toast.show();
            setTimeout(function () {
                var url = '@Url.Action("MM_ProductRegistration", "MM_ProductRegistration")';
                window.location.href = url;
            }, 2000);
        </script>
    }
    else if (ViewBag.Result == "Duplicated Company Name")
    {
        <script>
            const toastLiveExample = document.getElementById('liveToast');
            const toast = new bootstrap.Toast(toastLiveExample);
            toast.show();
        </script>
    }
}
