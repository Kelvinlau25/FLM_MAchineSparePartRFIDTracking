    //save image into temp folder
    function saveImageToTemp(colorWay, imageName) {
        const formData = new FormData();
        var referenceNo = $('#idReferenceNo').val();
        formData.append("imageData", $("#imgHidden").val()); // Add the image data to the form data
        formData.append("referenceNo", referenceNo);
        formData.append("colorWay", colorWay);
        formData.append("imageName", imageName);

        $.ajax({
            url: "/MM_ProductRegistration/SaveImageToTemp",
            type: "POST",
            data: formData,
            processData: false, // Prevent jQuery from converting the data to a query string
            contentType: false, // Set the content type to false to prevent jQuery from setting the content type
            success: function (result) {
                // Handle the response from the server
            }
        });
    }

    // Initialize RFID reader
    function initReader() {
        if (readerObj == null) {
            showAlert("Error", "RFID has not been set up yet");
        } else {


            Swal.fire({
                title: 'Loading...',
                html: 'Please wait while the RFID reader is connecting.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading(); // Show loading spinner
                }
            });

            hub.client.broadcastMessage = function (type, message) {
                if (type == "Success") {

                    window.onbeforeunload = function () {
                        hub.server.stopRFID(connectionId);
                    };

                    Swal.fire({
                        title: 'Connected!',
                        text: message,
                        //text: 'RFID Service is ready.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                else {
                    Swal.fire({
                        title: 'Error!',
                        text: message,
                        //text: 'Failed to start RFID Service.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            };

            hub.client.broadcastTag = function (tag) {
                $('#RFID').val(tag);
            };


            // Start the SignalR connection
            $.connection.hub.start().done(function () {
                connectionId = $.connection.hub.id;

                hub.server.startRFID(readerObj, connectionId, connectionHub)
                    .done(function () {

                    })
                    .fail(function (error) {
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to start RFID Service.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    });

            }).fail(function () {
                Swal.fire({
                    title: 'Error!',
                    text: 'Failed to connect RFID Service.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            });
        }
    }

    // Custom confirm() function
    function customConfirm(html, callback) {
        $('#customConfirm.modal-body').empty();
        $('#customConfirm.modal-body').append(html);
        $('#customConfirmModal').modal("show");

        $('#btnConfirmReplace').off('click').on('click', function () {
            if (typeof callback === 'function') {
                callback("Y");
            }
            $('#customConfirmModal').modal("hide");
            $('#removeBtn').css('display', 'none');
        });

        $('#btnCancel2').off('click').on('click', function () {
            if (typeof callback === 'function') {
                callback("N");
            }
            $('#customConfirmModal').modal("hide");
        });
    }

    //generate image on page initiate
    function generateImagePreview() {
        var imageData = @Html.Raw(Model.imageList);
        var imgID = ""

        for (var i = 0; i < imageData.length; i++) {

            imgID += imageData[i].imageID.join(",");
            for (var j = 0; j < imageData[i].imageName.length; j++) {
                var COLOR_WAY = imageData[i].COLOR_WAY;
                var imageName = (imageData[i].imageName[j]);
                var url = imageData[i].imageFile[j];
                var imageDiv = $("<div>").attr("class", "imageDiv mt-2 borderBottomImg pb-3");
                var colorWay = $("<p class='custom-color-count'>");
                var numOfImg = $("<span>");
                var imgContainer = $("<div>").attr("class", "image-container");
                var btnDelete = $("<button>").attr("class", "delete-button");
                var crossIcon = $("<i>").attr("class", "fas fa-times");
                var isColorExist = false;
                var matchedColorID;
                btnDelete.attr("id", imageName);
                btnDelete.attr("name", COLOR_WAY.trim().replace(/ /g, "~"));
                btnDelete.attr("onclick", "deleteImage(this,'" + url.split("?")[0] + "','" + imageData[i].imageID[j] +"')");
                btnDelete.attr("data-src", imageData[i].imageFile[j].split("?")[0])
                btnDelete.attr("type", "button");
                var img = $("<img>").attr("src", url);
                img.attr("class", "image-element");

                $(".imageDiv").each(function (index, element) {
                    var color = $(element).find("p").text();
                    if (color.includes(COLOR_WAY)) {
                        isColorExist = true;
                        matchedColorID = $(this).attr("id");
                    }
                });
                if (isColorExist == false) {
                    colorCount++;
                    imageDiv.attr("id", "imageDiv" + colorCount);
                    imageDiv.attr("data-color", COLOR_WAY);
                    colorWay.text(colorCount + ". " + COLOR_WAY);
                    numOfImg.text("1 out of 5");
                    numOfImg.attr("class", "float-end");
                    btnDelete.append(crossIcon);
                    imgContainer.append(img);
                    imgContainer.append(btnDelete);
                    imageDiv.append(colorWay);
                    colorWay.append(numOfImg);
                    imageDiv.append(imgContainer);
                    $('#imgUploadRow').append(imageDiv);
                }
                else {
                    var currentImageDiv = $("#" + matchedColorID);
                    if (currentImageDiv.find(".image-container").length < 6) {
                        var currentDivImgCount = currentImageDiv.find(".image-container").length + 1
                        currentImageDiv.find("span").text(currentDivImgCount + " out of 5");
                        btnDelete.append(crossIcon);
                        imgContainer.append(img);
                        imgContainer.append(btnDelete);
                        currentImageDiv.append(imgContainer);
                    }
                }
            }
        }
    }

    //called when image delete button is clicked
    function deleteImage(button, url, id) {
        $(button).parents(".imageDiv").find("span").text($(button).parents(".imageDiv").find(".image-container").length - 1 + " out of 5");
        $(button).parent().remove();

        deleteImageFromTemp($(button).attr("name"), $(button).attr("id"),url,id);
    }

    //remove image from temp folder
    function deleteImageFromTemp(colorWay, imageName,url,id) {
        const formData = new FormData();
        var referenceNo = $('#idReferenceNo').val();
        formData.append("referenceNo", referenceNo);
        formData.append("colorWay", colorWay);
        formData.append("imageName", imageName);
        formData.append("url", url);
        formData.append("id", id);


        $.ajax({
            url: "/MM_ProductRegistration/DeleteImageFromTemp",
            type: "POST",
            data: formData,
            processData: false, // Prevent jQuery from converting the data to a query string
            contentType: false, // Set the content type to false to prevent jQuery from setting the content type
            success: function (result) {
                // Handle the response from the server
                eval(result)
            }
        });
    }

</script>

