@model PAB_NewAquarium.Models.Product_H_Detail

@{
    ViewBag.Title = "MM_ProductRegistration_Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string referenceNo = Model.REFERENCE_NO;
    string status = Model.STATUS;

    if (Model.RFID_READER == null)
    {
        <script>
            var readerObj = null;
        </script>
    }
    else
    {
        <script>
        var readerObj = {
            READER_NAME: "@Model.RFID_READER.READER_NAME",
            READER_BRAND: "@Model.RFID_READER.READER_BRAND",
            READER_IP: "@Model.RFID_READER.READER_IP",
            READER_PORT: "@Model.RFID_READER.READER_PORT",
            READER_RANGE: "@Model.RFID_READER.READER_RANGE"
        }
        </script>
    }
}

<style>
    .custom-color-count {
        width: 39%;
    }

    .card-height {
        overflow-y: scroll;
    }

    .btn-file {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
    }

    .file-caption.icon-visible .file-caption-name {
        padding: 0.5rem 1rem;
    }

    @@media only screen and (max-device-width: 1280px) {
        .card-height {
            height: calc(100vh - 55px - 55px - 60px - 40px - 30px);
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) {
        .card-height {
            height: calc(100vh - 55px - 55px - 60px - 40px - 30px);
        }
    }

    @@media only screen and (min-device-width: 1920px) {
        .card-height {
            height: calc(100vh - 70px - 70px - 70px - 60px - 30px);
        }
    }

    #viewMoreButton {
        background-color: transparent;
        border: none;
        cursor: pointer;
        padding-right: 0px;
        color: #004098;
        text-decoration: underline;
    }

    .checkboxCustom {
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
        cursor: default;
    }

    .multiselect-reset .multiselect-all:hover {
        background-color: transparent !important;
    }

    .multiselectDdlCustom {
        font-weight: bold;
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
    }

    .btn-reset {
        float: right;
    }

        .btn-reset:hover {
            background-color: transparent;
        }

    #productTypeMulti, #materialTypeMulti, #categoryMulti {
        margin-right: 9px;
        display: none;
    }

    @@media (min-width: 768px) {
        .multiselect-all {
            float: left;
            padding-left: 0.2rem !important;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, -33px) !important;
        }

        .delete-button {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: red;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 50%;
            height: 20px;
            width: 20px;
        }
    }

    @@media (min-width: 1400px) {
        .multiselect-all {
            float: left;
            text-align: left;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, 41px) !important;
        }

        .delete-button {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: red;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 50%;
            height: 20px;
            width: 20px;
            padding: 0;
        }
    }

    #select-id + .btn-group {
        display: flex;
    }

        #select-id + .btn-group .text-center {
            text-align: left !important;
        }

        #select-id + .btn-group .multiselect-container {
            width: 100% !important;
        }

    .tr-select2 + .btn-group > .multiselect-container input[type="text"] {
        visibility: visible;
    }

    .grayed-out {
        background-color: #F0F0F0;
        pointer-events: none;
        box-shadow: 0 0 0 0.01rem #c2cdf6;
    }

    .image-container {
        position: relative;
        display: inline-block;
        margin-right: 10px;
    }

    #div_btnAddImage {
        justify-content: flex-end !important;
        display: flex;
    }

    .borderBottomImg {
        border-bottom: 1px solid lightgray;
    }

    .image-element {
        height: 100px;
        width: 100px;
        border-radius: 0.5rem;
    }
</style>


@using (Html.BeginForm("MM_ProductRegistration_Edit", "MM_ProductRegistration", FormMethod.Post, new { enctype = "multipart/form-data" }))
