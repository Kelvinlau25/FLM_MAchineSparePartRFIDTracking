<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
<script src="~/signalr/hubs"></script>
<script>
    var file, fileSizeInMB, colorCount = 0;
    var returnMessage = "@ViewBag.Result";
    var originalRFIDTag = "@Model.RFID";
    var ajaxRFIDStatus = '@Url.Action("RFIDStatus", "RFIDDashboard")';
    var firstLoad = true;
    var hub = $.connection.rFIDFabricRegHub;
    var connectionHub = "FabricReg";
    var connectionId;
    var obj = null, tagCounts = {};

    //get uploaded image
    document.addEventListener('DOMContentLoaded', function () {
        var fileInput = document.getElementById('fileInput');
        var resultElement = document.getElementById('resultText');

        fileInput.addEventListener('change', function () {
            if (fileInput.files.length > 0) {
                file = fileInput.files[0];
                fileSizeInMB = file.size / (1024 * 1024);

                if (fileSizeInMB > 100) {
                    resultElement.style.color = "#DA296B";
                    resultElement.textContent = 'File size is over 100MB.';
                } else {
                    resultElement.textContent = 'File size within 100MB.';
                    resultElement.style.color = "green";

                    const reader = new FileReader();

                    reader.onload = function (e) {
                        $('#imgHidden').val(e.target.result); // Store the image data in the hidden field
                    };

                    reader.readAsDataURL(file);
                }
            }
        });
    });

    $(document).ready(function () {

        onPageLoad();

        $("#btnConfirm").click(function (e) {
            var tag = $('#RFID').val();
            $('#submit-confirmation-modal').modal('hide');

            if (tag != originalRFIDTag && tag != "") {
                e.preventDefault();
                $.ajax({
                    type: "post",
                    url: ajaxRFIDStatus,
                    data: { tag: tag },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (data == "Y") {
                            showAlert('Error', 'Failed to submit, RFID Tag was used.');
                        }
                        else if (data == "N") {
                            $('form').submit();
                        }
                    },
                });
            }
        });

        $("#viewMoreButton").click(function () {
        $(".additional-content").slideToggle();
            var buttonText = "";
            if ($(this).text() === "View More") {
                buttonText = "View Less";
                $(this).css('color', '#FF3366');
            }
            else {
                buttonText = "View More";
                $(this).css('color', '#004098');
            }
        $(this).text(buttonText);
    });

        //called when Add button is clicked
        $("#btnAddImage").click(function () {
            var resultElement = document.getElementById('resultText');
            var selectedOptions = $('#select-id2').val();
            var selectedColorWay = selectedOptions.replace(/[\/.#]/g, ' ');

            //if no image is uploaded
            if (file == undefined) {
                resultElement.style.color = "#DA296B";
                resultElement.textContent = 'Please Upload Fabric Image.';
            }
            //if file size is below 100MB
            else if (fileSizeInMB < 100) {
                var fileInput = document.getElementById('fileInput');
                var imageName = (fileInput.files[0].name).trim().replace(/ /g, "~");
                //if color way dropdown is not selected
                if (selectedOptions == "") {
                    resultElement.style.color = "#DA296B";
                    resultElement.textContent = 'Please Select Color Way.';
                }
                else {
                    var url = URL.createObjectURL(file);
                    var imageDiv = $("<div>").attr("class", "imageDiv mt-2 borderBottomImg pb-3");
                    var colorWay = $("<p class='custom-color-count'>");
                    var numOfImg = $("<span>");
                    var imgContainer = $("<div>").attr("class", "image-container");
                    //var hiddenImg = $("<input type='hidden' id='ImageFile' name='ImageFile' />");
                    var btnDelete = $("<button>").attr("class", "delete-button");
                    var crossIcon = $("<i>").attr("class", "fas fa-times");
                    var isColorExist = false;
                    var matchedColorID;
                    btnDelete.attr("id", imageName);
                    btnDelete.attr("name", selectedColorWay.trim().replace(/ /g, "~"));

                    btnDelete.attr("onclick", "deleteImage(this,'"+url.toString()+"', 0)");
                    btnDelete.attr("type", "button");
                    var img = $("<img>").attr("src", url);
                    img.attr("class", "image-element");

                    //loop to check if the color way has image
                    $(".imageDiv").each(function (index, element) {
                        var color = $(element).find("p").text();
                        if (color.includes(selectedColorWay)) {
                            isColorExist = true;
                            matchedColorID = $(this).attr("id");
                        }
                    });

                    //if not exist create a new div for the color way
                    if (isColorExist == false) {
                        colorCount++;
                        resultElement.style.color = "green";
                        resultElement.textContent = 'File size within 100MB.';
                        imageDiv.attr("id", "imageDiv" + colorCount);
                        imageDiv.attr("data-color", selectedColorWay);
                        colorWay.text(colorCount + ". " + selectedColorWay);
                        numOfImg.text("1 out of 5");
                        numOfImg.attr("class", "float-end");
                        btnDelete.append(crossIcon);
                        imgContainer.append(img);
                        imgContainer.append(btnDelete);
                        //imgContainer.append(hiddenImg);
                        imageDiv.append(colorWay);
                        colorWay.append(numOfImg);
                        imageDiv.append(imgContainer);
                        $('#imgUploadRow').append(imageDiv);
                        saveImageToTemp(selectedColorWay, imageName);
                    }
                    //if color way exist
                    else {
                        var currentImageDiv = $("#" + matchedColorID);
                        var colorway = currentImageDiv.attr('data-color');
                        //if the color way has 5 images
                        if (currentImageDiv.find(".image-container").length >= 5) {
                            resultElement.style.color = "#DA296B";
                            resultElement.textContent = `${colorway} color cannot more than 5 images.`;
                        }
                        //else add the image into the color way
                        else {
                            var currentDivImgCount = currentImageDiv.find(".image-container").length + 1
                            currentImageDiv.find("span").text(currentDivImgCount + " out of 5");
                            resultElement.style.color = "green";
                            resultElement.textContent = 'File size within 100MB.';
                            btnDelete.append(crossIcon);
                            imgContainer.append(img);
                            imgContainer.append(btnDelete);
                            //imgContainer.append(hiddenImg);
                            currentImageDiv.append(imgContainer);
                            saveImageToTemp(selectedColorWay, imageName);
                        }
                    }

                    $('.card').animate({
                        scrollTop: $('.card')[0].scrollHeight
                    }, 200);
                }
            }

        });

