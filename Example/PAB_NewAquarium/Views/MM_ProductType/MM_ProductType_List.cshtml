@model PAB_NewAquarium.Models.MM_PRODUCT_TYPE

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var UrlActionAudit = Url.Action("MM_ProductType_AuditTrail", "MM_ProductType");
    var UrlActionCreate = Url.Action("MM_ProductType_Create", "MM_ProductType");
    var UrlActionDelete = Url.Action("MM_ProductType_Delete", "MM_ProductType");
    var UrlActionEdit = Url.Action("MM_ProductType_Edit", "MM_ProductType");
    var UrlActionList = Url.Action("MM_ProductType_List", "MM_ProductType");
    var UrlActionView = Url.Action("MM_ProductType_View", "MM_ProductType");
}

<!-- Common Listing CSS -->
<link href="~/ViewsHelpers/CommonListing/Listing.css" rel="stylesheet" />

<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">Product Type</p>
    </div>
    <div class="col-sm-6 text-end align-self-center">
        <div class="d-flex justify-content-end">
            <div id="customDTButton"></div>
        </div>
    </div>
</div>
<div class="tr-btm-line"></div>
<div class="page-container px-3 overflow-auto">
    <div class="tr-btm-btn-margin">
        <div>
            <div class="row mt-3 mb-2">
                <div class="col-12 col-sm-8"></div>
                <div class="col-12 col-sm-4 align-self-end text-end pb-0 mb-0" id="action-bar"></div>
            </div>
            <div class="row">
                <table id="tr-datatable" class="table table-hover table-bordered compact w-100">
                    <thead>
                        <tr class="bg-datatable-tr">
                            <th></th>
                            <th>Product Type</th>
                            <th>Description</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col">
                    <div class="aud export-section"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Common Listing Html -->
@Html.Partial("_Listing_Page_V2")

<!-- Common Listing JavaScript -->
<script src="~/ViewsHelpers/CommonListing/Listing.js"></script>

<script>
    var urlActionAudit = "@UrlActionAudit";
    var urlActionCreate = "@UrlActionCreate";
    var urlActionDelete = "@UrlActionDelete";
    var urlActionList = "@UrlActionList";
    var urlActionView = "@UrlActionView";
    var table;
    var data = @Html.Raw(Model.LISTING_JSON);

    $(document).ready(function () {

        onPageLoad();

        $('#btnDeleteConfirm').on('click', function () {
            var selectedValues = [];
            var selectedRows = table.rows({ selected: true }).data().toArray();
            selectedRows.forEach(function (rowData) {
                var checkboxValue = rowData["ID"];
                selectedValues.push(checkboxValue);
            });

            $('#modalDelete').modal('hide');

            $.ajax({
                url: urlActionDelete,
                type: 'POST',
                data: { id: selectedValues },
                success: function (response) {
                    if (response.valid) {
                        showAlert('Success', 'Record deleted successfully.', urlActionList);
                    } else {
                        showAlert('Error', 'Record deletion failed.');
                    }
                },
                error: function (xhr, status, error) {
                    showAlert('Error', error);
                }
            });
        });
    });

    function onPageLoad() {
        initPage();
        loadDataTable();
        initDataTableComponent();
        adjustDataTableColumn();
        addTableButtons();
    }

    function loadDataTable() {
        table = $('#tr-datatable').DataTable({
            data: data,
            scrollCollapse: true,
            scrollY: calcDataTableHeight,
            pagingType: 'simple_numbers',
            columns: [
                { data: 'ID' },
                { data: 'PRODUCT_TYPE' },
                { data: 'PRODUCT_DESC' },
            ],
            columnDefs: [
                {
                    targets: 0,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = '<div class="checkbox" ID=' + row["ID"] + '><input type="checkbox" class="dt-checkboxes form-check-input"><label></label></div>';
                        }
                        return data;
                    },
                    checkboxes: {
                        selectRow: true,
                        selectAllPages: false,
                        selectAllRender: '<div class="checkbox"><input type="checkbox" class="dt-checkboxes form-check-input"></div>'
                    }
                },
                {
                    targets: 3,
                    render: function (data, type, row, meta) {
                        return '<a href="' + urlActionView +'?id=' + row.ID + '" class="name tr-icon-size"><i class="fa-solid fa-eye"></i></a>';
                    },
                    orderable: false,
                }
            ],
            select: {
                style: 'multi',
                info: false,
                selector: 'td:nth-child(1)'
            },
            order: [[1, 'asc']],
            dom: `<'row toolbar-row g-0 custom-toolbar'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'<'toolbar'>>>
                  <'row'<'col-sm-12'tr>>
                  <'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end mt-2'p<'go-to align-self-center mx-2'>>>>`,
            fixedHeader: {
                header: true,
                footer: false
            },
            initComplete: function () {
                $('.custom-toolbar .toolbar').html(searchInputHtml);
            },
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            }
        });
    }

    function addTableButtons() {
        new $.fn.dataTable.Buttons(table, {
            name: "add",
            buttons: [
                {
                    text: '<i class="fa-solid fa-plus text-primary"></i>&nbsp;&nbsp; Add Product Type',
                    className: 'btn-sm btn-outline-secondary mt-1',
                    init: function (api, node, config) {
                        $(node).attr("id", "btnAdd");
                        $(node).removeClass('btn-secondary');
                    },
                    action: function (e, dt, node, config) {
                        // Add new action here
                        window.location.href = urlActionCreate;
                    }
                }
            ]
        });

        new $.fn.dataTable.Buttons(table, {
            name: "delete",
            buttons: [
                {
                    text: '<i class="fa-solid fa-trash-can tr-icon-size tr-icon-del"></i>',
                    className: 'tr-btn m-0 py-0 px-3 text-danger tr-trash isHide',
                    init: function (api, node, config) {
                        $(node).attr("id", "btnDelete");
                        $(node).attr("data-bs-toggle", "modal");
                        $(node).attr("data-bs-target", "#modalDelete");
                        $(node).removeClass('btn btn-secondary');
                    }
                }
            ]
        });

        new $.fn.dataTable.Buttons(table, {
            name: "audit",
            buttons: [
                {
                    text: 'Audit Trail',
                    className: 'm-0 p-0 tr-btn',
                    attr: {
                        id: 'btnAuditTrail'
                    },
                    init: function (api, node, config) {
                        $(node).removeClass('btn btn-secondary')
                    },
                    action: function (e, dt, node, config) {
                        var selectedValues = [];
                        var selectedRows = table.rows({ selected: true }).data().toArray();
                        const toastIDError = document.getElementById('errorToast');
                        const toastError = new bootstrap.Toast(toastIDError);

                        selectedRows.forEach(function (rowData) {
                            var checkboxValue = rowData;
                            selectedValues.push(checkboxValue);
                        });

                        if (selectedValues.length >= 2) {
                            showAlert('Error', 'Multiple selection for audit trail is not applicable!');
                            return;
                        }
                        else if (selectedValues.length == 0) {
                            showAlert('Error', 'Please select at least one record!');
                            return;
                        }
                        else {
                            var url = `${urlActionAudit}?id=${selectedValues[0].ID}`;
                            window.location.href = url;
                        }
                    }
                }
            ]
        });

        table.buttons("add", null).containers().appendTo('#customDTButton');
        table.buttons("audit, delete", null).containers().appendTo('#action-bar');
    }
</script>

