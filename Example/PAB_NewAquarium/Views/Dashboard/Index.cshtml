@model PAB_NewAquarium.Models.SalesDashboardModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hotSalesCount = Model.FABRIC_HOT_SALES.Count < 5 ? Model.FABRIC_HOT_SALES.Count : 5;
    var latestProductsCount = Model.LATEST_PRODUCTS.Count < 5 ? Model.LATEST_PRODUCTS.Count : 5;
}

<style>
    .page-container {
        overflow-x: hidden;
        overflow-y: scroll;
        max-height: calc(100vh - 55px - 25px);
    }

    .gradient-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(225deg, rgba(255,0,0,0), rgba(0,0,0,0.6));
    }

    .btn-carousel {
        color: #EBEBEB;
        background-color: #FFFFFF;
        border: 2px solid #EBEBEB;
        padding: 0.25rem;
    }

        .btn-carousel.active {
            color: #004098;
        }

    .divider-line {
        border-bottom: 2px solid #EBEBEB;
    }

    .image-element {
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
    }

    .carousel-caption {
        position: absolute;
        left: 10%;
        top: 50%;
        transform: translateY(-50%);
        color: #FFFFFF;
        text-align: left;
    }

    .carousel-caption-text {
        font-size: 40px;
        font-weight: bold;
        font-family: "Bell MT";
        cursor: default;
    }

    .carousel-caption-button {
        background-color: #FFFFFF;
        border-radius: 0.2rem;
        width: 120px;
        font-weight: bold;
    }

        .carousel-caption-button:hover {
            opacity: 0.7;
            color: #495057;
            background-color: #FFFFFF;
        }

    .carousel-item-container:hover {
        background-color: #EBF3FE;
        cursor: pointer;
    }

    .carousel-indicators [data-bs-target] {
        background-color: #EBEBEB;
        opacity: 1;
    }

    .carousel-indicators .active {
        background-color: #004098;
        opacity: 1;
    }

    #carousel-dashboard > .carousel-inner, img {
        height: 400px;
    }

    @@media only screen and (max-device-height: 799px) {
        .carousel-header {
            font-size: 22px;
        }

        .carousel-inner {
            height: 300px;
            min-width: 1200px;
        }

        .image-container {
            height: 200px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 20px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 20px;
        }

        .header-title {
            font-size: 14px;
        }

        .btn-carousel {
            height: 30px;
            width: 30px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (max-device-width: 1280px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 22px;
        }

        .carousel-inner {
            height: 300px;
            min-width: 1200px;
        }

        .image-container {
            height: 200px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 20px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 20px;
        }

        .header-title {
            font-size: 14px;
        }

        .btn-carousel {
            height: 30px;
            width: 30px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 30px;
        }

        .carousel-inner {
            height: 350px;
            min-width: 1500px;
        }

        .image-container {
            height: 250px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 30px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 30px;
        }

        .header-title {
            font-size: 16px;
        }

        .btn-carousel {
            height: 34px;
            width: 34px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (min-device-width: 1920px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 30px;
        }

        .carousel-inner {
            height: 400px;
            min-width: 1900px;
        }

        .image-container {
            height: 300px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 40px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 40px;
        }

        .header-title {
            font-size: 18px;
        }

        .btn-carousel {
            height: 34px;
            width: 34px;
        }

        .btn-view-more {
            font-size: large;
        }
    }
</style>

<!-- Remind: If this page got updated, remember update the CustomerDashboard.cshtml too -->
<div class="page-container">
    <div class="tr-btm-btn-margin">
        <div id="carousel-dashboard" class="carousel slide" data-ride="carousel">
            <ol class="carousel-indicators">
                @for (var i = 0; i < Model.CAROUSEL_DASHBOARD.Count; i++)
                {
                    <li data-bs-target="#carousel-dashboard" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                }
            </ol>
            <div class="carousel-inner">
                @for (var i = 0; i < Model.CAROUSEL_DASHBOARD.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img class="d-block w-100" src="@Model.CAROUSEL_DASHBOARD[i].IMAGE_URL">
                        <div class="gradient-background"></div>
                        <div class="carousel-caption">
                            <div><text class="carousel-caption-text">Shop Directly with</text></div>
                            <div><text class="carousel-caption-text">PENFABRIC</text></div>
                            <div class="mt-5"><button type="button" class="btn carousel-caption-button" onclick="viewAll('All')">VIEW NOW</button></div>
                        </div>
                    </div>
                }
            </div>
            <a class="carousel-control-prev" href="#carousel-dashboard" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carousel-dashboard" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>

        <!-- Fabric Hot Sales -->
        <div class="row justify-content-end mt-5">
            <div class="col-sm-4 text-center">
                <p class="carousel-header text-center bell-mt m-0"><b>Fabric Hot Sales</b></p>
            </div>
            <div class="col-sm-4 d-flex align-items-center justify-content-end me-3">
                <div class="d-flex align-items-end">
                    <button class="btn-carousel" type="button" href="#carouselFabric" data-bs-slide-to="0">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-left"></i></div>
                    </button>
                    <button class="btn-carousel border-start-0 active" type="button" href="#carouselFabric" data-bs-slide-to="1">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-right"></i></div>
                    </button>
                    <a class="btn-view-more ms-3 text-decoration-underline bell-mt" href="#" onclick="viewAll('HotSales')"><text>View All</text></a>
                </div>
            </div>
        </div>
        <div id="carouselFabric" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <!-- First Carousel -->
                <div class="carousel-item active">
                    <div class="row">
                        @for (var i = 0; i < hotSalesCount; i++)
                        {
                            <div class="carousel-item-container w-20" onclick="viewProduct(@Model.FABRIC_HOT_SALES[i].PRODUCT_H_ID)">
                                <div class="image-container m-3">
                                    <img src="@Model.FABRIC_HOT_SALES[i].IMAGE_URL" class="image-element" />
                                </div>
                                <div class="mx-3 mb-3">
                                    <div class="divider-line">
                                        <p class="header-title fw-bold mb-1">@Model.FABRIC_HOT_SALES[i].CATEGORY_NAME</p>
                                    </div>
                                    <div>
                                        <p class="mt-1 mb-0">@Model.FABRIC_HOT_SALES[i].CHOP_NO</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Second Carousel -->
                @if (Model.FABRIC_HOT_SALES.Count > 5)
                {
                    <div class="carousel-item">
                        <div class="row">
                            @for (var i = 5; i < Model.FABRIC_HOT_SALES.Count; i++)
                            {
                                <div class="carousel-item-container w-20" onclick="viewProduct(@Model.FABRIC_HOT_SALES[i].PRODUCT_H_ID)">
                                    <div class="image-container m-3">
                                        <img src="@Model.FABRIC_HOT_SALES[i].IMAGE_URL" class="image-element" />
                                    </div>
                                    <div class="mx-3 mb-3">
                                        <div class="divider-line">
                                            <p class="header-title fw-bold mb-1">@Model.FABRIC_HOT_SALES[i].CATEGORY_NAME</p>
                                        </div>
                                        <div>
                                            <p class="mt-1 mb-0">@Model.FABRIC_HOT_SALES[i].CHOP_NO</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <!-- Latest Products -->
        <div class="row justify-content-end mt-5">
            <div class="col-sm-4 text-center">
                <p class="carousel-header text-center bell-mt m-0"><b>Latest Products</b></p>
            </div>
            <div class="col-sm-4 d-flex align-items-center justify-content-end me-3">
                <div class="d-flex align-items-end">
                    <button class="btn-carousel" type="button" href="#carouselProduct" data-bs-slide-to="0">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-left"></i></div>
                    </button>
                    <button class="btn-carousel border-start-0 active" type="button" href="#carouselProduct" data-bs-slide-to="1">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-right"></i></div>
                    </button>
                    <a class="btn-view-more ms-3 text-decoration-underline bell-mt" href="#" onclick="viewAll('All')">View All</a>
                </div>
            </div>
        </div>
        <div id="carouselProduct" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <!-- First Carousel -->
                <div class="carousel-item active">
                    <div class="row">
                        @for (var i = 0; i < latestProductsCount; i++)
                        {
                            <div class="carousel-item-container w-20" onclick="viewProduct(@Model.LATEST_PRODUCTS[i].PRODUCT_H_ID)">
                                <div class="image-container m-3">
                                    <img src="@Model.LATEST_PRODUCTS[i].IMAGE_URL" class="image-element" />
                                </div>
                                <div class="mx-3 mb-3">
                                    <div class="divider-line">
                                        <p class="header-title fw-bold mb-1">@Model.LATEST_PRODUCTS[i].CATEGORY_NAME</p>
                                    </div>
                                    <div>
                                        <p class="mt-1 mb-0">@Model.LATEST_PRODUCTS[i].CHOP_NO</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Second Carousel -->
                @if (Model.LATEST_PRODUCTS.Count > 5)
                {
                    <div class="carousel-item">
                        <div class="row">
                            @for (var i = 5; i < Model.LATEST_PRODUCTS.Count; i++)
                            {
                                <div class="carousel-item-container w-20" onclick="viewProduct(@Model.LATEST_PRODUCTS[i].PRODUCT_H_ID)">
                                    <div class="image-container m-3">
                                        <img src="@Model.LATEST_PRODUCTS[i].IMAGE_URL" class="image-element" />
                                    </div>
                                    <div class="mx-3 mb-3">
                                        <div class="divider-line">
                                            <p class="header-title fw-bold mb-1">@Model.LATEST_PRODUCTS[i].CATEGORY_NAME</p>
                                        </div>
                                        <div>
                                            <p class="mt-1 mb-0">@Model.LATEST_PRODUCTS[i].CHOP_NO</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    var urlAllProduct = "@Url.Action("AllProducts", "AllProducts")";
    var urlActionView = "@Url.Action("ProductDetail", "ProductDetail")";
    var interval = 5000;
    var carouselInterval = setInterval(slide, interval);

    $(document).ready(function () {
        $('#carousel-dashboard').on('click', function () {
            clearInterval(carouselInterval);
            carouselInterval = setInterval(slide, interval);
        });

        $('.btn-carousel').on('click', function () {
            var slide = $(this).attr('data-bs-slide-to');

            if ($(this).hasClass('active')) {
                if (slide == 0) {
                    $(this).next().addClass('active');
                }
                else {
                    $(this).prev().addClass('active');
                }
            }
            $(this).removeClass('active');
        });
    });

    // Function for carousel slide every 5 seconds
    function slide() {
        $('#carousel-dashboard').carousel('next');
    }

    // Function for redirect user to all products page
    function viewAll(type) {
        if (type == "HotSales") {
            urlAllProduct += "?type=HotSales";
        }
        window.location = urlAllProduct;
    }

    // Function for redirect user to product detail page
    function viewProduct(id) {
        var url = urlActionView + `?id=${id}&groupDID=0`;
        window.location = url;
    }
</script>