@model PAB_NewAquarium.Models.ToReturnModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .backBtn {
        cursor: pointer;
        font-size: 20px;
    }

    .return-item {
        border-radius: 0.375rem;
        background-color: #F0F0F0;
        margin-bottom: 0.5rem;
        margin-right: 1rem;
    }

    .return-item-image {
        height: 150px;
        width: 150px;
        border-radius: 0.5rem;
    }

    input[type="checkbox"] {
        cursor: pointer;
    }

    .url-link:hover {
        text-decoration: underline;
    }

    @@media only screen and (max-device-width: 1280px) {
        .return-item-container {
            overflow-x: hidden;
            overflow-y: auto;
            height: calc(100vh - 320px);
        }

        .card-body {
            height: calc(100vh - 200px);
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) {
        .return-item-container {
            overflow-x: hidden;
            overflow-y: auto;
            height: calc(100vh - 320px);
        }
    }

    @@media only screen and (min-device-width: 1920px) {
        .return-item-container {
            overflow-x: hidden;
            overflow-y: auto;
            height: calc(100vh - 360px);
        }

        .card-body {
            height: calc(100vh - 240px);
        }
    }
</style>

<div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
<div class="page-container px-3">
    <div class="tr-btm-btn-margin">
        <div class="row align-items-baseline mt-3">
            <div class="col"><h6 class="text-muted card-title"><a href="@Url.Action("Account", "Account")"><span class="fas fa-chevron-left dark-blue me-sm-3 backBtn"></span></a>To Return List</h6></div>
        </div>
        <div class="row align-items-baseline mt-3">
            <div class="col">
                <a class="text-decoration-none" href="@Url.Action("Index", "Dashboard")"><span class="fa fa-house dark-blue"></span></a>
                <text class="mx-1">/</text>
                <a class="url-link" href="@Url.Action("Account", "Account")">My Account</a>
                <text class="mx-1">/</text>
                <text>To Return</text>
            </div>            
        </div>
        <div class="card mt-3 mb-2">
            <div class="card-body">
                <div class="row row-cols-auto px-3 pb-2 hidden-row hidden">
                    <div class="col">
                        <input type="checkbox" id="checkboxID" class="me-2" />
                        <text id="txtSelectedCount">Select - 0 Item (s)</text>
                    </div>
                </div>
                <div class="return-item-container">
                    @for (int i = 0; i < Model.RETURN_LIST.Count; i++)
                    {
                        <div class="return-item">
                            <div class="row row-cols-auto px-3 py-2">
                                <div class="col d-flex align-items-center">
                                    <input type="checkbox" class="me-2 checkbox" index="@Model.RETURN_LIST[i].PRODUCT_H_ID" />
                                    <img class="return-item-image" src="@Model.RETURN_LIST[i].IMAGE_URL" loading="lazy" />
                                </div>
                                <div class="col d-flex flex-column">
                                    <div class="row"><text><b>@Model.RETURN_LIST[i].CATEGORY_NAME</b></text></div>
                                    <div class="row mt-2"><text>Chop No: @Model.RETURN_LIST[i].CHOP_NO</text></div>
                                    <div class="row mt-auto"><text>Reference No: @Model.RETURN_LIST[i].REFERENCE_NO</text></div>
                                </div>
                                <div class="col d-flex flex-column ms-auto">
                                    <div class="row"> <text>Date Taken: @Model.RETURN_LIST[i].DATE_TAKEN</text></div>
                                    <div class="row mt-auto"><text>Original Location: <b>@Model.RETURN_LIST[i].HANGER_LOC</b></text></div>
                                    <div class="row"><text class="red">Current Location: <b>@Model.RETURN_LIST[i].CURRENT_LOC</b></text></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="row tr-btm-btn-area hidden-row hidden">
            <div class="col"></div>
            <div class="col text-end me-3">
                <button id="btnSubmit" type="button" class="btn btn-sm btn-primary mx-1" data-bs-toggle="modal" data-bs-target="#confirmation-modal">To Return</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="confirmation-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
            </div>
            <hr />
            <div class="modal-body">
                <h6>Are you sure to return these item(s)?</h6>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSubmitConfirm">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed toast-success">
    <div id="successToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
        <div class="toast-header" style="background-color: #E9FFF8">
            <strong class="me-auto" style="color: #00A251">Successful!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
            Return Successfully.
        </div>
    </div>
</div>
<div class="toast-container position-fixed toast-alert">
    <div id="errorToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
        <div class="toast-header" style="background-color: #FFF0EE">
            <strong class="me-auto text-danger">Warning!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
            
        </div>
    </div>
</div>

<script>
    var list = @Html.Raw(Json.Encode(Model.RETURN_LIST));
    var ajaxReturnItem = "@Url.Action("ReturnItem", "Account")";

    $(document).ready(function () {
        displayHidden();

        $('#checkboxID').on('click', function () {
            var isChecked = $(this).is(':checked');

            if (isChecked) {
                $('.checkbox').prop('checked', true);
                $('#txtSelectedCount').html('Select All - ' + list.length + ' Item (s)');
            }
            else {
                $('.checkbox').prop('checked', false);
                $('#txtSelectedCount').html('Select - 0 Item (s)');
            }
        });

        $('.checkbox').on('click', function () {
            var isCheckedCount = 0;
            $('.checkbox').each(function () {
                var isChecked = $(this).is(':checked');
                if (isChecked) {
                    isCheckedCount++;
                }
            });
            if (isCheckedCount == list.length) {
                $('#checkboxID').prop('checked', true);
                $('#txtSelectedCount').html('Select All - ' + isCheckedCount + ' Item (s)');
            }
            else {
                $('#checkboxID').prop('checked', false);
                $('#txtSelectedCount').html('Select - ' + isCheckedCount + ' Item (s)');
            }
        });

        $('#btnSubmitConfirm').on('click', function () {
            var array = [];
            $('#confirmation-modal').modal('hide');
            $('.checkbox').each(function () {
                var isChecked = $(this).is(':checked');
                var index = $(this).attr('index');
                if (isChecked) {                    
                    array.push(index);
                }
            });
            if (array.length == 0) {
                $('#errorToast .toast-body').html('Please select at least one record!');
                const toastLiveExample = document.getElementById('errorToast');
                const toast = new bootstrap.Toast(toastLiveExample);
                toast.show();
            }
            else {
                $.ajax({
                    type: "post",
                    url: ajaxReturnItem,
                    data: {
                        array: array
                    },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (data == "Success") {
                            const toastLiveExample = document.getElementById('successToast');
                            const toast = new bootstrap.Toast(toastLiveExample);
                            toast.show();
                            setTimeout(function () {
                                location.reload();
                            }, 2000);
                        }
                        else {
                            $('#errorToast .toast-body').html('Something wrong, please contact admin!');
                            const toastLiveExample = document.getElementById('errorToast');
                            const toast = new bootstrap.Toast(toastLiveExample);
                            toast.show();
                        }                       
                    },
                });
            }
        });
    });

    function displayHidden() {
        if (list.length > 0) {
            $('.hidden-row').removeClass('hidden');
        }
    }
</script>
