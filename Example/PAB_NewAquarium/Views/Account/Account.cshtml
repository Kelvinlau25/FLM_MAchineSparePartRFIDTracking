@model List<PAB_NewAquarium.Models.RECOMMENDED_PRODUCTS>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recentRequestCount = Model.Count < 5 ? Model.Count : 5;
}

<style>
    @@media (min-width: 768px) {

        .product-container {
            height: 79.5vh;
        }
    }

    @@media (min-width: 1400px) {
        .product-container {
            height: 82.5vh;
        }
    }

    .bold {
        font-weight: bold;
    }

    .sample-request-list-div {
        width: 200px;
        padding-top: 1rem;
        cursor: pointer;
    }

        .sample-request-list-div:hover {
            background-color: #EBF3FE;
        }

    .icon-size {
        font-size: 40px;
    }

    .icon-text {
        font-size: 20px;
        padding-top: 15px;
    }

    .btn-fabric {
        color: lightgrey;
        background-color: white;
        border: 1px solid lightgrey;
    }

        .btn-fabric:hover {
            color: #004098;
        }

        .btn-fabric:focus {
            color: #004098;
        }

    .tr-listing-header-title {
        font-size: 30px !important;
    }

    .image-element {
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
    }

    .image-return {
        height: 40px;
        width: 40px;
    }

    .red-dot {
        position: absolute;
        top: 0px;
        left: 35px;
        background-color: #E11818;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .return-count {
        position: absolute;
        top: -5px;
        left: 50px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 1px solid #DCDCDC;
        box-shadow: 0 5px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    }

    .carousel-item-container:hover {
        background-color: #EBF3FE;
        cursor: pointer;
    }

    .btn-carousel {
        color: #EBEBEB;
        background-color: #FFFFFF;
        border: 2px solid #EBEBEB;
    }

        .btn-carousel.active {
            color: #004098;
        }

    @@media only screen and (max-device-height: 799px) {
        .carousel-header {
            font-size: 22px;
        }

        .carousel-inner {
            height: 300px;
            min-width: 1200px;
        }

        .image-container {
            height: 200px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 20px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 20px;
        }

        .header-title {
            font-size: 14px;
        }

        .btn-carousel {
            height: 30px;
            width: 30px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (max-device-width: 1280px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 22px;
        }

        .carousel-inner {
            height: 300px;
            min-width: 1200px;
        }

        .image-container {
            height: 200px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 20px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 20px;
        }

        .header-title {
            font-size: 14px;
        }

        .btn-carousel {
            height: 30px;
            width: 30px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 30px;
        }

        .carousel-inner {
            height: 350px;
            min-width: 1500px;
        }

        .image-container {
            height: 250px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 30px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 30px;
        }

        .header-title {
            font-size: 16px;
        }

        .btn-carousel {
            height: 34px;
            width: 34px;
        }

        .btn-view-more {
            font-size: medium;
        }
    }

    @@media only screen and (min-device-width: 1920px) and (min-device-height: 800px) {
        .carousel-header {
            font-size: 30px;
        }

        .carousel-inner {
            height: 400px;
            min-width: 1900px;
        }

        .image-container {
            height: 300px;
        }

        .carousel-control-prev {
            width: auto;
            padding-left: 40px;
        }

        .carousel-control-next {
            width: auto;
            padding-right: 40px;
        }

        .header-title {
            font-size: 18px;
        }

        .btn-carousel {
            height: 34px;
            width: 34px;
        }

        .btn-view-more {
            font-size: large;
        }
    }
</style>

@using (Html.BeginForm("ProductDetail", "ProductDetail", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
    <div class="product-container mx-3 my-3 overflow-y-auto">
        <div class="row">
            <div class="col"><h5 class="text-muted card-title">Sample Request List</h5></div>
        </div>
        <div class="row">
            <div class="text-center sample-request-list-div d-none" onclick="location.href='@Url.Action("ToReturn", "Account")'">
                <div class="d-flex align-items-center justify-content-center">
                    <img src="~/assets/return.png" class="image-return" />
                    <div id="txtReturnCount" class="red-circle mx-1">
                        <text></text>
                    </div>
                </div>
                <p class="icon-text">To Return</p>
            </div>
            <div class="text-center sample-request-list-div" onclick="location.href='@Url.Action("RequestHistory", "Account")'">
                <span class="fas fa-list-check dark-blue icon-size"></span>
                <p class="icon-text">Request History</p>
            </div>
            <div class="text-center sample-request-list-div" onclick="location.href='@Url.Action("BrowsingHistory", "Account")'">
                <span class="fas fa-clock-rotate-left dark-blue icon-size"></span>
                <p class="icon-text">Browsing History</p>
            </div>
        </div>
        <hr />
        @*Recent Requested*@
        <div class="row justify-content-end mt-3">
            <div class="col-sm-4 text-center">
                <p class="carousel-header text-center bell-mt m-0"><b>Recent Requested</b></p>
            </div>
            <div class="col-sm-4 d-flex align-items-center justify-content-end me-3">
                <div class="d-flex align-items-end">
                    <button class="btn-carousel" type="button" href="#carouselFabric" data-bs-slide-to="0">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-left"></i></div>
                    </button>
                    <button class="btn-carousel border-start-0 active" type="button" href="#carouselFabric" data-bs-slide-to="1">
                        <div class="d-flex align-items-center justify-content-center"><i class="fa fa-solid fa-angle-right"></i></div>
                    </button>
                    <a class="btn-view-more ms-3 text-decoration-underline bell-mt" href="@Url.Action("AllProducts", "AllProducts")">View All</a>
                </div>
            </div>
            <div id="carouselFabric" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner">
                    <!-- First Carousel -->
                    <div class="carousel-item active">
                        <div class="row">
                            @for (var i = 0; i < recentRequestCount; i++)
                            {
                                <div class="carousel-item-container w-20" onclick="viewProduct(@Model[i].PRODUCT_H_ID)">
                                    <div class="image-container m-3">
                                        <img src="@Model[i].IMAGE_URL" class="image-element" />
                                    </div>
                                    <div class="mx-3 mb-3">
                                        <div class="divider-line">
                                            <p class="header-title fw-bold mb-1">@Model[i].CATEGORY_NAME</p>
                                        </div>
                                        <div>
                                            <p class="mt-1 mb-0">@Model[i].CHOP_NO</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Second Carousel -->
                    @if (Model.Count > 5)
                    {
                        <div class="carousel-item">
                            <div class="row">
                                @for (var i = 5; i < Model.Count; i++)
                                {
                                    <div class="carousel-item-container w-20" onclick="viewProduct(@Model[i].PRODUCT_H_ID)">
                                        <div class="image-container m-3">
                                            <img src="@Model[i].IMAGE_URL" class="image-element" />
                                        </div>
                                        <div class="mx-3 mb-3">
                                            <div class="divider-line">
                                                <p class="header-title fw-bold mb-1">@Model[i].CATEGORY_NAME</p>
                                            </div>
                                            <div>
                                                <p class="mt-1 mb-0">@Model[i].CHOP_NO</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<script>
    var urlProductDetail = "@Url.Action("ProductDetail", "ProductDetail")";

    $(document).ready(function () {
        $('.btn-carousel').on('click', function () {
            var slide = $(this).attr('data-bs-slide-to');

            if ($(this).hasClass('active')) {
                if (slide == 0) {
                    $(this).next().addClass('active');
                }
                else {
                    $(this).prev().addClass('active');
                }
            }
            $(this).removeClass('active');
        });
    });

    function viewProduct(id) {
        var url = urlProductDetail + '?id=' + id + '&groupDID=0';
        window.location = url;
    }
</script>
