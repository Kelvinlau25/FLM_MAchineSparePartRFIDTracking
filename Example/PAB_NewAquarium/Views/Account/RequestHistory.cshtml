    function loadTableData() {
        var html = '';
        var historyCategory = "", customer = "", fabricCategory = "", productType = "",sampleReqNo = "", sortBy = "";
        var fromDateVal, toDateVal;
        $('div.spanner').addClass("show");

        $('.multiselectpicker option:selected').each(function () {
            if (customer != "") {
                customer += "," + $(this).val()
            }
            else {
                customer += $(this).val()
            }
        });

        $('.multiselectpicker2 option:selected').each(function () {
            if (fabricCategory != "") {
                fabricCategory += "," + $(this).val()
            }
            else {
                fabricCategory += $(this).val()
            }
        });

        $('.multiselectpicker3 option:selected').each(function () {
            if (productType != "") {
                productType += "," + $(this).val()
            }
            else {
                productType += $(this).val()
            }
        });

        $('.multiselectpicker4 option:selected').each(function () {
            if (sampleReqNo != "") {
                sampleReqNo += "," + $(this).val()
            }
            else {
                sampleReqNo += $(this).val()
            }
        });

        historyCategory = $('#select-id1').val();
        sortBy = $('#select-id2').val();
        fromDateVal = $('#fromDate').val();
        toDateVal = $('#toDate').val();

        const formData = new FormData();
        formData.append("historyCategory", historyCategory);
        formData.append("customer", customer);
        formData.append("fabricCategory", fabricCategory);
        formData.append("productType", productType);
        formData.append("fromDate", fromDateVal);
        formData.append("toDate", toDateVal);
        formData.append("sortBy", sortBy);
        formData.append("sampleReqNo", sampleReqNo)

        $.ajax({
            url: "/Account/GetRequestHistory",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                filterData = result.RequestHistory;
                var month, newMonth = true, requestDate, newRequestDate = true, company, newCompany = true;

                if (filterData.length > 0) {
                    month = (filterData[0].CREATED_DATE).substring(3);
                    requestDate = (filterData[0].CREATED_DATE).substring(0, (filterData[0].CREATED_DATE).length - 5);
                    company = filterData[0].COMPANY_NAME;
                    $('#firstMonthTitle').text(month);
                    newMonth = false;
                }

                for (var i = 0; i < filterData.length; i++) {
                    var subMonth = (filterData[i].CREATED_DATE).substring(3);
                    var subRequestDate = (filterData[i].CREATED_DATE).substring(0, (filterData[i].CREATED_DATE).length - 5);
                    //check if it is the same month
                    if (subMonth != month) {
                        month = subMonth;
                        newMonth = true;
                        requestDate = subRequestDate;
                        newRequestDate = true
                        company = filterData[i].COMPANY_NAME;
                        newCompany = true;
                    }

                    //check if the request date is the same
                    if (subRequestDate != requestDate) {
                        requestDate = subRequestDate;
                        newRequestDate = true;
                    }

                    //check if the company is the same
                    if (filterData[i].COMPANY_NAME != company) {
                        company = filterData[i].COMPANY_NAME;
                        newCompany = true;
                    }

                    //if it is a new month
                    if (newMonth == true && i != 0) {
                        html += '<tr>';
                        html += '<td class="bold monthText">' + subMonth + '</td>'
                        html += '</tr>';
                        newMonth = false;
                    }

                    //if it is the new request date
                    if (newRequestDate == true) {
                        html += '<tr>';
                        html += '<td class="bold companyNameTitle">' + requestDate + '</td>'
                        html += '</tr>';
                        newRequestDate = false;
                        newCompany = true;
                    }
                    var categoryArr = filterData[i].CATEGORY.split(',');
                    html += '<tr>';


                    if (newCompany == true || newRequestDate == true) {
                        html += '<td class="text-start w-50"><div class="companyNameTitle">' + filterData[i].COMPANY_NAME + '</div><div class="row">';
                        html += '<hr class="companyDivider"/>';
                    }
                    else {
                        html += '<td class="text-start w-50"><div class="row">';
                    }

                    html += '<div class="col-sm-4">' +
                                '<div class="request-img-div">' +
                                    '<img width="100%" height="100%" class="request-img" ' +
                                         'src="' + filterData[i].PRODUCT_IMAGE + '" ' +
                                         'onclick="window.location.href=\'' +
                                         '@Url.Action("AdHocRequestEdit", "ProductDetail")?requestNo=' + filterData[i].SAMPLE_REQ_NO +
                                         '\'" />' +
                                '</div>' +
                            '</div>';
                    html += '<div class="col-sm-5 detail"><div><text class="bold form-header">' + categoryArr[0] + '</text></div>';
                    html += '<div><text class="form-text">Chop No: ' + filterData[i].CHOP_NO + '</text></div><br />';
                    html += '<div class="textControl"><text class="form-text">Variation: ' + filterData[i].COLOR_WAY + '</text></div>';
                    html += '<div class="textControl"><text class="form-text">Reference No: ' + filterData[i].REFERENCE_NO + '</text></div>';
                    html += '<div class="textControl"><text class="form-text">Request No: ' + filterData[i].SAMPLE_REQ_NO + '</text></div>';
                    html += '<div class="textControl"><text class="form-text">Remark: ' + filterData[i].REMARK + '</text></div>';
                    html += '</div>';
                    html += '<div class="col-sm-3 pt-3 form-text">Qty: ' + filterData[i].QUANTITY_REQ;
                    html += '</div>';
                    html += '</div></td>';

                    if (i < filterData.length - 1) {
                        if ((filterData[i + 1].CREATED_DATE).substring(3) == month && (filterData[i + 1].CREATED_DATE).substring(0, (filterData[i + 1].CREATED_DATE).length - 5) == requestDate && filterData[i + 1].COMPANY_NAME == company) {
                            i++;

                            if (newCompany == true) {
                                html += '<td class="text-start w-50"><div class="hiddenRow">_</div><div class="row">';
                                html += '<hr class="hideCompanyDivider"/>';
                                newCompany = false;
                            }
                            else {
                                html += '<td class="text-start w-50"><div class="row">';
                            }
                            var categoryArr2 = filterData[i].CATEGORY.split(',');
                            html += '<div class="col-sm-4"><div class="request-img-div"><img width="100%" height="100%" class="request-img" src="' + filterData[i].PRODUCT_IMAGE + '"></img></div></div>';
                            html += '<div class="col-sm-5 detail"><div><text class="bold form-header">' + categoryArr[0] + '</text></div>';
                            html += '<div><text class="form-text">Chop No: ' + filterData[i].CHOP_NO + '</text></div><br />';
                            html += '<div class="textControl"><text class="form-text">Variation: ' + filterData[i].COLOR_WAY + '</text></div>';
                            html += '<div class="textControl"><text class="form-text">Reference No: ' + filterData[i].REFERENCE_NO + '</text></div>';
                            html += '<div class="textControl"><text class="form-text">Request No: ' + filterData[i].SAMPLE_REQ_NO + '</text></div>';
                            html += '<div class="textControl"><text class="form-text">Remark: ' + filterData[i].REMARK + '</text></div>';
                            html += '</div>';
                            html += '<div class="col-sm-3 pt-3 form-text">Qty: ' + filterData[i].QUANTITY_REQ;
                            html += '</div>';
                            html += '</div></td>';
                        }
                        else {
                            html += '<td></td>';
                        }
                    }
                    else {
                        html += '<td></td>';
                    }
                    html += '</tr>';
                }
                if (filterData.length == 0) {
                    html += '<tr><td>No result found.</td></tr>'
                    $('#firstMonthTitle').text('');
                }

                $('.table tbody tr:not(:first-child)').remove();
                $('.table tbody').append(html);
                $('div.spanner').removeClass("show");
            }
        });
    }

</script>
