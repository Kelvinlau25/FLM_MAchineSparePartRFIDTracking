            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" for="materialTypeMulti" ><input type="checkbox" class="form-check-input" id="materialTypeMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn3"></button></div></br><div class="text-start" id="selectLimit3" style="padding:5px 11px;">0 out of @ViewBag.ProductTypeNum</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit3();
                loadTableData();
            }
        });
        $('.multiselectpicker3').multiselect('selectAll');
        $('#selectLimit3').text(@ViewBag.ProductTypeNum + " out of @ViewBag.ProductTypeNum")

        $("#resetBtn3").click(function () {
            checkSelectionLimit3();
            loadTableData();
        });

        function checkSelectionLimit3() {
            // Get selected options.
            var selectedOptions = $('.multiselectpicker3 option:selected');
