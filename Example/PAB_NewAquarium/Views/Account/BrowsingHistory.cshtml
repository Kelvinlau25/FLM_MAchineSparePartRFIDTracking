    function loadTableData() {
        var html = '';
        var customer = "", fabricCategory = "", productType = "", sortBy = "";
        var fromDateVal, toDateVal;
        $('div.spanner').addClass("show");

        $('.multiselectpicker option:selected').each(function () {
            if (customer != "") {
                customer += "," + $(this).val()
            }
            else {
                customer += $(this).val()
            }
        });

        $('.multiselectpicker2 option:selected').each(function () {
            if (fabricCategory != "") {
                fabricCategory += "," + $(this).val()
            }
            else {
                fabricCategory += $(this).val()
            }
        });

        $('.multiselectpicker3 option:selected').each(function () {
            if (productType != "") {
                productType += "," + $(this).val()
            }
            else {
                productType += $(this).val()
            }
        });

        sortBy = $('#select-id2').val();
        fromDateVal = $('#fromDate').val();
        toDateVal = $('#toDate').val();

        const formData = new FormData();
        formData.append("customer", customer);
        formData.append("fabricCategory", fabricCategory);
        formData.append("productType", productType);
        formData.append("fromDate", fromDateVal);
        formData.append("toDate", toDateVal);
        formData.append("sortBy", sortBy);
        formData.append("createdBy", "@ViewBag.CreatedBy");

        $.ajax({
            url: "/Account/GetBrowsingHistory",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                filterData = result.BrowsingHistory;
                customerData = result.BrowsingHistoryCustomer;
                var month, newMonth = true;

                if (filterData.length > 0) {
                    month = filterData[0].TRANSACTION_DATE;
                    $('#firstMonthTitle').text(month);
                    newMonth = false;
                }

                for (var i = 0; i < filterData.length; i++) {
                    //check if it is the same month
                    if (filterData[i].TRANSACTION_DATE != month) {
                        month = filterData[i].TRANSACTION_DATE;
                        newMonth = true;
                    }

                    //if it is new month
                    if (newMonth == true && i != 0) {
                        html += '<tr>';
                        html += '<td class="bold monthText">' + filterData[i].TRANSACTION_DATE + '</td>'
                        html += '</tr>';
                        newMonth = false;
                    }
                    var categoryArr = filterData[i].CATEGORY.split(',');
                    var filteredCustomerData = customerData.filter(function (item) {
                        // Replace this condition with your own
                        return item.PRODUCT_H_ID == filterData[i].PRODUCT_H_ID && item.TRANSACTION_DATE == filterData[i].TRANSACTION_DATE;
                    });
                    html += '<tr>';
                    html += '<td class="text-start w-50"><div class="row">';
                    html += '<div class="col-sm-4"><div class="browsing-img-div"><img width="100%" height="100%" class="browsing-img" src="' + filterData[i].PRODUCT_IMAGE + '"></img></div></div>';
                    html += '<div class="col-sm-8 detail"><div><text class="bold form-header">' + categoryArr[0] + '</text></div>';
                    html += '<div><text class="form-text">Chop No: ' + filterData[i].CHOP_NO + '</text></div><br />';
                    html += '<div class="textControl"><text class="form-text">' + filterData[i].COMPANY_NAME + '</text></div>';
                    html += '<div class="textControl"><text class="form-text">' + filterData[i].CUSTOMER_NAME + '</text></div>';
                    if (filterData[i].COMPANY_NAME != "") {
                        html += '<div class="textControl"><button type="button" class="float-start dark-blue viewMoreCustomer form-text">View More</button></div>';
                    }
                    html += '<div class="viewsPosition"><text class="form-text">' + filterData[i].VIEWS + ' views</text></div>';
                    html += '<div class="card customerListPosition"><table class="customerListTable"><th class="bold form-text">Customer View List</th>';
                    for (var j = 0; j < filteredCustomerData.length; j++) {
                        html += '<tr><td class="companyTd bold form-text">' + filteredCustomerData[j].COMPANY_NAME + '</td></tr>';
                        html += '<tr><td class="customerTd form-text">' + filteredCustomerData[j].CUSTOMER_NAME + '</td></tr>';
                    }
                    html += ' </table></div></div>';
                    html += '</div></td>';

                    if (i < filterData.length - 1) {
                        if (filterData[i + 1].TRANSACTION_DATE == month) {
                            i++;
                            var categoryArr2 = filterData[i].CATEGORY.split(',');
                            var filteredCustomerData2 = customerData.filter(function (item) {
                                // Replace this condition with your own
                                return item.PRODUCT_H_ID == filterData[i].PRODUCT_H_ID && item.TRANSACTION_DATE == filterData[i].TRANSACTION_DATE;
                            });
                            html += '<td class="text-start w-50"><div class="row">';
                            html += '<div class="col-sm-4"><div class="browsing-img-div"><img class="browsing-img" width="100%" height="100%" src="' + filterData[i].PRODUCT_IMAGE + '"></img></div></div>';
                            html += '<div class="col-sm-8 detail"><div><text class="bold form-header">' + categoryArr2[0] + '</text></div>';
                            html += '<div><text class="form-text">Chop No: ' + filterData[i].CHOP_NO + '</text></div><br />';
                            html += '<div class="textControl"><text class="form-text">' + filterData[i].COMPANY_NAME + '</text></div>';
                            html += '<div class="textControl"><text class="form-text">' + filterData[i].CUSTOMER_NAME + '</text></div>';
                            if (filterData[i].COMPANY_NAME != "") {
                                html += '<div class="textControl"><button type="button" class="float-start dark-blue viewMoreCustomer form-text">View More</button></div>';
                            }
                            html += '<div class="viewsPosition"><text class="form-text">' + filterData[i].VIEWS + ' views</text></div>';
                            html += '<div class="card customerListPosition"><table class="customerListTable"><th class="bold form-text">Customer View List</th>';
                            for (var z = 0; z < filteredCustomerData2.length; z++) {
                                html += '<tr><td class="companyTd bold form-text">' + filteredCustomerData2[z].COMPANY_NAME + '</td></tr>';
                                html += '<tr><td class="customerTd form-text">' + filteredCustomerData2[z].CUSTOMER_NAME + '</td></tr>';
                            }
                            html += ' </table></div></div>';
                            html += '</div></td>';
                        }
                        else {
                            html += '<td></td>';
                        }
                    }
                    else {
                        html += '<td></td>';
                    }
                    html += '</tr>';
                }
                if (filterData.length == 0) {
                    html += '<tr><td>No result found.</td></tr>'
                    $('#firstMonthTitle').text('');
                }

                $('.table tbody tr:not(:first-child)').remove();
                $('.table tbody').append(html);
                $('.customerListPosition').hide();
                $('div.spanner').removeClass("show");

                $(".viewMoreCustomer").click(function () {
                    $(this).parents('.detail').find('.customerListPosition').show();
                });

                $(document).click(function () {
                    var customerListPosition = $('.customerListPosition');
                    var viewMoreCustomer = $('.viewMoreCustomer');

                    if (!customerListPosition.is(event.target) && !customerListPosition.has(event.target).length &&
                        !viewMoreCustomer.is(event.target) && !viewMoreCustomer.has(event.target).length) {
                        customerListPosition.hide();
                    }
                });
            }
        });
    }

</script>
