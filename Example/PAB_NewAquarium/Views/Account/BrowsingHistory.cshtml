@model PAB_NewAquarium.Models.BrowsingHistoryList
@{
    ViewBag.Title = "Browsing History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style type="text/css">
    @@media (min-width: 768px) {
        .multiselect-all {
            float: left;
            padding-left: 0.2rem !important;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, -33px) !important;
        }
    }

    @@media (min-width: 1400px) {
        .multiselect-all {
            float: left;
            text-align: left;
        }

        .multiselect-container.dropdown-menu {
            transform: translate(0px, 41px) !important;
        }
    }

    .backBtn {
        cursor: pointer;
        font-size: 20px;
    }

    #viewMoreButton, .viewMoreCustomer {
        background-color: transparent;
        border: none;
        cursor: pointer;
        padding-right: 0px;
        text-decoration: underline;
        padding-left: 0px;
        color: #004098;
    }

    .checkboxCustom {
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
        cursor: default;
    }

    .multiselect-reset .multiselect-all:hover {
        background-color: transparent !important;
    }

    .multiselectDdlCustom {
        font-weight: bold;
        border: none;
        outline: none;
        --bs-btn-box-shadow: none;
    }

    .btn-reset {
        float: right;
    }

        .btn-reset:hover {
            background-color: transparent;
        }

    #companyMulti, #materialTypeMulti, #categoryMulti {
        margin-right: 9px;
        display: none;
    }

    .bold{
        font-weight: bold;
    }

    td {
        border-bottom-width: 0px !important;
    }

    .monthText{
        font-size: 25px;
    }

    .textControl {
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        max-width: 500px;
    }

    .detail{
        position: relative;
    }

    .viewsPosition{
        bottom: 0;
        position: absolute;
    }

    .customerListPosition {
        right: 0;
        position: absolute;
        top: -50px;
        padding: 10px;
        width: 300px;
        max-height: 250px;
        background-color: white;
        overflow-y: scroll;
    }

    .customerListTable th {
        border-bottom: 1px solid #C5C5C5;
    }

    .customerListTable .companyTd {
        padding-top: 10px;
    }

    .customerListTable .customerTd {
        color: #929292;
    }

    #sortByDdl {
        background-color: #ebf3ff;
        border: none;
        height: 40px;
    }

    .browsing-img {
        border-radius: 0.5rem;
    }

    .url-link:hover {
        text-decoration: underline;
    }
    #btnExport {
        height: 40px;
    }

    @@media only screen and (max-device-height: 799px) {
        .form-header {
            font-size: 16px;
        }

        .form-text {
            font-size: 14px;
        }

        .sortByDdl {
            width: 30%;
        }

        .browsing-img-div {
            height: 163px;
        }
    }

    @@media only screen and (max-device-width: 1280px) and (min-device-height: 800px) {
        .form-header {
            font-size: 16px;
        }

        .form-text {
            font-size: 14px;
        }

        .sortByDdl {
            width: 30%;
        }

        .browsing-img-div {
            height: 163px;
        }
    }

    @@media only screen and (min-device-width: 1281px) and (max-device-width: 1919px) and (min-device-height: 800px) {
        .form-header {
            font-size: 18px;
        }

        .form-text {
            font-size: 14px;
        }

        .sortByDdl {
            width: 25%;
        }

        .browsing-img-div {
            height: 204px;
        }
    }

    @@media only screen and (min-device-width: 1920px) and (min-device-height: 800px) {
        .form-header {
            font-size: 20px;
        }

        .form-text {
            font-size: 16px;
        }

        .sortByDdl {
            width: 25%;
        }

        .browsing-img-div {
            height: 264px;
        }
    }
</style>

@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()
    <div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
    <div class="page-container px-3 overflow-y-auto">
        <div class="tr-btm-btn-margin">
            <div class="row align-items-baseline mt-3">
                <div class="col"><h6 class="text-muted card-title"><a href="@Url.Action("Account", "Account")"><span class="fas fa-chevron-left dark-blue me-sm-3 backBtn"></span></a>Browsing History</h6></div>
            </div>
            <div class="row align-items-baseline mt-3">
                <div class="col">
                    <a class="text-decoration-none" href="@Url.Action("Index", "Dashboard")"><span class="fa fa-house dark-blue"></span></a>
                    <text class="mx-1">/</text>
                    <a  class="url-link" href="@Url.Action("Account", "Account")">My Account</a>
                    <text class="mx-1">/</text>
                    <text>Browsing History</text>
                </div>
            </div>
            <div class="card mt-3 mb-2 card-height">
                <div class="card-body">
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">History Category <span style="float:right">:</span></p>
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(m => m.BrowsingHistoryDdl, Model.BrowsingHistoryDdl, null, new { @class = "tr-select2 form-control", id = "select-id1" })
                        </div>
                        <div class="col-sm-1">

                        </div>
                        <div class="col-sm-2">
                            <p class="text-muted">Customer <span style="float:right">:</span></p>
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(m => m.CompanyDdl, Model.CompanyDdl, null, new { @class = "multiselectpicker form-control", multiple = "multiple", id = "multiselect-id1" })
                        </div>
                        <div class="col-sm-1">

                        </div>
                    </div>
                    <div class="additional-content" style="display:none;">
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">Fabric Category <span style="float:right">:</span></p>
                            </div>
                            <div class="col-sm-3">
                                @Html.DropDownListFor(m => m.FabricCategoryDdl, Model.FabricCategoryDdl, null, new { @class = "multiselectpicker2 form-control", multiple = "multiple", id = "multiselect-id2" })
                            </div>
                            <div class="col-sm-1">

                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">Product Types <span style="float:right">:</span></p>
                            </div>
                            <div class="col-sm-3">
                                @Html.DropDownListFor(m => m.ProductTypeDdl, Model.ProductTypeDdl, null, new { @class = "multiselectpicker3 form-control", multiple = "multiple", id = "multiselect-id3" })
                            </div>
                            <div class="col-sm-1">

                            </div>
                        </div>
                        <div class="row mt-2 align-items-baseline">
                            <div class="col-sm-2">
                                <p class="text-muted">From Date <span style="float:right">:</span></p>
                            </div>
                            <div class="col-sm-3">
                                <div class="input-group">
                                    @*@Html.TextBox("fromDate", null, new { @class = "form-control" })*@
                                    <input type="text" placeholder="Please pick a date..." class="form-control tr-date" id="fromDate" style="border-right:none; box-shadow: none; border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important;">
                                    <div class="input-group-text" style="background-color: transparent; border-left: none">
                                        <a href="" class="text-reset dp" id="dp1"><i class="fa-solid fa-calendar-days tr-icon-blue" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-1">

                            </div>
                            <div class="col-sm-2">
                                <p class="text-muted">To Date <span style="float:right">:</span></p>
                            </div>
                            <div class="col-sm-3">
                                <div class="input-group">
                                    @*@Html.TextBox("toDate", null, new { @class = "form-control" })*@
                                    <input type="text" placeholder="Please pick a date..." class="form-control tr-date" id="toDate" style="border-right:none; box-shadow: none; border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important;">
                                    <div class="input-group-text" style="background-color: transparent; border-left: none">
                                        <a href="" class="text-reset dp" id="dp2"><i class="fa-solid fa-calendar-days tr-icon-blue" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-1">

                            </div>
                        </div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <button type="button" class="float-start" id="viewMoreButton">View More</button>
                        </div>
                        <div class="col-sm-4">

                        </div>
                        <div class="col-sm-2">

                        </div>
                        <div class="col-sm-4">

                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="p-3 pt-0">
                            <table class="table">
                                <thead class="d-none">
                                    <tr>
                                        <th class="w-50"></th>
                                        <th class="w-50"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="bold monthText" id="firstMonthTitle"></td>
                                        <td class="text-end">
                                            <button type="button" style="display:none" class="btn buttons-excel buttons-html5 btn-sm btn-primary tr-btn-primary" id="btnExport">Export to Excel</button>
                                            @Html.DropDownListFor(m => m.SortBy, Model.SortBy, null, new { @class = "tr-select2 form-control", id = "select-id2" })
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <button id="scrollTopBtn" title="Go to top"><span class="fas fa-chevron-up dark-blue"></span></button>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="submit-confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to submit this record?</h6>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" value="submit" name="btn" id="btnConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed toast-alert">
        <div id="liveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
            <div class="toast-header" style="background-color: #FFF0EE">
                <strong class="me-auto text-danger">Warning!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Failed to submit, Duplicated Company Name.
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed toast-success">
        <div id="liveToast2" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto" style="color: #00A251">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Submit Successfully.
            </div>
        </div>
    </div>
}

<script>
    var filterData;
    var dateToday = new Date();
    var fromdate = ((dateToday.getMonth() + 1) < 10 ? '0' + (dateToday.getMonth() + 1) : (dateToday.getMonth() + 1)) + '/' + dateToday.getFullYear();
    var todate = ((dateToday.getMonth() + 1) < 10 ? '0' + (dateToday.getMonth() + 1) : (dateToday.getMonth() + 1)) + '/' + dateToday.getFullYear();
    var nextMonthDate = new Date(dateToday.getFullYear(), (dateToday.getMonth() + 1), 0)
    $(document).ready(function () {
        var today = new Date();
        var pastDate = new Date(today);
        pastDate.setMonth(pastDate.getMonth() - 2);
        fromdate = ((pastDate.getMonth() + 1) < 10 ? '0' + (pastDate.getMonth() + 1) : (pastDate.getMonth() + 1)) + '/' + pastDate.getFullYear();
        $('#fromDate').val(((pastDate.getMonth() + 1) < 10 ? '0' + (pastDate.getMonth() + 1) : (pastDate.getMonth() + 1)) + '/' + pastDate.getFullYear());
        //$('#fromDate').val(today.getMonth() + 1 + '/' + today.getFullYear());
        $('#toDate').val(((today.getMonth() + 1) < 10 ? '0' + (today.getMonth() + 1) : (today.getMonth() + 1)) + '/' + today.getFullYear());
        $("#viewMoreButton").click(function () {
            $(".additional-content").slideToggle();
            var buttonText = "";
            if ($(this).text() === "View More") {
                buttonText = "View Less";
                $(this).css('color', '#FF3366');
            }
            else {
                buttonText = "View More";
                $(this).css('color', '#004098');
            }
            $(this).text(buttonText);
        });

        $('#fromDate').datetimepicker({
            timepicker: false,
            format: 'd/m/Y',
            onSelectDate: function () {
                fromdate = $('#fromDate').val().substring(3);
                $('#fromDate').blur();
            },
            maxDate: new Date(todate.substring(3) + '/' + todate.substring(0, 2) + '/' + nextMonthDate.getDate()),
            onChangeDateTime: function (dp, $input) {
                var date = "01/" + fromdate;
                $('#fromDate').val(date.substring(3));
                var minDate = new Date(fromdate.substring(3) + '/' + fromdate.substring(0, 2) + '/01');
                $("#toDate").datetimepicker('setOptions', {
                    minDate: minDate
                });
                loadTableData();
            },
        });
        $('#dp1').on('click', function (e) {
            e.preventDefault();
            $('#fromDate').focus();
        });

        $('#toDate').datetimepicker({
            timepicker: false,
            format: 'd/m/Y',
            onSelectDate: function () {
                todate = $('#toDate').val().substring(3);
                $('#toDate').blur();
            },
            minDate: new Date(fromdate.substring(3) + '/' + fromdate.substring(0, 2) + '/01'),
            onChangeDateTime: function (dp, $input) {
                var date = "01/" + todate;
                $('#toDate').val(date.substring(3));
                var maxDate = new Date(todate.substring(3) + '/' + todate.substring(0, 2) + '/01');
                maxDate.setDate(maxDate.getDate() - 1);
                maxDate.setMonth(maxDate.getMonth() + 1);
                $("#fromDate").datetimepicker('setOptions', {
                    maxDate: maxDate
                });
                loadTableData();
            },
        });
        $('#dp2').on('click', function (e) {
            e.preventDefault();
            $('#toDate').focus();
        });

        $('#select-id1').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" id="historyCategoryDdl" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $("#select-id1").next().find('button').addClass('grayed-out')

        $('#select-id2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" id="sortByDdl" data-bs-toggle="dropdown"><label>Sort By:&nbsp;&nbsp; </label><span class="multiselect-selected-text"></span></button>',
            },
            onChange: function (option, checked) {
                loadTableData();
            }
        });

        $('.multiselectpicker').multiselect({
            buttonClass: 'form-select form-control text-start',
            includeResetOption: true,
            includeResetDivider: true,
            resetText: "CLEAR",
            selectAllText: ' Select all',
            includeSelectAllOption: true,
            onSelectAll: function () {
                checkSelectionLimit();
                loadTableData();
            },
            onDeselectAll: function () {
                checkSelectionLimit();
                loadTableData();
            },
            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" id="companyMultiLbl" for="companyMulti" ><input type="checkbox" class="form-check-input" id="companyMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn"></button></div></br><div class="text-start" id="selectLimit" style="padding:5px 11px;">0 out of @ViewBag.CompanyNum</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit();
                loadTableData();
            }
        });
        $('.multiselectpicker').multiselect('selectAll');
        $('#selectLimit').text(@ViewBag.CompanyNum + " out of @ViewBag.CompanyNum")

        $("#resetBtn").click(function () {
            checkSelectionLimit();
            loadTableData();
        });

        function checkSelectionLimit() {
            // Get selected options.
            var selectedOptions = $('.multiselectpicker option:selected');
            var selectLimit = $("#selectLimit");

                // Enable all checkboxes.
                $('.multiselectpicker option').each(function () {
                    var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                    input.prop('disabled', false);
                    input.parent('li').addClass('disabled');
            });

            selectLimit.text(selectedOptions.length + " out of @ViewBag.CompanyNum")
        }

        $('.multiselectpicker2').multiselect({
            buttonClass: 'form-select form-control text-start',
            includeResetOption: true,
            includeResetDivider: true,
            resetText: "CLEAR",
            selectAllText: ' Select all',
            includeSelectAllOption: true,
            onSelectAll: function () {
                checkSelectionLimit2();
                loadTableData();
            },
            onDeselectAll: function () {
                checkSelectionLimit2();
                loadTableData();
            },
            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" for="materialTypeMulti" ><input type="checkbox" class="form-check-input" id="materialTypeMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn2"></button></div></br><div class="text-start" id="selectLimit2" style="padding:5px 11px;">0 out of @ViewBag.FabricCategoryNum</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit2();
                loadTableData();
            }
        });
        $('.multiselectpicker2').multiselect('selectAll');
        $('#selectLimit2').text(@ViewBag.FabricCategoryNum + " out of @ViewBag.FabricCategoryNum")

        $("#resetBtn2").click(function () {
            checkSelectionLimit2();
            loadTableData();
        });

        function checkSelectionLimit2() {
            // Get selected options.
            var selectedOptions = $('.multiselectpicker2 option:selected');
            var selectLimit = $("#selectLimit2");

            $('.multiselectpicker2 option').each(function () {
                var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                input.prop('disabled', false);
                input.parent('li').addClass('disabled');
            });
            selectLimit.text(selectedOptions.length + " out of @ViewBag.FabricCategoryNum")
        }

        $('.multiselectpicker3').multiselect({
            buttonClass: 'form-select form-control text-start',
            includeResetOption: true,
            includeResetDivider: true,
            resetText: "CLEAR",
            selectAllText: ' Select all',
            includeSelectAllOption: true,
            onSelectAll: function () {
                checkSelectionLimit3();
                loadTableData();
            },
            onDeselectAll: function () {
                checkSelectionLimit3();
                loadTableData();
            },
            enableCaseInsensitiveFiltering: true,
            enableFiltering: true,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                resetButton: '<div class="multiselect-reset text-end p-2"> <label class="multiselect-all dark-blue btn btn-sm btn-block multiselectDdlCustom" for="materialTypeMulti" ><input type="checkbox" class="form-check-input" id="materialTypeMulti" value="multiselect-all"> SELECT ALL</label> <button class="btn btn-sm btn-block btn-outline-secondary btn-reset dark-blue multiselectDdlCustom" type="button" id="resetBtn3"></button></div></br><div class="text-start" id="selectLimit3" style="padding:5px 11px;">0 out of @ViewBag.ProductTypeNum</div>',
                filter: '<div class="multiselect-filter"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input class="form-control multiselect-search" type="text" /></div></div>',
            },

            onChange: function (option, checked) {
                checkSelectionLimit3();
                loadTableData();
            }
        });
        $('.multiselectpicker3').multiselect('selectAll');
        $('#selectLimit3').text(@ViewBag.ProductTypeNum + " out of @ViewBag.ProductTypeNum")

        $("#resetBtn3").click(function () {
            checkSelectionLimit3();
            loadTableData();
        });

        function checkSelectionLimit3() {
            // Get selected options.
            var selectedOptions = $('.multiselectpicker3 option:selected');
            var selectLimit = $("#selectLimit3");

            $('.multiselectpicker3 option').each(function () {
                var input = $('input[value="' + $(this).val() + '"]').parents('.multiselect-option');
                input.prop('disabled', false);
                input.parent('li').addClass('disabled');
            });
            selectLimit.text(selectedOptions.length + " out of @ViewBag.ProductTypeNum")
        }

        $('.multiselect-native-select > .btn-group').addClass("w-100");
        $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
        $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");
        $('#sortByDdl').parent('.btn-group').removeClass("w-100");
        $('#sortByDdl').parent('.btn-group').addClass("sortByDdl");

        loadTableData();

        $('.card-height').scroll(function () {
            if ($(this).scrollTop() > 100) {
                $('#scrollTopBtn').fadeIn();
            } else {
                $('#scrollTopBtn').fadeOut();
            }
        });

        // Scroll to top when the button is clicked
        $('#scrollTopBtn').click(function () {
            $('.card-height').animate({ scrollTop: 0 }, 800);
            return false;
        });


        $("#btnExport").click(function ()
        {
            var customer = "", fabricCategory = "", productType = "", sortBy = "";
            var fromDateVal, toDateVal;

            $('div.spanner').addClass("show");

            $('.multiselectpicker option:selected').each(function () {
                if (customer != "") {
                    customer += "," + $(this).val()
