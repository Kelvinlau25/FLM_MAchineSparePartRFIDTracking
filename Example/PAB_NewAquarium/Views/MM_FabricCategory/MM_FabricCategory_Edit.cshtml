@model PAB_NewAquarium.Models.MM_FABRIC_CATEGORY

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var UrlActionList = Url.Action("MM_FabricCategory_List", "MM_FabricCategory");
    var UrlActionValidate = Url.Action("MM_FabricCategory_CategoryNameCheck", "MM_FabricCategory");
}
<style>
    .nav-tabs {
        --bs-nav-tabs-border-width: 0px;
    }

    .tr-tab .nav-link {
        min-width: 250px;
        text-align: left;
        background-color: #F0F0F0 !important;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

        .tr-tab .nav-link:not(:first-child) {
            margin-left: 5px;
        }

    .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
        box-shadow: inset 0 0px 0 transparent !important;
    }

    .tr-tab .nav-link.active {
        color: #54575A !important;
        background-color: #EBF3FF !important;
        font-weight: bold;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .nav-tabs .nav-link {
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        border-width: 0px !important;
    }

    a.tr-disabled {
        pointer-events: none;
    }

    .tr-no-border {
        border: 0px !important;
    }

    .multiselect-container > .disabled {
        display: none;
    }

    .form-check-input {
        border-color: #929292;
    }

        .form-check-input[type="checkbox"]:indeterminate {
            background-color: #057FE5;
            border-color: #057FE5;
        }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.CATEGORY_H_ID)
    @Html.HiddenFor(model => model.PRODUCT_H_ID)
    @Html.HiddenFor(model => model.LISTING_JSON)
    <div class="row g-0 px-3 tr-listing-header">
        <div class="col-sm-6 align-self-center">
            <p class="text-muted m-0 tr-listing-header-title">Category</p>
        </div>
    </div>
    <div class="tr-btm-line"></div>
    <div class="page-container px-3 overflow-auto">
        <div class="tr-btm-btn-margin mt-3">
            <nav class="tr-tab">
                <div class="nav nav-tabs" id="nav-tab">
                    <button type="button" class="nav-link active" id="nav-page1-tab">Edit Category</button>
                    <button type="button" class="nav-link" id="nav-page2-tab">Selection of Fabric</button>
                </div>
            </nav>
            <div class="tab-content p-2" id="nav-tabContent" style="border: 4px solid #EBF3FF;">
                <div class="tab-pane show active" id="nav-page1">
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Category Name <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(model => model.CATEGORY_NAME, new { @class = "form-control form-valid" })
                            @Html.ValidationMessageFor(model => model.CATEGORY_NAME, null, new { @class = "text-danger" })
                        </div>
                        <div class="col hidden validName green"><i class="fa-solid fa-check"></i><text> Valid category name</text></div>
                        <div class="col hidden invalidName red"><i class="fa-solid fa-close"></i><text> This category name already exist</text></div>
                    </div>
                    <div class="row mt-2 align-items-baseline">
                        <div class="col-sm-2">
                            <p class="text-muted">Category Detail <span class="text-danger">*</span><span class="float-end">:</span></p>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextAreaFor(model => model.CATEGORY_DETAIL, new { @class = "form-control form-valid" })
                            @Html.ValidationMessageFor(model => model.CATEGORY_DETAIL, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="mb-5"></div>
                </div>
                <div class="tab-pane" id="nav-page2">
                    <div class="row">
                        <table id="tr-datatable" class="table table-hover table-bordered compact w-100">
                            <thead>
                                <tr class="bg-datatable-tr">
                                    <th></th>
                                    <th>Order Reference</th>
                                    <th>Chop No</th>
                                    <th>Running No</th>
                                    <th>Fabric Type</th>
                                    <th>Product Type</th>
                                    <th>Weave Type</th>
                                    <th>Width</th>
                                    <th>Weight</th>
                                    <th>Location</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row tr-btm-btn-area">
                <div class="col">
                    <button id="btnReset" type="button" class="btn btn-sm btn-secondary mx-1 hidden">Reset</button>
                </div>
                <div class="col text-end me-3">
                    <button id="btnBack" type="button" class="btn btn-sm btn-secondary mx-1" onclick="location.href='@UrlActionList'">Back</button>
                    <button id="btnNext" type="button" class="btn btn-sm btn-primary mx-1">Next</button>
                    <button id="btnBack2" type="button" class="btn btn-sm btn-secondary mx-1 hidden">Back</button>
                    <button id="btnSubmit" type="button" class="btn btn-sm btn-primary mx-1 hidden" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Dialog -->
    <div class="modal fade" id="submit-confirmation-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl justify-content-center">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmation</h5>
                </div>
                <hr />
                <div class="modal-body">
                    <h6>Are you sure to submit this record?</h6>
                    <div class="modal-body-scroll">
                        <table id="table-confirmation" class="table table-bordered w-100">
                            <thead>
                                <tr class="bg-datatable-tr">
                                    <th class="text-truncate">Order Reference</th>
                                    <th class="text-truncate">Chop No</th>
                                    <th class="text-truncate">Fabric Type</th>
                                    <th class="text-truncate">Product Type</th>
                                    <th class="text-truncate">Weave Type</th>
                                    <th class="text-truncate">Width</th>
                                    <th class="text-truncate">Weight</th>
                                    <th class="text-truncate">Location</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnSubmitConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Message -->
    <div class="toast-container position-fixed toast-success">
        <div id="successToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #00A251">
            <div class="toast-header" style="background-color: #E9FFF8">
                <strong class="me-auto green">Successful!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #E9FFF8; border-top: 1px solid #E9FFF8; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
                Submit Successfully.
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed toast-alert">
        <div id="errorToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" style="border: 1px solid #B1003C">
            <div class="toast-header" style="background-color: #FFF0EE">
                <strong class="me-auto text-danger">Warning!</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-muted" style="background-color: #FFF0EE; border-top: 1px solid #FFF0EE; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit">
            </div>
        </div>
    </div>
}

<script>
    var UrlActionList = "@UrlActionList";
    var UrlActionValidate = "@UrlActionValidate";
    var returnMessage = "@ViewBag.ReturnMessage";
    var table;  
    var data = [], dataAll = [];
    var data = @Html.Raw(Model.LISTING_JSON);
    var categoryID = '@Model.CATEGORY_H_ID';
    var selected = @Html.Raw(Json.Encode(Model.PRODUCT_H_ID));
    var selectedList = selected.split(',');
    dataAll = data;

    $(document).ready(function () {

        toastMessage();

        $('.tr-select2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.tr-select2:input').val('');
        $('.tr-select2').multiselect('rebuild');
        $('.tr-select').select2({
            theme: "bootstrap-5",
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            placeholder: $(this).data('placeholder'),
            minimumResultsForSearch: Infinity,
            templateSelection: function formatState(state) {
                return 'Status : ' + state.element.value;
            },
            dropdownCssClass: 'tr-select2-container',
            selectionCssClass: 'tr-no-border'
        });
        $('.multiselectpicker').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.multiselectpicker2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });
        $('.multiselect-native-select > .btn-group').addClass("w-100");
        $('.multiselect-native-select > .btn-group > .multiselect').removeClass("text-center");
        $('.multiselect-native-select > .btn-group > .multiselect-container').addClass("w-100");

        $('#tr-datatable').on('length.dt', function (e, settings, len) {
            var customToolbarDiv = $('.custom-toolbar');

            if (len == 10) {
                customToolbarDiv.removeClass('custom-toolbar-add-margin');
            } else {
                customToolbarDiv.addClass('custom-toolbar-add-margin');
            }
        });

        $('.dataTables_length select').addClass('tr-select2');

        $('.tr-select2').multiselect({
            buttonClass: 'form-select form-control text-start',
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
            }
        });

        $('.tr-select').select2({
            theme: "bootstrap-5",
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            placeholder: $(this).data('placeholder'),
            minimumResultsForSearch: Infinity,
            templateSelection: function formatState(state) {
                return 'Status : ' + state.element.value;
            },
            dropdownCssClass: 'tr-select2-container',
            selectionCssClass: 'tr-no-border'
        });

        $('#btnSearchAS').on('click', function () {
            $("div.spanner").addClass("show");
            $("div.overlay").addClass("show");
            setTimeout(function () {
                $("div.spanner").removeClass("show");
                $("div.overlay").removeClass("show");
            }, 2500);
        });

        $('#btnReset').on('click', function () {
            $("div.spanner").addClass("show");
            $("div.overlay").addClass("show");
            setTimeout(function () {
                table.destroy();
                loadDataTable();
                filterColumn();
                $("div.spanner").removeClass("show");
                $("div.overlay").removeClass("show");
            }, 100);
        });

        $('.tr-select').on('change', function (e) {
            if (e.target.value == "All") {
                data = dataAll;
            } else {
                data = dataAll.filter(x => x.Status.toString() == e.target.value);
            }
            $('.tr-rec').text(data.length);
            table.clear().rows.add(data).draw();
        });

        $('#table-confirmation').DataTable({
            orderCellsTop: false,
            paging: false,
            ordering: false,
            info: false,
            filter: false,
        });

        $('#btnNext').click(function () {
            var categoryName = $('#CATEGORY_NAME').val().trim();
            var categoryDetail = $('#CATEGORY_DETAIL').val();
            if (categoryName == "" || categoryDetail == "") {
                $('#nav-page1-tab').click();
                $('.form-valid').each(function () {
                    var validationMessage = $(this).attr('data-val-required');
                    if (validationMessage == undefined) {
                        validationMessage = "This field is required."
                    }
                    if ($(this).val().trim() === "") {
                        $(this).addClass('is-invalid');
                        $(this).siblings('.text-danger').text(validationMessage).show();
                    }
                    else {
                        $(this).removeClass('is-invalid');
                        $(this).siblings('.text-danger').text("").hide();
                    }
                });
            }
            else {
                $.ajax({
                    type: "post",
                    url: UrlActionValidate,
                    data: {
                        categoryID: categoryID,
                        categoryName: categoryName
                    },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (data == "EXIST") {
                            $('.validName').addClass("hidden");
                            $('.invalidName').removeClass("hidden");
                        }
                        else {
                            $('.validName').removeClass("hidden");
                            $('.invalidName').addClass("hidden");
                            $('#nav-page2-tab').click();
                            displaySecondPageButton();
                            table.columns.adjust();
                            adjustDataTableColumn();
                        }
                    },
                });
            }
        });

        $('#btnBack2').click(function () {
            $('#nav-page1-tab').click();
            displayFirstPageButton();
        });

        $('#nav-page1-tab').click(function () {
            displayFirstPageButton();
        });

        $('#nav-page2-tab').click(function () {
            var categoryName = $('#CATEGORY_NAME').val().trim();
            var categoryDetail = $('#CATEGORY_DETAIL').val();
            if (categoryName == "" || categoryDetail == "") {
                $('#nav-page1-tab').click();
                $('.form-valid').each(function () {
                    var validationMessage = $(this).attr('data-val-required');
                    if (validationMessage == undefined) {
                        validationMessage = "This field is required."
                    }
                    if ($(this).val().trim() === "") {
                        $(this).addClass('is-invalid');
                        $(this).siblings('.text-danger').text(validationMessage).show();
                    }
                    else {
                        $(this).removeClass('is-invalid');
                        $(this).siblings('.text-danger').text("").hide();
                    }
                });
            }
            else {
                $.ajax({
                    type: "post",
                    url: UrlActionValidate,
                    data: {
                        categoryID: categoryID,
                        categoryName: categoryName
                    },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (data == "EXIST") {
                            $('.validName').addClass("hidden");
                            $('.invalidName').removeClass("hidden");
                        }
                        else {
                            $('.validName').removeClass("hidden");
                            $('.invalidName').addClass("hidden");
                            displaySecondPageButton();
                            table.columns.adjust();
                            adjustDataTableColumn();
                        }
                    },
                });
            }
        });

        $('#btnSubmit').click(function () {
            var confirmationTable = $('#table-confirmation').DataTable();
            var selectedRows = table.rows({ selected: true }).data().toArray();
            if (selectedRows.length > 5) {
                $('.modal-body-scroll').css({
                    'height': '360px',
                    'overflow': 'hidden scroll'
                });
            }
            else {
                $(".modal-body-scroll").removeAttr("style");
            }
            confirmationTable.clear().draw();
            selectedRows.forEach(function (rowData) {
                confirmationTable.row.add([
                    rowData.REFERENCE_NO,
                    rowData.CHOP_NO,
                    rowData.FABRIC_TYPE,
                    rowData.PRODUCT_TYPE,
                    rowData.WEAVE_TYPE,
                    rowData.WIDTH,
                    rowData.FAB_WEIGHT_GSM,
                    rowData.HANGER_LOC
                ]).draw(false);
            });
        });

        $('#btnSubmitConfirm').click(function () {
            var categoryName = $('#CATEGORY_NAME').val();
            var categoryDetail = $('#CATEGORY_DETAIL').val();

            $('#submit-confirmation-modal').modal('hide');

            if (categoryName == '' || categoryDetail == '') {
                $('#nav-page1-tab').click();
            }
            else {
                var selectedValues = [];
                var selectedValuesString = "";
                var selectedRows = table.rows({ selected: true }).data().toArray();

                selectedRows.forEach(function (rowData) {
                    var checkboxValue = rowData;
                    selectedValues.push(checkboxValue.PRODUCT_H_ID);
                });

                if (selectedValues.length == 0) {
                    $('#errorToast .toast-body').html('Please select at least one record!');
                    const toastLiveExample = document.getElementById('errorToast');
                    const toast = new bootstrap.Toast(toastLiveExample);
                    toast.show();
                    return false;
                }

                else {
                    selectedValuesString = selectedValues.join(",");
                    $('#PRODUCT_H_ID').val(selectedValuesString);
                }
            }
        });

        table.on('draw', function () {
            adjustDataTableColumn();
        });
    });

    function loadDataTable() {
        table = $('#tr-datatable').DataTable({
            data: data,
            scrollCollapse: true,
            scrollY: calcDataTableHeight,
            pagingType: 'simple_numbers',
            columns: [
                { data: 'PRODUCT_H_ID' },
                { data: 'REFERENCE_NO' },
                { data: 'CHOP_NO' },
                { data: 'RUNNING_NO' },
                { data: 'FABRIC_TYPE' },
                { data: 'PRODUCT_TYPE' },
                { data: 'WEAVE_TYPE' },
                { data: 'WIDTH' },
                { data: 'FAB_WEIGHT_GSM' },
                { data: 'HANGER_LOC' },
            ],
            columnDefs: [
                {
                    targets: 0,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = '<div class="checkbox" ID="checkbox_' + row.PRODUCT_H_ID + '"><input type="checkbox" class="dt-checkboxes form-check-input"><label></label></div>';
                        }
                        return data;
                    },
                    checkboxes: {
                        selectRow: true,
                        selectAllPages: false,
                        selectAllRender: '<div class="checkbox"><input type="checkbox" class="dt-checkboxes form-check-input"></div>'
                    }
                }
            ],
            select: {
                style: 'multi',
                info: false,
                selector: 'td:nth-child(1)'
            },
            order: [],
            dom: "<'row toolbar-row g-0 custom-toolbar'<'col-sm-12 col-md-6 align-self-center'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end '<'toolbar'>>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'<'d-flex justify-content-end mt-2'p<'go-to align-self-center mx-2'>>>>",
            initComplete: function () {
                $("div.toolbar").html(`<div class="input-group input-group-sm">
                                            <input type="text" id="txtSearch" class="form-control remove-right-border tr-search-txt tr-list-txtbx-border" style="border-top-right-radius: 0px !important; border-bottom-right-radius: 0px !important;" placeholder="Search" aria-label="Search" aria-describedby="btnAdvanceSearch">
                                            <div class="input-group-text listing-search-icon tr-list-txtbx-border tr-input-grp-right">
                                                <a href="" class="text-reset d-flex align-items-center justify-content-end text-decoration-none" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i></a>
                                            </div>
                                       </div>`);

                $("#btnSearch").on("click", function (e) {
                    e.preventDefault();
                });

                $("#txtSearch").on("keyup", function (e) {
                    table.search($('#txtSearch').val()).draw();
                });

                $('#btnDeleteConfirm').on('click', function () {
                    var selectedValues = [];
                    var selectedRows = table.rows({ selected: true }).data().toArray();
                    selectedRows.forEach(function (rowData) {
                        var checkboxValue = rowData["ID"];
                        selectedValues.push(checkboxValue);
                    });

                    $.ajax({
                        url: UrlActionDelete, // Replace with your controller route
                        type: 'POST',
                        data: { id: selectedValues },
                        success: function (response) {
                            if (response == "SUCCESS") {
                                Swal.fire({
                                    title: "Success",
                                    text: "Successfully Deleted.",
                                    icon: "success",
                                    showCancelButton: false,
                                    confirmButtonText: "OK"
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // User pressed "OK", redirect to another view
                                        window.location.href = urlActionList;
                                    }
                                });
                            } else {
                                Swal.fire('Failed!', 'Failed Delete.', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.fire('Error!', error, 'error');
                        }
                    });
                });
            },
            drawCallback: function (settings) {
                var api = this.api();
                $("#txtGoTo").val(api.page() + 1);
            },
            fixedHeader: {
                header: true,
                footer: false
            }
        });

        $("div.go-to").html('<div class="d-flex align-items-center p-0"><input class="form-control" type="text" id="txtGoTo" style="width:75px" value=1> &nbsp; <div class="page-info">of ' + table.page.info().pages + '</div></div>');
        $("#txtGoTo").on('keyup', function (e) {
            try {
                var page = e.target.value;
                if ($.isNumeric(page) && page > 0 && page <= table.page.info().pages) {
                    table.page(page - 1).draw('page');
                } else if (e.target.value.trim() == '') {

                }
                else {
                    e.target.value = table.page() + 1;
                }

            } catch (ex) {
                e.target.value = 1;
            }
        });
        $("#txtGoTo").on('blur', function (e) {
            try {
                var page = e.target.value;
                if (page.trim() == '') {
                    $("#txtGoTo").val(1);
                    table.page(0).draw('page');
                    $("#txtGoTo").focus();
                }
            } catch (ex) {
                e.target.value = 1;
            }
        });
        $(".dataTables_length .form-select").on('change', function () {
            $("#txtGoTo").val(table.page() + 1);
            $("div.page-info").html('of ' + table.page.info().pages + '</div>');
        });
    }

    function filterColumn() {
        var table = $('#tr-datatable').DataTable();
        table.rows().data().each(function (rowData, index) {
            for (var i = 0; i < selectedList.length; i++) {
                if (rowData.PRODUCT_H_ID == selectedList[i]) {
                    table.row(index).select();
                }
            }
        });
    }

    function calcDataTableHeight() {
        var winWidth = $(window).width();
        if (winWidth >= 1280 && winWidth <= 1599) {
            return $(window).height() * 43 / 100;
        } else {
            return $(window).height() * 50 / 100;
        }
    };

    function adjustDataTableColumn() {
        if (hasVerticalScrollbar()) {
            $('.dataTables_scrollHead').css('width', 'calc(100% - 3px)');
            $('.custom-toolbar').css('width', 'calc(100% - 3px)');
        }
        else {
            $('.dataTables_scrollHead').css('width', '100%');
            $('.custom-toolbar').css('width', '100%');
        }
    }

    function hasVerticalScrollbar() {
        var table = $('#tr-datatable').DataTable();
        var tableWrapper = table.table().container();
        var tableBody = tableWrapper.querySelector('.dataTables_scrollBody');
        return tableBody.scrollHeight > tableBody.clientHeight;
    }

    function displayFirstPageButton() {
        $('#nav-page1').addClass('active');
        $('#nav-page1-tab').addClass('active');
        $('#nav-page2').removeClass('active');
        $('#nav-page2-tab').removeClass('active');
        $('#btnBack').removeClass("hidden");
        $('#btnNext').removeClass("hidden");
        $('#btnBack2').addClass("hidden");
        $('#btnReset').addClass("hidden");
        $('#btnSubmit').addClass("hidden");
    }

    function displaySecondPageButton() {
        $('#nav-page1').removeClass('active');
        $('#nav-page1-tab').removeClass('active');
        $('#nav-page2').addClass('active');
        $('#nav-page2-tab').addClass('active');
        $('#btnBack').addClass("hidden");
        $('#btnNext').addClass("hidden");
        $('#btnBack2').removeClass("hidden");
        $('#btnReset').removeClass("hidden");
        $('#btnSubmit').removeClass("hidden");
    }

    function toastMessage() {
        if (returnMessage != null && returnMessage != "" && returnMessage == "Success") {
            const toastLiveExample = document.getElementById('successToast');
            const toast = new bootstrap.Toast(toastLiveExample);
            toast.show();
            setTimeout(function () {
                window.location.href = UrlActionList;
            }, 2000);
        }

        else {
            loadDataTable();
            filterColumn();
        }
    }
</script>