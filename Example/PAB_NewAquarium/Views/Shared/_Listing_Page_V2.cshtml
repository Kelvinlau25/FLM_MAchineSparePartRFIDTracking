<div class="modal fade" id="modalDelete" tabindex="-1" aria-hidden="true">
    @Html.Partial("_Modal_Delete")
</div>
<div class="toast-container position-fixed toast-alert">
    @Html.Partial("_Toast_Error")
</div>

<!-- Hidden input for word search detection API use -->
<input type="hidden" id="hdnAiIndicator" value="0">

<!-- Modal dialog for AI down -->
<div class="modal fade" id="ai-unavailable-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">AI Features Currently Unavailable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr />
            <div class="modal-body p-5 text-center">
                <div class="row align-items-center mt-2">
                    <div class="col-12">
                        <img src="~/Images/AI-Outage.png" class="ai-outage" />
                    </div>
                </div>
                <div class="row align-items-center mt-2">
                    <div class="col-12 text-start">
                        The AI API service is currently experiencing an outage, resulting in the unavailability of all AI-related functions.
                    </div>
                </div>
                <div class="row align-items-center mt-2">
                    <div class="col-12 text-start">
                        Despite this disruption, you can still continue to use the system as usual without any interruptions.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- Datatable search input layout -->
<div class="datatable-search-input d-none">
    <div class="responsive-input-group input-group">
        <span class="ai-image input-group-text input-group-text-word-detection icon-border-container input-group-addon">
            <i class="fa-regular fa-sparkles"></i><span>AI</span>
        </span>
        <div class="position-relative">
            <div class="input-group">
                <input type="text" id="txtSearch" class="form-control remove-right-border tr-search-txt tr-list-txtbx-border rounded-0" placeholder="Search">
                <div class="input-group-text listing-search-icon tr-list-txtbx-border tr-input-grp-right rounded-0">
                    <div class="pointer text-reset d-flex align-items-center justify-content-end text-decoration-none">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                </div>
            </div>
            <div class="dropdown overlay-dropdown-list">
                <div class="tr-ddm dropdown-menu dropdown-menu-list w-100"></div>
            </div>
        </div>
    </div>
</div>

<!-- Datatable search input script -->
<script>
    var searchInputHtml = $('.datatable-search-input').html();
</script>