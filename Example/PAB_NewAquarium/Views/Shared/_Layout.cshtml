@using PAB_NewAquarium.Helpers
<!DOCTYPE html>
<html class="h-100">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>@System.Configuration.ConfigurationManager.AppSettings["SystemName"]</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/datatables")
    @Scripts.Render("~/bundles/js")
    @Scripts.Render("~/Scripts/Main.js")
    @Scripts.Render("~/Scripts/jquery.signalR-2.4.3.js")

    @RenderSection("scripts", required: false)
    @RenderSection("VendorCSS", required: false)
</head>
<body>
    <div class="sticky-top">
        <header class="sticky-top navbar navbar-dark flex-md-nowrap p-0 shadow tr-navbar">
            <div class="row row-cols-auto align-items-center">
                <a href="@Url.Action("Index", "Dashboard")" class="col" style="margin-left: 10px; margin-top: -5px">
                    <img class="p-0 tr-navbar-logo" src="~/Images/Toray Logo.png" />
                </a>
                <div class="tr-nav-divider"></div>
                <div id="accountMenu" class="d-md-none collapse">
                    <div class="row mb-2">
                        <p class="h4 text-secondary m-0 px-4">@System.Configuration.ConfigurationManager.AppSettings["SystemName"]</p>
                    </div>
                    <div class="row mb-2">
                        @if (Session["AclUser"] != null)
                        {
                            <p class="h6 text-secondary m-0 px-4">
                                <i class="fa-solid fa-user px-2"></i>@((Session["AclUser"] as ACL_UserObj).EMP_NAME)
                            </p>
                        }
                        else
                        {
                            <p class="h6 text-secondary m-0 px-4"><i class="fa-solid fa-user px-2"></i>GUEST</p>
                        }
                    </div>
                    <div class="row mb-2">
                        <a href="#" class="text-reset" style="color:#fff !important"><i class="fa-solid fa-right-from-bracket px-2"></i>LOGOUT</a>
                    </div>
                </div>
            </div>
            <div class="me-auto d-none d-md-block">
                <p class="m-0 px-4 tr-navbar-title">@System.Configuration.ConfigurationManager.AppSettings["SystemName"]</p>
            </div>
            <div class="navbar-nav d-none d-md-block">
                <div class="nav-item text-nowrap">
                    <div class="d-flex align-items-center">
                        <div class="mx-2">
                            @if (Session["AclUser"] != null)
                            {
                                <div class="dropdown overlay-dropdown">
                                    <a href="#" class="m-0 px-1 text-reset tr-navbar-logout dropdown-toggle" role="button" id="profileDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa-solid fa-user px-2"></i>&nbsp;
                                        @((Session["AclUser"] as ACL_UserObj).EMP_NAME.ToUpper())
                                    </a>
                                    <div class="tr-ddm dropdown-menu" aria-labelledby="profileDropdown">
                                        <a class="dropdown-item" href="@Url.Action("ChangePassword", "Home")">Change Password</a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a id="btnProfile" href="#" class="m-0 px-1 text-reset tr-navbar-logout">
                                    <i class="fa-solid fa-user px-2"></i>&nbsp; GUEST
                                </a>
                                <ul id="dropdownList" class="hidden">
                                    <li><a href="#">Option 1</a></li>
                                    <li><a href="#">Option 2</a></li>
                                    <li><a href="#">Option 3</a></li>
                                </ul>
                            }
                        </div>

                        <div class="tr-nav-divider"></div>

                        <div>
                            <a id="btnLogout" href="#" class="px-1 text-reset tr-navbar-logout"><i class="fa-solid fa-right-from-bracket px-2"></i>&nbsp;LOGOUT</a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="navbar-toggler position-absolute d-md-none collapsed" style="top:0.5em; right:4em" type="button" data-bs-toggle="collapse" data-bs-target="#accountMenu" aria-controls="accountMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span><i class="fa-solid fa-user"></i></span>
            </button>
        </header>
        <div id="navbar_horizontal" class="bg-white shadow">
            <ul id="navbar_horizontal_left" class="float-start">
                @if ((Session["AclUser"] != null))
                {
                    <li>
                        <a href="#" class="menu menu-text"><i class="fa-solid fa-bars me-2"></i>Menu</a>
                        @foreach (var item in (Session["ACLUser"] as ACL_UserObj).SIDEBAR_CONTENT)
                        {
                            if (item.LAYER == 1 && item.RESOURCE_SEQ > 100)
                            {
                                if (item.RESOURCE_NAME != "Fabric Hot Sales")
                                {
                                    <a href="/@item.RESOURCE_CONTROLLER/@item.RESOURCE_VIEW" class="nav-link nav-header header-text menu-text">@item.RESOURCE_NAME</a>
                                }
                                else
                                {
                                    <a href="/@item.RESOURCE_CONTROLLER/@item.RESOURCE_VIEW?type=HotSales" class="nav-link nav-header header-text menu-text">@item.RESOURCE_NAME</a>
                                }
                            }
                        }
                    </li>
                }
            </ul>
            <ul id="navbar_horizontal_right" class="float-end">
                <li class="me-3">
                    <div class="input-group">
                        <input id="inputOverallSearch" class="form-control " type="text" placeholder="Search" spellcheck="false" autocomplete="off" />
                        <div id="iconOverallSearch" class="input-group-text">
                            <i class="fa-solid fa-search dark-blue" aria-hidden="true"></i>
                        </div>
                    </div>
                </li>
                <li class="me-0 notificationBtn"><a href="#"><div class="noti-div"><span class="noti-red-icon"></span><i class="fa-solid fa-bell dark-blue nav-icon"></i></div></a></li>
                <li class="addToCartBtn">
                    <a href="#" onclick="redirectToCart()">
                        <i class="fa-solid fa-cart-shopping dark-blue nav-icon"></i>
                        <div id="txtCartCount" class="red-circle mx-1">
                            <text>0</text>
                        </div>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    
    <div id="sidebarcontent">
        <ul class="list-unstyled m-0">
            @if ((Session["AclUser"] != null))
            {
                var isChild = false;
                <li>
                    @foreach (var parent in (Session["ACLUser"] as ACL_UserObj).SIDEBAR_CONTENT)
                    {
                        if (parent.LAYER == 1 && parent.RESOURCE_SEQ <= 100)
                        {
                            foreach (var child in (Session["ACLUser"] as ACL_UserObj).SIDEBAR_CONTENT)
                            {
                                if (child.LAYER == 2 && child.RESOURCE_PARENT_ID == parent.ID_ACL_RESOURCE)
                                {
                                    isChild = true;
                                    break;
                                }
                            }
                            if (isChild)
                            {
                                <a href="#" class="nav-link nav-header header-text sidebar-text hasSub active">
                                    @parent.RESOURCE_NAME
                                    <div class="fas fa-chevron-right dropdown-toggle-icon dark-blue"></div>
                                </a>
                            }
                            else
                            {
                                <a href="/@parent.RESOURCE_CONTROLLER/@parent.RESOURCE_VIEW" class="nav-link nav-header header-text sidebar-text">
                                    @parent.RESOURCE_NAME
                                </a>
                            }
                            <ul class="list-unstyled hidden">
                                @foreach (var child in (Session["ACLUser"] as ACL_UserObj).SIDEBAR_CONTENT)
                                {
                                    if (child.LAYER == 2 && child.RESOURCE_PARENT_ID == parent.ID_ACL_RESOURCE)
                                    {
                                        <li class="nav-item">
                                            <a href="/@child.RESOURCE_CONTROLLER/@child.RESOURCE_VIEW" class="nav-link sub-header-text">
                                                @child.RESOURCE_NAME
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    }
                </li>
            }
        </ul>
    </div>
    <div id="sidebarlayer2content"></div>
    <div class="arrow_box">
        <br />
        <span class="h5 ps-3">Notification <span id="notiCount"></span></span>
        <span class="close-button" id="closeNotification">&times;</span>
        <hr />
        <div id="notificationContent">

        </div>
    </div>
    <div class="container-fluid d-flex flex-column">
        <div class="row flex-nowrap">
            <main class="col ps-md-2 mx-2 detail-frame">
                @RenderBody()
                <div class="spanner align-self-center">
                    <div class=" d-flex justify-content-center align-items-center">
                        <span class="fa-duotone fa-spinner fa-spin-pulse dark-blue"></span>
                    </div>
                    <div class="d-flex justify-content-center align-items-center pt-2 ps-3">
                        <text class="fw-bold white">Loading...</text>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div class="tr-footer d-flex flex-row" id="footer">
        <div class="flex-column px-1 text-black-50 tr-footer-text" style="margin:auto">
            <span>@System.Configuration.ConfigurationManager.AppSettings["VersionText"]</span>
        </div>
        <div class="flex-column flex-grow-1 text-center text-black-50 tr-footer-text" style="margin:auto; margin-left: -80px">
            @System.Configuration.ConfigurationManager.AppSettings["CopyrightText"].Replace("YEAR", DateTime.Now.Year.ToString())
        </div>
    </div>

    <div class="modal fade" id="customer-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Customer Registration</h5>
                    <button type="button" class="btnCloseModal" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <hr class="mt-3 mb-0" />
                <div class="modal-overlay bg-overlay">
                    <div class="customer-loading-spinner">
                        <div class=" d-flex justify-content-center align-items-center">
                            <span class="fa-duotone fa-spinner fa-spin-pulse dark-blue"></span>
                        </div>
                        <div class="d-flex justify-content-center align-items-center pt-2 ps-3">
                            <text class="fw-bold white">Loading...</text>
                        </div>
                    </div>
                    <div class="modal-body invisible">
                        <div class="customer-modal-first">
                            <div class="row align-items-center">
                                <div class="col-md-4 isLabel">Company <span class="text-danger">*</span><span class="float-end">:</span></div>
                                <div class="col-md-8">
                                    <select id="selectCompany" class="tr-selectCustCompany"></select>
                                </div>
                            </div>
                            <div class="row align-items-center mt-2">
                                <div class="col-md-4 isLabel">Customer Name <span class="text-danger">*</span><span class="float-end">:</span></div>
                                <div class="col-md-8">
                                    <input id="inputCustName" class="form-control" type="text" placeholder="Enter Customer Name" spellcheck="false" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                        <div class="customer-modal-second hidden">
                            <h6>Do you want to proceed with RFID Dashboard?</h6>
                        </div>
                        <div class="mt-2">
                            <span id="customer-reg-validation" class="text-danger hidden">Please insert required field.</span>
                        </div>
                        <div class="row align-items-center mt-3">
                            <div class="col-md-12 text-center">
                                <button class="btn-slider btn-slider-first" page="1"></button>
                                <button class="btn-slider btn-slider-second" page="2"></button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer invisible">
                        <button type="button" class="btn btn-sm btn-secondary btnCustomerLogin customer-modal-second hidden" rfid="no">No</button>
                        <button type="button" class="btn btn-sm btn-primary btnCustomerLogin customer-modal-second hidden" rfid="yes">Yes</button>
                        <button type="button" class="btn btn-sm btn-primary btn-slider customer-modal-first" page="2">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="session-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Session Expired</h5>
                    <button type="button" class="btnCloseModal" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <hr />
                <div class="modal-body">
                    <text class="text-nowrap">Your session is expired. Please login again.</text>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-sm btn-primary" href="/ACL/Login">Ok</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Common JavaScript -->
    <script src="~/ViewsHelpers/CommonComponent/Alert.js"></script>

    <script>
        var cooldown = false;
        var urlLogout = '@Url.Action("Logout", "ACL")';
        var urlRFIDDashboard = '@Url.Action("RFIDDashboard", "RFIDDashboard")';
        var urlCustomerDashboard = '@Url.Action("CustomerDashboard", "CustomerDashboard")';
        var ajaxGetAddToCart = '@Url.Action("GetAddToCart", "Dashboard")';
        var ajaxGetCustomer = '@Url.Action("GetCustomerList", "Dashboard")';
        var ajaxUserReg = '@Url.Action("InsertCustomerName", "Dashboard")';
        var ajaxCheckSession = '@Url.Action("CheckSessionTimeout", "Home")';
        var notificationContent = '@Url.Content("/Home/Notification")';
        var overallSearch = '@Url.Action("AllProducts", "AllProducts")';

        document.addEventListener('DOMContentLoaded', function () {
            var dropdownToggle = document.querySelector('.overlay-dropdown .dropdown-toggle');
            var dropdown = document.querySelector('.overlay-dropdown');

            // Add a click event listener to the document
            document.addEventListener('click', function (event) {
                // Check if the clicked element is not inside the dropdown
                if (!dropdown.contains(event.target) && event.target !== dropdownToggle) {
                    // Close the dropdown by removing the "show" class
                    dropdown.classList.remove('show');
                }
            });

            // Add a click event listener to the dropdown toggle button
            dropdownToggle.addEventListener('click', function (event) {
                // Prevent the click event from propagating to the document
                event.stopPropagation();

                // Toggle the "show" class on the dropdown
                dropdown.classList.toggle('show');
            });
        });

        $(document).ready(function () {
            $('#txtCartCount').attr('size', $('#txtCartCount').height());
            setActiveSidebar();
            setActiveTopNav();
            getAddToCart();

            $('#selectCompany').multiselect({
                buttonClass: 'form-select form-control text-start',
                enableCaseInsensitiveFiltering: true,
                enableFiltering: true,
                templates: {
                    button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                    filter: '<div class="multiselect-filter" style="position:sticky; top:0; background-color:white"><div class="input-group input-group-sm p-1"><div class="input-group-prepend"></div><input id="REFERENCE_NO_FILTER" class="form-control multiselect-search" type="text" /></div></div>',
                },
            });
            $('#selectCompany').next().addClass('w-100');
            $('#selectCompany').next().find('.multiselect').removeClass('text-center');

            $('#notificationContent').load(notificationContent, function () {
                $(document).click(function () {
                    var menu = $('.menu');
                    var sidebar = $('#sidebarcontent');
                    var sidebarlayer2 = $('#sidebarlayer2content');
                    var notificationBtn = $(".notificationBtn");
                    var notificationBox = $(".arrow_box");

                    if (!menu.is(event.target) && !menu.has(event.target).length &&
                        !sidebar.is(event.target) && !sidebar.has(event.target).length &&
                        !sidebarlayer2.is(event.target) && !sidebarlayer2.has(event.target).length
                    ) {
                        sidebar.hide();
                        sidebarlayer2.hide();
                    }

                    if (!notificationBtn.is(event.target) && !notificationBtn.has(event.target).length &&
                        !notificationBox.is(event.target) && !notificationBox.has(event.target).length &&
                        notificationBox.is(':visible')) {
                        notificationBox.hide();
                        updateNotification();
                    }
                });

                $('.notificationBtn').click(function () {
                    if ($('.arrow_box').is(':visible')) {
                        $('.arrow_box').hide();
                        updateNotification();
                    }
                    else {
                        $('.arrow_box').show();
                    }
                });

                var notificationCount = $('.new-noti').length;
                if (notificationCount > 0) {
                    $('#notiCount').text('(' + $('.new-noti').length + ')');
                    $('.noti-red-icon').show();
                }

                $('#closeNotification').click(function () {
                    $('.arrow_box').hide();
                    updateNotification();
                });
            });

            $('.file-upload').fileinput({
                showPreview: false,
                showUpload: false,
                showRemove: false,
                showUploadStats: false,
                browseClass: 'btn btn-sm btn-outline-secondary',
                browseLabel: 'Choose File',
                buttonLabelClass: 'file-input-browse-label'
            });

            $('.form-valid').on('blur change keyup', function () {
                var validationMessage = $(this).attr('data-val-required');
                if (validationMessage == undefined) {
                    validationMessage = "This field is required."
                }
                if ($(this).val().trim() === "") {
                    $(this).addClass('is-invalid');
                    $(this).siblings('.text-danger').text(validationMessage).show();
                }
                else {
                    $(this).removeClass('is-invalid');
                    $(this).siblings('.text-danger').text("").hide();
                }
            });

            $('.form-control').keydown(function (e) {
                //prevent empty string in textbox
                if (e.keyCode === 32 && $(this).val().length === 0 && !$(this).is('span')) {
                    e.preventDefault();
                }
                //prevent press enter to submit form
                if (e.keyCode == 13 && !$(this).is('textarea') && !$(this).is('span')) {
                    e.preventDefault();
                    return false;
                }
                // prevent press enter for first character in text area
                if (e.keyCode == 13 && $(this).is('textarea') && $(this).val().length === 0) {
                    e.preventDefault();
                    return false;
                }
            });

            $('.form-control').each(function () {
                $(this).on('input', function (event) {
                    var inputValue = event.target.value;
                    var regex = /[\uD800-\uDBFF][\uDC00-\uDFFF]/g;
                    if (regex.test(inputValue)) {
                        event.preventDefault();
                        $(this).val(inputValue.replace(regex, ''));
                    }
                });
            });

            $('form').submit(function () {
                $('.form-valid').each(function () {
                    if ($(this).val().trim() === "") {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                if ($('.is-invalid:visible').length > 0) {
                    const toastLiveExample = document.getElementById('liveToast3');
                    const toastIDError = document.getElementById('errorToast');
                    const toast = new bootstrap.Toast(toastLiveExample);
                    const toastError = new bootstrap.Toast(toastIDError);
                    if (toastLiveExample != null) {
                        toast.show();
                    }
                    else if (toastIDError != null){
                        $('#errorToast .toast-body').html("Submit Unsuccessful, Please Check Your Input.");
                        toastError.show();
                    }
                }
                $('button[type="submit"]').prop('disabled', true);
                setTimeout(function () {
                    $('button[type="submit"]').prop('disabled', false);
                }, 2000);
            });

            $('.btn-slider').on('click', function () {
                var page = $(this).attr('page');
                setActivePage(page);
            });

            $('#btnLogout').on('click', function () {
                window.location.href = urlLogout;
            });

            $('.btnCustomerLogin').on('click', function () {
                var companyCode = $('#selectCompany').val();
                var companyName = $('#selectCompany').next().find('.multiselect-selected-text').text();
                var customerName = $('#inputCustName').val().toUpperCase();
                var rfid = $(this).attr('rfid');

                $.ajax({
                    type: "post",
                    url: ajaxUserReg,
                    data: {
                        companyCode: companyCode,
                        companyName: companyName,
                        customerName: customerName
                    },
                    datatype: "json",
                    traditional: true,
                    success: function (data) {
                        if (rfid == "yes") {
                            window.open(urlRFIDDashboard, "_blank");
                            window.open(urlCustomerDashboard, "_blank");
                        }
                        else {
                            window.open(urlCustomerDashboard, "_blank");
                        }
                        setActivePage(1);
                        localStorage.setItem('customerID', data);
                        localStorage.setItem('customerName', customerName);
                        localStorage.setItem('companyName', companyName);
                        $(':input').val('');
                        $('#selectCompany').multiselect('rebuild');
                        $('#customer-modal').modal('hide');
                    },
                });
            });

            $('.btnCloseModal').on('click', function () {
                $('.modal').modal('hide');
                setActivePage(1);
            });

            $('.notificationBtn').mouseenter(function () {
                $('.fa-bell').addClass('fa-shake');
            });

            $('.notificationBtn').mouseleave(function () {
                $('.fa-bell').removeClass('fa-shake');
            });

            $('.addToCartBtn').mouseenter(function () {
                $('.fa-cart-shopping').addClass('fa-bounce');
            });

            $(".addToCartBtn").mouseleave(function () {
                $('.fa-cart-shopping').removeClass('fa-bounce');
            });

            $('#selectCompany').on('change', function () {
                var companyCode = $('#selectCompany').val();
                var width = $('#inputCustName').width() + "px !important";

                if (companyCode != "") {
                    $.ajax({
                        type: "post",
                        url: ajaxGetCustomer,
                        data: { companyCode: companyCode },
                        datatype: "json",
                        traditional: true,
                        success: function (data) {
                            var dataList = JSON.parse(data);
                            $("#inputCustName").autocomplete({
                                source: dataList,
                                create: function (event, ui) {
                                    var autocompleteMenu = $(this).data('ui-autocomplete').menu.element
                                    autocompleteMenu.addClass('ui-autocomplete-reg');
                                    autocompleteMenu.css({
                                        'border': '1px solid #EBEBEB'
                                    });
                                },
                                open: function (event, ui) {
                                    var inputVal = $(this).val();
                                    var matcher = new RegExp("(" + $.ui.autocomplete.escapeRegex(inputVal) + ")", "ig");

                                    $('.ui-menu-item').each(function () {
                                        var html = '<div class="ui-menu-item-wrapper">';
                                        html += $(this).text().replace(matcher, '<strong>$1</strong>');
                                        html += '</div>';
                                        $(this).html(html);
                                    });

                                    $('.ui-menu-item').hover(function () {
                                        $('.ui-menu-item').removeClass('bg-grey');
                                        $(this).addClass('bg-grey');
                                    });
                                }
                            });
                            $('.ui-autocomplete-reg').css('width', width);
                        },
                    });
                }
            });

            $('#session-modal').on('hidden.bs.modal', function () {
                window.location.href = '/ACL/Login';
            });

            $('#inputOverallSearch').on('keyup', function (e) {
                var selectedValue = $('#inputOverallSearch').val();
                if (e.keyCode == 13) {
                    window.location.href = overallSearch + "?search=" + selectedValue;
                }
            });

            $('#inputOverallSearch, #inputCustName').on('keydown', function (e) {
                var inputID = $(this).attr('id');
                var autocomplete = (inputID == "inputOverallSearch") ? "ui-autocomplete-search" : "ui-autocomplete-reg";
                var hasClass = false;
                if (e.keyCode === 40) {
                    $(`.${autocomplete}`).find('.ui-menu-item').each(function () {
                        if ($(this).hasClass('bg-grey')) {
                            if ($(this).is(':last-child')) {
                                $(this).removeClass('bg-grey');
                            }
                            else {
                                $(this).removeClass('bg-grey');
                                $(this).next().addClass('bg-grey');

                            }
                            hasClass = true;
                            return false;
                        }
                    });
                    if (!hasClass) {
                        $(`.${autocomplete}`).find('.ui-menu-item:first-child').addClass('bg-grey');
                    }
                }

                if (e.keyCode === 38) {
                    $(`.${autocomplete}`).find('.ui-menu-item').each(function () {
                        if ($(this).hasClass('bg-grey')) {
                            if ($(this).is(':first-child')) {
                                $(this).removeClass('bg-grey');
                            }
                            else {
                                $(this).removeClass('bg-grey');
                                $(this).prev().addClass('bg-grey');
                            }
                            hasClass = true;
                            return false;
                        }
                    });
                    if (!hasClass) {
                        $(`.${autocomplete}`).find('.ui-menu-item:last-child').addClass('bg-grey');
                    }
                }
            });

            $('#iconOverallSearch').on('click', function (e) {
                var selectedValue = $('#inputOverallSearch').val();
                window.location.href = overallSearch + "?search=" + selectedValue;
            });

            $(document).on('click', "#sidebarcontent li a.nav-header", function () {
                $("#sidebarcontent li ul.list-unstyled").collapse('hide');
                $("#sidebarcontent").find(".active").removeClass("active");
                $(this).find(".fas").addClass("active");
                $(this).addClass("active");
            });

            $(document).on('mousemove keypress', function () {
                checkSessionStatus();
            });

            getOverallSearchData();

            setInterval(checkSessionStatus, 910000);
        });

        $(document).ready(function () {
            var existingDiv = $('.detail-frame');
            existingDiv.removeClass('ps-md-2 mx-2').addClass('px-0');
            resizeContainer();
            $(window).on('resize', resizeContainer);
        });

        $(window).on('beforeunload', function () {
            loadings(true);
        });

        $(window).on('unload', function () {
            loadings(false);
        });

        function setActiveSidebar() {
            $('#sidebarlayer2content').css('left', $('#sidebarcontent').width());
            $(".menu").click(function () {
                if ($("#sidebarcontent").is(':visible')) {
                    $("#sidebarcontent").hide();
                    $("#sidebarlayer2content").hide();
                }
                else {
                    $("#sidebarcontent").show();
                }
            });

            $(".header-text").hover(function () {
                $("#sidebarlayer2content").empty();
                if ($(this).hasClass("hasSub")) {
                    $("#sidebarlayer2content").html("<p style='padding-top: 20px;'><i style='font-size: 14px; padding-left: 20px;'>" + "Show All " + $(this).text() + "</i></p>");
                    $(this).next("ul").find("li").each(function () {
                        var ul = $("<ul class='list-unstyled px-4'>");
                        var li = $("<li>");
                        var a = $("<a class='nav-link' href='" + $(this).find("a").attr("href") + "'>").text($(this).find("a").text());
                        ul.append(li);
                        li.append(a);
                        ul.appendTo("#sidebarlayer2content");
                    });
                    $("#sidebarlayer2content").show();
                }
                else {
                    $("#sidebarlayer2content").hide();
                }
            });

            $('#sidebarcontent > ul > li > a').click(function (e) {
                var href = $(this).attr('href');
                if (href == "/CustomerDashboard/CustomerDashboard") {
                    e.preventDefault();
                    var customer = localStorage.getItem('customerName');
                    if (customer == null) {
                        $("#sidebarcontent").addClass('d-none');
                        $('#customer-modal').modal('show');

                    }
                    else {
                        window.open(urlCustomerDashboard, "_blank");
                    }
                }
                else if (href == "/RFIDDashboard/RFIDDashboard") {
                    event.preventDefault();
                    window.open(urlRFIDDashboard, "_blank");
                }
            });

            $("#sidebarlayer2content").hover(function () {
                $("#sidebarcontent").show();
                $("#sidebarlayer2content").show();
            });

            $('#customer-modal').on('shown.bs.modal', function () {
                getCompanyDropdown();
            });

            $('#customer-modal').on('hidden.bs.modal', function () {
                $("#sidebarcontent").removeClass('d-none');
                $('.customer-loading-spinner').removeClass('hidden');
                $('.modal-overlay').removeClass('mt-3');
                $('.modal-overlay').addClass('bg-overlay');
                $('#customer-modal .modal-body').addClass('invisible');
                $('#customer-modal .modal-footer').addClass('invisible');
            });
        }

        function resizeContainer() {
            var windowHeight = $(window).height();
            var windowWidth = $(window).width();
            var headerHeight = $('header.sticky-top').outerHeight();
            var titleHeight = $('.tr-listing-header').outerHeight();
            var footerHeight = $('.tr-footer').outerHeight();
            var footerHeight1 = $('.tr-btm-btn-margin').outerHeight();
            var newHeight = windowHeight - (headerHeight + titleHeight + footerHeight);
            $('.page-container').css('height', newHeight + 'px');
        }

        function setActivePage(page) {
            var companyName = $('#selectCompany').val();
            var customerName = $('#inputCustName').val().trim();
            var height = $('.customer-modal-first').height();

            if (page == 1) {
                $('.btn-slider-first').css({
                    'background-color': '#004098'
                });

                $('.btn-slider-second').css({
                    'background-color': '#EBEBEB'
                });

                $('.customer-modal-first').removeClass('hidden');
                $('.customer-modal-second').addClass('hidden');
            }
            else {
                if (companyName == "" || customerName == "") {
                    $('#customer-reg-validation').removeClass('hidden');
                }
                else {
                    $('.btn-slider-first').css({
                        'background-color': '#EBEBEB'
                    });

                    $('.btn-slider-second').css({
                        'background-color': '#004098'
                    });

                    $('#customer-reg-validation').addClass('hidden');
                    $('.customer-modal-first').addClass('hidden');
                    $('.customer-modal-second').removeClass('hidden');
                    $('.customer-modal-first').next().height(height);
                }
            }
        }

        function getCompanyDropdown() {
            var data = localStorage.getItem('companyList');
            var dataList = JSON.parse(data);
            var companyDDL = $('#selectCompany');
            companyDDL.empty();
            companyDDL.append($('<option/>', {
                value: '',
                text: 'Select Company'
            }));
            for (var i = 0; i < dataList.length; i++) {
                companyDDL.append($('<option/>', {
                    value: dataList[i].Value,
                    text: dataList[i].Text
                }));
            }
            companyDDL.multiselect('rebuild');

            $('.customer-loading-spinner').addClass('hidden');
            $('.modal-overlay').addClass('mt-3');
            $('.modal-overlay').removeClass('bg-overlay');
            $('#customer-modal .modal-body').removeClass('invisible');
            $('#customer-modal .modal-footer').removeClass('invisible');
        }

        function getOverallSearchData() {
            var data = localStorage.getItem('overallData');
            var dataList = JSON.parse(data);

            $("#inputOverallSearch").autocomplete({
                source: dataList,
                select: function (event, ui) {
                    var selectedValue = ui.item.value;
                    window.location.href = overallSearch + "?search=" + selectedValue;
                },
                create: function (event, ui) {
                    var autocompleteMenu = $(this).data('ui-autocomplete').menu.element
                    autocompleteMenu.addClass('ui-autocomplete-search');
                    autocompleteMenu.css({
                        'border': '1px solid #EBEBEB',
                    });
                },
                open: function (event, ui) {
                    var inputVal = $(this).val();
                    var matcher = new RegExp("(" + $.ui.autocomplete.escapeRegex(inputVal) + ")", "ig");

                    $('.ui-menu-item').each(function () {
                        var html = '<div class="ui-menu-item-wrapper">';
                        html += $(this).text().replace(matcher, '<strong>$1</strong>');
                        html += '</div>';
                        $(this).html(html);
                    });

                    $('.ui-menu-item').hover(function () {
                        $('.ui-menu-item').removeClass('bg-grey');
                        $(this).addClass('bg-grey');
                    });
                }
            });
        }

        function getAddToCart() {
            var iconSize = parseInt($('#txtCartCount').attr('size'));

            $.ajax({
                type: "post",
                url: ajaxGetAddToCart,
                datatype: "json",
                traditional: true,
                success: function (data) {
                    if (data < 10) {
                        $('#txtCartCount > text').html(data);
                    }
                    else if (data >= 10 && data < 100) {
                        iconSize += 2;
                        $('#txtCartCount').css({
                            'height': iconSize,
                            'width': iconSize
                        });

                        $('#txtCartCount > text').html(data);
                    }
                    else if (data >= 100) {
                        iconSize += 4;
                        $('#txtCartCount').css({
                            'height': iconSize,
                            'width': iconSize
                        });

                        $('#txtCartCount > text').html("99+");
                    }
                    $('#txtCartCount > text').attr('count', data);
                },
            });
        }

        function updateNotification() {
            var noti_ID = [];
            $('.notiRow').each(function (index, element) {
                noti_ID.push($(element).attr('id'));
                $(element).parent('a').removeClass('new-noti');
                $(element).parent('a').addClass('nav-link');
            });
            $('#notiCount').text('');
            $('.noti-red-icon').hide();

            const formData = new FormData();
            formData.append("noti_ID", noti_ID);

            $.ajax({
                url: "/Home/Notification",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {

                }
            });
        }

        function redirectToCart() {
            window.location.href = "/ProductDetail/Cart";
        }

        function setActiveTopNav() {
            var currentURL = window.location.href;
            var currentNav = "";
            var nav1 = "/Dashboard/Index";
            var nav2 = "/AllProducts/AllProducts";
            var nav3 = "/AllProducts/AllProducts?type=HotSales";

            if (currentURL.includes(nav3)) {
                currentNav = nav3;
            }
            else if (currentURL.includes(nav2)) {
                currentNav = nav2;
            }
            else if (currentURL.includes(nav1)) {
                currentNav = nav1;
            }

            $('.nav-link').each(function () {
                if ($(this).attr('href') == currentNav) {
                    $(this).css({
                        "background-color": "#EBF3FE",
                        "color": "#004098",
                        "font-weight": "bold"
                    });
                }
            });
        }

        function checkSessionStatus() {
            if (cooldown) {
                return false;
            }
            else {
                cooldown = true;

                setTimeout(function () {
                    cooldown = false;
                }, 5000);

                $.ajax({
                    url: ajaxCheckSession,
                    type: 'POST',
                    success: function (response) {
                        if (response.sessionExpired) {
                            $('#session-modal').modal('show');
                        }
                    }
                });
            }
        }
    </script>
</body>
</html>
