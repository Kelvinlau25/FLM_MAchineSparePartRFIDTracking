@model PAB_NewAquarium.Models.AuthenticatorModel
@{
    ViewBag.Title = "System Design UI/UX Standardization";
    Layout = null;

    string ResetSuccess = TempData["ResetSuccess"] as string;
}
<!DOCTYPE html>
<html class="h-100">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@System.Configuration.ConfigurationManager.AppSettings["SystemName"]</title>
    @Styles.Render("~/Content/css-login")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Scripts/jquery-ui-1.12.1.min.js")
    <script src="~/Scripts/js/attrchange-2.0.1/js/attrchange.js"></script>
    <link href="~/Plugins/SpinThatShit-master/examples/style.css" rel="stylesheet" />
    <style>
        .is-invalid:has(+ * + .input-group-text) {
            border: 1px red solid;
        }

        .remove-left-border {
            border-left : 0px !important;
        }


        .btn-primary, .btn-secondary {
            border: 0px;
        }

        .form-control.is-valid {
            background-image: none;
        }

        .modal-content {
            border-radius: 5px !important;
        }

        .form-control {
            box-shadow: 0 0 0 0.01rem #c2cdf6 !important;
        }

        .image-login-cover {
            position: relative;
            bottom: 135%;
            left: 10%;
            max-width: 50%;
        }

        .gradient-background {
            position: relative;
            max-width: 100%;
            height: 100%;
            bottom: 100%;
            background-image: linear-gradient(225deg, rgba(255,0,0,0), rgba(0,0,0,0.6));
        }

        .fa-spinner {
            font-size: 40px;
            color: #004098;
        }

        /*For Mobile*/
        @@media only screen and (max-width: 767px) {
            .login-background {
                display: none;
            }
        }
    </style>
</head>
<body class="h-100 test">
    <div class="container-fluid h-100 p-0" style="overflow-x:hidden">
        <div class="row tr-body">
            <div class="login-background col-md-8 col-sm-12 h-100">
                <img style="object-fit:cover" class="img-fluid h-100 w-100" src="~/Images/LoginBg.png" alt="Company Photo">
                <div class="gradient-background"></div>
                <div class="image-login-cover ">
                    <img class="w-100" src="~/Images/LoginBg2.png" alt="Overlay Image" />
                </div>
            </div>
            <div class="col-md-4 col-sm-12 h-100 p-0 m-0">
                <div class="row pt-2">
                    <div class="col col-3 align-self-center">
                        <img class="img-fluid tr-logo" src="~/Images/Toray Logo 2.png" alt="Toray Logo" />
                    </div>
                    <div class="col col-9 tr-company" style="border-left: 1px solid gray">
                        <p class="h6 text-black-50 p-0 m-0">TORAY MALAYSIA SYSTEMS SOLUTION</p>
                    </div>
                </div>
                <div class="row align-items-center tr-system-title">
                    <p class="text-center tr-system-title-text">
                        @System.Configuration.ConfigurationManager.AppSettings["SystemName"]
                    </p>
                </div>
                <div class="row form-group-margin">
                    <hr />
                </div>
                <div class="row">
                    @using (Html.BeginForm("Login", "ACL", FormMethod.Post, new { @class = "box", id = "loginForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <fieldset>
                            <div class="form-group form-group-margin">
                                <label for="exampleInputEmail1" class="form-label mt-4">Username</label>
                                <div class="form-group">
                                    <div class="input-group has-validation">
                                        <span class="input-group-text icon-border-container input-group-addon" style="position: relative">
                                            <i class="fa-solid fa-user"></i>
                                        </span>
                                        @Html.TextBoxFor(a => a.LOGIN_ID, new { placeholder = "Username", @class = "form-control remove-left-border login-txt textbox keyboard", @value = "" })
                                        @Html.TextBoxFor(a => a.RETURN_URL, new { placeholder = "ReturnUrl", @class = "textbox", @style = "display:none" })
                                    </div>
                                    <div id="validationServer03Feedback">
                                        @Html.ValidationMessageFor(a => a.LOGIN_ID, "", new { @class = "invalid-feedback d-block text-start" })
                                    </div>
                                </div>
                            </div>
                            <div class="form-group form-group-margin">
                                <label for="exampleInputEmail1" class="form-label mt-4">Password</label>
                                <div class="form-group">
                                    <div class="input-group has-validation" id="show_hide_password">
                                        <span class="input-group-text icon-border-container input-group-addon">
                                            <i class="fa-solid fa-lock"></i>
                                        </span>
                                        @Html.PasswordFor(a => a.PASSWORD, new { placeholder = "Enter your Password", @class = "form-control password-txt login-txt textbox", @value = "", @style = "border-right: 0px" })
                                        <div class="input-group-text icon-border-container input-group-addon remove-left-border">
                                            <a href="" class="text-reset"><i class="fa-solid fa-eye-slash showPass" aria-hidden="true"></i></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="validationServer03Feedback">@Html.ValidationMessageFor(a => a.PASSWORD, "", new { @class = "invalid-feedback d-block text-start" })</div>
                            </div>
                            <div class="form-group form-group-margin text-end mb-3">
                                <button id="btnForgot" type="button" class="btn btn-link" style="padding-right: 0px; color: #004098; font-weight: bold; text-decoration: none; padding-bottom: 0px">Forgot Password?</button>
                            </div>
                            <div class="form-group form-group-margin d-grid gap-2 mt-4">
                                <button class="btn btn-primary tr-login-btn" type="submit" id="btnSubmit" style="border-radius: 2px"><b>LOGIN</b></button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>
        <div class="tr-footer d-flex flex-row" style="z-index:999;">
            <div class="flex-column px-1 text-black-50 tr-footer-text" style="margin:auto">
                <span>@System.Configuration.ConfigurationManager.AppSettings["VersionText"]</span>
            </div>
            <div class="flex-column flex-grow-1 text-center text-black-50 tr-footer-text" style="margin:auto; margin-left: -80px">
                @System.Configuration.ConfigurationManager.AppSettings["CopyrightText"].Replace("YEAR", DateTime.Now.Year.ToString())
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div class="overlay align-self-center"></div>
    <div class="spanner align-self-center">
        <div class=" d-flex justify-content-center align-items-center">
            <span class="fa-duotone fa-spinner fa-spin-pulse"></span>
        </div>
        <div class="d-flex justify-content-center align-items-center pt-2 ps-3">
            <text class="fw-bold">Loading...</text>
        </div>
    </div>
    <!-- Toast -->
    <div class="toast-container position-fixed end-0 p-3" style="bottom: 20px">
        <div id="liveToast" class="toast bg-primary-toast" role="alert" aria-live="assertive" aria-atomic="true" style="margin-top: -50px">
            <div class="toast-header bg-primary-tr">
                <strong class="me-auto">Success Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Login Successful
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed end-0 p-3" style="bottom: 20px">
        <div id="liveToast2" class="toast bg-danger-toast" role="alert" aria-live="assertive" aria-atomic="true" style="margin-top: -50px">
            <div class="toast-header bg-primary-tr">
                <strong class="me-auto">Failure Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Failed to login, invalid user!
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed end-0 p-3" style="bottom: 20px">
        <div id="liveToast3" class="toast bg-primary-toast" role="alert" aria-live="assertive" aria-atomic="true" style="margin-top: -50px">
            <div class="toast-header bg-primary-tr">
                <strong class="me-auto">Success Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Change Password Successful
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed end-0 p-3" style="bottom: 20px">
        <div id="liveToast4" class="toast bg-primary-toast" role="alert" aria-live="assertive" aria-atomic="true" style="margin-top: -50px">
            <div class="toast-header bg-primary-tr">
                <strong class="me-auto">Success Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Password reset successfully! Please re-login.
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Reset Password</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <form>
                            <fieldset>
                                <div class="form-group">
                                    <label>Enter your email to reset your password</label>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1" class="form-label mt-4">Username <span class="text-danger">*</span></label>
                                    <div class="form-group">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                            <input type="text" class="form-control" id="exampleInput1" placeholder="Enter your Username">
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="button">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body" id="modalContent">
                    <!-- Partial view content will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <div id="myModal2" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body" id="modalContent2">
                    <!-- Partial view content will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <div id="myModal3" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body" id="modalContent3">
                    <!-- Partial view content will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        var ajaxGetCompany = '@Url.Action("GetCompanyList", "Dashboard")';
        var ajaxGetCustomer = '@Url.Action("GetCustomerList", "Dashboard")';
        var ajaxGetOverallData = '@Url.Action("GetOverallSearchData", "Dashboard")';
        var validate = '@ViewBag.Validate';
        var message = '@ViewBag.Message';
        var resetSuccess = '@ViewBag.ResetSuccess';
        var urlDashboard = '@Url.Action("Index", "Dashboard")';
        var urlToReturn = '@Url.Action("RFIDToReturnList", "Account")';
        var a = false;
        var b = false;

        $(document).ready(function () {
            localStorage.removeItem('customerID');
            localStorage.removeItem('customerName');
            localStorage.removeItem('companyName');
            toastMessage();

            $('form').validate().settings.errorClass += ' is-invalid';
            $('form').validate().settings.validClass += ' is-valid';

            $(".has-validation input").attrchange({
                trackValues: true, // set to true so that the event object is updated with old & new values
                callback: function (evnt) {
                    console.log("triggered", evnt);

                    if (evnt.newValue.includes("is-invalid")) {
                        console.log("aria-invalid", $(this).attr("is-invalid"));
                        $(this).siblings('.input-group-text').css('border', '1px solid red');
                    }
                    if (evnt.newValue.includes("is-valid")) {
                        $(this).siblings('.input-group-text').css('border', '1px solid #48BB8F');
                    }
                }
            });

            $("#show_hide_password a").on('click', function (event) {
                event.preventDefault();
                if ($('#show_hide_password input').attr("type") == "text") {
                    $('#show_hide_password input').attr('type', 'password');
                    $('.showPass').addClass("fa-eye-slash");
                    $('.showPass').removeClass("fa-eye");
                } else if ($('#show_hide_password input').attr("type") == "password") {
                    $('#show_hide_password input').attr('type', 'text');
                    $('.showPass').removeClass("fa-eye-slash");
                    $('.showPass').addClass("fa-eye");
                }
            });

            $("#btnSubmit").click(function (e) {
                $('form').validate();
                if ($('form').valid()) {
                    $("div.spanner").addClass("show");
                    $("div.overlay").addClass("show");
                }
            });

            $("#btnForgot").click(function () {
                $.get("@Url.Action("OpenPartial", "ACL")", { PageName: "TriggerForgetPassword" }, function (data) {
                    $("#modalContent").html(data);
                    $("#myModal").modal("show");
                });
            });
        });

        function getOverallSearchData() {
            $.ajax({
                type: "get",
                url: ajaxGetOverallData,
                datatype: "json",
                traditional: true,
                success: function (data) {
                    localStorage.setItem("overallData", data);
                    a = true;
                    checkConditionsAndRedirect();
                },
            });
        }

        function getCompany() {
            $.ajax({
                type: "get",
                url: ajaxGetCompany,
                datatype: "json",
                traditional: true,
                success: function (data) {
                    localStorage.setItem("companyList", data);
                    b = true;
                    checkConditionsAndRedirect();
                },
            });
        }

        function checkConditionsAndRedirect() {
            if (a == true && b == true) {
                var session = localStorage.getItem('sessionRFID');
                var url = "";
                const toastLiveExample = document.getElementById('liveToast');
                const toast = new bootstrap.Toast(toastLiveExample);
                toast.show();
                if (session == "true") {

                    url = urlToReturn;
                }
                else {
                    url = urlDashboard;
                }
                localStorage.removeItem('sessionRFID');
                setTimeout(function () {
                    window.location.href = url;
                }, 1000);
            }
        }

        function toastMessage() {
            if (validate == 'True') {
                $('div.spanner').addClass("show");
                $('div.overlay').addClass("show");
                getOverallSearchData();
                getCompany();
                checkConditionsAndRedirect();
            }

            else if (validate == 'False') {
                const toastLiveExample = document.getElementById('liveToast2');
                const toast = new bootstrap.Toast(toastLiveExample);

                toast.show();
            }

            if (message != "" && message != null) {
                const toastLiveExample = document.getElementById('liveToast3');
                const toast = new bootstrap.Toast(toastLiveExample);

                toast.show();
            }

            if (resetSuccess != "" && resetSuccess != null) {
                const toastLiveExample = document.getElementById('liveToast4');
                const toast = new bootstrap.Toast(toastLiveExample);

                toast.show();
            }
        }
    </script>
</body>
</html>
