        //    }

        //    if (validPass) {
        //        $("#txtNewPass").addClass("border-success");
        //        $("#txtNewPass").removeClass("border-danger");
        //        $("#leftNewPass").addClass("border-success");
        //        $("#leftNewPass").removeClass("border-danger");
        //        $("#rightNewPass").addClass("border-success");
        //        $("#rightNewPass").removeClass("border-danger");
