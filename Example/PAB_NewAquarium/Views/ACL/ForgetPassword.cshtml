        $('#txtConfirmNewPass').on('keydown keyup change', function (e) {
            console.log(this.value === $('#txtNewPass').val());
            console.log(this.value);
            console.log($('#txtNewPass').val());
            console.log(validPass);

            if (this.value === $('#txtNewPass').val() && validPass === true) {
                $("#changeButtonSubmit").prop("disabled", false);
                $("#txtConfirmNewPass").addClass("border-success");
                $("#txtConfirmNewPass").removeClass("border-danger");
                $("#leftConfirmPass").addClass("border-success");
                $("#leftConfirmPass").removeClass("border-danger");
                $("#rightConfirmPass").addClass("border-success");
                $("#rightConfirmPass").removeClass("border-danger");
            } else {
                $("#changeButtonSubmit").prop("disabled", true);
                $("#txtConfirmNewPass").addClass("border-danger");
                $("#txtConfirmNewPass").removeClass("border-success");
                $("#leftConfirmPass").addClass("border-danger");
                $("#leftConfirmPass").removeClass("border-success");
                $("#rightConfirmPass").addClass("border-danger");
                $("#rightConfirmPass").removeClass("border-success");
            }
        });

        $("#changeButtonSubmit").click(function () {

            var emailAddress = '@(TempData["EmailAddress"] as string)';
            var OTP = '@(TempData["OTP"] as string)';

            var formData = {
                EmailAddress: emailAddress,
                OTP: OTP,
                NewPass: $("#txtNewPass").val(),
                ConfirmNewPass: $("#txtConfirmNewPass").val(),
            };

            $.ajax({
                type: "POST",
                url: "@Url.Action("ForgetPassword", "ACL")",
                data: formData, // Serialize form data correctly
                success: function (data) {
                    if (data.success) {
                        console.log(data);
                        window.location.href = '@Url.Action("Login", "ACL")';
                    } else {
                        $("#myModal3").modal('hide');
                        Swal.fire('Failed!', 'Reset Password Unsucccessfully.', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire('Error!', error, 'error');
                }
            });
        });
