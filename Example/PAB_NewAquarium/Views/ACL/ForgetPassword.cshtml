@model PAB_NewAquarium.Models.ForgetPasswordViewModel

@{
    string emailAddress = TempData["EmailAddress"] as string;
    string OTP = TempData["OTP"] as string;
}

<style>

    .tooltip-inner {
        max-width: 500px !important;
        height: 110px;
        font-size: 12px;
        padding: 10px 15px 10px 20px;
        background: rgba(255, 255, 255, 1) !important;
        color: black !important;
        border: 1px solid #737373;
        text-align: left;
    }

    .tooltip.show {
        opacity: 1 !important;
    } 

    .circle-icon {
        display: inline-block;
        width: 5px;
        height: 5px;
        background-color: red;
        border-radius: 50%;
        margin-right: 5px;
    }

    .password-requirement{
        text-align:left;
    }

    .green-circle {
        background-color: green;
        border-color: green;
        color: white;
    }

    .remove-left-border {
        background-color: white !important;
        box-shadow: none !important;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="form-group form-group-margin">
    <h4 class="text-center mt-2" style="font-weight:bold; color:#54575a;">Reset Password</h4>
</div>
<div class="row" id="triggerResetPassword">
    <fieldset>
        @Html.AntiForgeryToken()

        <div class="form-group form-group-margin">
            <label for="txtNewPass" class="form-label mt-4">New Password</label>
            <div class="form-group tr-chk-container">
                <div class="input-group" id="show_hide_password_forgot">
                    <span class="input-group-text icon-border-container input-group-addon" id="leftNewPass">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    @Html.PasswordFor(a => a.NewPass, new { id = "txtNewPass", placeholder = "Enter your Password", @class = "form-control password-txt login-txt textbox", @value = "" })
                    <div class="input-group-text icon-border-container remove-left-border" id="rightNewPass">
                        <a href="" class="text-reset"><i class="fa-solid fa-eye-slash showPass" aria-hidden="true"></i></a>
                    </div>
                    <div class="errMsg col-12">@Html.ValidationMessageFor(a => a.NewPass, "", new { @class = "red", @style = "color:red" })</div>
                </div>
            </div>
        </div>
        <div class="form-group form-group-margin">
            <label for="txtConfirmNewPass" class="form-label mt-4">Confirm New Password</label>
            <div class="form-group">
                <div class="input-group" id="show_hide_password_confirm">
                    <span class="input-group-text icon-border-container input-group-addon" id="leftConfirmPass">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    @Html.PasswordFor(a => a.ConfirmNewPass, new { id = "txtConfirmNewPass", placeholder = "Enter your Password", @class = "form-control password-txt login-txt textbox", @value = "" })
                    <div class="input-group-text icon-border-container remove-left-border" id="rightConfirmPass">
                        <a href="" class="text-reset"><i class="fa-solid fa-eye-slash showPassConfirm" aria-hidden="true"></i></a>
                    </div>
                    <div class="errMsg col-12">@Html.ValidationMessageFor(a => a.ConfirmNewPass, "", new { @class = "red", @style = "color:red" })</div>
                </div>
            </div>
        </div>
        <div class="form-group form-group-margin d-grid gap-2 mt-4">
            <button class="btn btn-primary tr-login-btn" type="submit" disabled id="changeButtonSubmit" style="border-radius: 2px"><b>RESET</b></button>
        </div>
    </fieldset>
</div>
<script>

    function updateTooltip(isValid) {
        var tooltipEl = tooltip._tooltip;
        if (isValid) {
            tooltipEl.querySelector('.requirement-icon').classList.add('valid');
            tooltipEl.querySelector('.requirement-text').style.color = 'green';
        } else {
            tooltipEl.querySelector('.requirement-icon').classList.remove('valid');
            tooltipEl.querySelector('.requirement-text').style.color = 'red';
        }
    }


    $(document).ready(function () {
        var tooltipContent = `
            <div>
                <div>
                    <h6 class="requirement-text">Password Requirement</h6>
                </div>
                <div class="password-requirement">
                    <span class="circle-icon" id="eightCharCircle"></span>
                    <span><small>Must be over 8 characters</small></span>
                </div>
                <div class="password-requirement">
                    <span class="circle-icon" id="oneULCircle"></span>
                    <span><small>Have at least 1 uppercase & lowercase letter</small></span>
                </div>
                <div class="password-requirement">
                    <span class="circle-icon" id="oneNumberCircle"></span>
                    <span><small>Have at least 1 number & 1 special character</small></span>
                </div>
                <div class="password-requirement">
                    <span class="circle-icon" id="noSpaceCircle"></span>
                    <span><small>No spacing</small></span>
                </div>
            </div>
        `;

        var tooltip = new bootstrap.Tooltip($("#txtNewPass"), {
            title: tooltipContent,
            placement: 'left',
            trigger: 'focus hover', // Set trigger option to 'hover' only
            html: true, // Enable HTML content
        });

        var validPass = false;

        $('#txtNewPass').on('focus', function () {
            // Update something when the input field is focused
            console.log('Input field is focused');
            var password = $(this).val();

            // Check for each requirement and update circle color accordingly
            var eightCharCircle = $('#eightCharCircle');
            var oneULCircle = $('#oneULCircle');
            var oneNumberCircle = $('#oneNumberCircle');
            var noSpaceCircle = $('#noSpaceCircle');

            // Check for at least 8 characters
            if (password.length >= 8) {
                eightCharCircle.css('background-color', 'green');
            } else {
                validPass = false;
                eightCharCircle.css('background-color', '');
            }

            // Check for at least 1 uppercase and 1 lowercase letter
            if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                oneULCircle.css('background-color', 'green');
            } else {
                validPass = false;
                oneULCircle.css('background-color', '');
            }

            // Check for at least 1 number and 1 special character
            if (/\d/.test(password) && /[!@@#$%^&*()\-_=+{}[\]|\\;:'",.<>/?]/.test(password)) {
                oneNumberCircle.css('background-color', 'green');
            } else {
                validPass = false;
                oneNumberCircle.css('background-color', '');
            }

            // Check for no spacing
            if (!/\s/.test(password)) {
                noSpaceCircle.css('background-color', 'green');
            } else {
                validPass = false;
                noSpaceCircle.css('background-color', '');
            }
        });

        $('#txtNewPass').on('keydown keyup change', function (e) {

            if (e.code === "Space") {
                e.preventDefault;
            }
            validPass = true;

            var password = $(this).val();

            // Check for each requirement and update circle color accordingly
            var eightCharCircle = $('#eightCharCircle');
            var oneULCircle = $('#oneULCircle');
            var oneNumberCircle = $('#oneNumberCircle');
            var noSpaceCircle = $('#noSpaceCircle');

            // Check for at least 8 characters
            if (password.length >= 8) {
                eightCharCircle.css('background-color', 'green');
            } else {
                validPass = false;
                eightCharCircle.css('background-color', '');
            }

            // Check for at least 1 uppercase and 1 lowercase letter
            if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                oneULCircle.css('background-color', 'green');
            } else {
                validPass = false;
                oneULCircle.css('background-color', '');
            }

            // Check for at least 1 number and 1 special character
            if (/\d/.test(password) && /[!@@#$%^&*()\-_=+{}[\]|\\;:'",.<>/?]/.test(password)) {
                oneNumberCircle.css('background-color', 'green');
            } else {
                validPass = false;
                oneNumberCircle.css('background-color', '');
            }

            // Check for no spacing
            if (!/\s/.test(password)) {
                noSpaceCircle.css('background-color', 'green');
            } else {
                validPass = false;
                noSpaceCircle.css('background-color', '');
            }

            if (validPass) {
                $("#txtNewPass").addClass("border-success");
                $("#txtNewPass").removeClass("border-danger");
                $("#leftNewPass").addClass("border-success");
                $("#leftNewPass").removeClass("border-danger");
                $("#rightNewPass").addClass("border-success");
                $("#rightNewPass").removeClass("border-danger");
            } else {
                $("#txtNewPass").addClass("border-danger");
                $("#txtNewPass").removeClass("border-success");
                $("#leftNewPass").addClass("border-danger");
                $("#leftNewPass").removeClass("border-success");
                $("#rightNewPass").addClass("border-danger");
                $("#rightNewPass").removeClass("border-success");
            }
        });

        $("#txtNewPass").focus();


        $("#show_hide_password_forgot a").on('click', function (event) {
            event.preventDefault();
            if ($('#show_hide_password_forgot input').attr("type") == "text") {
                $('#show_hide_password_forgot input').attr('type', 'password');
                $('.showPass').addClass("fa-eye-slash");
                $('.showPass').removeClass("fa-eye");
            } else if ($('#show_hide_password_forgot input').attr("type") == "password") {
                $('#show_hide_password_forgot input').attr('type', 'text');
                $('.showPass').removeClass("fa-eye-slash");
                $('.showPass').addClass("fa-eye");
            }
        });

        $("#show_hide_password_confirm a").on('click', function (event) {
            event.preventDefault();
            if ($('#show_hide_password_confirm input').attr("type") == "text") {
                $('#show_hide_password_confirm input').attr('type', 'password');
                $('.showPassConfirm').addClass("fa-eye-slash");
                $('.showPassConfirm').removeClass("fa-eye");
            } else if ($('#show_hide_password_confirm input').attr("type") == "password") {
                $('#show_hide_password_confirm input').attr('type', 'text');
                $('.showPassConfirm').removeClass("fa-eye-slash");
                $('.showPassConfirm').addClass("fa-eye");
            }
        });

        const urlParams = new URLSearchParams(window.location.search);
        const Message = urlParams.get('AlertMessage');
        if (Message != null) {
            alert(Message);
        }



