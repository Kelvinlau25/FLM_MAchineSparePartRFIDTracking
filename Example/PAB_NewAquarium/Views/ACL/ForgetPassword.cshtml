        //    }

        //    // Check for at least one special character
        //    if (!/[!@@#$%^&*()\-_=+{}[\]|\\;:'",.<>/?]/.test(password)) {
        //        validPass = false;
        //        $('#reqSpecial').removeClass("text-success");
        //        $('#reqSpecial').addClass("text-danger");
        //    } else {
