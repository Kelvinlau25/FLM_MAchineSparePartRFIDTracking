@model PAB_NewAquarium.Models.TriggerForgetPasswordViewModel

<fieldset>
    <form id="myForm" action="@Url.Action("TriggerForgetPassword", "ACL")" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group form-group-margin">
            <h4 class="text-center mt-4" style="font-weight:bold; color:#54575a;">Forgot Password?</h4>
            <label for="txtEmailAddress" class="text-center w-100 form-label mt-4"><small>Please enter email address that associated with your account.</small></label>
            <div class="form-group mt-3">
                <div class="input-group">
                    @Html.TextBoxFor(a => a.EmailAddress, new { name = "EmailAddress", id = "txtEmailAddress", placeholder = "user@mail.toray", @class = "form-control login-txt textbox keyboard" })
                </div>
                <div class="errMsg col-12" id="errorMessageDiv">
                    @Html.ValidationMessageFor(a => a.EmailAddress, "", new { @id = "errorMessage", @class = "red", @style = "color:red" })
                </div>
            </div>
        </div>
        <div class="form-group form-group-margin d-grid gap-2 mt-1">
            <span class="text-end w-100">
                <a href="#" id="hasOTPBtn" class="forget-password-text" style="text-decoration:none;">Already has OTP?</a>
            </span>
        </div>
        <div class="form-group form-group-margin d-grid gap-2 mt-4">
            <button class="btn btn-primary tr-login-btn" type="button" id="Submit" style="border-radius: 2px"><b>SEND</b></button>
        </div>
        <div class="form-group form-group-margin d-grid gap-2 mt-4">
            <span class="text-center w-100">
                <a href="@Url.Action("Login", "ACL")" class="forget-password-text" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-2"></i>Back to login</a>
            </span>
        </div>
    </form>
</fieldset>

<script>
    document.getElementById("hasOTPBtn").addEventListener("click", function() {

        $("#myModal").modal('hide');

        $.get("@Url.Action("OpenPartial", "ACL")", { PageName: "VerifyOTP" }, function (data) {
            $("#modalContent2").html(data);
            $("#myModal2").modal("show");
        });
    });

    $(document).ready(function () {
        $("#Submit").click(function () {
            var form = $(this).closest("form");
            $.ajax({
                type: "POST",
                url: "@Url.Action("TriggerForgetPassword", "ACL")",
                data: form.serialize(), // Serialize form data correctly
                success: function (data) {
                    if (data.success) {
                        $("#errorMessage").text("");
                        $("#myModal").modal('hide');

                        // Open myModal2 and load its content
                        $.get("@Url.Action("OpenPartial", "ACL")", { PageName: "VerifyOTP" }, function (data) {
                            $("#modalContent2").html(data);
                            $("#myModal2").modal("show"); // Show myModal2
                        });
                    } else {
                        $("#errorMessage").text(data.errorMessage);
                    }
                },
                error: function (xhr, status, error) {
                    // Handle AJAX error here if needed
                }
            });
        });
    });
</script>
