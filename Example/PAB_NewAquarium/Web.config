<configuration>
	<configSections>
		<section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
	</configSections>
	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="dev_env" value="true" />
		<add key="isTest" value="True" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<add key="SystemName" value="Penfabric Aquarium" />
		<add key="CompanyCode_ACL" value="PAB" />
		<add key="DBTYPE" value="MSSQL" />
		<add key="SystemName_ACL" value="PAB New Aquarium" />
		<add key="CopyrightText" value="Copyright @ YEAR TORAY MALAYSIA SYSTEMS SOLUTION" />
		<add key="VersionText" value="PAB New Aquarium V1.0" />

		<!-- Please register the database connection string-->
		<add key="ACL" value="PAB_NEW_AQUA" />
		<add key="DEV" value="PAB_NEW_AQUA" />
		<add key="GENERAL_QR_DEV" value="TMS_General_QR_TEST" />
		<add key="GENERAL_QR_LIVE" value="TMS_General_QR" />
		<add key="LIVE" value="PAB_NewAquarium_Live" />
		<add key="SignalR" value="DEV_MVC" />
		<add key="DEV_Oracle" value="StdTemplate_DEVOracle" />

		<!--AI API function KEY NEEDED-->
		<add key="ProxyIP" value="http://10.252.133.21:8080"/>
		<add key="AUTO_KEY_TEST" value="http://10.200.0.81:1250/api/getKey" />
		<add key="AUTO_KEY_LIVE" value="http://cld-tgm-app001.toray.my:155/api/getKey" />
		<add key="M_CLIENTADDRESS" value="http://cld-tgm-app001.toray.my:155/api/configuration" />
		<add key="MATRIX_COMPARISON_API" value="https://tms-iot-ai-webapp.azurewebsites.net/comparisonmatrix" />
		
		<!-- PAB QR Marketing -->
		<add key="PAB_QR_API" value="https://www.pabdigitalmarketing.com/Upload/" />
		<add key="PAB_SampleInv" value="PAB_SampleInv" />
		

		<!--Live-->
		<!--<add key="ACL_API" value="http://cld-tgm-app001.toray.my:160" />-->

		<!--Dev-->
		<add key="ACL_API" value="http://10.200.0.81:513" />
		<!--<add key="ACL_API" value="http://10.201.2.4:267" />-->
		
		
	</appSettings>
	<system.web>
		<customErrors mode="Off" />
		<compilation debug="true" targetFramework="4.6.1" />
		<httpRuntime targetFramework="4.6.1" />
		<sessionState timeout="15"></sessionState>
	</system.web>
