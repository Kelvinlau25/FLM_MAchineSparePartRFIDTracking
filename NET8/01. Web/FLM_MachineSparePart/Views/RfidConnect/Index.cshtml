@model List<FILM_Sparepart_MVC.Models.ReaderRFIDModel>
@{
    ViewBag.Title = "RFID Reader Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2><i class="fa fa-wifi"></i> RFID Reader Monitor</h2>
<hr />

<!-- ── Connect Result Alert ───────────────────────────── -->
<div id="connectResultAlert" style="display:none; margin-bottom:10px;"></div>

<!-- ── Reader Status Table ─────────────────────────────── -->
<div class="panel panel-default">
    <div class="panel-heading">
        <b>Reader Status</b>
        <button id="btnDisconnectAll"
                class="btn btn-xs btn-danger pull-right"
                onclick="disconnectAll()">
            <i class="fa fa-times-circle"></i> Disconnect All
        </button>
    </div>
    <div class="panel-body" style="padding:0;">
        <table class="table table-bordered" style="margin-bottom:0;">
            <thead class="head">
                <tr>
                    <th>Location</th>
                    <th>IP Address</th>
                    <th>Host Name</th>
                    <th>Status</th>
                    <th style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody id="readerTableBody">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var statusId = "status-"  + item.HOST_NAME.Replace(".", "-");
                        var btnConnId = "btnConn-"  + item.HOST_NAME.Replace(".", "-");
                        var btnDiscId = "btnDisc-"  + item.HOST_NAME.Replace(".", "-");
                        var spinnerId = "spin-"     + item.HOST_NAME.Replace(".", "-");
                        <tr data-reader="@item.HOST_NAME" data-ip="@item.IP_ADDRESS">
                            <td>@item.LOCATION</td>
                            <td>@item.IP_ADDRESS</td>
                            <td>@item.HOST_NAME</td>
                            <td>
                                <span class="reader-status label label-default" id="@statusId">
                                    Checking...
                                </span>
                            </td>
                            <td>
                                <button id="@btnConnId"
                                        class="btn btn-xs btn-success btn-connect"
                                        data-ip="@item.IP_ADDRESS"
                                        onclick="connectReader(this)">
                                    <i class="fa fa-plug"></i> Connect
                                </button>
                                <button id="@btnDiscId"
                                        class="btn btn-xs btn-warning btn-disconnect"
                                        data-ip="@item.IP_ADDRESS"
                                        style="display:none;"
                                        onclick="disconnectReader(this)">
                                    <i class="fa fa-unlink"></i> Disconnect
                                </button>
                                <span id="@spinnerId" style="display:none; margin-left:4px;">
                                    <i class="fa fa-spinner fa-spin"></i>
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No RFID reader config found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Live Event Panels ──────────────────────────────── -->
<div class="row" style="margin-top:20px;">

    <div class="col-md-6">
        <div class="panel panel-info">
            <div class="panel-heading">
                <b><i class="fa fa-tag"></i> Tag Reads</b>
                <button class="btn btn-xs btn-default pull-right" onclick="clearLog('tagLog')">Clear</button>
            </div>
            <div class="panel-body" style="padding:6px;">
                <div id="tagLog" class="live-log"></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-success">
            <div class="panel-heading">
                <b><i class="fa fa-exchange"></i> Transactions (IN / OUT)</b>
                <button class="btn btn-xs btn-default pull-right" onclick="clearLog('tranLog')">Clear</button>
            </div>
            <div class="panel-body" style="padding:6px;">
                <div id="tranLog" class="live-log"></div>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <div class="panel panel-warning">
            <div class="panel-heading">
                <b><i class="fa fa-lightbulb-o"></i> Tower Lights</b>
            </div>
            <div class="panel-body">
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        var lightId = "light-" + item.HOST_NAME.Replace(".", "-");
                        <div style="margin-bottom:8px;">
                            <b>@item.LOCATION</b> <small class="text-muted">(@item.HOST_NAME)</small>
                            <span id="@lightId" class="label label-default"
                                  style="margin-left:8px; font-size:13px;">
                                &#x26AB; Off
                            </span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading"><b><i class="fa fa-plug"></i> Connection Info</b></div>
            <div class="panel-body">
                <table class="table table-condensed" style="margin-bottom:0;">
                    <tr>
                        <td><b>SignalR</b></td>
                        <td><span id="signalrStatus" class="label label-danger">Disconnected</span></td>
                    </tr>
                    <tr>
                        <td><b>Connection ID</b></td>
                        <td><small id="connectionId">-</small></td>
                    </tr>
                    <tr>
                        <td><b>Last Tag</b></td>
                        <td><span id="lastTag">-</span></td>
                    </tr>
                    <tr>
                        <td><b>Last Transaction</b></td>
                        <td><span id="lastTran">-</span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- ── Debug Log ──────────────────────────────────────── -->
<div class="panel panel-default">
    <div class="panel-heading">
        <b><i class="fa fa-terminal"></i> Debug Log</b>
        <button class="btn btn-xs btn-default pull-right" onclick="clearLog('debugLog')">Clear</button>
    </div>
    <div class="panel-body" style="padding:6px;">
        <div id="debugLog" class="live-log" style="min-height:140px;"></div>
    </div>
</div>

<style>
    .live-log {
        border: 1px solid #ddd;
        padding: 8px;
        min-height: 120px;
        max-height: 260px;
        overflow-y: auto;
        background: #fafafa;
        font-family: monospace;
        font-size: 12px;
        white-space: pre-wrap;
        word-break: break-all;
    }

        .live-log .entry {
            border-bottom: 1px solid #f0f0f0;
            padding: 2px 0;
        }

            .live-log .entry:last-child {
                border-bottom: none;
            }

    .entry-success {
        color: #27ae60;
    }

    .entry-error {
        color: #e74c3c;
    }

    .entry-info {
        color: #2980b9;
    }

    .entry-warn {
        color: #e67e22;
    }
</style>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        var _alertTimer = null;

        // ── Helpers ──────────────────────────────────────────────────────────
        function ts() {
            return new Date().toLocaleTimeString();
        }

        function appendLog(divId, cssClass, text) {
            var $log = $("#" + divId);
            $log.append('<div class="entry ' + cssClass + '">[' + ts() + '] ' + text + '</div>');
            $log.scrollTop($log[0].scrollHeight);
        }

        function clearLog(divId) {
            $("#" + divId).empty();
        }

        function safeId(hostName) {
            return hostName.replace(/\./g, "-");
        }

        // ── Connect result alert (auto-dismisses after 6 s) ──────────────────
        function showConnectAlert(alertClass, iconClass, message) {
            var $alert = $("#connectResultAlert");
            $alert.html(
                '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
                '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                '<i class="fa ' + iconClass + '"></i> ' + message +
                '</div>'
            ).show();

            if (_alertTimer) clearTimeout(_alertTimer);
            _alertTimer = setTimeout(function () { $alert.fadeOut(); }, 6000);
        }

        // ── Status label ─────────────────────────────────────────────────────
        // status values: "Connected" | "Already Connected" | "Connecting" |
        //                "Reconnecting" | "Disconnected"
        function setReaderStatus(hostName, status) {
            var sid  = safeId(hostName);
            var $el  = $("#status-" + sid);
            var s    = status.toLowerCase();

            $el.text(status);
            $el.removeClass("label-danger label-success label-warning label-info label-default");

            if (s === "connected") {
                $el.addClass("label-success");
                updateButtons(sid, true);
            } else if (s === "already connected") {
                $el.addClass("label-info");
                updateButtons(sid, true);          // treat as connected — show Disconnect
            } else if (s.indexOf("reconnect") >= 0) {
                $el.addClass("label-warning");
                updateButtons(sid, false);
            } else if (s.indexOf("connect") >= 0) { // "Connecting"
                $el.addClass("label-warning");
                updateButtons(sid, false);
            } else {
                $el.addClass("label-danger");      // "Disconnected" / "Failed"
                updateButtons(sid, false);
            }
        }

        // ── Button visibility ─────────────────────────────────────────────────
        function updateButtons(sid, isConnected) {
            if (isConnected) {
                $("#btnConn-" + sid).hide();
                $("#btnDisc-" + sid).show();
            } else {
                $("#btnDisc-" + sid).hide();
                $("#btnConn-" + sid).show();
            }
        }

        function setButtonsBusy(sid, busy) {
            $("#btnConn-" + sid).prop("disabled", busy);
            $("#btnDisc-" + sid).prop("disabled", busy);
            $("#spin-" + sid).toggle(busy);
        }

        // ── Tower light ──────────────────────────────────────────────────────
        function setTowerLight(hostName, color) {
            var $el = $("#light-" + safeId(hostName));
            $el.removeClass("label-default label-success label-danger label-warning");
            switch (color.toLowerCase()) {
                case "green": $el.addClass("label-success").text("Green"); break;
                case "red":   $el.addClass("label-danger").text("Red");   break;
                default:      $el.addClass("label-default").text("Off");  break;
            }
        }

        // ── Action button handlers ────────────────────────────────────────────
        function connectReader(btn) {
            var ip       = $(btn).data("ip");
            var row      = $(btn).closest("tr");
            var hostName = row.data("reader");
            var sid      = safeId(hostName);

            setButtonsBusy(sid, true);
            setReaderStatus(hostName, "Connecting");
            appendLog("debugLog", "entry-info", "[Connect] Requesting connect for " + ip + " (" + hostName + ")");

            connection.invoke("ConnectReader", ip).catch(function (err) {
                appendLog("debugLog", "entry-error", "[Connect] Invoke error: " + err);
                setButtonsBusy(sid, false);
                setReaderStatus(hostName, "Disconnected");
                showConnectAlert("alert-danger", "fa-times-circle",
                    "Failed to send connect request for " + ip + ": " + err);
            });
        }

        function disconnectReader(btn) {
            var ip       = $(btn).data("ip");
            var row      = $(btn).closest("tr");
            var hostName = row.data("reader");
            var sid      = safeId(hostName);

            setButtonsBusy(sid, true);
            appendLog("debugLog", "entry-warn", "[Disconnect] Requesting disconnect for " + ip);

            connection.invoke("DisconnectReader", ip).then(function () {
                setButtonsBusy(sid, false);
                setReaderStatus(hostName, "Disconnected");   // ← add this
                appendLog("debugLog", "entry-warn", "[Disconnect] " + hostName + " disconnected.");
            }).catch(function (err) {
                appendLog("debugLog", "entry-error", "[Disconnect] Error: " + err);
                setButtonsBusy(sid, false);
            });
        }

        function disconnectAll() {
            if (!confirm("Disconnect ALL readers?")) return;
            appendLog("debugLog", "entry-warn", "[DisconnectAll] Requesting disconnect all...");
            connection.invoke("DisconnectAll").catch(function (err) {
                appendLog("debugLog", "entry-error", "[DisconnectAll] Error: " + err);
            });
        }

        // ── SignalR setup ─────────────────────────────────────────────────────
        var connection = new signalR.HubConnectionBuilder()
            .withUrl('@Url.Content("~/rfidHub")')
            .withAutomaticReconnect()
            .build();

        // ── Handle ConnectReader result (fires only on the browser that clicked) ──
        connection.on("OnConnectResult", function (result) {
            var hostName = null;
            var sid      = null;

            // Resolve hostName + sid from the IP
            $("#readerTableBody tr").each(function () {
                if ($(this).data("ip") === result.ipAddress) {
                    hostName = $(this).data("reader");
                    sid      = safeId(hostName);
                }
            });

            if (sid) setButtonsBusy(sid, false);

            switch (result.status) {
                case "Connected":
                    if (hostName) setReaderStatus(hostName, "Connected");
                    showConnectAlert("alert-success", "fa-check-circle", result.message);
                    appendLog("debugLog", "entry-success", "[ConnectResult] " + result.message);
                    break;

                case "AlreadyConnected":
                    if (hostName) setReaderStatus(hostName, "Already Connected");
                    showConnectAlert("alert-info", "fa-info-circle",
                        "<b>Connection already existed.</b> " + result.message);
                    appendLog("debugLog", "entry-info", "[ConnectResult] Already connected: " + result.message);
                    break;

                case "Failed":
                    if (hostName) setReaderStatus(hostName, "Disconnected");
                    showConnectAlert("alert-danger", "fa-times-circle",
                        "<b>Connection failed.</b> " + result.message);
                    appendLog("debugLog", "entry-error", "[ConnectResult] Failed: " + result.message);
                    break;
            }
        });

        // ── Pre-populate status from running service ──────────────────────────
        connection.on("OnReaderStatuses", function (statuses) {
            if (!statuses) return;
            statuses.forEach(function (r) {
                var sid = safeId(r.hostName);
                if (r.isConnected) {
                    setReaderStatus(r.hostName, "Connected");
                    appendLog("debugLog", "entry-success",
                        "[ServiceStatus] " + r.hostName + " already connected (service running)");
                } else {
                    setReaderStatus(r.hostName, "Disconnected");
                    appendLog("debugLog", "entry-warn",
                        "[ServiceStatus] " + r.hostName + " is disconnected");
                }
                setButtonsBusy(sid, false);
            });
        });

        connection.on("OnReaderStatus", function (hostName, status, message) {
            setReaderStatus(hostName, status);
            setButtonsBusy(safeId(hostName), false);
            var css = (status.toLowerCase() === "connected") ? "entry-success"
                    : (status.toLowerCase().indexOf("connect") >= 0) ? "entry-info"
                    : "entry-warn";
            appendLog("debugLog", css,
                "[ReaderStatus] " + hostName + " | " + status +
                (message ? " - " + message : ""));
        });

        connection.on("OnTagRead", function (hostName, tagId, location, antennaId) {
            $("#lastTag").text(tagId + " at " + location);
            appendLog("tagLog", "entry-info",
                hostName + " | " + tagId + " | " + location + " | Antenna " + antennaId);
            appendLog("debugLog", "entry-info",
                "[TagRead] " + hostName + " | " + tagId + " | " + location + " | Antenna " + antennaId);
        });

        connection.on("OnTransaction", function (tagId, direction, success, message) {
            var icon = success ? "[OK]" : "[FAIL]";
            var css  = success ? "entry-success" : "entry-error";
            var text = tagId + " | " + direction + " | " + icon +
                       (message ? " - " + message : "");
            $("#lastTran").text(tagId + " | " + direction + " | " + icon);
            appendLog("tranLog", css, text);
            appendLog("debugLog", css, "[Transaction] " + text);
        });

        connection.on("OnTowerLight", function (hostName, color) {
            setTowerLight(hostName, color);
            var css = color === "green" ? "entry-success"
                    : color === "red"   ? "entry-error"
                    : "entry-warn";
            appendLog("debugLog", css, "[TowerLight] " + hostName + " | " + color);
        });

        connection.on("OnPong", function (service, time) {
            appendLog("debugLog", "entry-success",
                "[Pong] Service=" + service + " Time=" + time);
        });

        connection.onreconnecting(function () {
            $("#signalrStatus").text("Reconnecting...")
                .removeClass().addClass("label label-warning");
            appendLog("debugLog", "entry-warn", "SignalR reconnecting...");
        });

        connection.onreconnected(function () {
            $("#signalrStatus").text("Connected")
                .removeClass().addClass("label label-success");
            appendLog("debugLog", "entry-success", "SignalR reconnected.");
            connection.invoke("GetReaderStatuses").catch(function (err) {
                appendLog("debugLog", "entry-error", "GetReaderStatuses failed: " + err);
            });
        });

        connection.onclose(function () {
            $("#signalrStatus").text("Disconnected")
                .removeClass().addClass("label label-danger");
            appendLog("debugLog", "entry-error", "SignalR disconnected.");
        });

        $(function () {
            connection.start().then(function () {
                $("#signalrStatus").text("Connected")
                    .removeClass().addClass("label label-success");
                $("#connectionId").text(connection.connectionId);
                appendLog("debugLog", "entry-success",
                    "SignalR connected. ID = " + connection.connectionId);

                connection.invoke("GetReaderStatuses").catch(function (err) {
                    appendLog("debugLog", "entry-error", "GetReaderStatuses failed: " + err);
                });

                connection.invoke("Ping").catch(function (err) {
                    appendLog("debugLog", "entry-error", "Ping failed: " + err);
                });

            }).catch(function (err) {
                $("#signalrStatus").text("Failed")
                    .removeClass().addClass("label label-danger");
                appendLog("debugLog", "entry-error", "SignalR start failed: " + err);
            });
        });
    </script>
}