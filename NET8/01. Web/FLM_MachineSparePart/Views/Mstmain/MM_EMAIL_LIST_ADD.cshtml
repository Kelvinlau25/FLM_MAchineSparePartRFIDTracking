@model UserMMModel.EmailList

@{
    var url = @Url.Action("MM_EMAIL_LIST_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Email List - Add";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}


@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_EMAIL_LIST_LST", "Mstmain")';
        window.location.href = url;
        </script>
    }

    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

<script type="text/javascript">
    var popup;
    function SelectParentID() {
        var url = '@Url.Action("ResourceParentPopUp", "Mstmain")';
        popup = window.open(url, "Popup", "scrollbars=yes,resizable=yes,location=no,toolbar=no,width=500,height=500");
        popup.focus();
    }
        </script>

        <h2>Email List Master Maintenance - Add</h2>
        <hr />

        @using (Html.BeginForm())
        {

            @Html.AntiForgeryToken()
            <div class="col-100">
                <div class="col-md-8">
                    @Html.HiddenFor(a => a.EMAIL_LIST_ID)
                </div>

                <div class="col-md-8">
                    @Html.HiddenFor(a => a.Email_Group_Cat_1)
                </div>

                <div class="col-md-8">
                    <label>Email Group Name</label>
                </div>

                <div class="col-md-8">
                    <div class="form-group">
                        @Html.TextBoxFor(a => a.Email_Group_Id, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(a => a.Email_Group_Id, "", new { @style = "color:red" })
                    </div>
                </div>

                <div class="col-md-8">
                    <label>Email Group Category</label>
                </div>

                <div class="col-md-8">
                    <div class="form-group">
                        @Html.DropDownListFor(a => a.Email_Group_Cat_1, Model.DropdownEmailGroupCat, "Select Email Category", new { @class = "form-control txtbox" })
                        @Html.ValidationMessageFor(a => a.Email_Group_Cat_1, "", new { @style = "color:red" })
                        @*@Html.DropDownListFor(a => a.Email_Group_Cat_1, ViewData["Email_Group_Cat_1"] as SelectList, new { @class = "form-control txtbox" })*@
                        @*@Html.TextBoxFor(a => a.Email_Group_Cat, null, new { @class = "form-control" })
        @Html.ValidationMessageFor(a => a.Email_Group_Cat)*@
                    </div>
                </div>

                <div class="col-md-8">
                    <label>Email List</label>
                </div>

                <div class="col-md-8">
                    <div class="form-group">
                        <table>
                            <tr>
                                <td style="width:100%;">
                                    @Html.TextAreaFor(model => model.Email_List, 4, 3, new { @class = "form-control required", style = "max-width:65% !important;", @maxlength = "500" })
                                </td>
                                <td>
                                    <img src="~/images/info.ico" height="30" width="30" alt="" title="Please place a comma (,) after every email input.
For example:
alvin_wong_rumin@tms.toray.my ,
charlene_chong@tms.toray.my " />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    @Html.ValidationMessageFor(a => a.Email_List, "", new { @style = "color:red" })
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="col-md-8">
                    @Html.LabelFor(a => a.Remarks)
                </div>

                <div class="form-group">
                    <div class="col-md-8">
                        @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox" })
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
                @Html.BackButton(url)
            </div>
        }


