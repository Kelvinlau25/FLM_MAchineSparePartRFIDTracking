@model UserMMModel.SparePart
@{
    var url = @Url.Action("MM_SPART_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Spare Part";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_SPART_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_SPART_EDIT", "Mstmain" , new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@{
    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

<h2>Spare Part Master Maintenance - Edit</h2>
<hr />
<table style="width:100%;">
