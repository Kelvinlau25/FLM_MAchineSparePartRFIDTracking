@model UserMMModel.Manufacturer

@{
    var url = @Url.Action("MM_MANUF_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Manufacturer - Edit ";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_MANUF_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_MANUF_EDIT", "Mstmain" , new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

