<style>
    #viewContent {
        border-top: solid 2px #CCC;
    }

        #viewContent > form > span {
            display: block;
            color: red;
        }

        #viewContent h3 {
            border-bottom: none;
        }
</style>

@{
    /**/

    var url = @Url.Action("MM_SPART_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Spare Part - Excel";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@{
    if (ViewBag.Message != "" && ViewBag.Message != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Message");
        </script>
    }
}

<h2>Spare Part Master Maintenance - Add(Excel)</h2>
<hr />
@using (Html.BeginForm("MM_SPART_ADD_Excel", "Mstmain", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-2">Template Download</label>
            <label class="labelW10">:</label>
            <div class="col-sm-4">
                <a href="@Url.Action("GetSpartExcel", "MstMain")" target="_blank">Spare Part Excel Template Download</a>
            </div>

        </div>

        <div class="form-group">
            <label class="col-sm-2">Excel File Upload</label>
            <label class="labelW10">:</label>
            <div class="col-sm-9">
                @using (Html.BeginForm("MM_SPART_ADD_Excel", "Mstmain", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {

                <div class="col-sm-9" style="padding-left:0px;">
                    <input type="file" id="file" name="file" class="btn btn-primary" />
                    <input type="submit" value="Upload File" class="btn btn-primary" />
                </div>
                   
                }
            </div>

        </div>


        <br />
    </div>

}



