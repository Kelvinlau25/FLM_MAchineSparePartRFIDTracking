@model UserMMModel.EmailList

@{
    var url = @Url.Action("MM_EMAIL_LIST_LST", "Mstmain").ToString();
    ViewBag.Title = "MM Email List - Edit";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}


@section scripts
{

    @*To update Email Group Category dropdownlist from model data.*@
    <script type="text/javascript">
        $("document").ready(function () {          
            $('#ddlEmailCat').val('@Model.Email_Group_Cat_1');            
        });
     
    </script>
}

@if (!string.IsNullOrEmpty(ViewBag.Result))
{
    <script type="text/javascript">
        var chkmsg = "@ViewBag.Result";
        var url = "";
        //alert("viewbag");
        alert(chkmsg);
        if (chkmsg == "Data is successfully saved.") {
            url= '@Url.Action("MM_EMAIL_LIST_LST", "Mstmain")';
        } else {
            url = '@Url.Action("MM_EMAIL_LIST_EDIT", "Mstmain" , new { id = ViewBag.ID })';
        }
        window.location.href = url;
    </script>
}

@{
    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

