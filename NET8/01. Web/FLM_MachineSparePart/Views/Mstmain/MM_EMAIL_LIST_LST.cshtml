@using UserMMModel
@model IEnumerable<EmailList>
@{
    ViewBag.Title = "MM Email List";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
    
    var pageIndex = ViewBag.PageIndex ?? 1;
    var pageSize = 10;
    var items = Model.ToList();
}

@if (TempData["result"] != null)
{
    <script type="text/javascript">
        //alert("viewdata");
        alert("@TempData["result"]");
        window.location.href = "@Url.Action("MM_EMAIL_LIST_LST", "Mstmain")";
    </script>
}

<h2>Email List Master Maintenance</h2>
<hr />
@{
    @Html.Partial("_HeaderNoAdd",
    new ViewDataDictionary(this.ViewData) {
        { "Act", "MM_EMAIL_LIST_ADD" },
        { "Ctrl", "Mstmain" },
        { "SrcAct", "MM_EMAIL_LIST_LST" },
        { "SrcVal", "SEARCH_VALUE" }
    })
}
<br />
<br />
<div id="grid">
    <table class="table table-bordered">
        <thead class="head">
            <tr>
                <th>Email Group</th>
                <th>Email Category</th>
                <th>Email List</th>
                <th>Remarks</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @if (items != null && items.Any())
            {
                foreach (var item in items)
                {
                    <tr>
                        <td>@item.Email_Group_Id</td>
                        <td>@item.Email_Group_Cat</td>
                        <td>@item.Email_List</td>
                        <td>@item.Remarks</td>
                        <td>
                            <a href="@Url.Action("MM_EMAIL_LIST_EDIT", "Mstmain", new { id = item.EMAIL_LIST_ID })">
                                <i class="fa fa-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No records found</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<input type="button" value="Export to Excel" class="btn btn-primary" onclick="location.href='@Url.Action("ExportExcelEmailList", "Mstmain")'" />
