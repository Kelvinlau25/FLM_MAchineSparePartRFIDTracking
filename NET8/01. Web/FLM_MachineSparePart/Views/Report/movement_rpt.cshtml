@model ReportModel.MovementRpt
@using System.Data

@{
    /**/

    var url = @Url.Action("movement_rpt", "Report").ToString();
    ViewBag.Title = "movement_rpt";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";

}

<style type="text/css">
    table, th, td {
        /*border: 1px solid black;*/
        text-align: center;
    }

    #tbl1, #tbl1 th, #tbl1 td, #tbl2, #tbl2 th, #tbl2 td, #tbl3, #tbl3 th, #tbl3 td {
        border: 1px solid black;
    }

    .ui-datepicker select.ui-datepicker-month, .ui-datepicker select.ui-datepicker-year {
        color: black;
    }
</style>


<h2>Report Screen</h2>
<hr />
@*@using (Html.BeginForm())*@
@using (Html.BeginForm("movement_rpt", "Report", FormMethod.Post))
{
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    <div class="form-group">
        <label class="col-sm-2">Report Name</label>
        <label class="labelW10">:</label>
        <div class="col-sm-3">
            @Html.DropDownListFor(m => m.selectedId, Model.DropdownReportName, "--Select--", new { @class = "form-control", id = "ddlReport" })
            @Html.ValidationMessageFor(m => m.selectedId, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Date From</label>
        <label class="labelW10">:</label>
        <div class="col-sm-2">
            @*@Html.EditorFor(m => m.DateFrom, new { @class = "form-control datestart", @id = "datepicker" })*@
            @Html.EditorFor(model => model.DateFrom, new { htmlAttributes = new { @class = "form-control datepickerFrom", id = "txtDateFrom" } })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Date To</label>
        <label class="labelW10">:</label>
        <div class="col-sm-2">
            @*@Html.EditorFor(m => m.DateTo, new { @class = "form-control dateend", @id = "datepicker" })*@
            @Html.EditorFor(model => model.DateTo, new { htmlAttributes = new { @class = "form-control datepickerTo", id = "txtDateTo" } })
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2">Location</label>
        <label class="labelW10">:</label>
        <div class="col-sm-3">
            @Html.DropDownListFor(m => m.selectedLocId, Model.DropdownLocationName, "--Select--", new { @class = "form-control", id = "ddlReport2" })
            @Html.ValidationMessageFor(m => m.selectedLocId, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="form-group">
        <input id="Submit" type="submit" name="ActionType" value="Search" class="btn btn-primary" />
        <input type="submit" name="ActionType" value="Reset" class="btn btn-primary" />
        <input type="submit" name="ActionType" value="Export" class="btn btn-primary" />
    </div>

    <div id="tblunknown" style="height: 200px; overflow: auto;">
        <table style="border:solid;width:100%;" id="tbl1">
            <tr>
                <th colspan="15" style="background-color:darkblue; color:white;">Unknown Transaction Report</th>
            </tr>
            <tr>
                <td>RFID ID</td>
                <td>SERIES NO</td>
                <td>PART NO</td>
                <td>MODEL NO</td>
                <td>MACHINE MODEL</td>
                <td>STORAGE CODE</td>
                @*<td>STORAGE DESCRIPTION 1</td>
                <td>STORAGE DESCRIPTION 2</td>*@
                <td>MANUFACTURER</td>
                <td>TRANSACTION TYPE</td>
                <td>STATUS</td>
                <td>CREATED DATE</td>
                <td>CREATED BY</td>
                <td>UPDATED BY</td>
                <td>UPDATED DATE</td>
            </tr>


            @foreach (DataRow row in Model.tableParent.Rows)
            {
                <tr>
                    @foreach (DataColumn col in Model.tableParent.Columns)
                    {
                        <td>@row[col.ColumnName]</td>
                    }
                </tr>
            }
        </table>
    </div>
    <div id="tblsparepart" style="height: 200px; overflow: auto;">
        <table style="border:solid;width:100%;" id="tbl2">
            <tr>
                <th colspan="13" style="background-color:darkblue; color:white; text-align:center;">Spare Part Transaction Report</th>
            </tr>
            <tr>
                <td>MODEL NO</td>
                <td>SERIES NO</td>
                <td>TRANSACTION REASON</td>
                <td>TRANSACTION NAME</td>
                <td>TRANSACTION FLOW</td>
                <td>STATUS</td>
                <td>STORAGE ID</td>
                @*<td>STORAGE DESCRIPTION 1</td>
                <td>STORAGE DESCRIPTION 2</td>*@
                <td>CREATED BY</td>
                <td>CREATED DATE</td>
                <td>UPDATED BY</td>
                <td>UPDATED DATE</td>

            </tr>

            @foreach (DataRow row in Model.tableParent.Rows)
            {
                <tr>
                    @foreach (DataColumn col in Model.tableParent.Columns)
                    {
                        <td>@row[col.ColumnName]</td>
                    }
                </tr>
            }
        </table>
    </div>
    <div id="tbldetail" style="height: 1000px; overflow: auto;">
        <table style="border:solid;width:100%;" id="tbl3">
            <tr>
                <th colspan="14" style="background-color:darkblue; color:white; text-align:center;">Detail Transaction Report</th>
            </tr>
            <tr>
                <td>TRANSACTION TYPE</td>
                <td>RFID ID</td>
                <td>SERIES NO</td>
                <td>PART NO</td>
                <td>MODEL NO</td>
                <td>MACHINE MODEL</td>
                <td>STORAGE CODE</td>
                @*<td>STORAGE DESCRIPTION 1</td>
                <td>STORAGE DESCRIPTION 2</td>*@
                <td>MANUFACTURER</td>
                <td>STATUS</td>
                <td>REMARKS</td>
                <td>CREATED DATE</td>
                <td>CREATED BY</td>
            </tr>

            @foreach (DataRow row in Model.tableParent.Rows)
            {
                <tr>
                    @foreach (DataColumn col in Model.tableParent.Columns)
                    {
                        <td>@row[col.ColumnName]</td>
                    }
                </tr>
            }

        </table>
    </div>
</div>

}

@section scripts
{
    <link href="~/css/jquery-ui-1.8.22.custom.css" rel="stylesheet">
    <script src="~/js/jquery-ui-1.10.3.custom.js"></script>
    <script src="~/js/jquery.mtz.monthpicker.js"></script>

}
<script type="text/javascript">
    $(function () {

        $(".datepickerFrom").datepicker({
            dateFormat: 'yy-mm-dd',
            //defaultDate: "+1w",
            changeMonth: true,
            changeYear: true,
            //numberOfMonths: 1,
            //onSelect: function (selectedDate) {
            //    $("#txtDateFrom").val(selectedDate);
            //},
            onClose: function (selectedDate) {
                $(".datepickerTo").datepicker("option", "minDate", selectedDate);
            }
        }).attr('readonly', 'true');

        $(".datepickerTo").datepicker({
            dateFormat: 'yy-mm-dd', //'mm/dd/yy'
            //defaultDate: "+1w",
            changeMonth: true,
            changeYear: true,
            //numberOfMonths: 1,
            //onSelect: function (selectedDate) {
            //    $("#txtDateTo").val(selectedDate);
            //},
            onClose: function (selectedDate) {
                $(".datepickerFrom").datepicker("option", "maxDate", selectedDate);
            }
        }).attr('readonly', 'true');

    });

</script>
<script type="text/javascript">
    function postback() {
        var elem = document.getElementById("postbackBtn");
        if (typeof elem.onsubmit == "function") {
            elem.onsubmit.apply(elem);
        }
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {
    if ('@ViewBag.ReportType' == 'Select') {
        $('#tblunknown').hide();
        $('#tblsparepart').hide();
        $('#tbldetail').hide();
    }
    else if ('@ViewBag.ReportType' == 'Unknown') {
        $('#tblunknown').show();
        $('#tblsparepart').hide();
        $('#tbldetail').hide();
    }
    else if ('@ViewBag.ReportType' == 'SparePart') {
        $('#tblunknown').hide();
        $('#tblsparepart').show();
        $('#tbldetail').hide();
    }
    else if ('@ViewBag.ReportType' == 'Detail') {
        $('#tblunknown').hide();
        $('#tblsparepart').hide();
        $('#tbldetail').show();
    }
    else if ('@ViewBag.ReportType' == 'Reset') {
        $('#ddlReport').val('');
        $('#ddlReport2').val('');
        $('#txtDateFrom').val('');
        $('#txtDateTo').val('');
        $('#tblunknown').hide();
        $('#tblsparepart').hide();
        $('#tbldetail').hide();
    }
});

</script>
@{
    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Result");
            var url = '@Url.Action("movement_rpt", "Report")';
            window.location.href = url;
        </script>
    }
}
