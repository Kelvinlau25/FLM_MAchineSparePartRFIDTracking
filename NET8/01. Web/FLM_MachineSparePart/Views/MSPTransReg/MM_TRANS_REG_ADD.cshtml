    //for autocomplete
    $(function () {        
        $("#txtModelNo").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("MM_TRANS_REG_MODELNO_Search")',
                    type: "POST",
                    dataType: "json",
                    data: { searchvalue: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Model_No, value: item.Model_No, id: item.SPARE_PART_MODEL_ID };
                        }))

                    }
                })
            },
            messages: {
                noResults: "", results: ""
            },
            select: function (event, ui) {
                //update the jQuery selector here to your target hidden field
                $("#txtmodelid").val(ui.item.id);
                if ($("#ddlTransType").find('option:selected').val() != '')
                {
                    $.ajax({
                        url: '@Url.Action("GetOnHandQty")',
                        type: 'POST',
                        data: { modelID: ui.item.id, transtypeID: $("#ddlTransType").find('option:selected').val() },
                        success: function (result) {
                            //alert(result.myResult1);
                            //alert(result.myResult2);                        
                            var modelID = result.myResult1;
                            var transID = result.myResult2;
                            $('#txtOnHandQty').val(modelID);
                            $('#txtOnRequestQty').val(transID);
                        },
                        error: function (result) {
                            alert("error" + result);
                        }
                    });
                }
            }
        });        
    });

    //for selected index change
    $(document).on('change', '#ddlTransType', (function () {
        var transtype = $(this).val();
        var modelno = $("#txtModelNo").val();
        //alert(transtype);
        //alert(modelno);
        if (modelno == '') {
            $(this).val('');    //reset into default value
            $("#txtModelNo").focus();
            alert("Please select model first before choose your transaction type.");
        }
        else {
            if (transtype == '')
                alert("Please select transaction type.");
            else {
                //alert($("#txtmodelid").val());
                //alert($(this).find('option:selected').val());
                $.ajax({
                    url: '@Url.Action("GetOnHandQty")',
                    type: 'POST',
                    data: { modelID: $("#txtmodelid").val(), transtypeID: $(this).find('option:selected').val() },
                    success: function (result) {
                        //alert(result.myResult1);
                        //alert(result.myResult2);                        
                        var modelID = result.myResult1;
                        var transID = result.myResult2;
                        $('#txtOnHandQty').val(modelID);
                        $('#txtOnRequestQty').val(transID);
                    },
                    error: function (result) {
                        alert("error" + result);
                    }
                });
            }
        }
    }));

    $(function () {
        $("#txtTransQty").keydown(function (event) {
            if (event.shiftKey) {
                event.preventDefault();
            }
            if (event.keyCode == 46 || event.keyCode == 8) {
            }
            else {
                if (event.keyCode < 95) {
                    if (event.keyCode < 48 || event.keyCode > 57) {
                        event.preventDefault();
                    }
                }
                else {
                    if (event.keyCode < 96 || event.keyCode > 105) {
                        event.preventDefault();
                    }
                }
            }
        });
    });
</script>


