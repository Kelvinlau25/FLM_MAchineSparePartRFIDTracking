@model MSPTransReg.Transaction
@{
    var url = @Url.Action("MM_TRANS_REG_LST", "MSPTransReg").ToString();
    ViewBag.Title = "MM_TRANS_REG_ADD";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        var url = '@Url.Action("MM_TRANS_REG_LST", "MSPTransReg")';
        window.location.href = url;
        </script>
    }

    if (ViewBag.Error != "" && ViewBag.Error != null)
    {
        <script type="text/javascript" language="javascript">
            alert("@ViewBag.Error");
        </script>
    }
}

