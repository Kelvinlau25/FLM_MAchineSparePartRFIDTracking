<div class="col-100">
    <div class="col-md-8">
        <label>Model No</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @*for Pop Up*@
            @*@Html.TextBoxFor(a => a.Model_No, null, new { @class = "form-control txtbox", @readonly = "true", id="txtmodelno", @Value=ViewBag.model })   
            <input id="ppModel" type="submit" class="btn btn-primary" value="..." />         
            @Html.HiddenFor(a => a.SPARE_PART_MODEL_ID, new { id = "txtmodelid", @Value = ViewBag.ID })*@

            @*for autocomplete*@
            @Html.EditorFor(a => a.Model_No, new { htmlAttributes = new { @class = "form-control", id="txtModelNo" } })
            @Html.HiddenFor(a => a.SPARE_PART_MODEL_ID, new { id="txtmodelid" })

            @Html.ValidationMessageFor(a => a.Model_No, "", new { @style="color:red" })
        </div>        
        @*<div id="dialog" style="display: none">            
        </div>*@
    </div>
    <div class="col-md-8">
        <label>Transaction Type</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.DropDownListFor(m => m.Trans_Type_ID, Model.DropdownTransType, "Select Transaction Type", new { @class = "form-control", id = "ddlTransType" })            
            @Html.ValidationMessageFor(a => a.Trans_Type_ID, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Quantity On Hand</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.QTY_ON_HAND, null, new { @class = "form-control txtbox", @readonly = "true", id = "txtOnHandQty" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Quantity On Request</label>
    </div>

    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.QTY_ON_REQUEST, null, new { @class = "form-control txtbox", @readonly = "true", id = "txtOnRequestQty" })
        </div>
    </div>
    <div class="col-md-8">
        <label>Transaction Quantity</label>
    </div>

    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.QTY_TRANS, null, new { @class = "form-control txtbox", @maxlength = "50", id = "txtTransQty" })            
        </div>
    </div>
    <div class="col-md-8">
        <label>Status</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.Status, null, new { @class = "form-control txtbox", @readonly = "true" })            
        </div>
    </div>    
    <div class="col-md-8">
        <label>Reason</label>
    </div>
    <div class="col-md-8">
        <div class="form-group">
            @Html.TextBoxFor(a => a.Trans_Reason, null, new { @class = "form-control txtbox", @maxlength = "50" })
            @Html.ValidationMessageFor(a => a.Trans_Reason, "", new { @style = "color:red" })
        </div>
    </div>
    <div class="col-md-8">
        @Html.LabelFor(a => a.Remarks)
    </div>
    <div class="form-group">
        <div class="col-md-8">
            @Html.TextBoxFor(a => a.Remarks, null, new { @class = "form-control txtbox", @maxlength = "50" })
        </div>
    </div>

    <div class="col-md-8">
        <input id="Submit" type="submit" class="btn btn-primary" value="Submit" />
        @Html.BackButton(url)
    </div>
    <br />
</div>

}