                return Json(new { success = false, error = "Model is null" });
            }
            
            Console.WriteLine($"Model.rfid: [{model.rfid ?? "NULL"}]");
            Console.WriteLine($"Model.location: [{model.location ?? "NULL"}]");
            Console.WriteLine($"Model.username: [{model.username ?? "NULL"}]");
            
