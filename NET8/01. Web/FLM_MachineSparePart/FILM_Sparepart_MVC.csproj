<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>FILM_Sparepart_MVC</RootNamespace>
		<AssemblyName>FILM_Sparepart_MVC</AssemblyName>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<!-- Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.2.*" />

		<!-- Active Directory -->
		<PackageReference Include="System.DirectoryServices" Version="8.0.*" />
		<PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.*" />

		<!-- Bundling and Minification -->
		<PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.*" />

		<!-- Excel Processing -->
		<PackageReference Include="ClosedXML" Version="0.102.*" />
		<PackageReference Include="EPPlus" Version="7.0.*" />
		<PackageReference Include="ExcelDataReader" Version="3.7.*" />
		<PackageReference Include="ExcelDataReader.DataSet" Version="3.7.*" />

		<!-- JSON -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.*" />

		<!-- SQL Client -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.*" />

		<!-- SignalR -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
	</ItemGroup>

	<ItemGroup>
		<!-- RFID managed wrapper – v1.2.0.0 (same DLL used by PAB_NewAquarium) -->
		<Reference Include="Symbol.RFID3.Host">
			<HintPath>SDK\Symbol.RFID3.Host.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- favicon.ico served as static file from wwwroot -->
		<Content Include="favicon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>wwwroot\favicon.ico</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Copy native RFID DLLs to output directory -->
		<None Include="SDK\Symbol.RFID3.Host.dll">
			<Link>Symbol.RFID3.Host.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="SDK\RFIDAPI32PC.dll">
			<Link>RFIDAPI32PC.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Services\" />
	</ItemGroup>

</Project>